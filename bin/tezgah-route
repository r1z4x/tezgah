#!/usr/bin/env python3
"""tezgah-route - which worker a delegated task goes to, and the model table.

  tezgah-route "<brief>" [--phase P] [--json]   the agent to spawn, and why
  tezgah-route --check                          the table's age and refresh flags
  tezgah-route --refresh                        re-read prices/ids (OpenRouter),
                                                resolve opencode selectors
  tezgah-route --mode auto|anthropic|any        omp's family, then re-apply omp
  tezgah-route --health                         probe the other funded families;
                                                one at a limit leaves the chain
                                                until its reset; re-apply omp
  tezgah-route --fallback vendor|any|none       what a chain falls back to, then
                                                re-apply omp
  tezgah-route --report                         each route's first check, by tier

A brief naming stored data, a migration, credentials, the gate or security goes to
tezgah-frontier by rule - or to tezgah-security when it only reviews; otherwise
Jev answers two Choices in one call (~700 input tokens, ~0.4 s): the tier, and
whether the brief is the whole job of a specialist (tezgah-tester, -docs,
-security, -ui, -researcher, -reviewer), which is then the agent named. With no
key or `judge-off`, `--phase review|research` names the reviewer or the
researcher, another `--phase` (explore|code|mechanical|plan) picks the tier from
the static table, and with neither the middle tier is used. The brief is sent to the judge seam's
provider - the session's own CLI (omp, claude, opencode, cursor, codex) or the Jev
model through TypeSafe, OpenRouter System One, Cloudflare Workers AI or a
compatible endpoint (TEZGAH_JEV_PROVIDER picks one), else the OpenRouter chat
fallback - so write it in English, the language the judge reads best.

Every routed call writes one `route` row to the session's ledger, named by
TEZGAH_SESSION (omp, opencode, Claude), CODEX_THREAD_ID (Codex) or
CURSOR_CONVERSATION_ID (Cursor); when two of them name different sessions (a host
started from another host's shell) it writes none. The row holds the
tier, agent, what set the tier (`via`: rule|jev|phase|default), the static
table's tier when --phase was given, the worker's model, and `override` (user: an
omp entry the user owns; mode: no entry, so the session model). `--report` joins
each route to the first check of the worker it sent - the child session whose
`spawned` row names this session as its parent, matched by agent type, or by
order only where no spawn could be swapped - and counts a route it cannot prove
as `unjoined`. That outcome is what the V2-as-default
decision waits for (docs/models.md).

A report missing an output field, or an `ESCALATE:`, gets one narrower re-brief
of the same role naming that field or judgement; only a second miss is restarted
on tezgah-frontier with the original brief, never continued. Exit codes: 0 routed / current, 1 the
table is stale or flagged (`--check`) or the refresh failed, 2 misuse.
"""
import argparse
import json
import os
import sys
import time

HERE = os.path.dirname(os.path.dirname(os.path.realpath(__file__)))
sys.path.insert(0, os.path.join(HERE, "hooks"))
import tezgah_integrity as ti  # noqa: E402
import tezgah_judge  # noqa: E402
import tezgah_models as tm  # noqa: E402
import tezgah_paths as tp  # noqa: E402


def main(argv):
    parser = argparse.ArgumentParser(
        prog="tezgah-route",
        description="Name the tier worker a delegated task goes to, and keep the model table.",
        epilog="A report missing an output field, or an `ESCALATE:`, gets one "
               "narrower re-brief of the same role naming that field or judgement; "
               "only a second miss is restarted on tezgah-frontier with the original "
               "brief, never continued.")
    parser.add_argument("brief", nargs="*", help="the delegation brief, in English")
    parser.add_argument("--phase", choices=sorted(tm.PHASE_TIER),
                        help="the static table's row when no judgement is available")
    parser.add_argument("--json", action="store_true", dest="as_json")
    parser.add_argument("--check", action="store_true",
                        help="the table's age and the flags the last refresh left")
    parser.add_argument("--refresh", action="store_true",
                        help="re-read prices and ids, resolve opencode selectors")
    parser.add_argument("--mode", choices=tm.MODES, help="omp's family, then re-apply")
    parser.add_argument("--health", action="store_true",
                        help="probe the other funded families, record the ones at a "
                             "limit until their reset, then re-apply omp's chain")
    parser.add_argument("--fallback", choices=tp.FALLBACKS,
                        help="which families a chain falls back to (config.json "
                             "`fallback`), then re-apply")
    parser.add_argument("--report", action="store_true",
                        help="every ledger's routes joined to the first check after each")
    args = parser.parse_args(argv[1:])
    brief = " ".join(args.brief).strip()
    if args.check:
        lines, stale = tm.check()
        print("\n".join(lines))
        return 1 if stale else 0
    if args.refresh:
        lines, ok = tm.refresh()
        print("\n".join(lines))
        status = tm.apply_omp()
        if status:
            print(status)
        return 0 if ok else 1
    if args.report:
        groups, below = tm.route_report(
            {os.path.basename(p)[:-len(".jsonl")]: ti.events_path(p) for p in ti.ledgers()})

        def line(name, c):
            return "%s routes=%d pass=%d fail=%d ran=%d none=%d unjoined=%d" % (
                name, c["routes"], c["pass"], c["fail"], c["ran"], c["none"],
                c["unjoined"])
        for (via, tier), counts in sorted(groups.items()):
            print(line("%s %s" % (via, tier), counts))
        print(line("jev-below-static", below))
        return 0
    if args.fallback:
        # config.json `fallback` has one other writer: none. A config that does not
        # parse is refused, not replaced (like tezgah-setup --jev).
        try:
            with open(tp.CONFIG, encoding="utf-8") as fh:
                cfg = json.load(fh)
        except FileNotFoundError:
            cfg = {}
        except (OSError, ValueError):
            print("%s is not valid JSON; fallback not set" % tp.CONFIG, file=sys.stderr)
            return 1
        if cfg.get("fallback") != args.fallback:
            cfg["fallback"] = args.fallback
            os.makedirs(os.path.dirname(tp.CONFIG), exist_ok=True)
            tmp = tp.CONFIG + ".tmp"
            with open(tmp, "w", encoding="utf-8") as fh:
                json.dump(cfg, fh, indent=2, sort_keys=True)
                fh.write("\n")
            os.replace(tmp, tp.CONFIG)
        print("fallback: %s (%s)" % (args.fallback, tp.CONFIG))
        print(tm.apply_omp() or "omp not answering; the chain applies at the next setup")
        return 0
    if args.health:
        mode = tm.omp_mode()
        data = tm.refresh_health(mode)
        for family in tm.funded_families(live=False):
            row = data["down"].get(family)
            state = ("the mode's own family, not probed" if family == mode else
                     "down until %s - %s" % (time.strftime("%Y-%m-%d %H:%M",
                                                         time.localtime(row["until"])),
                                             row.get("reason", "")) if row else "up")
            print("%s: %s" % (family, state))
        print(tm.apply_omp() or "omp not answering; the chain applies at the next setup")
        return 0
    if args.mode:
        data = tm.overlay()
        data.pop("mode", None)
        if args.mode != "auto":
            data["mode"] = args.mode
        if not tm.save_overlay(data):
            print("could not write %s" % tm.OVERLAY, file=sys.stderr)
            return 1
        print("omp mode: %s" % args.mode)
        print(tm.apply_omp() or "omp not answering; the mode applies at the next setup")
        return 0
    if not brief:
        print("usage: tezgah-route \"<brief>\" [--phase P] [--json] | --check | --refresh "
              "| --mode M | --health | --fallback F | --report", file=sys.stderr)
        return 2
    ask = tezgah_judge.ask if tezgah_judge.available() else None
    out = tm.route(brief, args.phase, ask)
    judged = out.pop("judged")
    # The session the row goes under: omp, opencode and Claude (CLAUDE_ENV_FILE)
    # export TEZGAH_SESSION, a Codex shell carries CODEX_THREAD_ID (the root
    # thread its hooks' session_id names), a Cursor agent shell
    # CURSOR_CONVERSATION_ID (its hooks' conversation_id). A host started from
    # another host's agent shell inherits that host's id and markers alike, so
    # two different ids name no host: no row, and the route is never written
    # into another host's ledger.
    ids = {os.environ.get(v) for v in ("TEZGAH_SESSION", "CODEX_THREAD_ID",
                                        "CURSOR_CONVERSATION_ID")} - {None, ""}
    session = ids.pop() if len(ids) == 1 else None
    if judged:
        usage = judged.get("usage")
        usage = usage if isinstance(usage, dict) else {}
        detail = "tezgah-route {} tier={} in={} out={} ms={}".format(
            judged.get("model", tezgah_judge.MODEL), out["tier"],
            usage.get("input_tokens"), usage.get("output_tokens"),
            judged.get("latency_ms"))
        ti.note(session, "judge", detail)
    if session:  # the omp read in worker_model costs a process; skip it with no ledger
        ti.note(session, "route", tm.route_detail(out, args.phase,
                                                  *tm.worker_model(out["agent"])))
    if args.as_json:
        print(json.dumps(out))
    else:
        print("agent: %s\ntier: %s\nwhy: %s" % (out["agent"], out["tier"], out["why"]))
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
