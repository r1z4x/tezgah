#!/usr/bin/env python3
"""tezgah-lessons [--root DIR] [--fixture PATH] - propose a tidy of .tezgah/lessons.md.

Read-only: it prints proposals and never writes the ledger, which is the user's
to edit. Lines are numbered the way the injector reads them (the Nth lesson,
blank lines and `#` headings skipped). Three kinds of proposal:

  rewrite N  a line whose rule is not up front (no ` - ` within its first 120
             characters), with a rule-first text for it: its first `: ` or `; `
             turned into ` - ` when that falls inside the bound, else its last
             clause moved in front.
  merge A, B lines that say one lesson (word-Jaccard >= 0.2 over the ranker's
             words, function words out), to be written as one line.
  retire N   a line an enforcer already carries (RETIRE), with the
             `|| enforced_by:` suffix that takes it out of the injected block.

--fixture reads {"lessons_prompts": [{"q": ..., "gt": [N, ...]}]} and prints the
lessons ranking's recall@5 before and after the proposed merges, the ground
truth remapped to the merged numbering. Exit codes: 0 proposals printed, 1 the
merges would lower that recall, 2 usage.
"""
import argparse
import json
import os
import re
import sys

HERE = os.path.dirname(os.path.dirname(os.path.realpath(__file__)))
sys.path.insert(0, os.path.join(HERE, "hooks"))
import tezgah_context as tc  # noqa: E402
import tezgah_lessons  # noqa: E402
import tezgah_rank  # noqa: E402

# Word-Jaccard at which two lines are one lesson: the duplicate-append measure of
# the lessons roadmap (a new line at or above 0.2 to an existing one is a
# repeat), over every word the ranker sees.
MERGE_JACCARD = 0.2
# The lines an enforcer already carries, by a phrase of their text: the gate's
# `piped` refusal, and the research CLI's refusal pinned by its test.
RETIRE = (("A piped check is not evidence", "piped"),
          ("At most one line is open at a time", "tests.test_research.Unfinished"))


def clusters(lines):
    """Groups (0-based, ascending) of two or more lines that say one lesson:
    single-link over MERGE_JACCARD."""
    sets = [set(tezgah_rank.words(ln)) for ln in lines]
    group = list(range(len(lines)))

    def find(i):
        while group[i] != i:
            i = group[i]
        return i
    for i in range(len(lines)):
        for j in range(i + 1, len(lines)):
            union = sets[i] | sets[j]
            if union and len(sets[i] & sets[j]) / len(union) >= MERGE_JACCARD:
                group[find(j)] = find(i)
    out = {}
    for i in range(len(lines)):
        out.setdefault(find(i), []).append(i)
    return sorted(g for g in out.values() if len(g) > 1)


def _prose(line):
    """`line` with code spans and parentheses blanked, so a clause boundary is
    never looked for inside `a: b` or `(x; y)`."""
    return re.sub(r"`[^`]*`|\([^()]*\)", lambda m: "_" * len(m.group()), line)


def rewrite(line):
    """A rule-first text for `line`, or None when it already opens with its rule
    or offers no clause boundary to move."""
    sep, bound = tc.LESSON_SEPARATOR, tc.LESSON_SEPARATOR_BY
    if 0 <= line.find(sep) < bound:
        return None
    prose = _prose(line)
    first = [i for i in (prose.find(": "), prose.find("; ")) if 0 <= i < bound]
    if first:
        i = min(first)
        return line[:i] + sep + line[i + 2:]
    at, mark = max((prose.rfind(b), b) for b in (": ", "; ", ". ", sep))
    tail = line[at + len(mark):].rstrip(" .")
    if at <= 0 or not tail:
        return None
    return tail[0].upper() + tail[1:] + sep + line[:at].rstrip(" .")


def recall(lines, prompts):
    """Mean recall@5 of the lessons ranking over `prompts` (gt 0-based)."""
    hits = [len(set(gt) & set(tezgah_rank.rank(q, lines, 5, tc.LESSON_MAX_DF)))
            / len(gt) for q, gt in prompts if gt]
    return sum(hits) / len(hits) if hits else 0.0


def merged(lines, groups):
    """(lines, where): the ledger with each group joined at its first member,
    and each old index's new one."""
    head = {g[0]: g for g in groups}
    gone = {i for g in groups for i in g[1:]}
    out, where = [], {}
    for i, ln in enumerate(lines):
        if i in gone:
            continue
        where[i] = len(out)
        out.append(" ".join(lines[j] for j in head[i]) if i in head else ln)
    for g in groups:
        for i in g[1:]:
            where[i] = where[g[0]]
    return out, where


def main(argv):
    ap = argparse.ArgumentParser(prog="tezgah-lessons", description=__doc__.split("\n")[0])
    ap.add_argument("--root", default=os.getcwd())
    ap.add_argument("--fixture")
    args = ap.parse_args(argv)
    lines = tezgah_lessons.lines(args.root)
    print("Proposals for %s (nothing is written; apply what you agree with by hand):"
          % os.path.join(args.root, ".tezgah", "lessons.md"))
    for n, ln in enumerate(lines, 1):
        text = rewrite(ln)
        if text:
            print("rewrite %d: %s" % (n, text))
    groups = clusters(lines)
    for g in groups:
        print("merge %s: one lesson, write it as one rule-first line"
              % ", ".join(str(i + 1) for i in g))
    for n, ln in enumerate(lines, 1):
        for needle, by in RETIRE:
            if needle in ln:
                print("retire %d: append `|| enforced_by: %s`" % (n, by))
    if not args.fixture:
        return 0
    with open(args.fixture, encoding="utf-8") as fh:
        prompts = [(p["q"], [g - 1 for g in p["gt"]])
                   for p in json.load(fh)["lessons_prompts"]]
    after_lines, where = merged(lines, groups)
    before = recall(lines, prompts)
    after = recall(after_lines, [(q, sorted({where[g] for g in gt if g in where}))
                                 for q, gt in prompts])
    print("recall@5 %.3f before, %.3f after the merges: %s"
          % (before, after, "holds" if after >= before else "DROPS"))
    return 0 if after >= before else 1


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
