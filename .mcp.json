{
  "mcpServers": {
    "codegraph": {
      "command": "${HOME}/.local/bin/codegraph",
      "args": [
        "serve",
        "--mcp"
      ],
      "env": {
        "CODEGRAPH_MCP_TOOLS": "explore,node,search,callers,callees,impact,files,status",
        "CODEGRAPH_TELEMETRY": "0"
      }
    },
    "tezgah": {
      "command": "${HOME}/radioconda/bin/python3",
      "args": [
        "${HOME}/Projects/tezgah/bin/tezgah-mcp"
      ]
    },
    "playwright": {
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp@0.0.81",
        "--isolated",
        "--caps=testing,storage,network"
      ],
      "env": {
        "PLAYWRIGHT_MCP_OUTPUT_DIR": "${HOME}/.cache/tezgah/apps"
      }
    },
    "mobile-mcp": {
      "command": "npx",
      "args": [
        "-y",
        "@mobilenext/mobile-mcp@1.0.4"
      ],
      "env": {
        "MOBILEMCP_DISABLE_TELEMETRY": "1"
      }
    }
  }
}
