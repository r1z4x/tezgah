    ] + mcp_rows(set(mcp.get("mcpServers") or {}), "mcp.json") + [
        mcp_row(TEZGAH_MCP_NAME, (mcp.get("mcpServers") or {}).get(TEZGAH_MCP_NAME),
                "mcp.json", tezgah_mcp_command()),
