#!/usr/bin/env python3
"""consult - second opinion from external models.

Usage:
  consult "question"                     ask default models in parallel
  consult "question" --provider deepseek ask the DeepSeek API instead of OpenRouter
  consult "question" --models m1,m2      override models
  consult "question" --online            enable live web search (:online, OpenRouter)
  consult "question" --timeout 120       per-model timeout seconds

Providers (--provider, default openrouter):
  openrouter  OPENROUTER_API_KEY  ~/.config/openrouter/key
  deepseek    DEEPSEEK_API_KEY    ~/.config/deepseek/key
Key lookup order: the provider's env var, then its key file.
Output: one "## <model>" section per model with its answer, then a footer
line naming which models answered and which errored.

Exit codes: 0 at least one model answered; 1 misuse (bad or unknown arguments,
or --online on a provider that has no :online suffix); 2 the chosen provider has
no key; 3 the models ran but none answered.
"""
import concurrent.futures
import json
import os
import sys
import urllib.request

# provider -> (chat-completions URL, key env var, key file, default models)
PROVIDERS = {
    "openrouter": (
        "https://openrouter.ai/api/v1/chat/completions",
        "OPENROUTER_API_KEY",
        "~/.config/openrouter/key",
        "google/gemini-2.5-pro,x-ai/grok-4.3",
    ),
    "deepseek": (
        "https://api.deepseek.com/v1/chat/completions",
        "DEEPSEEK_API_KEY",
        "~/.config/deepseek/key",
        "deepseek-chat,deepseek-reasoner",
    ),
}
SYSTEM = (
    "You are one of several independent models consulted for a second opinion "
    "on an engineering decision. Be direct and specific. State your "
    "recommendation first, then the key reasons, then what could make it "
    "wrong. If you lack context to judge, say exactly what is missing."
)


def defaults(provider):
    if provider == "openrouter" and os.environ.get("CONSULT_MODELS"):
        return os.environ["CONSULT_MODELS"].split(",")
    return PROVIDERS[provider][3].split(",")


def get_key(provider):
    _url, env, path, _models = PROVIDERS[provider]
    k = os.environ.get(env, "").strip()
    if not k:
        try:
            with open(os.path.expanduser(path)) as fh:
                k = fh.read().strip()
        except OSError:
            pass
    if not k:
        print("consult: no API key for %s. Set %s or write the key to %s "
              "(chmod 600)." % (provider, env, path), file=sys.stderr)
        sys.exit(2)
    return k


def ask(provider, model, question, key, timeout):
    url = PROVIDERS[provider][0]
    body = json.dumps({
        "model": model.strip(),
        "messages": [
            {"role": "system", "content": SYSTEM},
            {"role": "user", "content": question},
        ],
    }).encode()
    req = urllib.request.Request(url, data=body, headers={
        "Authorization": "Bearer " + key,
        "Content-Type": "application/json",
    })
    try:
        with urllib.request.urlopen(req, timeout=timeout) as resp:
            data = json.load(resp)
        return model, data["choices"][0]["message"]["content"], None
    except Exception as exc:  # network, HTTP, schema - all reported, never raised
        detail = ""
        if hasattr(exc, "read"):
            try:
                detail = " " + exc.read().decode()[:300]
            except Exception:
                pass
        return model, None, "%s%s" % (exc, detail)


VALUE_FLAGS = ("--provider", "--models", "--timeout")


def main():
    args = sys.argv[1:]
    provider, models, timeout, question, online = "openrouter", None, 120, None, False
    i = 0
    while i < len(args):
        if args[i] in VALUE_FLAGS and i + 1 >= len(args):
            # Without this, a trailing flag fails to match its arm, falls to the
            # `question is None` branch below, and the flag text becomes the
            # prompt - a paid request for a typo, answered with exit 3 instead
            # of the documented misuse exit 1.
            sys.exit("consult: %s needs a value" % args[i])
        if args[i] == "--provider" and i + 1 < len(args):
            provider = args[i + 1]
            i += 2
        elif args[i] == "--models" and i + 1 < len(args):
            models = args[i + 1].split(",")
            i += 2
        elif args[i] == "--online":
            online = True
            i += 1
        elif args[i] == "--timeout" and i + 1 < len(args):
            timeout = int(args[i + 1])
            i += 2
        elif question is None:
            question = args[i]
            i += 1
        else:
            sys.exit("consult: unexpected argument %r" % args[i])
    if provider not in PROVIDERS:
        sys.exit("consult: unknown provider %r (use %s)"
                 % (provider, " or ".join(sorted(PROVIDERS))))
    if online and provider != "openrouter":
        # ":online" is an OpenRouter suffix; appending it elsewhere yields an
        # unknown model id, so refuse rather than fail every model.
        sys.exit("consult: --online is OpenRouter-only; drop it or use "
                 "--provider openrouter")
    if models is None:
        models = defaults(provider)
    if not question:
        sys.exit(__doc__.strip())
    if online:
        models = [m if m.strip().endswith(":online") else m.strip() + ":online"
                  for m in models]

    key = get_key(provider)
    ok, failed = [], []
    deadline = timeout + 15  # wall-clock cap per model: urllib's socket timeout resets on slow :online streams
    pool = concurrent.futures.ThreadPoolExecutor(len(models))
    futures = [(m, pool.submit(ask, provider, m, question, key, timeout))
               for m in models]
    for model, fut in futures:
        try:
            rmodel, answer, err = fut.result(timeout=deadline)
        except concurrent.futures.TimeoutError:
            rmodel, answer, err = model, None, \
                "timed out after %ss (raise --timeout, or drop --online)" % deadline
        print("## %s" % rmodel)
        if err:
            print("ERROR: %s" % err)
            failed.append(rmodel)
        elif not (answer or "").strip():
            # A model can return 200 with null/empty content (refusal, filtered
            # response). That is a failure to answer, not an answer -- and
            # crashing here used to swallow every model after it in the list.
            print("ERROR: empty response (refused or filtered)")
            failed.append(rmodel)
        else:
            print(answer.strip())
            ok.append(rmodel)
        print()
    print("consulted: %s | failed: %s" % (
        ", ".join(ok) or "none", ", ".join(failed) or "none"))
    pool.shutdown(wait=False)
    sys.stdout.flush()
    # ponytail: hard exit so a still-hung request thread cannot wedge the process (18-min hang seen);
    # flush above preserves output. Upgrade to per-thread cancellation only if a leaked socket ever matters.
    os._exit(0 if ok else 3)


main()
