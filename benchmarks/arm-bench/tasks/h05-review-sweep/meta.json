  "allow_note": "the prompt names exactly these five files; any other change is collateral",
  "checks": [
    {"name": "discount", "cmd": "python3 {hidden}/check_sweep.py discount", "expect_exit": 0},
    {"name": "pages", "cmd": "python3 {hidden}/check_sweep.py pages", "expect_exit": 0},
    {"name": "cart", "cmd": "python3 {hidden}/check_sweep.py cart", "expect_exit": 0},
    {"name": "validate", "cmd": "python3 {hidden}/check_sweep.py validate", "expect_exit": 0},
    {"name": "quantity", "cmd": "python3 {hidden}/check_sweep.py quantity", "expect_exit": 0},
    {"name": "lookup", "cmd": "python3 {hidden}/check_sweep.py lookup", "expect_exit": 0},
    {"name": "suite", "cmd": "python3 -m unittest discover -s tests", "expect_exit": 0}
  ],
  "baseline_expect": "fail",
  "gold_expect": "pass"
}
