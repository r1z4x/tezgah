#!/usr/bin/env python3
"""tezgah-setup - arm every host you have from this one checkout.

  tezgah-setup                         report what is armed, per host
  tezgah-setup --install               wire every detected host
  tezgah-setup --install --hosts claude,codex,opencode,cursor,dsh
  tezgah-setup --roots ~/work:~/oss --install
  tezgah-setup --uninstall             remove only tezgah-managed wiring
  tezgah-setup --version               print the plugin version
  tezgah-setup --adopt                 move the predecessor wiring aside
  tezgah-setup --sync                  dev: copy this checkout over the Claude plugin copy
  tezgah-setup --status [PATH]         print the armed/used checklist

Claude Code installs from a plugin; the other four do not have that channel,
so they are wired here: Codex hooks.json + skills, Cursor hooks.json + skills,
opencode plugins + instructions + skills, dsh's managed patch block, and the
shared MCP registration.
Re-running is idempotent; every write is backed up once as <file>.tezgah-bak.
"""
import argparse
import datetime
import hashlib
import json
import os
import re
import shutil
import subprocess
import sys

HERE = os.path.dirname(os.path.dirname(os.path.realpath(__file__)))
sys.path.insert(0, os.path.join(HERE, "hooks"))
import tezgah_context  # noqa: E402
import tezgah_paths as tp  # noqa: E402
import tezgah_policy as policy  # noqa: E402
from tezgah_policy import (CBM_RULE, CONSULT, EXEC, NO_CONSULT, ORCHESTRATE,
                           PONYTAIL, WORKFLOWS)  # noqa: E402

HOME = os.path.expanduser("~")
CLAUDE = os.path.join(HOME, ".claude")
CODEX = os.path.join(HOME, ".codex")
OPENCODE = os.path.join(
    os.environ.get("XDG_CONFIG_HOME") or os.path.join(HOME, ".config"), "opencode")
CURSOR = os.path.join(HOME, ".cursor")
DSH = os.environ.get("DSH_HOME") or os.path.join(HOME, ".dsh")
DSH_PATCH = os.path.join(DSH, "cordis.patch.yml")
SKILLS = ["harness", "tezgah-contract", "ponytail", "no-ai-slop",
          "plan-add", "plan-status", "plan-sync"]
WORKFLOW_FILES = ["cbm-map.js", "cbm-review.js", "cbm-impact.js"]
ALL_HOSTS = ["claude", "codex", "opencode", "cursor", "dsh"]
CONTRACT_SHA = os.path.join(tp.CONFIG_DIR, "contract.sha256")
CODEX_PRETOOL_MATCHER = ("Bash|exec_command|apply_patch|Edit|Write|mcp__.*|"
                         "spawn_agent|Agent|Task|Grep")
OK, NO = "  ok  ", " MISS "


def mkdirp(p):
    os.makedirs(p, exist_ok=True)


def expand(p):
    return os.path.expanduser(str(p))


def plugin_version():
    try:
        with open(os.path.join(HERE, ".claude-plugin", "plugin.json")) as fh:
            return json.load(fh).get("version", "unknown")
    except Exception:
        return "unknown"


def policy_sha():
    """sha256 of the shared policy, the source of the opencode contract."""
    try:
        with open(os.path.join(HERE, "hooks", "tezgah_policy.py"), "rb") as fh:
            return hashlib.sha256(fh.read()).hexdigest()
    except OSError:
        return ""


def contract_stale():
    """True when the stored contract hash is missing or out of date."""
    try:
        with open(CONTRACT_SHA) as fh:
            stored = fh.read().strip()
    except OSError:
        stored = ""
    return stored != policy_sha()


def link(src, dst):
    """Idempotent symlink. A real file in the way is kept as <dst>.tezgah-bak
    and replaced, so an old shim (codex/bin/consult) does not block the build."""
    if os.path.isdir(dst) and not os.path.islink(dst):
        return "%s %s is a directory - move it aside first" % (NO, dst)
    if os.path.islink(dst):
        if os.path.realpath(dst) == os.path.realpath(src):
            return "%s %s" % (OK, dst)
        os.unlink(dst)
    elif os.path.exists(dst):
        try:
            os.replace(dst, dst + ".tezgah-bak")
        except OSError as exc:
            return "%s %s (%s)" % (NO, dst, exc)
    try:
        mkdirp(os.path.dirname(dst))
        os.symlink(src, dst)
        return "%s %s -> %s" % (OK, dst, src)
    except OSError as exc:
        return "%s %s (%s)" % (NO, dst, exc)


def read_json(path, default):
    try:
        with open(path) as fh:
            return json.load(fh)
    except Exception:
        return default


def write_json(path, data):
    mkdirp(os.path.dirname(path))
    backup(path)
    tmp = path + ".tmp"
    with open(tmp, "w") as fh:
        json.dump(data, fh, indent=2)
        fh.write("\n")
    os.replace(tmp, path)


def backup(path):
    if os.path.exists(path) and not os.path.exists(path + ".tezgah-bak"):
        try:
            shutil.copy2(path, path + ".tezgah-bak")
        except OSError:
            pass


def set_managed_block(path, block, start="# tezgah:start", end="# tezgah:end"):
    """Replace the tezgah block in a text file, or append it. A YAML file that
    is an empty sequence (`[]`, the dsh patch-layer default) loses that token
    first, because a sequence cannot follow it."""
    try:
        with open(path) as fh:
            lines = fh.read().splitlines()
    except OSError:
        lines = []
    out, skip = [], False
    for ln in lines:
        if ln.strip().startswith(start):
            skip = True
            continue
        if ln.strip().startswith(end):
            skip = False
            continue
        if not skip and ln.strip() != "[]":
            out.append(ln)
    while out and not out[-1].strip():
        out.pop()
    if not out:
        out = ["# dsh home patch layer - tezgah-setup manages the marked block below"]
    mkdirp(os.path.dirname(path))
    backup(path)
    text = "\n".join(out) + "\n" + start + " (managed by tezgah-setup; do not edit)\n" \
        + block.strip() + "\n" + end + "\n"
    with open(path, "w") as fh:
        fh.write(text)


def cbm_command():
    return tp.cbm_bin() or tp.config().get("cbm_bin") or tp.CBM


def detected():
    return {
        "claude": os.path.isdir(CLAUDE),
        "codex": os.path.isdir(CODEX),
        "opencode": os.path.isdir(OPENCODE) or bool(shutil.which("opencode")),
        "cursor": os.path.isdir(CURSOR),
        "dsh": os.path.isdir(DSH) or bool(shutil.which("dsh")),
    }


# ---------------------------------------------------------------- install ----

def install_common(new_roots, hosts):
    cfg = tp.config()
    cfg["roots"] = [expand(r) for r in new_roots] if new_roots else \
        (tp.roots() or [tp.DEFAULT_ROOT])
    if tp.cbm_bin():
        cfg["cbm_bin"] = tp.cbm_bin()
    cfg["hosts"] = hosts
    write_json(tp.CONFIG, cfg)
    print("%s %s  roots=%s" % (OK, tp.CONFIG, cfg["roots"]))
    sha = policy_sha()
    if sha:
        mkdirp(tp.CONFIG_DIR)
        with open(CONTRACT_SHA, "w") as fh:
            fh.write(sha + "\n")
        print("%s %s" % (OK, CONTRACT_SHA))
    for name, src in [
            ("consult", os.path.join(HERE, "bin", "consult")),
            ("codegen", os.path.join(HERE, "bin", "codegen")),
            ("tezgah-status", os.path.join(HERE, "bin", "tezgah-status")),
            ("tezgah-render-table", os.path.join(HERE, "skills", "plan-add", "render_table.py")),
            ("tezgah-codex-hook", os.path.join(HERE, "hosts", "codex", "hook.py")),
            ("tezgah-cursor-hook", os.path.join(HERE, "hosts", "cursor", "hook.py")),
            ("tezgah-statusline", os.path.join(HERE, "statusline.py"))]:
        print(link(src, os.path.join(tp.BIN_DIR, name)))


def statusline_wired():
    sl = read_json(os.path.join(CLAUDE, "settings.json"), {}).get("statusLine") or {}
    return "statusline.py" in json.dumps(sl)


def install_claude():
    print("\nclaude:")
    print(link(os.path.join(HERE, "statusline.py"), os.path.join(CLAUDE, "statusline.py")))
    for w in WORKFLOW_FILES:
        print(link(os.path.join(HERE, "workflows", w), os.path.join(CLAUDE, "workflows", w)))
    for b in ("consult", "codegen", "tezgah-render-table"):
        src = (os.path.join(HERE, "bin", b) if b != "tezgah-render-table"
               else os.path.join(HERE, "skills", "plan-add", "render_table.py"))
        print(link(src, os.path.join(CLAUDE, "bin", b)))
    wire_claude_statusline()
    wire_claude_attribution()


def wire_claude_attribution():
    """Mechanically disable Claude Code's commit/PR attribution.

    `attribution` is a documented settings key (docs.claude.com settings
    reference): {"commit": "", "pr": "", "sessionUrl": false} hides all of it.
    The hooks also enforce this, but the setting removes the default at source.
    Backed up; skipped when already correct."""
    sp = os.path.join(CLAUDE, "settings.json")
    settings = read_json(sp, None)
    if settings is None:
        print("%s %s (will not create it - set attribution by hand)" % (NO, sp))
        return
    wanted = {"commit": "", "pr": "", "sessionUrl": False}
    if settings.get("attribution") == wanted:
        print("%s attribution disabled in Claude settings" % OK)
        return
    settings["attribution"] = wanted
    write_json(sp, settings)
    print("%s attribution -> none (previous kept as %s.tezgah-bak)" % (OK, sp))


def wire_claude_statusline():
    """Point Claude's statusLine at tezgah's wrapper (it forwards to Orca, then
    appends the tezgah segment). Backed up; skipped when already correct."""
    sp = os.path.join(CLAUDE, "settings.json")
    settings = read_json(sp, None)
    if settings is None:
        print("%s %s (will not create it - add the statusLine line by hand)" % (NO, sp))
        return
    cmd = 'python3 "$HOME/.claude/statusline.py"'
    if (settings.get("statusLine") or {}).get("command") == cmd:
        print("%s statusLine -> tezgah" % OK)
        return
    settings["statusLine"] = {"type": "command", "command": cmd}
    write_json(sp, settings)
    print("%s statusLine -> tezgah (previous kept as %s.tezgah-bak)" % (OK, sp))


def install_codex():
    print("\ncodex:")
    cmd = 'python3 "%s"' % os.path.join(tp.BIN_DIR, "tezgah-codex-hook")
    # PreToolUse carries a matcher on the group object, mirroring
    # hosts/codex/hooks.json, and is what makes the policy gate blocking.
    events = [("SessionStart", None), ("UserPromptSubmit", None),
              ("PreToolUse", CODEX_PRETOOL_MATCHER), ("PostToolUse", None),
              ("SubagentStart", None), ("PostCompact", None), ("Stop", None)]
    path = os.path.join(CODEX, "hooks.json")
    data = read_json(path, {"hooks": {}})
    hooks = data.setdefault("hooks", {})
    for ev, matcher in events:
        arr = hooks.setdefault(ev, [])
        arr[:] = [e for e in arr if "tezgah" not in json.dumps(e)]
        group = {}
        if matcher:
            group["matcher"] = matcher
        group["hooks"] = [{"type": "command", "command": cmd, "timeout": 10}]
        arr.append(group)
    write_json(path, data)
    print("%s %s" % (OK, path))
    for s in SKILLS:
        print(link(os.path.join(HERE, "skills", s), os.path.join(CODEX, "skills", s)))
    mcp = os.path.join(CODEX, "bin", "consult")
    print(link(os.path.join(tp.BIN_DIR, "consult"), mcp))
    ensure_toml_mcp(os.path.join(CODEX, "config.toml"))


def ensure_toml_mcp(path):
    try:
        with open(path) as fh:
            text = fh.read()
    except OSError:
        if not os.path.isdir(os.path.dirname(path)):
            return
        text = ""  # codex is installed but has no config.toml yet
    if "mcp_servers.codebase-memory-mcp" in text:
        print("%s MCP server already in %s" % (OK, path))
        return
    backup(path)
    with open(path, "a") as fh:
        fh.write(('\n' if text and not text.endswith("\n") else '')
                 + '[mcp_servers.codebase-memory-mcp]\ncommand = "%s"\n' % cbm_command())
    print("%s added MCP server to %s" % (OK, path))


def opencode_contract():
    """The standing contract for opencode, rendered from the shared policy.

    When the policy exposes a consolidated CORE block it is the contract;
    otherwise the individual blocks are concatenated as before."""
    root = (tp.roots() or [tp.DEFAULT_ROOT])[0]
    core = getattr(policy, "CORE", None)
    if core:
        blocks = [core]
    else:
        blocks = [CBM_RULE % ("each repository", "index it with index_repository if unindexed"),
                  WORKFLOWS, ORCHESTRATE, PONYTAIL, EXEC,
                  CONSULT if tp.have_consult_key() else NO_CONSULT]
    # opencode has no session-start inject hook, so the always-on file must
    # carry the same pointer every hook host appends: without it the two-tier
    # codegen routing and the consult detail are never in front of the session.
    blocks.append(
        "**Full contract on demand.** The router (frontier model) decides and "
        "verifies; bounded, well-specified edits go to `{CODEGEN_BIN}` on a "
        "cheap model, which returns a diff to a scratch dir and never writes "
        "the repo (exit 2 = write it yourself with the main model). Consult "
        "rules and the exact kill switches live in the `tezgah-contract` "
        "skill - load it on the first non-trivial task.")
    text = tezgah_context.render("\n\n".join(b.strip() for b in blocks), root)
    path = os.path.join(tp.CONFIG_DIR, "opencode-contract.md")
    mkdirp(tp.CONFIG_DIR)
    with open(path, "w") as fh:
        fh.write("<!-- generated by tezgah-setup from hooks/tezgah_policy.py;"
                 " edit the source, re-run --install -->\n\n" + text + "\n")
    return path


def install_opencode():
    print("\nopencode:")
    src = os.path.join(HERE, "hosts", "opencode", "plugins", "tezgah.js")
    for d in ("plugins", "plugin"):  # opencode version drift; the plugin self-guards
        print(link(src, os.path.join(OPENCODE, d, "tezgah.js")))
    for s in SKILLS:
        print(link(os.path.join(HERE, "skills", s), os.path.join(OPENCODE, "skills", s)))
    contract = opencode_contract()
    cfg = read_json(os.path.join(OPENCODE, "opencode.json"),
                    {"$schema": "https://opencode.ai/config.json"})
    instr = cfg.get("instructions") or []
    if contract not in instr:
        instr.append(contract)
    cfg["instructions"] = instr
    mcp = cfg.setdefault("mcp", {})
    mcp.setdefault("codebase-memory-mcp", {"enabled": True, "type": "local",
                                           "command": [cbm_command()]})
    write_json(os.path.join(OPENCODE, "opencode.json"), cfg)
    print("%s opencode.json (instructions + mcp)" % OK)
    # TUI status line: opencode has no command statusLine, only a TUI plugin
    # declared in tui.json. Local path spec resolves relative to tui.json.
    print(link(os.path.join(HERE, "hosts", "opencode", "tui", "tezgah-tui.tsx"),
               os.path.join(OPENCODE, "tui-plugins", "tezgah-tui.tsx")))
    tpath = os.path.join(OPENCODE, "tui.json")
    tui = read_json(tpath, {"$schema": "https://opencode.ai/tui.json"})
    plugins = tui.get("plugin") or []
    spec = "./tui-plugins/tezgah-tui.tsx"
    if spec not in [p if isinstance(p, str) else p[0] for p in plugins]:
        plugins.append(spec)
    tui["plugin"] = plugins
    write_json(tpath, tui)
    print("%s tui.json (status line plugin)" % OK)


def install_cursor():
    print("\ncursor:")
    cmd = 'python3 "%s"' % os.path.join(tp.BIN_DIR, "tezgah-cursor-hook")
    path = os.path.join(CURSOR, "hooks.json")
    data = read_json(path, {"version": 1, "hooks": {}})
    data.setdefault("version", 1)
    hooks = data.setdefault("hooks", {})
    # Mirrors hosts/cursor/hooks.json. Existing (Orca) entries are merged,
    # never overwritten: only tezgah entries are replaced.
    spec = {
        "sessionStart": {"timeout": 10},
        "preToolUse": {"timeout": 5, "matcher": "Shell|Grep|Task"},
        "postToolUse": {"timeout": 10},
        "postToolUseFailure": {"timeout": 10},
        "subagentStart": {"timeout": 5},
        "subagentStop": {"timeout": 10},
        "beforeSubmitPrompt": {"timeout": 10},
        "stop": {"timeout": 10},
        "beforeMCPExecution": {"timeout": 5},
        "afterShellExecution": {"timeout": 10},
        "afterMCPExecution": {"timeout": 10},
        "afterFileEdit": {"timeout": 10},
    }
    for ev, extra in spec.items():
        arr = hooks.setdefault(ev, [])
        arr[:] = [e for e in arr if "tezgah" not in json.dumps(e)]
        entry = {"command": cmd}
        entry.update(extra)
        arr.append(entry)
    write_json(path, data)
    print("%s %s" % (OK, path))
    for s in SKILLS:
        print(link(os.path.join(HERE, "skills", s), os.path.join(CURSOR, "skills", s)))
    mpath = os.path.join(CURSOR, "mcp.json")
    mcfg = read_json(mpath, {"mcpServers": {}})
    mcfg.setdefault("mcpServers", {}).setdefault(
        "codebase-memory-mcp", {"command": cbm_command()})
    write_json(mpath, mcfg)
    print("%s %s" % (OK, mpath))
    cc = os.path.join(CURSOR, "cli-config.json")
    cfg = read_json(cc, {})
    cfg.setdefault("version", 1)
    cfg["statusLine"] = {
        "type": "command",
        "command": 'python3 "%s" --cursor' % os.path.join(tp.BIN_DIR, "tezgah-statusline"),
    }
    write_json(cc, cfg)
    print("%s %s (statusLine -> tezgah)" % (OK, cc))


def dsh_patch_block():
    """dsh home-patch rows: run tezgah's existing Claude hooks in dsh through its
    claude-code bridge (same contract, same grep/Explore gate, same attribution
    gate), and register the code graph as an MCP server."""
    return (
        "- insert:\n"
        "    - id: tezgah-hooks\n"
        "      name: '@deepseek-ai/dsh-hooks-claude-code'\n"
        "      config:\n"
        "        configPath: %s\n"
        "        pluginRoot: %s\n"
        "        projectDir: .\n"
        "    - id: tezgah-mcp\n"
        "      name: '@deepseek-ai/dsh-mcp-client'\n"
        "      config:\n"
        "        serverName: codebase-memory-mcp\n"
        "        transport: stdio\n"
        "        command: %s\n"
        % (os.path.join(HERE, "hooks", "hooks.json"), HERE, cbm_command()))


def install_dsh():
    print("\ndsh:")
    for s in SKILLS:
        print(link(os.path.join(HERE, "skills", s), os.path.join(DSH, "skills", s)))
    set_managed_block(DSH_PATCH, dsh_patch_block())
    print("%s %s" % (OK, DSH_PATCH))


INSTALLERS = {"claude": install_claude, "codex": install_codex,
              "opencode": install_opencode, "cursor": install_cursor,
              "dsh": install_dsh}


# ---------------------------------------------------------------- uninstall ----

def is_tezgah_link(path):
    """A symlink is tezgah-managed when it resolves inside this checkout."""
    if not os.path.islink(path):
        return False
    target = os.path.realpath(path)
    return target == HERE or target.startswith(HERE + os.sep)


def unlink_tezgah(path):
    """Remove a tezgah symlink only; anything else is left untouched."""
    if not os.path.islink(path):
        return False
    if not is_tezgah_link(path):
        print("%s kept %s (not a tezgah link)" % (NO, path))
        return False
    os.unlink(path)
    print("%s removed %s" % (OK, path))
    return True


def unlink_dir(d):
    """Remove every tezgah symlink directly inside d (non-recursive)."""
    try:
        names = sorted(os.listdir(d))
    except OSError:
        return
    for name in names:
        unlink_tezgah(os.path.join(d, name))


def drop_managed_hook_entries(path):
    """Remove only tezgah's own entries from a host hooks.json."""
    data = read_json(path, None)
    if not data:
        print("%s no %s" % (OK, path))
        return
    changed = False
    kept_events = {}
    for ev, arr in (data.get("hooks") or {}).items():
        kept = [e for e in arr if "tezgah" not in json.dumps(e)]
        changed = changed or len(kept) != len(arr)
        if kept:
            kept_events[ev] = kept
    if not changed:
        print("%s no tezgah hook entries in %s" % (OK, path))
        return
    if kept_events:
        data["hooks"] = kept_events
    else:
        data.pop("hooks", None)
    write_json(path, data)
    print("%s removed tezgah hook entries from %s" % (OK, path))


def remove_managed_block(path, start="# tezgah:start", end="# tezgah:end"):
    """Drop the tezgah-delimited block, leaving every other line intact."""
    try:
        with open(path) as fh:
            lines = fh.read().splitlines()
    except OSError:
        print("%s no %s" % (OK, path))
        return
    out, skip, changed = [], False, False
    for ln in lines:
        stripped = ln.strip()
        if stripped.startswith(start):
            skip, changed = True, True
            continue
        if stripped.startswith(end):
            skip = False
            continue
        if not skip:
            out.append(ln)
    if not changed:
        print("%s no tezgah block in %s" % (OK, path))
        return
    while out and not out[-1].strip():
        out.pop()
    with open(path, "w") as fh:
        fh.write(("\n".join(out) + "\n") if out else "")
    print("%s removed tezgah block from %s" % (OK, path))


def uninstall_common():
    print("\ncommon:")
    unlink_dir(tp.BIN_DIR)


def unwire_claude_settings():
    """Remove tezgah's statusLine and attribution keys, leaving everything else."""
    sp = os.path.join(CLAUDE, "settings.json")
    s = read_json(sp, None)
    if not s:
        return
    changed = False
    if "statusline.py" in json.dumps(s.get("statusLine") or {}):
        s.pop("statusLine", None)
        changed = True
    if s.get("attribution") == {"commit": "", "pr": "", "sessionUrl": False}:
        s.pop("attribution", None)
        changed = True
    if changed:
        write_json(sp, s)
        print("%s removed tezgah statusLine/attribution from %s (restore from .tezgah-bak if wanted)" % (OK, sp))


def unwire_opencode_config():
    """Drop tezgah's contract path and TUI plugin spec from the opencode configs."""
    p = os.path.join(OPENCODE, "opencode.json")
    c = read_json(p, None)
    if c and c.get("instructions"):
        kept = [i for i in c["instructions"] if "tezgah" not in i]
        if kept != c["instructions"]:
            if kept:
                c["instructions"] = kept
            else:
                c.pop("instructions", None)
            write_json(p, c)
            print("%s removed tezgah instructions from %s" % (OK, p))
    t = os.path.join(OPENCODE, "tui.json")
    tj = read_json(t, None)
    if tj and tj.get("plugin"):
        kept = [x for x in tj["plugin"]
                if "tezgah-tui" not in (x if isinstance(x, str) else x[0])]
        if kept != tj["plugin"]:
            if kept:
                tj["plugin"] = kept
            else:
                tj.pop("plugin", None)
            write_json(t, tj)
            print("%s removed tezgah TUI plugin from %s" % (OK, t))


def uninstall_claude():
    print("\nclaude:")
    unlink_tezgah(os.path.join(CLAUDE, "statusline.py"))
    for w in WORKFLOW_FILES:
        unlink_tezgah(os.path.join(CLAUDE, "workflows", w))
    for b in ("consult", "codegen", "tezgah-render-table"):
        unlink_tezgah(os.path.join(CLAUDE, "bin", b))
    unwire_claude_settings()


def uninstall_codex():
    print("\ncodex:")
    for s in SKILLS:
        unlink_tezgah(os.path.join(CODEX, "skills", s))
    drop_managed_hook_entries(os.path.join(CODEX, "hooks.json"))


def uninstall_opencode():
    print("\nopencode:")
    for s in SKILLS:
        unlink_tezgah(os.path.join(OPENCODE, "skills", s))
    for d in ("plugins", "plugin"):
        unlink_tezgah(os.path.join(OPENCODE, d, "tezgah.js"))
    unlink_tezgah(os.path.join(OPENCODE, "tui-plugins", "tezgah-tui.tsx"))
    unwire_opencode_config()


def uninstall_cursor():
    print("\ncursor:")
    for s in SKILLS:
        unlink_tezgah(os.path.join(CURSOR, "skills", s))
    drop_managed_hook_entries(os.path.join(CURSOR, "hooks.json"))


def uninstall_dsh():
    print("\ndsh:")
    for s in SKILLS:
        unlink_tezgah(os.path.join(DSH, "skills", s))
    remove_managed_block(DSH_PATCH)


UNINSTALLERS = {"claude": uninstall_claude, "codex": uninstall_codex,
                "opencode": uninstall_opencode, "cursor": uninstall_cursor,
                "dsh": uninstall_dsh}


def uninstall(hosts):
    print("uninstalling for: %s\n" % (", ".join(hosts) or "none detected"))
    uninstall_common()
    for h in hosts:
        UNINSTALLERS[h]()
    print("\nnon-tezgah files and .tezgah-bak backups were left untouched.")


# ------------------------------------------------------------------ adopt ----

def _move(path, dest_dir):
    if not os.path.exists(path):
        return False
    mkdirp(dest_dir)
    shutil.move(path, os.path.join(dest_dir, os.path.basename(path)))
    return True


def adopt():
    """Retire the pre-tezgah wiring: the Codex projects-harness, the ~/.claude
    cbm-* hook files and their settings.json entries. Nothing is deleted - it is
    moved under ~/.config/tezgah/adopted/<timestamp>/."""
    stamp = datetime.datetime.now().strftime("%Y%m%d-%H%M%S")
    dest = os.path.join(tp.CONFIG_DIR, "adopted", stamp)
    print("adopt: moving predecessor wiring to %s\n" % dest)

    # Codex: projects-harness dir + its hooks.json entries
    print("%s projects-harness" % (OK if _move(os.path.join(CODEX, "projects-harness"),
                                               dest) else NO))
    path = os.path.join(CODEX, "hooks.json")
    data = read_json(path, None)
    if data:
        for ev, arr in list((data.get("hooks") or {}).items()):
            arr[:] = [e for e in arr
                      if "projects-harness" not in json.dumps(e)
                      and "Code discovery: prefer" not in json.dumps(e)]
        data["hooks"] = {ev: arr for ev, arr in (data.get("hooks") or {}).items() if arr}
        write_json(path, data)
        print("%s cleaned %s" % (OK, path))

    # Claude: the cbm-* hook scripts and the settings.json entries that call them
    for name in ("cbm-code-discovery-gate", "cbm-session-reminder", "cbm-subagent-reminder"):
        print("%s ~/.claude/hooks/%s" % (OK if _move(os.path.join(CLAUDE, "hooks", name),
                                                     dest) else NO, name))
    # Codex: the old bin shims that exec'd projects-harness
    for name in ("codex-harness-status", "consult"):
        f = os.path.join(CODEX, "bin", name)
        if os.path.isfile(f) and not os.path.islink(f):
            try:
                stale = "projects-harness" in open(f).read()
            except OSError:
                stale = False
            if stale:
                print("%s ~/.codex/bin/%s" % (OK if _move(f, dest) else NO, name))
    sp = os.path.join(CLAUDE, "settings.json")
    settings = read_json(sp, None)
    if settings:
        changed = False
        for ev, arr in (settings.get("hooks") or {}).items():
            kept = []
            for entry in arr:
                hs = entry.get("hooks")
                if isinstance(hs, list):
                    before = len(hs)
                    hs[:] = [h for h in hs if "cbm-" not in h.get("command", "")]
                    changed = changed or len(hs) != before
                    if not hs:
                        continue
                kept.append(entry)
            arr[:] = kept
        if changed:
            settings["hooks"] = {ev: arr for ev, arr in (settings.get("hooks") or {}).items() if arr}
            write_json(sp, settings)
            print("%s cleaned cbm hook entries from %s" % (OK, sp))
        else:
            print("%s no cbm hook entries in %s" % (OK, sp))
    print("\nrestart each host for the hooks to reload.")


# ----------------------------------------------------------------- report ----

def predecessors():
    """Pre-tezgah wiring still present; --adopt retires it."""
    out = []
    if os.path.isdir(os.path.join(CODEX, "projects-harness")):
        out.append("~/.codex/projects-harness present")
    if _hooks_has(os.path.join(CODEX, "hooks.json"), "projects-harness"):
        out.append("projects-harness entries in ~/.codex/hooks.json")
    if any(os.path.exists(os.path.join(CLAUDE, "hooks", n)) for n in
           ("cbm-code-discovery-gate", "cbm-session-reminder", "cbm-subagent-reminder")):
        out.append("~/.claude/hooks/cbm-* present")
    if "cbm-" in json.dumps(read_json(os.path.join(CLAUDE, "settings.json"), {})):
        out.append("cbm hook entries in ~/.claude/settings.json")
    return out


def report(hosts):
    print("tezgah checkout: %s\n" % HERE)
    print("roots (%s):" % ("TEZGAH_ROOTS" if os.environ.get("TEZGAH_ROOTS")
                           else "config" if os.path.exists(tp.CONFIG) else "default"))
    for r in tp.roots():
        print("  %s %s" % (OK if os.path.isdir(r) else NO, r))
    print("\ncommon:")
    rows = [
        ("config %s" % tp.CONFIG, os.path.exists(tp.CONFIG)),
        ("%s on PATH" % tp.CBM, bool(tp.cbm_bin())),
        ("OpenRouter key (consult/codegen)", tp.have_consult_key()),
        ("git", bool(shutil.which("git"))),
        ("plugin.json and marketplace.json agree on the version", versions_agree()),
    ]
    for label, good in rows:
        print("  %s %s" % (OK if good else NO, label))
    if contract_stale():
        print("  %s %s" % (NO, "opencode contract stale - re-run --install"))
    pred = predecessors()
    if pred:
        print("\npredecessor wiring still present (retire with --adopt):")
        for p in pred:
            print("  ?    %s" % p)
    for h in hosts:
        print("\n%s:" % h)
        for label, good in HOST_CHECKS[h]():
            print("  %s %s" % (OK if good else NO, label))


def host_checks_claude():
    return [
        ("statusline symlink", os.path.islink(os.path.join(CLAUDE, "statusline.py"))),
        ("statusLine in settings.json", statusline_wired()),
        ("workflows in ~/.claude/workflows",
         all(os.path.islink(os.path.join(CLAUDE, "workflows", w)) for w in WORKFLOW_FILES)),
        ("bin on ~/.claude/bin",
         all(os.path.islink(os.path.join(CLAUDE, "bin", b))
             for b in ("consult", "codegen", "tezgah-render-table"))),
    ]


def _hooks_has(path, marker, events=None):
    data = read_json(path, {}) or {}
    for ev, arr in (data.get("hooks") or {}).items():
        if events and ev not in events:
            continue
        if any(marker in json.dumps(e) for e in arr):
            return True
    return False


def host_checks_codex():
    cmd = "tezgah-codex-hook"
    return [
        ("hooks.json wired", _hooks_has(os.path.join(CODEX, "hooks.json"), cmd)),
        ("skills linked", all(os.path.islink(os.path.join(CODEX, "skills", s)) for s in SKILLS)),
        ("MCP in config.toml", "mcp_servers.codebase-memory-mcp"
         in (open(os.path.join(CODEX, "config.toml")).read()
             if os.path.exists(os.path.join(CODEX, "config.toml")) else "")),
    ]


def host_checks_opencode():
    cfg = read_json(os.path.join(OPENCODE, "opencode.json"), {})
    tui = read_json(os.path.join(OPENCODE, "tui.json"), {})
    instr = cfg.get("instructions") or []
    specs = [p if isinstance(p, str) else p[0] for p in (tui.get("plugin") or [])]
    return [
        ("plugin linked", any(os.path.islink(os.path.join(OPENCODE, d, "tezgah.js"))
                              for d in ("plugins", "plugin"))),
        ("skills linked", all(os.path.islink(os.path.join(OPENCODE, "skills", s)) for s in SKILLS)),
        ("contract in instructions", any("tezgah" in i for i in instr)),
        ("MCP in opencode.json", "codebase-memory-mcp" in (cfg.get("mcp") or {})),
        ("status line plugin in tui.json + linked",
         any("tezgah-tui" in s for s in specs)
         and os.path.exists(os.path.join(OPENCODE, "tui-plugins", "tezgah-tui.tsx"))),
    ]


def host_checks_cursor():
    mcp = read_json(os.path.join(CURSOR, "mcp.json"), {})
    cli = read_json(os.path.join(CURSOR, "cli-config.json"), {})
    return [
        ("hooks.json wired", _hooks_has(os.path.join(CURSOR, "hooks.json"), "tezgah-cursor-hook")),
        ("skills linked", all(os.path.islink(os.path.join(CURSOR, "skills", s)) for s in SKILLS)),
        ("MCP in mcp.json", "codebase-memory-mcp" in (mcp.get("mcpServers") or {})),
        ("statusLine in cli-config.json", "tezgah-statusline" in json.dumps(cli.get("statusLine") or {})),
    ]


def host_checks_dsh():
    try:
        with open(DSH_PATCH) as fh:
            patched = fh.read()
    except OSError:
        patched = ""
    return [
        ("claude-code hooks bridge in cordis.patch.yml", "dsh-hooks-claude-code" in patched),
        ("MCP bridge in cordis.patch.yml", "dsh-mcp-client" in patched),
        ("skills linked", all(os.path.islink(os.path.join(DSH, "skills", s)) for s in SKILLS)),
    ]


HOST_CHECKS = {"claude": host_checks_claude, "codex": host_checks_codex,
               "opencode": host_checks_opencode, "cursor": host_checks_cursor,
               "dsh": host_checks_dsh}


def versions_agree():
    try:
        v = []
        for f in ("plugin.json", "marketplace.json"):
            with open(os.path.join(HERE, ".claude-plugin", f)) as fh:
                d = json.load(fh)
            v.append(d["plugins"][0]["version"] if f == "marketplace.json" else d["version"])
        return v[0] == v[1]
    except Exception:
        return False


# ------------------------------------------------------------------- sync ----

def sync():
    """Copy this checkout over the installed Claude plugin, which is a COPY."""
    cache = os.path.join(HOME, ".claude", "plugins", "cache")
    targets = []
    for dirpath, _dirnames, _ in os.walk(cache):
        manifest = os.path.join(dirpath, ".claude-plugin", "plugin.json")
        try:
            with open(manifest) as fh:
                if json.load(fh).get("name") == "tezgah":
                    targets.append(dirpath)
        except Exception:
            continue
    if not targets:
        print("no installed tezgah found under %s (nothing to sync)" % cache)
        return 1
    tracked = subprocess.run(
        ["git", "-C", HERE, "ls-files", "--cached", "--others", "--exclude-standard"],
        capture_output=True, text=True)
    if tracked.returncode != 0:
        print("not a git checkout, nothing to sync from: %s" % HERE)
        return 1
    # --others includes a new source file that is not committed yet; a plain
    # `ls-files` would drop it from the copy (and delete it from the plugin cache)
    files = [f for f in tracked.stdout.splitlines()
             if f and not f.startswith("plans/") and "__pycache__" not in f]
    for t in targets:
        for name in os.listdir(t):
            if name != ".git":
                path = os.path.join(t, name)
                shutil.rmtree(path, ignore_errors=True) if os.path.isdir(path) \
                    else os.remove(path)
        for f in files:
            dst = os.path.join(t, f)
            os.makedirs(os.path.dirname(dst), exist_ok=True)
            shutil.copy2(os.path.join(HERE, f), dst)
        print("%s synced %s (%d files)" % (OK, t, len(files)))
    print("\nrestart Claude Code: hooks are read once per session.")
    return 0


# ------------------------------------------------------------------- main ----

def main(argv):
    ap = argparse.ArgumentParser(description="arm tezgah in every installed host")
    ap.add_argument("--install", action="store_true")
    ap.add_argument("--uninstall", action="store_true")
    ap.add_argument("--adopt", action="store_true")
    ap.add_argument("--sync", action="store_true")
    ap.add_argument("--status", nargs="?", const=os.getcwd())
    ap.add_argument("--version", action="version", version=plugin_version())
    ap.add_argument("--roots")
    ap.add_argument("--hosts")
    args = ap.parse_args(argv[1:])

    if args.sync:
        return sync()
    if args.status:
        print(tezgah_context.health_lines(os.path.realpath(expand(args.status))))
        return 0

    hosts = [h.strip() for h in args.hosts.split(",")] if args.hosts else \
        [h for h, present in detected().items() if present]
    bad = [h for h in hosts if h not in ALL_HOSTS]
    if bad:
        sys.exit("unknown host(s): %s (choose from %s)" % (", ".join(bad), ", ".join(ALL_HOSTS)))

    if args.uninstall:
        uninstall(hosts)
        return 0

    if args.adopt:
        adopt()
        if not args.install:
            return 0

    if args.install:
        new_roots = [r for r in args.roots.split(os.pathsep) if r.strip()] if args.roots else []
        print("installing for: %s\n" % (", ".join(hosts) or "none detected"))
        install_common(new_roots, hosts)
        for h in hosts:
            INSTALLERS[h]()
        print()
        return report(hosts)

    if args.roots:
        sys.exit("--roots only means something with --install")
    return report(hosts)


if __name__ == "__main__":
    sys.exit(main(sys.argv))
