{
  "owner": "hooks/tezgah_gate.py::decision. A rule change adds or flips its vectors here in the same commit; a host change edits that host's builder in tests/test_gate_vectors.py. A ceiling is a disagreement someone decided to keep: it names the plan that closes it, and the runner fails when it stops disagreeing.",
  "placeholders": {
    "{GHP}": "a ghp_ token, assembled at runtime so no file in the tree carries one whole",
    "{SKLIVE}": "an sk-live- token, assembled the same way",
    "{SKIP}": "the pytest skip marker, assembled because the shortcut rule refuses a tests/ file that adds it"
  },
  "hosts": {
    "core": {"tools": {"Write": "Write", "Edit": "Edit", "apply_patch": "apply_patch",
                       "str_replace_editor": "str_replace_editor", "Bash": "Bash"}},
    "claude": {"tools": {"Write": "Write", "Edit": "Edit", "Bash": "Bash"},
               "matcher": "hooks/hooks.json"},
    "dsh": {"tools": {"Write": "Write", "Edit": "Edit", "Bash": "Bash"},
            "matcher": "hosts/dsh/hooks.json"},
    "codex": {"tools": {"Write": "Write", "Edit": "Edit", "apply_patch": "apply_patch",
                        "Bash": "Bash"},
              "matcher": "hosts/codex/hooks.json"},
    "cursor": {"tools": {"Write": "Write", "Edit": "Edit", "Bash": "Shell"},
               "matcher": "hosts/cursor/hooks.json"},
    "omp": {"tools": {"Write": "write", "Edit": "edit", "apply_patch": "apply_patch",
                      "Bash": "bash"},
            "matcher": "hosts/omp/tezgah-hook.ts.in"},
    "opencode": {"tools": {"Write": "write", "Edit": "edit", "Bash": "bash"}}
  },
  "vectors": [
    {"id": "secret-write", "tool": "Write", "expect": "Credential",
     "input": {"file_path": "src/config.py", "content": "API = \"{GHP}\"\n"}},
    {"id": "secret-edit", "tool": "Edit", "expect": "Credential",
     "input": {"file_path": "src/config.py", "old_string": "API = None\n",
               "new_string": "API = \"{SKLIVE}\"\n"}},
    {"id": "secret-patch", "tool": "apply_patch", "expect": "Credential",
     "input": {"patch": "*** Begin Patch\n*** Update File: src/config.py\n@@\n-API = None\n+API = \"{GHP}\"\n*** End Patch"}},
    {"id": "secret-new-str", "tool": "str_replace_editor", "expect": "Credential",
     "input": {"command": "str_replace", "path": "src/config.py", "old_str": "API = None\n",
               "new_str": "API = \"{GHP}\"\n"}},
    {"id": "secret-file-text", "tool": "str_replace_editor", "expect": "Credential",
     "input": {"command": "create", "path": "src/config.py", "file_text": "API = \"{SKLIVE}\"\n"}},
    {"id": "secret-heredoc", "tool": "Bash", "expect": "Credential",
     "input": {"command": "cat > src/config.py <<'EOF'\nAPI = \"{GHP}\"\nEOF"}},

    {"id": "env-read-write", "tool": "Write", "expect": null,
     "input": {"file_path": "src/db.py", "content": "password = os.environ[\"DB_PASSWORD\"]\n"}},
    {"id": "env-read-edit", "tool": "Edit", "expect": null,
     "input": {"file_path": "src/db.py", "old_string": "password = None\n",
               "new_string": "password = os.environ[\"DB_PASSWORD\"]\n"}},
    {"id": "env-read-patch", "tool": "apply_patch", "expect": null,
     "input": {"patch": "*** Begin Patch\n*** Update File: src/db.py\n@@\n-password = None\n+password = os.environ[\"DB_PASSWORD\"]\n*** End Patch"}},
    {"id": "env-read-new-str", "tool": "str_replace_editor", "expect": null,
     "input": {"command": "str_replace", "path": "src/db.py", "old_str": "password = None\n",
               "new_str": "password = os.environ[\"DB_PASSWORD\"]\n"}},
    {"id": "env-read-file-text", "tool": "str_replace_editor", "expect": null,
     "input": {"command": "create", "path": "src/db.py",
               "file_text": "password = os.environ[\"DB_PASSWORD\"]\n"}},
    {"id": "env-read-heredoc", "tool": "Bash", "expect": null,
     "input": {"command": "cat > src/db.py <<'EOF'\npassword = os.environ[\"DB_PASSWORD\"]\nEOF"}},

    {"id": "ident-write", "tool": "Write", "expect": null,
     "input": {"file_path": "src/models.py", "content": "ORDER = \"pk_users_organization_id\"\nBRANCH = \"sk-telemetry-dashboard-refactor\"\n"}},
    {"id": "ident-edit", "tool": "Edit", "expect": null,
     "input": {"file_path": "src/models.py", "old_string": "ORDER = None\n",
               "new_string": "ORDER = \"pk_users_organization_id\"\n"}},
    {"id": "ident-patch", "tool": "apply_patch", "expect": null,
     "input": {"patch": "*** Begin Patch\n*** Update File: src/models.py\n@@\n-BRANCH = None\n+BRANCH = \"sk-telemetry-dashboard-refactor\"\n*** End Patch"}},
    {"id": "ident-new-str", "tool": "str_replace_editor", "expect": null,
     "input": {"command": "str_replace", "path": "src/models.py", "old_str": "ORDER = None\n",
               "new_str": "ORDER = \"pk_users_organization_id\"\n"}},
    {"id": "ident-file-text", "tool": "str_replace_editor", "expect": null,
     "input": {"command": "create", "path": "src/models.py",
               "file_text": "BRANCH = \"sk-telemetry-dashboard-refactor\"\n"}},
    {"id": "ident-heredoc", "tool": "Bash", "expect": null,
     "input": {"command": "cat > src/models.py <<'EOF'\nORDER = \"pk_users_organization_id\"\nBRANCH = \"sk-telemetry-dashboard-refactor\"\nEOF"}},
    {"id": "ident-shell-redirect", "tool": "Bash", "expect": null,
     "input": {"command": "echo sk-telemetry-dashboard-refactor pk_users_organization_id >> notes.txt"}},

    {"id": "git-add-env", "tool": "Bash", "expect": "Credential",
     "input": {"command": "git add .env"}},
    {"id": "git-add-env-example", "tool": "Bash", "expect": null,
     "input": {"command": "git add .env.example"}},

    {"id": "skip-new-string", "tool": "Edit", "expect": "Test disable",
     "input": {"file_path": "tests/test_zz.py", "old_string": "def test_x():\n",
               "new_string": "{SKIP}\ndef test_x():\n"}},
    {"id": "skip-content", "tool": "Write", "expect": "Test disable",
     "input": {"file_path": "tests/test_zz.py", "content": "{SKIP}\ndef test_x():\n    assert f()\n"}},
    {"id": "skip-patch", "tool": "apply_patch", "expect": "Test disable",
     "input": {"patch": "*** Begin Patch\n*** Update File: tests/test_zz.py\n@@\n+{SKIP}\n def test_x():\n*** End Patch"}},
    {"id": "skip-new-str", "tool": "str_replace_editor", "expect": "Test disable",
     "input": {"command": "str_replace", "path": "tests/test_zz.py", "old_str": "def test_x():\n",
               "new_str": "{SKIP}\ndef test_x():\n"}},
    {"id": "skip-file-text", "tool": "str_replace_editor", "expect": "Test disable",
     "input": {"command": "create", "path": "tests/test_zz.py",
               "file_text": "{SKIP}\ndef test_x():\n    assert f()\n"}},
    {"id": "skip-heredoc", "tool": "Bash", "expect": "Test disable",
     "input": {"command": "cat > tests/test_zz.py <<'EOF'\n{SKIP}\ndef test_x():\n    assert f()\nEOF"}},
    {"id": "skip-patch-non-test-file", "tool": "apply_patch", "expect": null,
     "input": {"patch": "*** Begin Patch\n*** Update File: src/probe.py\n@@\n+{SKIP}\n*** Update File: tests/test_zz.py\n@@\n-a = 1\n+a = 2\n*** End Patch"}},

    {"id": "assert-true-new-string", "tool": "Edit", "expect": null,
     "input": {"file_path": "tests/test_zz.py", "old_string": "    assert f() == 1\n",
               "new_string": "    assert True\n"}},
    {"id": "assert-true-patch", "tool": "apply_patch", "expect": null,
     "input": {"patch": "*** Begin Patch\n*** Update File: tests/test_zz.py\n@@\n-    assert f() == 1\n+    assert True\n*** End Patch"}},
    {"id": "assert-true-new-str", "tool": "str_replace_editor", "expect": null,
     "input": {"command": "str_replace", "path": "tests/test_zz.py", "old_str": "    assert f() == 1\n",
               "new_str": "    assert True\n"}},
    {"id": "collect-ignore-file-text", "tool": "str_replace_editor", "expect": null,
     "input": {"command": "create", "path": "tests/conftest.py",
               "file_text": "collect_ignore = [\"test_slow.py\"]\n"}}
  ],
  "ceilings": [
    {"host": "opencode", "vector": "git-add-env",
     "why": "opencode's shell rules are the JS mirror (hosts/opencode/plugins/tezgah.js::secretCommand) and it asks the core only for TASK_CLI / IDENT_CMD / piped checks; plan 057 (d) puts every shell line to bin/tezgah-gate decide."}
  ]
}
