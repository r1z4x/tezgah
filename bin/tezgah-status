#!/usr/bin/env python3
"""tezgah-status [PATH] - the armed/used checklist for any host.

Reads the same core the hooks do. Claude Code also shows this in its status
line; this CLI is how Codex, Cursor and opencode sessions get it.
"""
import os
import sys

HERE = os.path.dirname(os.path.dirname(os.path.realpath(__file__)))
sys.path.insert(0, os.path.join(HERE, "hooks"))
from tezgah_context import health_lines  # noqa: E402


def main():
    cwd = os.path.realpath(sys.argv[1] if len(sys.argv) > 1 else os.getcwd())
    line = health_lines(cwd, os.environ.get("TEZGAH_SESSION"))
    if line:
        print(line)
    return 0


if __name__ == "__main__":
    sys.exit(main())
