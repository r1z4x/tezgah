#!/usr/bin/env python3
"""tezgah-status [PATH] [SESSION_ID] - the armed/used checklist for any host.

Reads the same core the hooks do. Claude Code also shows this in its status
line; this CLI is how Codex, Cursor and opencode sessions get it. The session
id may be passed as the second argument or via TEZGAH_SESSION; without it the
"used" marks cannot light up, so a host that knows the id should pass it.
"""
import os
import sys

HERE = os.path.dirname(os.path.dirname(os.path.realpath(__file__)))
sys.path.insert(0, os.path.join(HERE, "hooks"))
from tezgah_context import health_lines  # noqa: E402


def main():
    args = sys.argv[1:]
    cwd = os.path.realpath(args[0] if args else os.getcwd())
    session = args[1] if len(args) > 1 else os.environ.get("TEZGAH_SESSION")
    line = health_lines(cwd, session)
    if line:
        print(line)
    return 0


if __name__ == "__main__":
    sys.exit(main())
