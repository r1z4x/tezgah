__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
.DS_Store

# local research notes: kept out of the public repo, never published
/docs/research/

# tezgah: generated agents (managed; removed by tezgah-setup --uninstall)
/.claude/agents/
/.codex/agents/
/.opencode/agents/
# tezgah: end generated agents

# arm-bench: per-arm agent state (SQLite, model caches) is runtime, not evidence
/benchmarks/arm-bench/arms/*/
# ...but the contract variants are the experiment, so they are committed
!/benchmarks/arm-bench/arms/orx-*/
/benchmarks/arm-bench/arms/orx-*/*
!/benchmarks/arm-bench/arms/orx-*/RULES.md
!/benchmarks/arm-bench/arms/orx-*/PROVENANCE.md
# omp-task-rule ships no RULES.md of its own: its treatment is a one-line hook path
# change inside the copied agent dir, so PROVENANCE.md is the whole recipe.
!/benchmarks/arm-bench/arms/omp-task-rule/
/benchmarks/arm-bench/arms/omp-task-rule/*
!/benchmarks/arm-bench/arms/omp-task-rule/PROVENANCE.md

# arm-bench: run directories are throwaway fixtures
/benchmarks/arm-bench/.runs/

# local state: the lessons ledger, the research lines, and the local plugin
# manifest are the maintainer's, not repository content
/.tezgah/
/.claude-plugin/
