DSH_WEB = os.path.join(DSH, "profiles", "web")
DSH_WEB_PATCH = os.path.join(DSH_WEB, "cordis.patch.yml")
DSH_STATUSLINE = "tezgah-dsh-statusline"
OMP = tp.HOST_DIRS["omp"]
OMP_AGENT = os.path.join(OMP, "agent")
OMP_MCP_SCHEMA = ("https://raw.githubusercontent.com/can1357/oh-my-pi/main/"
                  "packages/coding-agent/src/config/mcp-schema.json")
# The managed RULES.md still carries this one line: RULES.md is the always-on
# file, so a session whose extension cannot start still learns the ledger
# exists. The hook injects the actual lessons at session start.
OMP_LESSONS = ("Read `.tezgah/lessons.md` in the repository if it exists and "
               "treat every line as a standing constraint on the work.")
LOCAL_BIN = os.path.join(HOME, ".local", "bin")
SKILLS = ["harness", "tezgah-contract", "ponytail", "no-ai-slop",
          "analyze-app", "plan-add", "plan-status", "plan-sync", "research",
          "ai-research"]
# Shipped by tezgah, reached only from a research task: the always-on router
# collapses it to its bucket's count line like every other on-demand bucket.
RESEARCH_SKILLS = frozenset(("ai-research",))
# opencode context hygiene tezgah arms: prune clears old tool results from the
# prompt (stops a long session re-sending every output each step) and the
# watcher ignore keeps fs-events out of noisy trees. Both merge; a user's
# explicit value wins.
OPENCODE_IGNORE = [".git/**", "node_modules/**", "dist/**", "build/**",
                   ".venv/**", "__pycache__/**", ".ruff_cache/**"]
