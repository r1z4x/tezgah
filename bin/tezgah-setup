# the tree as installs name it: a Homebrew keg through its stable opt/ link
HERE = tp.stable_root(_TREE)

HOME = os.path.expanduser("~")
# Where a released artifact unpacks: <prefix>/<version> plus a `current` symlink
# (a junction or a copy on Windows) to the active one. XDG_DATA_HOME is honoured,
# Windows defaults to LOCALAPPDATA as packaging/install.ps1 does, TEZGAH_PREFIX
# wins outright, and main() resolves the prefix a flag, that env var, the tree
# this process is running from, or the prefix an install recorded - in that
# order - because "is this link tezgah's?" has to accept an install tree exactly
# as it accepts this checkout: a version flip moves what `current` points at, and
# a link judged by the checkout alone is orphaned by every upgrade.
PREFIX_ENV = "TEZGAH_PREFIX"


def default_prefix():
    """The prefix when nothing names one: XDG_DATA_HOME, then LOCALAPPDATA on
    Windows (install.ps1's own default), then ~/.local/share."""
    data = (os.environ.get("XDG_DATA_HOME")
            or (os.name == "nt" and os.environ.get("LOCALAPPDATA"))
            or os.path.join(HOME, ".local", "share"))
    return os.path.join(data, "tezgah")


INSTALL_PREFIX = os.path.realpath(os.environ.get(PREFIX_ENV) or default_prefix())
# True when the prefix came from the environment rather than from the computed
# default: an explicit answer outranks both fallbacks main() resolves (the tree
# that is running, and the prefix an install recorded).
PREFIX_PINNED = bool(os.environ.get(PREFIX_ENV))


def is_link(path):
    """True for a symlink and for a Windows directory junction, which
    `os.path.islink` does not see. `os.path.isjunction` is 3.12+; below it the
    reparse tag answers (`st_reparse_tag`, and the `stat` constant, exist only
    on Windows, so the tag is IO_REPARSE_TAG_MOUNT_POINT's value)."""
    if os.path.islink(path):
        return True
    isjunction = getattr(os.path, "isjunction", None)
    if isjunction:
        return isjunction(path)
    try:
        return os.lstat(path).st_reparse_tag == 0xA0000003
    except (OSError, AttributeError):
        return False


def running_prefix():
    """The install prefix this tree is running from, or "" when it is a checkout.

    `<prefix>/<version>/bin/tezgah-setup` with `<prefix>/current` pointing back
    at it is exactly the released layout, and the running tree is the one piece
    of evidence that cannot be stale about where it lives. It is needed because
    `packaging/install.sh` and `install.ps1` run this installer from the tree
    they just unpacked: without this, a first `--upgrade` from an artifact would
    aim at the default prefix wherever the user put the tree.

    `current` is a symlink, or on Windows a junction; when install.ps1 could not
    make the junction it copied the tree, and the installer runs from the copy,
    so HERE is `<prefix>/current` itself. That copy is a release only when it
    has no `.git` and the VERSION build.sh writes names a version tree beside
    it: a checkout cloned as `current` next to another tree is not one, and
    `--uninstall` would remove both."""
    prefix = os.path.dirname(HERE)  # HERE is <prefix>/<version>, two levels above bin/
    current = os.path.join(prefix, "current")
    if not os.path.isdir(prefix):
        return ""
    if is_link(current) and os.path.realpath(current) == HERE:
        return prefix
    if HERE != current or os.path.exists(os.path.join(HERE, ".git")):
        return ""
    try:
        with open(os.path.join(HERE, "VERSION"), encoding="utf-8") as fh:
            version = fh.read(64).strip()
    except OSError:
        return ""
    if version and os.path.basename(version) == version \
            and version not in (".", "..", "current") \
            and os.path.isfile(os.path.join(prefix, version, "bin", "tezgah-setup")):
        return prefix
    return ""
