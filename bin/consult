#!/usr/bin/env python3
"""consult - second opinion from external models via OpenRouter.

Usage:
  consult "question"                     ask default models in parallel
  consult "question" --models m1,m2      override models
  consult "question" --online            enable live web search (:online)
  consult "question" --timeout 120       per-model timeout seconds

Key lookup order: OPENROUTER_API_KEY env, then ~/.config/openrouter/key.
Output: one "## <model>" section per model with its answer, then a footer
line naming which models answered and which errored. Exit 1 if ALL failed.
"""
import concurrent.futures
import json
import os
import sys
import urllib.request

DEFAULT_MODELS = os.environ.get(
    "CONSULT_MODELS",
    "google/gemini-2.5-pro,x-ai/grok-4.3"
).split(",")
API = "https://openrouter.ai/api/v1/chat/completions"
SYSTEM = (
    "You are one of several independent models consulted for a second opinion "
    "on an engineering decision. Be direct and specific. State your "
    "recommendation first, then the key reasons, then what could make it "
    "wrong. If you lack context to judge, say exactly what is missing."
)


def get_key():
    k = os.environ.get("OPENROUTER_API_KEY", "").strip()
    if not k:
        try:
            with open(os.path.expanduser("~/.config/openrouter/key")) as fh:
                k = fh.read().strip()
        except OSError:
            pass
    if not k:
        sys.exit(
            "consult: no API key. Set OPENROUTER_API_KEY or write the key to "
            "~/.config/openrouter/key (chmod 600)."
        )
    return k


def ask(model, question, key, timeout):
    body = json.dumps({
        "model": model.strip(),
        "messages": [
            {"role": "system", "content": SYSTEM},
            {"role": "user", "content": question},
        ],
    }).encode()
    req = urllib.request.Request(API, data=body, headers={
        "Authorization": "Bearer " + key,
        "Content-Type": "application/json",
    })
    try:
        with urllib.request.urlopen(req, timeout=timeout) as resp:
            data = json.load(resp)
        return model, data["choices"][0]["message"]["content"], None
    except Exception as exc:  # network, HTTP, schema - all reported, never raised
        detail = ""
        if hasattr(exc, "read"):
            try:
                detail = " " + exc.read().decode()[:300]
            except Exception:
                pass
        return model, None, "%s%s" % (exc, detail)


def main():
    args = sys.argv[1:]
    models, timeout, question, online = list(DEFAULT_MODELS), 120, None, False
    i = 0
    while i < len(args):
        if args[i] == "--models" and i + 1 < len(args):
            models = args[i + 1].split(",")
            i += 2
        elif args[i] == "--online":
            online = True
            i += 1
        elif args[i] == "--timeout" and i + 1 < len(args):
            timeout = int(args[i + 1])
            i += 2
        elif question is None:
            question = args[i]
            i += 1
        else:
            sys.exit("consult: unexpected argument %r" % args[i])
    if not question:
        sys.exit(__doc__.strip())
    if online:
        models = [m if m.strip().endswith(":online") else m.strip() + ":online"
                  for m in models]

    key = get_key()
    ok, failed = [], []
    deadline = timeout + 15  # wall-clock cap per model: urllib's socket timeout resets on slow :online streams
    pool = concurrent.futures.ThreadPoolExecutor(len(models))
    futures = [(m, pool.submit(ask, m, question, key, timeout)) for m in models]
    for model, fut in futures:
        try:
            rmodel, answer, err = fut.result(timeout=deadline)
        except concurrent.futures.TimeoutError:
            rmodel, answer, err = model, None, \
                "timed out after %ss (raise --timeout, or drop --online)" % deadline
        print("## %s" % rmodel)
        if err:
            print("ERROR: %s" % err)
            failed.append(rmodel)
        elif not (answer or "").strip():
            # A model can return 200 with null/empty content (refusal, filtered
            # response). That is a failure to answer, not an answer -- and
            # crashing here used to swallow every model after it in the list.
            print("ERROR: empty response (refused or filtered)")
            failed.append(rmodel)
        else:
            print(answer.strip())
            ok.append(rmodel)
        print()
    print("consulted: %s | failed: %s" % (
        ", ".join(ok) or "none", ", ".join(failed) or "none"))
    pool.shutdown(wait=False)
    sys.stdout.flush()
    # ponytail: hard exit so a still-hung request thread cannot wedge the process (18-min hang seen);
    # flush above preserves output. Upgrade to per-thread cancellation only if a leaked socket ever matters.
    os._exit(0 if ok else 1)


main()
