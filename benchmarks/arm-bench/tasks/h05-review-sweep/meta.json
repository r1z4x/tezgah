{
  "id": "h05-review-sweep",
  "family": "long-horizon",
  "prompt": "prompt.md",
  "fixture_dir": "corpus/inventory",
  "source": "new in the hard family (2026-09-16); six independent findings across five files, one check each, so a row records how far an arm got rather than only whether it finished",
  "allow": [
    "inventory/core.py",
    "inventory/paginate.py",
    "inventory/cart.py",
    "inventory/validate.py",
    "inventory/parsing.py"
