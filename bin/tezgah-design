#!/usr/bin/env python3
"""tezgah-design derive|check - the per-repo design contract, and the check that
can fail.

  tezgah-design derive --repo DIR [--out FILE] [--json]
  tezgah-design check --contract FILE --measured FILE|- [--json]
  tezgah-design slop --repo DIR [--url URL] [--render] [--measured FILE]
                        [--out FILE] [--json]

The contract is the floor a UI turn is judged against: the colour roles, the
type scale, the spacing unit and the state set a repository already uses, plus
the component inventory it owns. `derive` writes a first `.tezgah/design-contract.md`
from the repository's own token source (CSS custom properties, a Tailwind config,
a tokens/theme JSON) and exits 2 rather than invent a palette it did not find.
`slop` runs Hallmark's own gate list (`skills/hallmark/scripts/sloplint.mjs`)
over the repository or a running URL, writes the verdict to
`.tezgah/design/slop.json` and exits 1 on any Floor FAIL. It is the Hallmark half
of the UI floor; `check` is ours, and a contract's `precedence` says which of the
two owns each key, so neither can quietly override the other. Exit 3 when Node or
the vendored skill is missing: that is a check that did not run, never a pass.
`check` compares a measurement - the per-component computed styles and observed
states the analyze-app loop produces - against that file, prints every violation
with its component and its rule, and exits non-zero when there is at least one.
It names how many components it judged, and exits 2 when that is zero: `0
violations` over a measurement that carries no component would say the app is
clean when nothing was looked at.

Stdlib only, deterministic, no network and no credential: the same tree and the
same measurement print the same bytes, with no clock and no path outside the
repository in the artifact.

  derive  exit 0 the contract was written; 2 no token source; 1 usage or IO
  check   exit 0 `0 violations` over at least one component judged; 1 one or
          more violations; 2 usage, IO, a bad contract or nothing judged
"""
import json
import math
import os
import re
import shutil
import subprocess
import sys

HERE = os.path.dirname(os.path.dirname(os.path.realpath(__file__)))
sys.path.insert(0, os.path.join(HERE, "hooks"))
from tezgah_paths import linked_main, project_top  # noqa: E402

# The state set every interactive control and every data view owes: seven per
# control, eight per data view, thirteen distinct states - `loading` and `error`
# are the two the halves share, and the shipped lists name them twice rather than
# once. Pinned equal to the three lists the repository already ships
# (tests/test_design_cli.py:StateSetPin) rather than left to drift as a fourth
# copy.
STATES_INTERACTIVE = ("default", "hover", "focus", "active", "disabled",
                      "loading", "error")
STATES_DATA = ("empty", "loading", "skeleton", "error", "offline", "partial",
               "long-text", "permission-denied")
STATES = STATES_INTERACTIVE + tuple(s for s in STATES_DATA
                                    if s not in STATES_INTERACTIVE)
KINDS = ("interactive", "data")

# The floors that are not this repository's to choose: WCAG 2.2 SC 2.5.8 (the
# 24x24 CSS px target size) and SC 1.4.3 (4.5:1, or 3:1 for large text, which is
# 24px and up, or 18.66px bold).
# The precedence table (plan 133). A key owned by two sources is refused by
# `check`, so the tie-break cannot drift silently; `verbatim` says how far the
# user's own words reach, and it stops at style.
PRECEDENCE = {
    "ours": ["states", "components", "evidence", "facts"],
    "theirs": ["material", "motion-character"],
    "shared": ["contrast", "focus-visible", "reduced-motion", "tap-target"],
    "verbatim": "style",
}
TAP_TARGET = 24
CONTRAST_NORMAL = 4.5
CONTRAST_LARGE = 3.0
LARGE_TEXT = 24

# The two floors the vendored design library names and a measurement can decide:
# a focus indication that survives the outline being switched off (SC 2.4.7 Focus
# Visible, Level AA - skills/design-library's `keyboard-navigation` and
# `focus-attention-design`), and motion that has a declared way out (SC 2.3.3
# Animation from Interactions, Level AAA - `motion-sensitivity`). Their shape is
# habitat's component schema, where `focus` is a required part of a component's
# `accessibility` block: the measurement says what is there, the contract says
# what is allowed. Both read only declarations the measurement makes, so a
# measurement that says nothing about focus or motion is not judged at all.
# What counts as a focus indication beside a dead outline: a treatment that
# paints without it. `outline-color` is NOT one - a colour with `outline-style:
# none` and `outline-width: 0` paints nothing, and every resolved computed-style
# dump carries one, so accepting it would make the rule silent on the shape a
# real measurement has.
FOCUS_PROPS = ("outline", "outline-style", "outline-width", "outline-color")
# The props that can paint: a value among these is what the rule concludes from.
FOCUS_PAINTS = ("outline", "outline-style", "outline-width")
# A box-shadow paints on its own, so it settles the rule by itself. A border
# does not: `border-style`'s initial value is `none`, whose colour and width are
# ignored, and a computed width is 0 whenever the style is none or hidden - so a
# resolved computed-style dump of a border-less element carries
# `border-width: 0px` and a colour. `border_paints()` reads those.
FOCUS_ALTERNATIVES = ("box-shadow",)
FOCUS_BORDER_PAINTS = ("border", "border-style", "border-width")
# The style words that draw nothing at all, and the shape of a length token.
STYLE_OFF = frozenset(("none", "hidden"))
LENGTH_TOKEN = re.compile(r"^[-+]?\d*\.?\d+[a-z%]*$")
# A length that is zero in every entry, in any unit and any number of leading
# zeroes: a drawn border or outline needs one that is not.
ZERO = re.compile(r"^[-+]?0+\.?0*[a-z%]*$")
MOTION_PROPS = ("transition-duration", "animation-duration")

SKIP_DIRS = frozenset((".git", "node_modules", "dist", "build", ".venv", "venv",
                       "vendor", "__pycache__", ".next", ".cache", "coverage",
                       ".tezgah", ".codegraph"))
CSS_SUFFIXES = (".css", ".scss", ".sass", ".less")
TAILWIND_NAMES = ("tailwind.config.js", "tailwind.config.cjs",
                  "tailwind.config.mjs", "tailwind.config.ts",
                  "tailwind.config.json")
THEME_NAMES = ("theme.json", "tokens.json", "design-tokens.json")
FILE_CAP = 4000
CSS_CAP = 200

DECL = re.compile(r"(--[A-Za-z0-9_-]+)\s*:\s*([^;{}]+)")
BLOCK = re.compile(r"\b%s\s*:\s*\{")
PAIR = re.compile(r"^\s*['\"]?([A-Za-z0-9_-]+)['\"]?\s*:\s*(.+?)\s*$")
HEX3 = re.compile(r"^#([0-9a-f])([0-9a-f])([0-9a-f])$", re.I)
HEX6 = re.compile(r"^#([0-9a-f]{6})$", re.I)
RGB = re.compile(r"^rgba?\(\s*(\d+)[\s,]+(\d+)[\s,]+(\d+)"
                 r"(?:[\s,/]+([0-9.]+%?))?\s*\)$", re.I)
LENGTH = re.compile(r"^(-?\d*\.?\d+)(px|rem|pt|em|%)?$")
# Values that make no claim about a token: an absent value said out loud.
NOTHING = frozenset(("none", "transparent", "currentcolor", "inherit",
                     "initial", "unset", "auto", "normal"))
COLOUR_PROPS = ("color", "background-color", "border-color", "outline-color")
SPACING_PROPS = ("padding", "padding-top", "padding-right", "padding-bottom",
                 "padding-left", "margin", "margin-top", "margin-right",
                 "margin-bottom", "margin-left", "gap", "row-gap", "column-gap")
SPACE_NAMES = ("space-unit", "spacing-unit", "space-base", "grid-unit",
               "base-unit", "space", "spacing", "unit", "rhythm")
TYPE_NAME = re.compile(r"^(?:font|text|type)[-_]?size|^fs(?:[-_]|$)"
                       r"|^(?:font|text)[-_]?scale", re.I)


# --- values -----------------------------------------------------------------
def normalise_colour(value):
    """`#rrggbb` for a colour literal, or None. `transparent` and its family are
    None without being a claim: they say there is no colour to judge."""
    text = str(value or "").strip().lower()
    if not text or text in NOTHING or text.startswith("var("):
        return None
    m = HEX3.match(text)
    if m:
        return "#" + "".join(c * 2 for c in m.groups())
    if HEX6.match(text):
        return text
    m = RGB.match(text)
    if m:
        if m.group(4) and m.group(4).endswith("%"):
            try:
                if float(m.group(4)[:-1]) == 0:
                    return None
            except ValueError:
                return None
        elif m.group(4) and float(m.group(4)) == 0:
            return None
        try:
            return "#%02x%02x%02x" % tuple(min(255, int(m.group(i)))
                                           for i in (1, 2, 3))
        except ValueError:
            return None
    return None


def length_px(value):
    """The value in CSS px, or None when it is not an absolute length. `rem` is
    read at the root size (16px), `pt` at 4/3 px; a unitless value is a length
    only at zero, and `em`/`%` depend on a context this file does not have."""
    m = LENGTH.match(str(value or "").strip().lower())
    if not m:
        return None
    n, unit = float(m.group(1)), m.group(2)
    if unit == "px":
        return n
    if unit is None:
        return 0.0 if n == 0 else None
    if unit == "rem":
        return n * 16
    if unit == "pt":
        return n * 4 / 3
    return None


def _luminance(hex_colour):
    parts = [int(hex_colour[i:i + 2], 16) / 255 for i in (1, 3, 5)]
    parts = [p / 12.92 if p <= 0.03928 else ((p + 0.055) / 1.055) ** 2.4
             for p in parts]
    return 0.2126 * parts[0] + 0.7152 * parts[1] + 0.0722 * parts[2]


def contrast_ratio(fore, back):
    """The WCAG 2.2 contrast ratio between two `#rrggbb` colours."""
    a, b = _luminance(fore), _luminance(back)
    hi, lo = max(a, b), min(a, b)
    return (hi + 0.05) / (lo + 0.05)


def durations_ms(value):
    """(the longest readable time in ms, the count of entries that were not a
    time) for a CSS time or a comma list.

    A list takes its longest entry - that is the one a person sits through and
    the one a guard has to cover - and it is read entry by entry, so one entry
    nobody can parse neither hides a readable one nor lets the value read as
    settled."""
    worst, unreadable = None, 0
    for part in str(value or "").split(","):
        m = re.fullmatch(r"\s*(-?\d*\.?\d+)\s*(ms|s)\s*", part)
        if not m:
            unreadable += 1
            continue
        ms = float(m.group(1)) * (1 if m.group(2) == "ms" else 1000)
        worst = ms if worst is None else max(worst, ms)
    return worst, unreadable


def paints_nothing(value):
    """True when a declaration draws nothing: every entry is a zero length, or a
    word that claims nothing (`none`, `hidden`, `transparent` and its family).

    A resolved computed-style dump carries these where nothing is drawn -
    `outline-width: 0px`, `border-width: 0px`, `box-shadow: none` - so reading
    one as evidence of a treatment is how a rule goes silent on the measurement
    shape it was written for."""
    parts = str(value or "").lower().replace(",", " ").split()
    return bool(parts) and all(p in NOTHING or p == "hidden" or ZERO.match(p)
                               for p in parts)


def declaration_draws(value):
    """True when one measured declaration draws something.

    A lone longhand is judged by its own value (`2px` draws, `0px` does not).
    The `border` and `outline` shorthands carry width, style and colour in one
    string, so they draw only when no component of them says otherwise: a
    `none`/`hidden` style word, or a width that is zero - `border: 0 solid #111`
    draws nothing whatever the style says, which is a border-less element's
    computed shape on a Tailwind page, and `outline: 0 solid #111` is focus with
    nothing to see."""
    parts = str(value or "").lower().replace(",", " ").split()
    if not parts:
        return False
    if any(part == "auto" for part in parts):
        # `outline-style: auto` is the focus ring the UA draws, so it belongs on
        # the drawing side even though `auto` claims nothing for most props.
        return True
    if any(part in STYLE_OFF for part in parts):
        return False
    if all(paints_nothing(part) for part in parts):
        return False
    widths = [part for part in parts if LENGTH_TOKEN.match(part)]
    return not (widths and all(ZERO.match(width) for width in widths))


def border_paints(styles):
    """True when the measurement names a border that draws something.

    Every declared part of it has to draw: a live `border-style` beside
    `border-width: 0px` draws nothing, and that pair is the computed shape of a
    border-less element on a Tailwind page, so either half read alone would let
    the rule settle on a border nobody sees."""
    values = [styles[prop] for prop in FOCUS_BORDER_PAINTS if prop in styles]
    return bool(values) and all(declaration_draws(value) for value in values)


def focus_outline_off(styles):
    """The declarations that switch focus off with nothing beside them to show
    it, or [].

    `outline: none` is a violation only when the same measurement names no other
    indication: a `box-shadow` that draws, or a border that can paint, is a focus
    treatment by another route. An `outline-color`, a bare `border-color` and a
    zero-width border are not: a resolved computed-style dump carries all three
    while nothing is drawn."""
    off = ["%s: %s" % (prop, styles[prop])
           for prop in FOCUS_PAINTS
           if prop in styles and not declaration_draws(styles[prop])]
    if not off:
        return []
    if any(prop in styles and not paints_nothing(styles[prop])
           for prop in FOCUS_ALTERNATIVES):
        return []
    if border_paints(styles):
        return []
    return off


# --- reading the repository's own tokens ------------------------------------
def walk(root):
    """Every file under `root`, repo-relative and sorted, with the directories a
    token source is never in skipped and the count bounded."""
    out = []
    for base, dirs, names in os.walk(root):
        dirs[:] = sorted(d for d in dirs if d not in SKIP_DIRS)
        for name in sorted(names):
            rel = os.path.relpath(os.path.join(base, name), root)
            out.append(rel.replace(os.sep, "/"))
            if len(out) >= FILE_CAP:
                return out
    return out


def read_text(root, rel):
    try:
        with open(os.path.join(root, rel), encoding="utf-8",
                  errors="replace") as fh:
            return fh.read()
    except OSError:
        return ""


def css_declarations(root, files):
    """{name: value} from the custom properties of this repository's stylesheets,
    later declarations winning, files in sorted order."""
    out, sources = {}, []
    seen = 0
    for rel in files:
        if not rel.lower().endswith(CSS_SUFFIXES):
            continue
        seen += 1
        if seen > CSS_CAP:
            break
        text = read_text(root, rel)
        found = False
        for name, value in DECL.findall(text):
            out[name.lstrip("-")] = value.strip()
            found = True
        if found:
            sources.append(rel)
    return out, sources


def _block_body(text, key):
    """Every `key: { ... }` body in `text`, brace-balanced, in file order."""
    out = []
    for m in re.finditer(BLOCK.pattern % re.escape(key), text):
        i, depth = m.end(), 1
        while i < len(text) and depth:
            if text[i] == "{":
                depth += 1
            elif text[i] == "}":
                depth -= 1
            i += 1
        out.append(text[m.end():i - 1])
    return out


def _pairs(body):
    """The `key: value` pairs at the top level of a config block. A nested
    object is skipped, not flattened: its leaves are a scale of their own and
    this reader does not claim to know its shape."""
    items, depth, buf = [], 0, []
    for ch in body:
        if ch in "{[":
            depth += 1
        elif ch in "}]":
            depth -= 1
        if ch == "," and depth == 0:
            items.append("".join(buf))
            buf = []
        else:
            buf.append(ch)
    items.append("".join(buf))
    out = []
    for item in items:
        if "{" in item:
            continue
        m = PAIR.match(item)
        if m:
            out.append((m.group(1), m.group(2).strip().strip("'\"")))
    return out


def tailwind_tokens(root, files):
    """The tokens a Tailwind config declares, read from its `colors`, `spacing`
    and `fontSize` blocks."""
    rel = next((f for f in files if os.path.basename(f) in TAILWIND_NAMES), None)
    if rel is None:
        return {}, []
    text = read_text(root, rel)
    colours, space, scale = {}, [], []
    for body in _block_body(text, "colors"):
        for key, value in _pairs(body):
            hexed = normalise_colour(value)
            if hexed:
                colours[key] = hexed
    for body in _block_body(text, "spacing"):
        for key, value in _pairs(body):
            px = length_px(value)
            if px:
                space.append((key in ("unit", "base"), px))
    for body in _block_body(text, "fontSize"):
        for _, value in _pairs(body):
            for token in re.findall(r"['\"]?([\d.]+(?:px|rem|pt))", value):
                px = length_px(token)
                if px:
                    scale.append(int(round(px)))
    out = {}
    # A key named `unit`/`base` states the unit; otherwise the greatest common
    # divisor of the scale the config declares is the unit it is built on.
    named = sorted((px for explicit, px in space if explicit))
    if named:
        out["space_unit"] = int(named[0])
    elif space:
        out["space_unit"] = int(_gcd([px for _, px in space]))
    if scale:
        out["type_scale"] = sorted(set(scale))
    if colours:
        out["colors"] = colours
    return out, [rel]


def theme_tokens(root, files):
    """The tokens a tokens/theme JSON declares, found by key anywhere in it."""
    rel = next((f for f in files if os.path.basename(f) in THEME_NAMES), None)
    if rel is None:
        return {}, []
    try:
        data = json.loads(read_text(root, rel))
    except ValueError:
        return {}, []
    colours, space, scale = {}, {}, []

    def visit(node):
        if isinstance(node, dict):
            for key, value in node.items():
                low = str(key).lower()
                if isinstance(value, dict):
                    if low in ("colors", "color", "palette", "colour"):
                        for name, item in value.items():
                            if isinstance(item, str) and normalise_colour(item):
                                colours[str(name)] = normalise_colour(item)
                    if low in ("spacing", "space"):
                        for name, item in value.items():
                            px = length_px(item) if isinstance(item, str) else None
                            if px:
                                space[str(name)] = px
                    if low in ("fontsize", "font-size", "font_sizes",
                               "font-sizes"):
                        for _, item in value.items():
                            token = item[0] if isinstance(item, list) and item \
                                else item
                            px = length_px(token) if isinstance(token, str) else None
                            if px:
                                scale.append(int(round(px)))
                    visit(value)
        elif isinstance(node, list):
            for item in node:
                visit(item)

    visit(data)
    out = {}
    if space:
        out["space_unit"] = int(_gcd(list(space.values())))
    if scale:
        out["type_scale"] = sorted(set(scale))
    if colours:
        out["colors"] = colours
    return out, [rel]


def _gcd(values):
    values = [int(round(v)) for v in values if v]
    if not values:
        return 0
    out = values[0]
    for v in values[1:]:
        while v:
            out, v = v, out % v
    return out


def _roles(declarations):
    """{role: hex} for the custom properties that carry a colour literal."""
    out = {}
    for name, value in declarations.items():
        hexed = normalise_colour(value)
        if not hexed:
            continue
        role = re.sub(r"^(?:colou?r|clr|c)[-_]", "", name, flags=re.I)
        role = re.sub(r"[-_]?colou?r$", "", role, flags=re.I)
        out[(role or "color").replace("_", "-").strip("-")] = hexed
    return out


def css_tokens(root, files):
    """The tokens a repository's CSS custom properties carry."""
    decls, sources = css_declarations(root, files)
    if not decls:
        return {}, []
    out = {}
    colours = _roles(decls)
    if colours:
        out["colors"] = colours
    # A property named for the unit states it; otherwise the greatest common
    # divisor of the spacing scale the file declares is the unit it is built on.
    for key, value in decls.items():
        bare = re.sub(r"[-_]unit$", "", key).strip("-")
        if key in SPACE_NAMES or bare in SPACE_NAMES:
            px = length_px(value)
            if px:
                out["space_unit"] = int(round(px))
                break
    if "space_unit" not in out:
        scale = [length_px(v) for k, v in decls.items()
                 if re.match(r"^(?:space|spacing|gap)[-_]", k)]
        scale = [px for px in scale if px]
        if scale:
            out["space_unit"] = int(_gcd(scale))
    scale = []
    for key, value in decls.items():
        if TYPE_NAME.search(key):
            px = length_px(value)
            if px:
                scale.append(int(round(px)))
    if scale:
        out["type_scale"] = sorted(set(scale))
    return out, sources


DESIGN_MD = ("design.md", "DESIGN.md")


def _oklch_to_hex(value):
    """`oklch(L C H [/ A])` as `#rrggbb`, or None when it is not that shape.

    Hallmark's locked system states its palette in OKLCH; the contract compares
    measured colours as hex, so one side has to be converted and it is this one.
    The conversion is Ottosson's OKLab -> linear sRGB with a clamp at the gamut,
    which is what a browser paints for the same value."""
    body = value.strip()
    if not body.lower().startswith("oklch("):
        return None
    inner = body[body.index("(") + 1:body.rindex(")")]
    inner = inner.split("/")[0]
    parts = [p for p in re.split(r"[\s,]+", inner.strip()) if p]
    if len(parts) < 3:
        return None
    try:
        light = parts[0]
        lum = float(light[:-1]) / 100.0 if light.endswith("%") else float(light)
        c = float(parts[1])
        hue = parts[2]
        h = float(hue[:-3]) if hue.endswith("deg") else float(hue)
    except ValueError:
        return None
    rad = math.radians(h)
    a_, b_ = c * math.cos(rad), c * math.sin(rad)
    l_ = (lum + 0.3963377774 * a_ + 0.2158037573 * b_) ** 3
    m_ = (lum - 0.1055613458 * a_ - 0.0638541728 * b_) ** 3
    s_ = (lum - 0.0894841775 * a_ - 1.2914855480 * b_) ** 3
    r = 4.0767416621 * l_ - 3.3077115913 * m_ + 0.2309699292 * s_
    g = -1.2684380046 * l_ + 2.6097574011 * m_ - 0.3413193965 * s_
    bl = -0.0041960863 * l_ - 0.7034186147 * m_ + 1.7076147010 * s_

    def gamma(x):
        x = min(1.0, max(0.0, x))
        return 12.92 * x if x <= 0.0031308 else 1.055 * x ** (1 / 2.4) - 0.055
    return "#%02x%02x%02x" % tuple(int(round(gamma(v) * 255)) for v in (r, g, bl))


def design_md_tokens(root):
    """(tokens, source) from Hallmark's locked `design.md`, or ({}, "").

    Hallmark's file owns the material: the palette stated in OKLCH, the font
    roles and the motion character. It owns no state set, no component
    inventory and no measured evidence, which stay the contract's, so reading it
    fills the tokens half and leaves the rest to `contract_data`."""
    for name in DESIGN_MD:
        path = os.path.join(root, name)
        if not os.path.isfile(path):
            continue
        text = open(path, encoding="utf-8", errors="replace").read()
        block = re.search(r"```css\s*(.*?)```", text, re.S)
        if not block:
            continue
        colors, fonts = {}, {}
        for var, value in re.findall(r"--([a-z0-9-]+)\s*:\s*([^;]+);", block.group(1)):
            value = value.strip()
            if var.startswith("color-"):
                role = var[len("color-"):]
                hexv = _oklch_to_hex(value) if value.lower().startswith("oklch(") else (
                    value if re.fullmatch(r"#[0-9a-fA-F]{3,8}", value) else None)
                if hexv:
                    colors[role] = hexv
            elif var.startswith("font-"):
                fonts[var[len("font-"):]] = value
        if colors:
            tokens = {"colors": colors}
            if fonts:
                tokens["fonts"] = fonts
            return tokens, "design-md"
    return {}, ""


def derive(root):
    """(tokens, source, read from) from the repository's own token source, or
    (None, reason, []) when it carries none."""
    locked, locked_source = design_md_tokens(root)
    if locked.get("colors"):
        # a locked system wins over a re-derivation: pages share it, and a second
        # floor derived beside it is the drift plan 133 exists to prevent
        return locked, locked_source, [os.path.join(root, "design.md")]
    files = walk(root)
    for name, reader in (("css-custom-properties", css_tokens),
                         ("tailwind-config", tailwind_tokens),
                         ("theme-json", theme_tokens)):
        tokens, sources = reader(root, files)
        if tokens.get("colors"):
            return tokens, name, sources
    return None, ("no token source: looked for CSS custom properties, a "
                  "Tailwind config and a tokens/theme JSON"), []


def contract_data(tokens, source):
    """The machine half of the contract: the derived tokens, the shipped state
    set, and the component inventory the repository owns."""
    return {
        "version": 1,
        "source": source,
        "tokens": {
            "space_unit": tokens.get("space_unit"),
            "type_scale": tokens.get("type_scale") or [],
            "colors": tokens.get("colors") or {},
            "tap_target": TAP_TARGET,
            "contrast": {"normal": CONTRAST_NORMAL, "large": CONTRAST_LARGE},
        },
        "states": {"interactive": list(STATES_INTERACTIVE),
                   "data": list(STATES_DATA)},
        "components": [],
        # plan 133: one machine-read precedence between this contract and
        # Hallmark's design.md, so the two floors cannot drift. `ours` is what a
        # Hallmark stamp, waiver or verbatim flag can never relax; `theirs` is
        # the material we do not judge; `shared` states the same intent on both
        # sides, our numbers and their shapes.
        "precedence": dict(PRECEDENCE),
    }


def contract_text(data, sources, derived_note):
    """The artifact: what a reader opens, and the block `check` reads. Field
    names and prose stay English; nothing here carries a clock or a machine
    path.

    The inventory line is always written, and says plainly when it is empty:
    `derive` reads tokens, never components - the measurement names a component,
    the repository names files - so a derived contract's `component-inventory`
    rule is inert until someone fills the list in. A reader who assumed the
    floor judged the inventory would read every derived contract as stricter
    than it is."""
    read = ", ".join(sources[:3]) if sources else "(none)"
    names = [str(c.get("name")) for c in (data.get("components") or [])
             if isinstance(c, dict)]
    inventory = ", ".join(names) if names else "(empty)"
    rule = ("""- `components` is the inventory this contract owns, and it is EMPTY:
  `derive` reads tokens and never components, so the `component-inventory` rule
  is inert on this contract - nothing below judges a component that is not
  listed. Add one `{name, kind}` per component the repository owns."""
            if not names else
            """- `components` is the inventory this contract owns. A component the
  measurement shows that is not listed here is a violation, so a new component
  is added here before the turn closes.""")
    return """# Design contract

source: %s
read from: %s
component inventory: %s

The floor this repository's screens are judged against. `bin/tezgah-design check`
compares a measurement - the per-component computed styles and observed states
the analyze-app loop produces - against the block below and exits non-zero on
every disagreement. The shape, the state set and the derivation rule live in the
`design-contract` skill.

- Colour roles are this repository's own token names; nothing here was invented.
- `tap_target` and `contrast` are WCAG 2.2 floors (SC 2.5.8, SC 1.4.3), not this
  repository's choices.
- `space_unit` is the unit the repository's own spacing tokens are built on; a
  measured spacing that is not a multiple of it is a violation.
%s
- %s

```json
%s
```
""" % (data["source"], read, inventory, rule, derived_note,
       json.dumps(data, indent=2, sort_keys=True))


# --- the check ---------------------------------------------------------------
def read_contract(path):
    """(data, reason): the fenced JSON block of a contract file, or why not."""
    try:
        with open(path, encoding="utf-8") as fh:
            text = fh.read()
    except OSError as exc:
        return None, "cannot read the contract: %s" % exc
    m = re.search(r"```json\s*\n(.*?)\n```", text, re.S)
    if not m:
        return None, ("the contract carries no ```json block: the machine half "
                      "of the artifact is missing")
    try:
        data = json.loads(m.group(1))
    except ValueError as exc:
        return None, "the contract's json block does not parse: %s" % exc
    if not isinstance(data, dict):
        return None, "the contract's json block is not an object"
    return data, None


def _violation(component, rule, detail):
    return {"component": component, "rule": rule, "detail": detail}


def precedence_problem(table):
    """Why a contract's precedence cannot be read, or "" when it can.

    Plan 133: the table is the only tie-break between this floor and Hallmark's
    design.md, so an ambiguous one is refused rather than resolved by whoever
    reads it next. Absent is allowed - a contract written before the table
    existed keeps working - but a present one must name every key exactly once
    and must not hand `facts` to the user's own words."""
    if table is None:
        return ""
    if not isinstance(table, dict):
        return "precedence must be an object of classes to keys"
    seen = {}
    for cls in ("ours", "theirs", "shared"):
        keys = table.get(cls)
        if keys is None:
            continue
        if not isinstance(keys, list) or not all(isinstance(k, str) for k in keys):
            return "precedence.%s must be a list of key names" % cls
        for key in keys:
            if key in seen:
                return ("precedence names %r twice (%s and %s): one key belongs "
                        "to one source" % (key, seen[key], cls))
            seen[key] = cls
    if "facts" in table.get("theirs", []) or "facts" in table.get("shared", []):
        return ("precedence cannot share `facts`: an invented metric, quote or "
                "logo is never licensed by a theme, a waiver or the user's words")
    verbatim = table.get("verbatim")
    if verbatim not in (None, "style"):
        return ("precedence.verbatim may only be `style`: the user's own words "
                "excuse a style gate, never a fabricated fact")
    return ""


def check(data, measured):
    """(violations, unjudged, judged): every disagreement between a measurement
    and the contract, each naming its component and its rule, the count of
    measured values the contract could not judge at all, and how many components
    it judged at all.

    `judged` is what keeps "judged everything, found nothing" apart from "judged
    nothing": a measurement that carries no component the contract can judge is
    not a clean app, and the caller refuses to report it as one. A component
    counts only when a rule actually judged it - the presence of a dict is not a
    judgement, so `{"components": [{}]}` judges nothing, and neither is a name the
    contract's inventory lists: `component-inventory` is a finding about the name
    and nothing more, so a component that arrived with only a name is not counted
    as judged. The contract-level rules above run either way - an unusable
    contract is a finding whether or not anything was measured against it."""
    out, unjudged, judged = [], 0, 0

    def bad(component, rule, detail):
        out.append(_violation(component, rule, detail))

    if not str(data.get("source") or "").strip():
        bad("contract", "contract-source",
            "the contract carries no `source:` line, so nobody can say whether "
            "it was read from this repository or invented")
    tokens = data.get("tokens") if isinstance(data.get("tokens"), dict) else {}
    colours = {str(k): normalise_colour(v)
               for k, v in (tokens.get("colors") or {}).items()}
    palette = sorted({v for v in colours.values() if v})
    if not palette:
        bad("contract", "contract-palette",
            "the contract names no colour role, so no colour can be judged "
            "against it")
    space = tokens.get("space_unit")
    scale = [int(v) for v in (tokens.get("type_scale") or []) if v is not None]
    tap = tokens.get("tap_target") or TAP_TARGET
    reduced = bool(tokens.get("reduced_motion"))
    floors = tokens.get("contrast") or {}
    normal = float(floors.get("normal") or CONTRAST_NORMAL)
    large = float(floors.get("large") or CONTRAST_LARGE)
    states = data.get("states") if isinstance(data.get("states"), dict) else {}
    for kind, shipped in (("interactive", STATES_INTERACTIVE),
                          ("data", STATES_DATA)):
        got = states.get(kind)
        if not isinstance(got, list) or len(got) != len(shipped) \
                or any(str(a) != b for a, b in zip(got, shipped)):
            bad("contract", "state-set",
                "the contract's `%s` states are not the shipped set (%s): a "
                "floor that drops a state is not the floor" % (kind, ", ".join(shipped)))
    inventory = [str(c.get("name")) for c in (data.get("components") or [])
                 if isinstance(c, dict)]

    for comp in (measured.get("components") or []):
        if not isinstance(comp, dict):
            unjudged += 1
            continue
        # A rule that read a value of this component sets this; a dict no rule
        # could read anything out of is not a judged component, however many
        # keys it arrived with.
        hit = False
        name = str(comp.get("name") or "?")
        styles = {str(k).lower(): v for k, v in (comp.get("styles") or {}).items()}
        for prop in COLOUR_PROPS:
            if prop not in styles:
                continue
            hexed = normalise_colour(styles[prop])
            if not hexed:
                if str(styles[prop]).strip().lower() not in NOTHING:
                    unjudged += 1
                continue
            hit = True
            if palette and hexed not in palette:
                bad(name, "palette",
                    "%s %s is not a colour role in the contract (%s)"
                    % (prop, styles[prop], ", ".join(palette)))
        for prop in ("font-size",):
            if prop not in styles:
                continue
            px = length_px(styles[prop])
            if px is None or not scale:
                unjudged += 1
            else:
                hit = True
                if int(round(px)) not in scale:
                    bad(name, "type-scale",
                        "%s %s is off the contract's type scale (%s)"
                        % (prop, styles[prop],
                           ", ".join("%dpx" % s for s in scale)))
        for prop, value in sorted(styles.items()):
            if prop not in SPACING_PROPS:
                continue
            for part in str(value).split():
                px = length_px(part)
                if px is None or not space:
                    unjudged += 1
                else:
                    hit = True
                    if px % space:
                        bad(name, "spacing-rhythm",
                            "%s %s is not a multiple of the %spx spacing unit"
                            % (prop, value, space))
        kind = comp.get("kind")
        if kind == "interactive":
            for prop in ("width", "height"):
                px = length_px(styles.get(prop))
                if px is None:
                    unjudged += 1
                else:
                    hit = True
                    if px < tap:
                        bad(name, "tap-target",
                            "%s %s is below the %dpx target floor (WCAG 2.2 "
                            "SC 2.5.8)" % (prop, styles[prop], tap))
            claims = [prop for prop in FOCUS_PROPS if prop in styles]
            if claims:
                off = focus_outline_off(styles)
                if off:
                    hit = True
                    bad(name, "focus-visible",
                        "%s, with no other focus indication measured beside it "
                        "(a box-shadow, a border that draws): a keyboard user "
                        "cannot see where they are (WCAG 2.2 SC 2.4.7 Focus "
                        "Visible, Level AA)" % ", ".join(off))
                elif (any(prop in styles and declaration_draws(styles[prop])
                          for prop in FOCUS_PAINTS) or border_paints(styles)):
                    hit = True
                else:
                    # an outline-colour with no outline to paint says nothing a
                    # rule can conclude from: a value, not a judgement
                    unjudged += 1
        moving, judged_motion = [], False
        for prop in MOTION_PROPS:
            if prop not in styles:
                continue
            ms, unreadable = durations_ms(styles[prop])
            unjudged += unreadable
            if ms is None:
                continue
            judged_motion = True
            if ms > 0:
                moving.append("%s: %s" % (prop, styles[prop]))
        if judged_motion:
            hit = True
        if moving and not reduced:
            bad(name, "reduced-motion",
                "%s is measured and the contract declares no reduced-motion "
                "guard (`tokens.reduced_motion`): motion with no way out "
                "(WCAG 2.2 SC 2.3.3 Animation from Interactions, Level AAA)"
                % ", ".join(moving))
        fore = normalise_colour(styles.get("color"))
        back = normalise_colour(styles.get("background-color"))
        if fore and back:
            hit = True
            size = length_px(styles.get("font-size"))
            floor = large if size is not None and size >= LARGE_TEXT else normal
            ratio = contrast_ratio(fore, back)
            if ratio + 1e-9 < floor:
                bad(name, "contrast",
                    "%.2f:1 for %s on %s is below the %.1f:1 floor (WCAG 2.2 "
                    "SC 1.4.3)" % (ratio, styles.get("color"),
                                   styles.get("background-color"), floor))
        if kind in KINDS:
            hit = True
            required = states.get(kind) or []
            shown = [str(s) for s in (comp.get("states") or [])]
            missing = [s for s in required if s not in shown]
            if missing:
                bad(name, "state-coverage",
                    "states not observed: %s" % ", ".join(missing))
        elif kind is None:
            unjudged += 1
        if inventory and name not in inventory:
            bad(name, "component-inventory",
                "not in the contract's component inventory")
        if hit:
            judged += 1
    out.sort(key=lambda v: (v["component"], v["rule"], v["detail"]))
    return out, unjudged, judged


# --- the command line --------------------------------------------------------
class Usage(Exception):
    pass


def parse(argv, names):
    """`--flag value` pairs for the flags this verb takes; an unknown flag or a
    missing value is a usage error, never a silently ignored argument."""
    out, i = {}, 0
    while i < len(argv):
        arg = argv[i]
        if arg == "--json":
            out["json"] = True
        elif arg == "--render":
            out["render"] = True
        elif arg in names:
            if i + 1 >= len(argv):
                raise Usage("%s wants a value" % arg)
            out[arg.lstrip("-")] = argv[i + 1]
            i += 1
        else:
            raise Usage("unknown argument: %s" % arg)
        i += 1
    return out


def _print_json(payload):
    sys.stdout.write(json.dumps(payload, indent=2, sort_keys=True) + "\n")


def derive_cli(opts):
    root = project_top(os.path.abspath(opts.get("repo") or ""))
    if not os.path.isdir(root):
        raise Usage("--repo must name a directory")
    # the tokens are this checkout's; the contract goes to the repository's one
    # workspace, the main checkout's `.tezgah` (plan 097), which a worktree's
    # removal does not take with it
    ws = linked_main(root) or root
    out = opts.get("out") or os.path.join(ws, ".tezgah", "design-contract.md")
    if os.path.exists(out):
        # A contract that exists is the repository's own decision: it carries
        # the component inventory someone filled in, so overwriting it would
        # throw that away. Re-deriving over a token change is a hand edit, or a
        # deliberate `rm` first.
        raise Usage("the contract already exists at %s: a contract is edited, "
                    "not overwritten - remove it first or pass --out elsewhere"
                    % os.path.abspath(out))
    tokens, source, sources = derive(root)
    if tokens is None:
        if opts.get("json"):
            _print_json({"ok": False, "error": source})
        sys.stderr.write("tezgah-design: %s\nWrite the contract by hand with "
                         "`source: derived` naming where the floor came from "
                         "(the design-contract skill says how), or point "
                         "`--repo` at a repository that has one.\n" % source)
        return 2
    data = contract_data(tokens, source)
    note = ("Derived from the repository's own token source; refresh it by "
            "removing this file and re-running `tezgah-design derive`." if sources else
            "Derived, not read: name here what the floor came from.")
    text = contract_text(data, sources, note)
    try:
        os.makedirs(os.path.dirname(os.path.abspath(out)), exist_ok=True)
        with open(out, "w", encoding="utf-8") as fh:
            fh.write(text)
    except OSError as exc:
        raise Usage("cannot write %s: %s" % (out, exc))
    shown = os.path.relpath(out, ws)
    if opts.get("json"):
        _print_json({"ok": True, "out": shown, "source": source,
                     "colors": len(data["tokens"]["colors"]),
                     "space_unit": data["tokens"]["space_unit"],
                     "type_scale": data["tokens"]["type_scale"],
                     "components": len(data["components"])})
    else:
        # absolute: from a worktree the contract is the main checkout's, which a
        # `.tezgah/...` read from the worktree's cwd does not name (review N1)
        sys.stdout.write(
            "wrote %s (source: %s, %d colour roles, %s, %d type steps)\n"
            % (os.path.abspath(out), source, len(data["tokens"]["colors"]),
               "%spx unit" % data["tokens"]["space_unit"]
               if data["tokens"]["space_unit"] else "no spacing unit found",
               len(data["tokens"]["type_scale"])))
        sys.stdout.write(
            "component inventory: empty - `derive` reads tokens and never "
            "components, so the `component-inventory` rule is inert on this "
            "contract until the list is filled in\n")
    return 0


SLOPLINT = os.path.join("skills", "hallmark", "scripts", "sloplint.mjs")


def sloplint_path(root):
    """The vendored linter's path, or "" when it is not installed beside us."""
    candidates = [
        os.path.join(os.path.dirname(os.path.dirname(os.path.abspath(__file__))), SLOPLINT),
        os.path.expanduser(os.path.join("~", ".config", "tezgah", SLOPLINT)),
    ]
    for path in candidates:
        if os.path.isfile(path):
            return path
    return ""


def slop_cli(opts):
    """Hallmark's gate list, run over this repository, into one verdict.

    The Floor is theirs and Ours is the contract's, so this verb is the one place
    the two are merged: `sloplint --json` gives FAIL/REFLEX, and the contract's
    `check` runs when a measurement is given. A merge that hides one side would
    make a page pass here and fail in the Stop rule, so the verdict is the union
    and it is written down (`.tezgah/design/slop.json`) for that rule to read."""
    root = project_top(os.path.abspath(opts.get("repo") or ""))
    if not os.path.isdir(root):
        raise Usage("--repo must name a directory")
    linter = sloplint_path(root)
    if not linter:
        sys.stderr.write("tezgah-design: hallmark is not installed beside tezgah "
                         "(%s), so only the contract check can run - no static "
                         "slop tier this time\n" % SLOPLINT)
        return 3
    if not shutil.which("node"):
        sys.stderr.write("tezgah-design: node is not on PATH, so hallmark's "
                         "sloplint cannot run - only the contract check can\n")
        return 3
    target = opts.get("url") or root
    argv = [shutil.which("node"), linter, "--json"]
    if opts.get("url"):
        argv += ["--url", opts["url"]]   # a URL is an address, never a path
    else:
        argv.append(root)
    if opts.get("render"):
        argv.append("--render")
    if opts.get("genre"):
        argv += ["--genre", opts["genre"]]
    try:
        proc = subprocess.run(argv, capture_output=True, text=True, timeout=300)
    except (OSError, subprocess.SubprocessError) as exc:
        raise Usage("sloplint could not run: %s" % exc)
    try:
        report = json.loads(proc.stdout)
    except ValueError:
        raise Usage("sloplint printed no JSON (exit %d): %s"
                    % (proc.returncode, (proc.stderr or "").strip()[:200]))
    summary = report.get("summary") or {}
    fails, reflex = int(summary.get("fails") or 0), int(summary.get("reflex") or 0)
    # What the render tier actually did, never what the flag asked for: without
    # puppeteer-core sloplint answers `not run: …` and every Floor/R and M/R gate
    # stays unjudged, so a `clean` there would excuse a page nobody measured
    # (review of plan 133 finding 2).
    rendered = str(summary.get("render") or "off")
    unjudged = rendered.startswith("not run")
    verdict = {"version": 1, "tool": "tezgah-design slop",
               "sloplint_exit": proc.returncode,
               "target": os.path.abspath(target),
               "render": rendered,
               "render_unjudged": unjudged,
               "fails": fails, "reflex": reflex,
               "waived": int(summary.get("waived") or 0),
               "answered": int(summary.get("answered") or 0),
               "clean": fails == 0 and reflex == 0 and not unjudged,
               "findings": [f for f in (report.get("findings") or [])
                            if f.get("grade") in ("FAIL", "REFLEX")]}
    ws = linked_main(root) or root
    # The union, enforced here rather than in the Stop rule (review of plan 133
    # finding 3): a component's UI floor is Hallmark's gate list AND this
    # repository's contract, so `slop` reads the contract half too. No contract,
    # no obligation. A contract with no measurement is unjudged, never clean.
    contract_path = os.path.join(ws, ".tezgah", "design-contract.md")
    contract = {"present": os.path.isfile(contract_path), "judged": False,
                "violations": [], "unjudged": 0}
    if contract["present"]:
        data, reason = read_contract(contract_path)
        if data is None:
            raise Usage(reason)
        problem = precedence_problem(data.get("precedence"))
        if problem:
            raise Usage(problem)
        raw = ""
        measured_path = opts.get("measured") or os.path.join(
            ws, ".tezgah", "design", "measurement.json")
        if os.path.isfile(measured_path):
            with open(measured_path, encoding="utf-8") as fh:
                raw = fh.read()
        if raw.strip():
            try:
                got = json.loads(raw)
            except ValueError:
                raise Usage("the measurement is not JSON: %s" % measured_path)
            violations, unjudged, judged = check(data, got)
            contract.update(judged=judged > 0, unjudged=unjudged,
                            violations=[str(v) for v in violations])
    verdict["contract"] = contract
    if contract["present"] and not contract["judged"]:
        verdict["clean"] = False
    out = opts.get("out") or os.path.join(ws, ".tezgah", "design", "slop.json")
    try:
        os.makedirs(os.path.dirname(os.path.abspath(out)), exist_ok=True)
        with open(out, "w", encoding="utf-8") as fh:
            json.dump(verdict, fh, indent=2, sort_keys=True)
            fh.write("\n")
    except OSError as exc:
        raise Usage("cannot write %s: %s" % (out, exc))
    if opts.get("json"):
        _print_json(verdict)
    else:
        sys.stdout.write("slop: %d FAIL, %d REFLEX over %s (render %s) -> %s\n"
                         % (fails, reflex, target, rendered,
                            "clean" if verdict["clean"] else "not clean"))
    if contract["present"] and not contract["judged"]:
        sys.stderr.write("tezgah-design: the contract exists but no measurement "
                         "judged a component, so the design half is unjudged - "
                         "run the analyze-app loop and pass --measured\n")
    return 0 if verdict["clean"] and not contract["violations"] else 1


def check_cli(opts):
    contract = opts.get("contract")
    measured = opts.get("measured")
    if not contract or not measured:
        raise Usage("check wants --contract FILE and --measured FILE|-")
    if (not os.path.isabs(contract) and not os.path.exists(contract)
            and contract.replace(os.sep, "/").startswith(".tezgah/")):
        # a worktree's `.tezgah/...` is the main checkout's workspace (plan 097,
        # review N1): the path the Stop refusal and the reviewer prompt name
        cwd = os.getcwd()
        contract = os.path.join(linked_main(cwd) or cwd, contract)
    data, reason = read_contract(contract)
    if data is None:
        raise Usage(reason)
    problem = precedence_problem(data.get("precedence"))
    if problem:
        raise Usage(problem)
    if measured == "-":
        raw = sys.stdin.read()
    else:
        try:
            with open(measured, encoding="utf-8") as fh:
                raw = fh.read()
        except OSError as exc:
            raise Usage("cannot read the measurement: %s" % exc)
    if not raw.strip():
        raise Usage("the measurement at %s is empty" % measured)
    try:
        got = json.loads(raw)
    except ValueError as exc:
        raise Usage("the measurement does not parse: %s" % exc)
    if isinstance(got, list):
        got = {"components": got}
    if not isinstance(got, dict):
        raise Usage("the measurement is not an object with a `components` list")
    violations, unjudged, judged = check(data, got)
    if not judged:
        # `0 violations` over a measurement with nothing in it says the app is
        # clean when nothing was looked at, and the Stop rule reads that output
        # as the floor having been applied. It is a usage error, not a pass.
        message = (
            "nothing was judged: %s, so `0 violations` would report a clean app "
            "when nothing was looked at. Pass the per-component styles and "
            "states the analyze-app read produces."
            % ("the measurement carries no `components` list"
               if not got.get("components") else
               "no entry in `components` is one the contract could judge"))
        if opts.get("json"):
            _print_json({"ok": False, "count": len(violations),
                         "violations": violations, "unjudged": unjudged,
                         "judged": 0, "error": message})
        else:
            sys.stderr.write("tezgah-design: %s\n" % message)
        return 2
    if opts.get("json"):
        _print_json({"ok": not violations, "count": len(violations),
                     "violations": violations, "unjudged": unjudged,
                     "judged": judged})
    else:
        sys.stdout.write("%d violations\n" % len(violations))
        for v in violations:
            sys.stdout.write("%s: %s - %s\n"
                             % (v["component"], v["rule"], v["detail"]))
        if unjudged:
            sys.stdout.write("%d measured values the contract could not judge\n"
                             % unjudged)
        sys.stdout.write("%d component%s judged\n"
                         % (judged, "" if judged == 1 else "s"))
    return 1 if violations else 0


def main(argv):
    if not argv or argv[0] in ("-h", "--help"):
        sys.stdout.write(__doc__)
        return 0 if argv else 2
    verb, rest = argv[0], argv[1:]
    if verb in ("derive", "check") and "--render" in rest:
        sys.stderr.write("tezgah-design: --render belongs to `slop`, not %s\n" % verb)
        return 2
    try:
        if verb == "derive":
            return derive_cli(parse(rest, ("--repo", "--out")))
        if verb == "check":
            return check_cli(parse(rest, ("--contract", "--measured")))
        if verb == "slop":
            return slop_cli(parse(rest, ("--repo", "--url", "--out", "--genre", "--measured")))
        raise Usage("unknown verb: %s (derive|check|slop)" % verb)
    except Usage as exc:
        sys.stderr.write("tezgah-design: %s\n" % exc)
        return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
