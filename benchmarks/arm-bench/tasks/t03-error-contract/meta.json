{
  "id": "t03-error-contract",
  "family": "exact-error-contract",
  "prompt": "prompt.md",
  "allow": ["src/config.py"],
  "allow_note": "the prompt permits exactly one file; any other change is collateral",
  "checks": [
    {"name": "errors", "cmd": "python3 {hidden}/check_errors.py", "expect_exit": 0},
    {"name": "parse", "cmd": "python3 {hidden}/check_parse.py", "expect_exit": 0}
  ],
  "baseline_expect": "fail",
  "gold_expect": "pass"
}
