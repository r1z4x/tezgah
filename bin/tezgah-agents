#!/usr/bin/env python3
"""tezgah-agents [PATH] - generate/refresh this repo's tezgah subagent set.

The hook hosts run this from SessionStart via the shared context (tezgah_context
calls tezgah_agents.sync_root). opencode has no such hook, so its plugin spawns
this on the first message of a session. Same single Python source, so the
capability gates, the host set and the idempotent write behave identically.
"""
import os
import sys

HERE = os.path.dirname(os.path.dirname(os.path.realpath(__file__)))
sys.path.insert(0, os.path.join(HERE, "hooks"))
from tezgah_agents import sync_root  # noqa: E402
from tezgah_context import repo_root, under  # noqa: E402


def main():
    cwd = os.path.realpath(sys.argv[1] if len(sys.argv) > 1 else os.getcwd())
    if not under(cwd):
        return 0
    note = sync_root(repo_root(cwd))
    if note:
        print(note)
    return 0


if __name__ == "__main__":
    sys.exit(main())
