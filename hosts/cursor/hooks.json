{
  "version": 1,
  "hooks": {
    "sessionStart": [
      { "command": "python3 \"@CURSOR_HOOK@\"", "timeout": 10 }
    ],
    "preToolUse": [
      { "command": "python3 \"@CURSOR_HOOK@\"", "timeout": 5, "matcher": "Shell|Grep|Task" }
    ],
    "postToolUse": [
      { "command": "python3 \"@CURSOR_HOOK@\"", "timeout": 10 }
    ],
    "postToolUseFailure": [
      { "command": "python3 \"@CURSOR_HOOK@\"", "timeout": 10 }
    ],
    "subagentStart": [
      { "command": "python3 \"@CURSOR_HOOK@\"", "timeout": 5 }
    ],
    "beforeSubmitPrompt": [
      { "command": "python3 \"@CURSOR_HOOK@\"", "timeout": 10 }
    ],
    "stop": [
      { "command": "python3 \"@CURSOR_HOOK@\"", "timeout": 10 }
    ]
  }
}
