{
  "hooks": {
    "SessionStart": [
      { "hooks": [ { "type": "command", "command": "@CODEX_HOOK@", "timeout": 10 } ] }
    ],
    "UserPromptSubmit": [
      { "hooks": [ { "type": "command", "command": "@CODEX_HOOK@", "timeout": 10 } ] }
    ],
    "PreToolUse": [
      { "matcher": "Bash|exec_command|PowerShell|pwsh|apply_patch|Edit|Write|mcp__.*|spawn_agent|Agent|Task|Grep",
        "hooks": [ { "type": "command", "command": "@CODEX_HOOK@", "timeout": 10 } ] }
    ],
    "PostToolUse": [
      { "hooks": [ { "type": "command", "command": "@CODEX_HOOK@", "timeout": 10 } ] }
    ],
    "SubagentStart": [
      { "hooks": [ { "type": "command", "command": "@CODEX_HOOK@", "timeout": 10 } ] }
    ],
    "PostCompact": [
      { "hooks": [ { "type": "command", "command": "@CODEX_HOOK@", "timeout": 10 } ] }
    ],
    "Stop": [
      { "hooks": [ { "type": "command", "command": "@CODEX_HOOK@", "timeout": 10 } ] }
    ]
  }
}
