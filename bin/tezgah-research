#!/usr/bin/env python3
"""tezgah-research - the research workspace CLI.

  tezgah-research init <slug> --ask "<the user's words>" [--question "..."]
                       [--method qualitative|measured|exploratory] [--class R1..R12]
                       [--in "<covered>"]... [--out "<left alone>"]... [--allow-open "<why>"]
                       [--supersedes <slug>]
                       [--arena "<problem>" --budget "<budget>" [--evaluator <path> --metric "<m>"]]
                                                   scaffold a line
  tezgah-research commit <slug> "<message>"       commit the line in .tezgah's own repo
                                                   (the project's, when it tracks .tezgah)
  tezgah-research check [<slug>] [--json] [--strict] [--orx] [--online] [--all-lines]
                        [-- <slug>]                the discipline checks
  tezgah-research status                           one line per research line
  tezgah-research --all                            every checkout's lines (git worktrees)
  tezgah-research claim <slug>                     record one claim from stdin
  tezgah-research predict <slug>                   record one prediction from stdin
  tezgah-research components [--json]              what predicts what, per component
  tezgah-research migrate <slug> [--dry-run]       derive fields the rules require
  tezgah-research source <slug> <hypothesis> --run <orxRunId> [--command "<cmd>"]
                           [--instrument <name>] [--arm <a>] [--item <i>] [--value <field>=<number>]...
                           [--scope real|fixture|derived] [--fixture "<what was generated>"]
  tezgah-research compare <slug> <decision>        record one variants x criteria cell from stdin
  tezgah-research verdict <slug> <id> met|not-met|unanswerable --evidence "<ref>"
                                                   record one success criterion's verdict
  tezgah-research conclude <slug>                  conclude a line whose criteria all carry a verdict
  tezgah-research migrate-layout                   move flat research/<slug> into open/ or done/
  tezgah-research close <slug> --limit "<reason>"  conclude a line as a deliberate limit
  tezgah-research seal <slug> [--history-lost] --ack "<owner decision>"
                                                   seal a line concluded before seals existed
  tezgah-research import <checkout> [<slug>] [--allow-open "<why>"]
                                                   bring lines from another checkout, with history
  tezgah-research next --topic <t> [--flow metric-dashboard|feature] [--json]
                                                   the product-flow steps of a topic and the next one
  tezgah-research idea <slug>                      record one idea of an exploratory line from stdin
  tezgah-research stage <slug> <idea> <stage> [--evidence "<ref or JSON>"] [--reason "<why>"]
                                                   move an idea to its next stage
  tezgah-research match <slug>                     record one judged tournament match from stdin
  tezgah-research board <slug> [--json]            each idea's stage, score and next action
  tezgah-research dedup <slug> [--threshold <(0,1]>] [--json]
                                                   cluster the proposed ideas, write nothing
  tezgah-research yield [--json] [--all-lines]     how far ideas got, per operator and family
  tezgah-research cite <slug>                      query four registries for each formal INDEX id
  tezgah-research fetch <slug> <note> [--file <path> --ack "<the user's words>" | --orx]
                                                   capture a note's source text and its quotes
  tezgah-research search <slug> --tag primary|snowball|counter|known [--item "<scope.in item>"]
                         -- <connector> <args...>  capture one search on an allowlisted connector
  tezgah-research instrument add <slug> <name> --kind measure|verdict --rung R1|R2|R3|R4
                         --construct "<text>"      register an instrument
  tezgah-research gold <slug> <instrument> --arm <a> --n N --seed S
                                                   draw an arm's seeded gold sample
  tezgah-research label <slug> <instrument> --arm <a> (--human "<name>" --ack "<the user's words>"
                        | --provider openrouter --model <m>)
                                                   label an arm's gold sample
  tezgah-research switch <slug> <instrument> (--to R1|R2|R3|R4|<method> | --narrow "<what the
                         claims now say>") --reason "<why>"
                                                   record a switch away from an instrument
  tezgah-research release-check [--fixtures <dir>] score the known-truth cases, exit 1 past the bounds
  tezgah-research calibration                      Brier score over resolved hypotheses

A research line lives at <repo>/.tezgah/research/<slug>/ and holds the state an
auditable investigation needs: the question, the decision log, the findings, the
claims with their kind, falsification criteria and evidence, the predictions bound
to the commits that carried each proposed change, one directory per
experiment whose protocol is committed before its results, the literature index,
and the review a concluded line reports. `check` exits 1 when a line breaks those
rules, so a hook or a person can act on it. The project ignores `.tezgah/`; the
commits the order rule reads are made in `.tezgah`'s own private git repository,
which `init` creates and `commit` writes to, and a line the project itself
committed before the move keeps its order proof in the project's history. A
folded `.tezgah` - one the project tracks, with no repository of its own - has
only the project's history, so `commit` commits the line there, after the
message passes the gate's own language and attribution readers (exit 2 and
the gate's refusal when it does not, nothing committed).

`check` with no slug reports the open lines in full; a line under `done/` is
verified by its order seal's hashes alone and named only when they fail, with
one line counting the done lines - `check --all-lines` re-checks every line in
full, and `check <slug>` always does for that line (ADR 015).

`check --strict` also fails the guarantees the checker cannot decide - an
experiment file no repository can commit, a protocol that answers neither
what it predicts nor what would falsify it, a report a concluded line owes that
states nowhere what the evidence does not show, a claim written before `kind`
existed, a results row written before `source` did, a results file whose rows
declare no `scope` (what their numbers were measured on), a claim resting on a
fixture row that declares no scope or asserting a number its cited artifacts do not
contain, a grey source with no quality
note, an unsourced `Patterns` bullet, a concluded line with no review, a claim
that supersedes another - because a session that wants a line it can defend wants
those refused rather than noted. `check --orx` adds the run command the orx
project registered against this repository holds, which is the recipe its runs
have to be reproducible from. `migrate` derives the `kind` of the claims, the
`source` of the results rows whose own fields imply one, and the
`literature/INDEX.jsonl` rows from the artifacts already in the line, and reports
every field it cannot derive instead of inventing one - `scope` is one of those, so
the session that ran the experiment is the only thing that can supply it.
`source --run` files one
run's orx log as the experiment's receipt, and takes `--scope` for the row it
writes. `predict` writes one row of `predictions.jsonl` - the commit a proposed
change landed in, the claim it moves, the metric, its `value_before` and
`value_after`, and what would falsify it - and refuses a row whose commit is not
in this history, whose metric or baseline names no number, whose falsifier is
empty, whose commit reached a frozen path (`hooks/tezgah_gate.py`,
`hooks/tezgah_integrity.py`, `tests/`, `benchmarks/`, a protocol) without a human
`granted_by`, whose `claim` names an id the line does not hold, or whose
`components` is missing or names a component the manifest
(`hooks/tezgah_components.py`) does not define. `components` prints, per component
the manifest defines, the prediction rows that name it and their state -
`unmeasured` until the round measures them, `held` once `value_after` is filled,
`falsified` when the claim the row names is `refuted` in the line's own
`claims.jsonl` - with the number of components and rows it read. It is a report
and not a gate: it always exits 0.

`init` reads the lines already in the repository before it scaffolds anything, and
refuses while one of them is unfinished - its phase not `concluded`, a claim left
`hypothesis` or `testing`, a pre-registered experiment with no results or no
analysis, no `to_human/report.md` or `to_human/review.json`, a review finding with
no status, a design/plan/analysis/code deliverable with no decision comparing its
variants - printing every open slug with its reasons. `--allow-open "<reason>"`
opens the new line anyway and writes the reason into its `log.md` as the first
entry; an empty reason is misuse, and the hatch is refused while any open line has
`check` errors. `close <slug> --limit "<reason>"` concludes a line on purpose,
writing the reasons it was still open into `state.json` `closed` and `log.md`.
`--supersedes <old>` opens a new version of an existing line, which then carries
the old deliverable as a variant; a line asking an existing line's exact question
without it is refused. `compare` appends one cell to
`decisions/<decision>/comparison.jsonl` under the rule `check` applies to it.
`check` prints the same list of open lines after the per-line report, and so does
`status`, so neither state has to be discovered by being refused.

`init --method exploratory` (rules 7) opens a campaign instead of a question:
`--arena` and `--budget` (and, for a measurable arena, `--evaluator` with its
`--metric`, whose sha256 `init` records) are the lock committed before the
first idea. `idea`, `stage` and `match` append the campaign's rows under the
lock, each judged by the one function `check` applies to it; a `prior-art`
stage whose verdict is `known` takes `--reason` and is killed in the same
append. `board`, `dedup` and `yield` are reports: they write nothing and exit 0.

Exit codes: 0 clean, 1 problems found - a broken line for `check`, a refused
claim for `claim`, a refused row for `predict`, `idea`, `stage` or `match`, which
writes nothing and prints one reason per problem, or a new line refused for
`init` over unfinished ones - 2 misuse, or a folded `commit` whose message the
gate would refuse.
"""
import json
import os
import subprocess
import sys
import time

HERE = os.path.dirname(os.path.dirname(os.path.realpath(__file__)))
sys.path.insert(0, os.path.join(HERE, "hooks"))
import tezgah_paths as tp  # noqa: E402
import tezgah_product as tp_product  # noqa: E402
import tezgah_research as tr  # noqa: E402


def checkout_root(path):
    """The checkout `path` is in: git's top level, the project around it inside
    `.tezgah`, else the directory itself."""
    try:
        out = subprocess.run(["git", "-C", path, "rev-parse", "--show-toplevel"],
                             capture_output=True, text=True)
        if out.returncode == 0 and out.stdout.strip():
            return tp.project_top(out.stdout.strip())
    except OSError:
        pass
    return os.path.realpath(path)


def repo_root(path):
    """The checkout whose `.tezgah` holds the lines: the main checkout, from a
    linked worktree too, as for bin/tezgah-task - a line written into a
    worktree's own `.tezgah` went with `git worktree remove` (plan 097)."""
    top = checkout_root(path)
    return tp.linked_main(top) or top


def misuse(message):
    """Misuse exits 2, so a caller can tell it from a line that fails the checks."""
    print("tezgah-research: %s" % message, file=sys.stderr)
    return 2


INIT_USAGE = ('init <slug> --ask "<the user\'s words>" [--tier quick|study|program]'
              ' [--method qualitative|measured|exploratory] [--class R1..R12]'
              ' [--in "<covered>"]... [--out "<left alone>"]... [--question "..."]'
              ' [--allow-open "<reason>"] [--supersedes <slug>]'
              ' [--arena "<problem>" --budget "<budget>"'
              ' [--evaluator <path> --metric "<metric>"]]')
INIT_EXAMPLE = ('tezgah-research init cache-latency --ask "does the cache cut p95?" '
                '--method measured --in "p95 of the read path" --out "write path"')


def cmd_init(args):
    # R0 is refused before any other argument is read (spec 3.3): a factual or
    # reference question gets its answer in the reply, never a line
    if any(a == "--class" and b == "R0" for a, b in zip(args, args[1:])):
        print("FAIL init: R0 gets no line: a factual or reference question is answered "
              "in the reply with its evidence")
        return 1
    if not args:
        return misuse("init needs a slug")
    if args[0] in ("-h", "--help"):
        print("usage: tezgah-research %s\nexample: %s" % (INIT_USAGE, INIT_EXAMPLE))
        return 0
    slug = args[0].strip().lower().replace(" ", "-")
    if not tr.valid_slug(slug):
        # A slug is the directory name the other commands list, so anything that
        # is not one (a path, a `..`, a leading dot) would scaffold a line that
        # `check`, `status` and `claim` can never see.
        return misuse("init <slug>: %r is not a slug - lowercase letters, digits "
                      "and dashes" % args[0])
    question, allow, supersedes = "", None, None
    ask, tier, method, scope_in, scope_out = "", str(tr.DEFAULT_TIER), "", [], []
    arena, question_class = {}, ""
    rest = args[1:]
    while rest:
        flag = rest.pop(0)
        if flag == "--question" and rest:
            question = rest.pop(0)
        elif flag == "--ask" and rest:
            ask = rest.pop(0)
        elif flag == "--tier" and rest:
            tier = rest.pop(0)
        elif flag == "--method" and rest and rest[0] in tr.METHODS:
            method = rest.pop(0)
        elif flag == "--in" and rest:
            scope_in.append(rest.pop(0))
        elif flag == "--class" and rest and rest[0] in tr.QUESTION_CLASSES[1:] \
                and not question_class:
            question_class = rest.pop(0)
        elif flag == "--out" and rest:
            scope_out.append(rest.pop(0))
        elif flag == "--allow-open" and rest:
            allow = rest.pop(0)
        elif flag == "--supersedes" and rest:
            supersedes = rest.pop(0)
        elif flag in ("--arena", "--budget", "--evaluator", "--metric") and rest \
                and flag not in arena:
            arena[flag] = rest.pop(0)
        else:
            return misuse(INIT_USAGE)
    if method == "exploratory":
        # The arena is the lock an exploratory line commits before its first idea,
        # so a line without one is a call that cannot work, not a line to repair.
        if not all(arena.get(f, "").strip() for f in ("--arena", "--budget")):
            return misuse('--method exploratory needs --arena "<the problem, verbatim>" '
                          'and --budget "<ideas, pilots, full runs, wall time>"')
        if bool(arena.get("--evaluator", "").strip()) != bool(
                arena.get("--metric", "").strip()):
            return misuse("--evaluator and --metric go together: the file that scores a "
                          "candidate and the number it returns")
        evaluator = arena.get("--evaluator", "").strip()
        if evaluator and (os.path.isabs(evaluator) or ".." in evaluator.split("/")
                          or not os.path.isfile(os.path.join(
                              tp.work_tree(repo_root(os.getcwd())), evaluator))):
            return misuse("--evaluator %r is not a file under the repository" % evaluator)
    elif arena:
        return misuse("--arena, --budget, --evaluator and --metric belong to "
                      "--method exploratory")
    problems = tr.ask_problems(ask, tier)
    if problems:
        for problem in problems:
            print("FAIL init: %s" % problem)
        if not ask.strip():
            print("usage: tezgah-research %s\nexample: %s" % (INIT_USAGE, INIT_EXAMPLE),
                  file=sys.stderr)
        return 1
    if allow is not None and not allow.strip():
        return misuse("--allow-open needs the reason the new line is worth opening "
                      "over the unfinished ones")
    repo = repo_root(os.getcwd())
    if supersedes is not None and supersedes not in tr.slugs(repo):
        return misuse("--supersedes %r is not a research line here" % supersedes)
    unfinished = tr.open_lines(repo)
    if unfinished and allow is None:
        # The refusal is the whole point: a line opened beside eleven unfinished
        # ones is how this repository came to hold thirteen of them, so the state
        # is read before anything is written and the reason is the only way past.
        print("init refused: %d research line(s) are unfinished, and a new line is "
              "not opened over them without a reason:" % len(unfinished))
        for name, reasons in unfinished:
            print("  %s: %s" % (name, "; ".join(reasons)))
        print('to open %s anyway, say why: tezgah-research init %s '
              '--allow-open "<reason>"' % (slug, slug))
        return 1
    broken = tr.broken_open_lines(repo) if unfinished else []
    if broken:
        # The hatch opens a line beside unfinished ones, never beside broken ones:
        # a broken line is fixed, or closed as a deliberate limit, first.
        print("init refused: --allow-open does not open a line beside an open line "
              "that check refuses:")
        for name, errors in broken:
            print("  %s: %d error(s), first: %s" % (name, len(errors), errors[0]))
        print('fix them, or record what is left: tezgah-research close <slug> '
              '--limit "<reason>"')
        return 1
    twins = [t for t in tr.serial_twins(repo, slug, {"question": question})
             if t != supersedes]
    if twins:
        print("init refused: %s already asks this question; a new version of it is "
              "compared with the old one, not opened beside it: tezgah-research "
              "init %s --supersedes %s" % (", ".join(twins), slug, twins[0]))
        return 1
    created = time.strftime("%Y-%m-%d")
    record = None
    if method == "exploratory":
        record = tr.arena_record(repo, arena["--arena"], arena["--budget"],
                                 arena.get("--evaluator", "").strip(),
                                 arena.get("--metric", "").strip())
    made = tr.init(repo, slug, question=question, created=created,
                   supersedes=supersedes, ask=ask, tier=tier, method=method,
                   scope_in=scope_in, scope_out=scope_out, arena=record,
                   question_class=question_class)
    if allow is not None:
        problem = tr.note_open(repo, slug, allow, created)
        if problem:
            print("  WARNING: the reason could not be written to log.md (%s)"
                  % problem)
    print("research line: %s" % tr.line_dir(repo, slug))
    for path in made:
        print("  wrote %s" % path)
    for problem in tr.scope_problems(tr.line_state(repo, slug)):
        print("  owed: %s" % problem)
    if question_class:
        print("obligations: %s" % ", ".join(tr.obligations(question_class, method)))
        print(tr.budget(slug, tr.line_dir(repo, slug), tr.line_state(repo, slug))[0])
        for line, cid, status, sim in tr.overlaps(repo, question or ask, slug):
            print("overlap: %s/%s %s %.2f" % (line, cid, status, sim))
    if method == "exploratory":
        print("\nnext: commit the arena now, before any idea - `~/.config/tezgah/bin/tezgah-research commit "
              "%s \"arena\"`; an idea committed with it or before it is refused. Then "
              "record ideas (`~/.config/tezgah/bin/tezgah-research idea %s`, one JSON row on stdin, each "
              "naming its operator, generator and kill result), commit them, and "
              "follow `~/.config/tezgah/bin/tezgah-research board %s`: dedup, prior art, matches, pilots, a "
              "full run, a confirmation on unseen data." % (slug, slug, slug))
    elif method == "qualitative":
        print("\nnext: read the primary sources for each state.json scope.in item "
              "(`orx discover`, `orx paper`), save each to literature/ as you read "
              "it, and record every claim with a `trace` naming the S<n> it answers "
              "and the source it rests on. No experiment, no metric.")
    else:
        print("\nnext: write experiments/<hypothesis>/protocol.md - what the change "
              "is, what it predicts, what result would falsify it, why - and COMMIT "
              "it before the run: `~/.config/tezgah/bin/tezgah-research commit %s \"protocol "
              "<hypothesis>\"`. Then record the run in results.jsonl and commit it "
              "the same way, in a later commit. The commits land in `.tezgah`'s own "
              "git repository (the project ignores `.tezgah/`). Then analyse it in "
              "analysis.md, and put the claim in claims.jsonl with its kind, "
              "falsification criterion, evidence and the S<n> it traces to." % slug)
    print("kill switch: research-off")
    return 0


def cmd_commit(args):
    """Commit one line in the private `.tezgah` repository, or in the project's
    when `.tezgah` is folded - the commit the order rule reads. Only the line's
    own paths are staged and committed: every layout location of the slug, so
    the move `conclude` makes from `open/` to `done/` lands whole."""
    if len(args) != 2 or not args[1].strip():
        return misuse('commit <slug> "<message>"')
    slug, message = args
    repo = repo_root(os.getcwd())
    known = tr.slugs(repo)
    if slug not in known:
        return misuse("no such research line (have: %s)" % (", ".join(known) or "none"))
    return commit_path(repo, [os.path.join(f, slug) for f in tr.layout_roots(repo)],
                       message)


def present(paths, base, ls_files):
    """The paths relative to `base` that exist on disk or that git still
    tracks: a pathspec matching nothing would make `git add` fail."""
    rels = [os.path.relpath(p, base) for p in paths]
    tracked = ls_files(*rels).splitlines() if rels else []
    return [r for r, p in zip(rels, paths) if os.path.lexists(p) or any(
        t == r or t.startswith(r + "/") for t in tracked)]


def commit_path(repo, paths, message):
    """Stage and commit `paths` alone in the private repository of `repo`, or in
    the project's own when `.tezgah` is folded - tracked by the project, with no
    repository of its own (`tr.folded`)."""
    ws = tp.ensure_workspace(repo)
    if ws is None and tr.folded(repo):
        return commit_project(repo, paths, message)
    if ws is None:
        print("commit refused: %s is not a git work tree (or .tezgah could not be "
              "set up), so there is no private repository to commit into" % repo)
        return 1
    try:
        rels = present(paths, ws, lambda *r: tp.ws_git(repo, "ls-files", "--", *r).stdout)
        done = tp.ws_git(repo, "add", "-A", "--", *rels)
        if not done.returncode:
            done = tp.ws_git(repo, "commit", "-q", "-m", message, "--", *rels)
    except OSError as exc:
        print("commit failed: %s" % exc)
        return 1
    if done.returncode:
        print("commit failed: %s" % (done.stderr or done.stdout).strip())
        return 1
    sha = tp.ws_git(repo, "rev-parse", "HEAD").stdout.strip()
    print("committed %s in %s at %s" % (" ".join(rels), ws, sha))
    return 0


def message_refusal(message):
    """The refusal the gate prints for `message` as a `git commit -m` value, or
    None. A folded `commit` writes the project's own history, which the gate
    never sees through this command, so the message meets the gate's own
    readers here: the language reader `lang_reason` hands each subject to
    (`tezgah_lang.refusal`), then the credit forms `attribution` matches
    (`ATTRIB`), under the same switches."""
    if tp.off("pretooluse-off"):
        return None
    import tezgah_gate as gate  # deferred: only a folded commit pays the import
    if gate.tezgah_lang is not None and not tp.off("lang-off"):
        reason = gate.tezgah_lang.refusal("commit subject", message)
        if reason:
            return reason
    return gate.ATTRIB_DENY if gate.ATTRIB.search(message) else None


def commit_project(repo, paths, message):
    """Stage and commit `paths` alone in the project's repository: the history a
    folded `.tezgah` lives in. Anything else the owner staged stays staged and
    out of this commit (`commit -- <paths>`); the project's identity, signing and
    hooks apply, since this is the project's own history. A message the gate
    would refuse is refused first, exit 2, and nothing is staged."""
    refused = message_refusal(message)
    if refused:
        print("commit refused: %s" % refused, file=sys.stderr)
        return 2
    git = ["git", "-C", repo]
    try:
        rels = present(paths, repo, lambda *r: subprocess.run(
            git + ["ls-files", "--"] + list(r), capture_output=True, text=True).stdout)
        done = subprocess.run(git + ["add", "-A", "--"] + rels, capture_output=True,
                              text=True)
        if not done.returncode:
            done = subprocess.run(git + ["commit", "-q", "-m", message, "--"] + rels,
                                  capture_output=True, text=True)
    except OSError as exc:
        print("commit failed: %s" % exc)
        return 1
    if done.returncode:
        print("commit failed: %s" % (done.stderr or done.stdout).strip())
        return 1
    sha = subprocess.run(git + ["rev-parse", "HEAD"], capture_output=True,
                         text=True).stdout.strip()
    print("committed %s in the project repository %s at %s (.tezgah is tracked by "
          "the project, so the project's history carries the line)"
          % (" ".join(rels), repo, sha))
    return 0


def cmd_check(args):
    # after `--` every word is the slug, never a flag (the MCP tool passes it so)
    sep = args.index("--") if "--" in args else len(args)
    flags, after = args[:sep], args[sep + 1:]
    as_json = "--json" in flags
    strict = "--strict" in flags
    ask_orx = "--orx" in flags
    online = "--online" in flags
    all_lines = "--all-lines" in flags
    rest = [a for a in flags
            if a not in ("--json", "--strict", "--orx", "--online", "--all-lines")] + after
    repo = repo_root(os.getcwd())
    if len(rest) > 1:
        return misuse("check [<slug>] [--json] [--strict] [--orx] [--online] "
                      "[--all-lines] [-- <slug>]")
    known = tr.slugs(repo)
    if rest and rest[0] not in known:
        print("FAIL %s: no such research line (have: %s)"
              % (rest[0], ", ".join(known) or "none"))
        return 1
    problems = 0
    report = {}
    if known:
        report = tr.check(repo, rest[0] if rest else None, strict=strict,
                          all_lines=all_lines, code=checkout_root(os.getcwd()),
                          flags={"online": online, "orx": ask_orx})
        for slug, row in report.items():
            for err in row["errors"]:
                problems += 1
                print("FAIL %s: %s" % (slug, err))
            for warn in row["warnings"]:
                print("warn %s: %s" % (slug, warn))
            # rules 8's report lines (certainty, stats, effect, budget, ...): never
            # problems, and inside the JSON row rather than before it
            for line in [] if as_json else row.get("report", []):
                print(line)
    else:
        print("no research line under %s" % tr.root(repo))
    lines = len(report)
    if ask_orx:
        # The registry is the repository's, not a line's, so this runs whatever the
        # lines look like - which is also why it is only asked for when --orx says so.
        report["orx"] = tr.check_orx(repo, tp.orx_bin(), strict=strict)
        for err in report["orx"]["errors"]:
            problems += 1
            print("FAIL orx: %s" % err)
        for warn in report["orx"]["warnings"]:
            print("warn orx: %s" % warn)
    if as_json:
        # The payload is the whole answer for a machine caller: a sentence after
        # it is not JSON, and one before it is prose the reader never asked for.
        print(json.dumps(report, indent=2))
        return 1 if problems else 0
    if not problems:
        print("research: %d line(s) ok" % lines)
    if not rest and not all_lines:
        done = [slug for slug in known if tr.sealed(repo, slug)]
        if done:
            seals = sum(1 for slug in done if tr.SEAL in tr.line_state(repo, slug))
            print("research: %d done line(s): %d checked by their seal, %d unsealed "
                  "(not checked); `check --all-lines` runs them in full"
                  % (len(done), seals, len(done) - seals))
    # The layer's own state, after the per-line report and outside the FAIL/warn
    # classes: a line being open is a state and not a defect, but it is the state
    # `init` refuses a new line over, so a session running `check` sees it here
    # instead of meeting it at its next `init`. Only when the whole layer was
    # asked about: `check <slug>` answers for that line and stays that answer.
    if not rest:
        unfinished = tr.open_note(repo)
        if unfinished:
            print(unfinished)
    return 1 if problems else 0


def cmd_status(args):
    if args:
        return misuse("status takes no arguments")
    repo = repo_root(os.getcwd())
    rows = tr.summary(repo)
    if not rows:
        print("no research line under %s" % tr.root(repo))
        return 0
    for row in rows:
        print(row)
    return 0


def cmd_components(args):
    """The per-component report: which predictions name each component and what
    state they are in, read from the manifest the rules also read.

    Always exit 0, because it is a report and not a gate: it refuses nothing the
    checker does not already refuse, and what it prints - the components and the
    rows it read - is what tells an empty manifest from a line with no
    predictions. The shaping is the module's (`component_report`,
    `components_text`), so the `--json` and the text are one decision."""
    as_json = "--json" in args
    if [a for a in args if a != "--json"]:
        return misuse("components [--json]")
    report = tr.component_report(repo_root(os.getcwd()))
    if as_json:
        print(json.dumps(report, indent=2))
        return 0
    for line in tr.components_text(report):
        print(line)
    return 0


def cmd_claim(args):
    """Record the claim handed in on stdin; the line must exist first, so a
    typo cannot create one. Reading stdin happens after the slug check, so a
    misuse case never waits on a terminal."""
    if not args:
        return misuse("claim needs a slug")
    slug = args[0]
    repo = repo_root(os.getcwd())
    known = tr.slugs(repo)
    if slug not in known:
        return misuse("no such research line (have: %s)" % (", ".join(known) or "none"))
    try:
        # The bytes, decoded here rather than by the interpreter's stdin wrapper:
        # under a C locale that wrapper reads invalid bytes as lone surrogates, so
        # a claim could be recorded whose statement is not text at all.
        body = sys.stdin.buffer.read().decode("utf-8")
    except UnicodeDecodeError:
        return misuse("stdin is not valid UTF-8")
    if not body.strip():
        return misuse("claim needs one JSON object on stdin")
    try:
        claim = json.loads(body)
    except ValueError:
        return misuse("stdin is not valid JSON")
    if not isinstance(claim, dict):
        return misuse("stdin must be one JSON object")
    try:
        claim_id, problems = tr.append_claim(repo, slug, claim)
    except OSError as exc:
        # The line directory can go missing or stop being writable between the
        # slug check and the append; that is a problem with the line, not with
        # how the command was called, so it takes the refusal channel.
        claim_id, problems = claim.get("id"), ["cannot append to claims.jsonl: %s" % exc]
    if problems:
        for problem in problems:
            print("FAIL %s: %s" % (slug, problem))
        return 1
    print(("claim %s recorded" % claim_id) if claim_id else "claim recorded")
    return 0


def cmd_predict(args):
    """Record the prediction handed in on stdin; the line must exist first, the
    same way `claim` requires it, and the row is judged by the module's own
    `prediction_problems` so the writer can never refuse what `check` accepts.

    One reason per problem, and nothing written when anything is refused: a row
    the loop later reads is a promise about a commit, so a half-valid one is not
    worth appending. The undecidable class - a commit git cannot place - is
    printed as a warning and recorded, which is the same fail-open `check` uses:
    a check that cannot decide must not invent a refusal."""
    if len(args) != 1:
        return misuse("predict <slug>")
    slug = args[0]
    repo = repo_root(os.getcwd())
    known = tr.slugs(repo)
    if slug not in known:
        return misuse("no such research line (have: %s)" % (", ".join(known) or "none"))
    try:
        # The bytes, decoded here rather than by the interpreter's stdin wrapper:
        # under a C locale that wrapper reads invalid bytes as lone surrogates, so
        # a row could be recorded whose metric is not text at all.
        body = sys.stdin.buffer.read().decode("utf-8")
    except UnicodeDecodeError:
        return misuse("stdin is not valid UTF-8")
    if not body.strip():
        return misuse("predict needs one JSON object on stdin")
    try:
        pred = json.loads(body)
    except ValueError:
        return misuse("stdin is not valid JSON")
    if not isinstance(pred, dict):
        return misuse("stdin must be one JSON object")
    try:
        problems, undecided = tr.append_prediction(repo, slug, pred)
    except OSError as exc:
        # The line directory can go missing or stop being writable between the
        # slug check and the append; that is a problem with the line, not with
        # how the command was called, so it takes the refusal channel.
        problems = ["cannot append to predictions.jsonl: %s" % exc]
        undecided = []
    for problem in problems:
        print("FAIL %s: %s" % (slug, problem))
    for note in undecided:
        print("warn %s: %s" % (slug, note))
    if problems:
        return 1
    print("prediction for commit %s recorded" % pred.get("commit"))
    return 0


def cmd_migrate(args):
    """Derive what the newer rules require of the artifacts already in the line.

    The dry run prints exactly what the real run would derive and what it cannot,
    which is the point of having it: an existing line is other sessions' evidence,
    and a migration that cannot be previewed is a migration nobody dares run."""
    dry = "--dry-run" in args
    rest = [a for a in args if a != "--dry-run"]
    if len(rest) != 1:
        return misuse("migrate <slug> [--dry-run]")
    slug = rest[0]
    repo = repo_root(os.getcwd())
    known = tr.slugs(repo)
    if slug not in known:
        return misuse("no such research line (have: %s)" % (", ".join(known) or "none"))
    lines, problems = tr.migrate(repo, slug, dry_run=dry)
    print("migrate %s%s: %d derived" % (slug, " (dry run, nothing written)" if dry
                                        else "", len(lines)))
    for line in lines:
        print("  %s" % line)
    for problem in problems:
        print("could not derive: %s" % problem)
    return 0


def cmd_source(args):
    """File one orx run's log as the receipt of an experiment."""
    import re
    reserved = ("source", "log", "run", "arm", "item", "instrument", "scope", "fixture",
                "status", "command")
    usage = ('source <slug> <hypothesis> --run <orxRunId> [--instrument <name>] [--arm <a>] '
             '[--item <i>] [--value <field>=<number>]... [--command "<cmd>"] '
             '[--scope real|fixture|derived] [--fixture "<what was generated>"]')
    if len(args) < 2:
        return misuse(usage)
    slug, hypothesis = args[0], args[1]
    run = command = scope = arm = item = ""
    instrument = None
    fixture = None
    values = []
    rest = args[2:]
    while rest:
        flag = rest.pop(0)
        if flag == "--run" and rest:
            run = rest.pop(0)
        elif flag == "--command" and rest:
            command = rest.pop(0)
        elif flag == "--scope" and rest:
            scope = rest.pop(0)
        elif flag == "--fixture" and rest:
            fixture = rest.pop(0)
        elif flag == "--instrument" and rest:
            instrument = rest.pop(0)
        elif flag == "--arm" and rest:
            arm = rest.pop(0)
        elif flag == "--item" and rest:
            item = rest.pop(0)
        elif flag == "--value" and rest:
            field, _eq, number = rest.pop(0).partition("=")
            if field in reserved:
                return misuse("--value %s: %s is a reserved row key" % (field, field))
            if not re.fullmatch(r"[A-Za-z_][\w.-]*", field) or not re.fullmatch(
                    r"-?\d+(?:\.\d+)?", number):
                return misuse("--value needs <field>=<number>, not %r" % (field + _eq + number))
            values.append((field, number))
        else:
            return misuse(usage)
    if "/" in hypothesis or "\\" in hypothesis or hypothesis.startswith("."):
        return misuse("source <slug> <hypothesis>: %r is not an experiment "
                      "directory name" % hypothesis)
    if not run:
        return misuse("source needs --run <orxRunId>")
    if scope and scope not in tr.SCOPES:
        return misuse("--scope %r is not one of %s" % (scope, ", ".join(tr.SCOPES)))
    if fixture is not None and not fixture.strip():
        return misuse("--fixture needs the text naming what was generated")
    if instrument is not None and not instrument.strip():
        return misuse("--instrument needs the instrument's name")
    repo = repo_root(os.getcwd())
    known = tr.slugs(repo)
    if slug not in known:
        return misuse("no such research line (have: %s)" % (", ".join(known) or "none"))
    orx = tp.orx_bin()
    if not orx:
        return misuse("orx is not installed, so no run log can be read; nothing "
                      "was written (TEZGAH_ORX_BIN overrides the lookup)")
    path, problems = tr.source_run(repo, slug, hypothesis, run, orx, command, scope,
                                   fixture or "", arm, item, values, instrument or "")
    if problems:
        for problem in problems:
            print("FAIL %s: %s" % (slug, problem))
        return 1
    print("receipt %s" % path)
    rows = tr._row_objects(os.path.join(os.path.dirname(os.path.dirname(path)),
                                        "results.jsonl"))
    print("row %s" % json.dumps(rows[-1] if rows else {}))
    if not scope:
        print("note: the row declares no scope, so nothing says whether this run "
              "measured the running system or an input you generated; re-file with "
              "--scope %s" % "|".join(tr.SCOPES))
    elif scope == "fixture" and not fixture:
        print("note: the row declares scope fixture and does not say what was "
              "generated, which is the field the checker warns about; re-file with "
              '--fixture "<what was generated>"')
    return 0


def cmd_compare(args):
    """Record one variants x criteria cell from stdin into
    decisions/<decision>/comparison.jsonl, judged by the checker's own rule."""
    if len(args) != 2:
        return misuse("compare <slug> <decision>")
    slug, decision = args
    repo = repo_root(os.getcwd())
    known = tr.slugs(repo)
    if slug not in known:
        return misuse("no such research line (have: %s)" % (", ".join(known) or "none"))
    try:
        body = sys.stdin.buffer.read().decode("utf-8")
        row = json.loads(body)
    except (UnicodeDecodeError, ValueError):
        return misuse("compare needs one JSON object on stdin")
    try:
        problems = tr.append_comparison(repo, slug, decision, row)
    except OSError as exc:
        problems = ["cannot append to comparison.jsonl: %s" % exc]
    if problems:
        for problem in problems:
            print("FAIL %s/%s: %s" % (slug, decision, problem))
        return 1
    print("cell %s x %s recorded" % (row.get("variant"), row.get("criterion")))
    criteria = os.path.join(tr.line_dir(repo, slug), "decisions", decision,
                            "criteria.json")
    if not tr.added_commits(repo, criteria)[0]:
        print("note: criteria.json is not committed, so nothing shows the criteria "
              "were fixed before this cell; commit it before the comparison")
    return 0


def _campaign_slug(args, usage, count=1):
    """(repo, slug, None) for a campaign command's line, or (None, None, exit code)."""
    if len(args) < count:
        return None, None, misuse(usage)
    repo = repo_root(os.getcwd())
    known = tr.slugs(repo)
    if args[0] not in known:
        return None, None, misuse("no such research line (have: %s)"
                                  % (", ".join(known) or "none"))
    return repo, args[0], None


def _stdin_row(what):
    """(row, None) for the one JSON object on stdin, or (None, exit code)."""
    try:
        body = sys.stdin.buffer.read().decode("utf-8")
        row = json.loads(body)
    except (UnicodeDecodeError, ValueError):
        return None, misuse("%s needs one JSON object on stdin" % what)
    if not isinstance(row, dict):
        return None, misuse("%s needs one JSON object on stdin" % what)
    return row, None


def _refused(slug, problems):
    for problem in problems:
        print("FAIL %s: %s" % (slug, problem))
    return 1 if problems else 0


def cmd_idea(args):
    """Record one idea of an exploratory line from stdin (`append_idea`)."""
    repo, slug, code = _campaign_slug(args, "idea <slug>")
    if code is not None or len(args) != 1:
        return code if code is not None else misuse("idea <slug>")
    row, code = _stdin_row("idea")
    if code is not None:
        return code
    try:
        iid, problems = tr.append_idea(repo, slug, row)
    except OSError as exc:
        iid, problems = row.get("id"), ["cannot append to ideas.jsonl: %s" % exc]
    if _refused(slug, problems):
        return 1
    print("idea %s recorded" % iid)
    return 0


def cmd_stage(args):
    """Move one idea to a stage, with the evidence that stage takes (a path or a
    JSON object) and the reason a kill - or a known prior art - owes."""
    usage = ('stage <slug> <idea> <stage> [--evidence "<ref or JSON>"] '
             '[--reason "<why>"]')
    repo, slug, code = _campaign_slug(args, usage, 3)
    if code is not None:
        return code
    row = {"idea": args[1], "stage": args[2]}
    reason, rest = None, args[3:]
    while rest:
        flag = rest.pop(0)
        if flag == "--evidence" and rest and "evidence" not in row:
            text = rest.pop(0)
            try:
                row["evidence"] = json.loads(text) if text.lstrip()[:1] in "{[" \
                    and text.strip() else text
            except ValueError:
                return misuse("--evidence starts like JSON and does not parse")
        elif flag == "--reason" and rest and reason is None:
            reason = rest.pop(0)
        else:
            return misuse(usage)
    row["date"] = time.strftime("%Y-%m-%d")
    kill_reason = None
    if row["stage"] == "killed":
        row["reason"] = reason
    else:
        kill_reason = reason
    try:
        problems = tr.append_stage(repo, slug, {k: v for k, v in row.items()
                                                if v is not None}, kill_reason)
    except OSError as exc:
        problems = ["cannot append to stages.jsonl: %s" % exc]
    if _refused(slug, problems):
        return 1
    killed = row["stage"] == "prior-art" and kill_reason \
        and isinstance(row.get("evidence"), dict) \
        and row["evidence"].get("verdict") == "known"
    print("%s: %s recorded%s" % (row["idea"], row["stage"],
                                 " and killed (%s)" % kill_reason if killed else ""))
    return 0


def cmd_match(args):
    """Record one judged tournament match from stdin (`append_match`)."""
    repo, slug, code = _campaign_slug(args, "match <slug>")
    if code is not None or len(args) != 1:
        return code if code is not None else misuse("match <slug>")
    row, code = _stdin_row("match")
    if code is not None:
        return code
    try:
        problems = tr.append_match(repo, slug, row)
    except OSError as exc:
        problems = ["cannot append to tournament.jsonl: %s" % exc]
    if _refused(slug, problems):
        return 1
    print("match %s v %s recorded" % (row.get("a"), row.get("b")))
    return 0


def cmd_board(args):
    """The campaign's board: a report a fresh session resumes from, exit 0."""
    flags = [a for a in args if a != "--json"]
    repo, slug, code = _campaign_slug(flags, "board <slug> [--json]")
    if code is not None or len(flags) != 1:
        return code if code is not None else misuse("board <slug> [--json]")
    report = tr.board(repo, slug)
    if "--json" in args:
        print(json.dumps(report, indent=2))
        return 0
    for line in tr.board_text(report):
        print(line)
    return 0


def cmd_dedup(args):
    """Cluster the proposed ideas by statement; writes nothing, exit 0."""
    usage = "dedup <slug> [--threshold <(0,1]>] [--json]"
    rest, threshold, as_json = list(args), None, False
    if "--json" in rest:
        rest.remove("--json")
        as_json = True
    if "--threshold" in rest:
        i = rest.index("--threshold")
        try:
            threshold = float(rest[i + 1])
        except (IndexError, ValueError):
            return misuse(usage)
        if not 0 < threshold <= 1:
            return misuse("--threshold is a similarity in (0, 1]")
        rest = rest[:i] + rest[i + 2:]
    repo, slug, code = _campaign_slug(rest, usage)
    if code is not None or len(rest) != 1:
        return code if code is not None else misuse(usage)
    report = tr.dedup(repo, slug, threshold)
    if as_json:
        print(json.dumps(report, indent=2))
        return 0
    for line in tr.dedup_text(report, slug):
        print(line)
    return 0


def cmd_yield(args):
    """Per operator and generator family, how far the ideas got; exit 0."""
    if [a for a in args if a not in ("--json", "--all-lines")]:
        return misuse("yield [--json] [--all-lines]")
    report = tr.yield_report(repo_root(os.getcwd()), all_lines="--all-lines" in args)
    if "--json" in args:
        print(json.dumps(report, indent=2))
        return 0
    for line in tr.yield_text(report):
        print(line)
    return 0


def cmd_next(args):
    """The product-flow steps of one topic with their status, then the first
    missing or due step's skill and command; a report, so exit 0."""
    usage = "next --topic <t> [--flow %s] [--json]" % "|".join(tp_product.FLOWS)
    opts, as_json, rest = {}, False, list(args)
    while rest:
        arg = rest.pop(0)
        if arg == "--json":
            as_json = True
        elif arg in ("--topic", "--flow") and rest and arg not in opts:
            opts[arg] = rest.pop(0)
        else:
            return misuse(usage)
    flow = opts.get("--flow", "metric-dashboard")
    if "--topic" not in opts:
        return misuse(usage)
    if flow not in tp_product.FLOWS:
        return misuse("unknown flow %r (%s)" % (flow, ", ".join(tp_product.FLOWS)))
    topic = opts["--topic"]
    steps = tp_product.next_steps(repo_root(os.getcwd()), topic, flow)
    if as_json:
        # the step list next_steps returns; the next step is its first
        # missing or due entry
        print(json.dumps(steps, indent=2))
        return 0
    first = next((s for s in steps if s["status"] in ("missing", "due")), None)
    for n, step in enumerate(steps, 1):
        print("%d. %s [%s] %s - %s" % (n, step["id"], step["status"], step["skill"],
                                       step["detail"]))
    print("next: %s - %s" % (first["skill"], first["command"]) if first
          else "next: nothing left")
    return 0


def cmd_verdict(args):
    """Record one success criterion's verdict, with the evidence it rests on."""
    if len(args) < 3:
        return misuse('verdict <slug> <id> met|not-met|unanswerable --evidence "<ref>"')
    slug, sid, verdict = args[0], args[1], args[2]
    evidence = ""
    rest = args[3:]
    while rest:
        flag = rest.pop(0)
        if flag == "--evidence" and rest:
            evidence = rest.pop(0)
        else:
            return misuse('verdict <slug> <id> met|not-met|unanswerable --evidence "<ref>"')
    repo = repo_root(os.getcwd())
    if slug not in tr.slugs(repo):
        return misuse("no such research line: %s" % slug)
    path = os.path.join(tr.line_dir(repo, slug), "state.json")
    try:
        with open(path, encoding="utf-8") as fh:
            state = json.load(fh)
    except (OSError, ValueError) as exc:
        print("FAIL %s: state.json does not parse (%s)" % (slug, exc))
        return 1
    if not isinstance(state, dict):
        print("FAIL %s: state.json is not an object" % slug)
        return 1
    problems = tr.verdict_problems(state, [(sid, verdict, evidence)])
    if problems:
        for problem in problems:
            print("FAIL verdict: %s" % problem)
        return 1
    for row in state.get("success") or []:
        if str(row.get("id")) == sid:
            row["verdict"] = verdict
            row["evidence"] = evidence
    with open(path, "w", encoding="utf-8") as fh:
        fh.write(json.dumps(state, indent=2) + "\n")
    print("criterion %s: %s (%s)" % (sid, verdict, evidence))
    return 0


def cmd_conclude(args):
    """Conclude a line once every success criterion carries a verdict."""
    if len(args) != 1:
        return misuse("conclude <slug>")
    slug = args[0]
    repo = repo_root(os.getcwd())
    if slug not in tr.slugs(repo):
        return misuse("no such research line: %s" % slug)
    problems, _state = tr.conclude_line(repo, slug, time.strftime("%Y-%m-%d"))
    if problems:
        for problem in problems:
            print("FAIL conclude: %s" % problem)
        return 1
    print("concluded %s; it moved to research/done/%s" % (slug, slug))
    return 0


def cmd_migrate_layout(args):
    """Move flat `research/<slug>` directories into `open/` or `done/`."""
    if args:
        return misuse("migrate-layout takes no arguments")
    repo = repo_root(os.getcwd())
    moved = tr.migrate_layout(repo)
    for slug, folder in moved:
        print("moved %s -> research/%s/%s" % (slug, folder, slug))
    print("migrate-layout: %d line(s) moved" % len(moved))
    return 0


def cmd_close(args):
    """Conclude a line as a deliberate limit, writing what was left and why."""
    ack = ""
    rest = list(args)
    if "--ack" in rest:
        i = rest.index("--ack")
        if i + 1 >= len(rest):
            return misuse('--ack "<what the user said>" needs the words')
        ack = rest[i + 1]
        rest = rest[:i] + rest[i + 2:]
    if len(rest) != 3 or rest[1] != "--limit" or not rest[2].strip():
        return misuse('close <slug> --limit "<what is left and why>" '
                      '[--ack "<what the user said about the unmet criteria>"]')
    slug, limit = rest[0], rest[2]
    repo = repo_root(os.getcwd())
    known = tr.slugs(repo)
    if slug not in known:
        return misuse("no such research line (have: %s)" % (", ".join(known) or "none"))
    left, problem = tr.close_line(repo, slug, limit,
                                  time.strftime("%Y-%m-%d"), ack=ack)
    if problem:
        print("FAIL %s: %s" % (slug, problem))
        return 1
    print("closed %s as a deliberate limit; left: %s"
          % (slug, "; ".join(left) or "nothing"))
    return 0


def cmd_seal(args):
    """Seal a line concluded before the seal existed: plainly when every
    experiment's order still checks (ADR 018), or with the owner's
    `history-lost` verdict (ADR 009); a line concluded or closed now is sealed
    by `conclude`/`close` itself."""
    usage = 'seal <slug> [--history-lost] --ack "<the owner\'s decision>"'
    lost = args[1:2] == ["--history-lost"]
    rest = args[:1] + args[2:] if lost else args
    if len(rest) != 3 or rest[1] != "--ack":
        return misuse(usage)
    slug, ack = rest[0], rest[2]
    repo = repo_root(os.getcwd())
    if slug not in tr.slugs(repo):
        return misuse("no such research line: %s" % slug)
    record, problem = tr.retro_seal(repo, slug, ack, time.strftime("%Y-%m-%d"),
                                    history_lost=lost)
    if problem:
        print("FAIL %s: %s" % (slug, problem))
        return 1
    rows = record["experiments"]
    if not lost:
        print("sealed %s: %d experiment(s), order checks" % (slug, len(rows)))
        return 0
    lost = sorted(h for h, row in rows.items() if row.get("order") == tr.HISTORY_LOST)
    print("sealed %s: %d experiment(s), history lost for %s"
          % (slug, len(rows), ", ".join(lost) or "none"))
    return 0


def cmd_import(args):
    """Bring lines from another checkout's `.tezgah` repository with their
    history; a plain copy is refused."""
    usage = 'import <checkout> [<slug>] [--allow-open "<reason>"]'
    rest, allow = list(args), None
    if "--allow-open" in rest:
        i = rest.index("--allow-open")
        if i + 1 >= len(rest) or not rest[i + 1].strip():
            return misuse("--allow-open needs the reason the line is worth opening")
        allow = rest[i + 1]
        rest = rest[:i] + rest[i + 2:]
    if len(rest) not in (1, 2) or any(a.startswith("-") for a in rest):
        return misuse(usage)
    source = os.path.abspath(rest[0])
    slug = rest[1] if len(rest) == 2 else None
    if slug is not None and not tr.valid_slug(slug):
        return misuse("not a research line name: %r" % slug)
    repo = repo_root(os.getcwd())
    if tp.ensure_workspace(repo) is None:
        print("import refused: %s is not a git work tree (or .tezgah could not be "
              "set up)" % repo)
        return 1
    imported, problem = tr.import_line(repo, source, slug, allow,
                                       time.strftime("%Y-%m-%d"))
    if problem:
        print("FAIL import: %s" % problem)
        return 1
    print("imported %s from %s" % (", ".join(imported) or "nothing", source))
    return 0


def cmd_all(args):
    if args:
        return misuse("--all takes no arguments")
    # every checkout's own `.tezgah`, marking the one this runs in
    for row in tr.across(checkout_root(os.getcwd())):
        print(row)
    return 0


def main(argv):
    if len(argv) < 2:
        print(__doc__, file=sys.stderr)
        return 2
    cmd, rest = argv[1], argv[2:]
    if cmd == "--all":
        return cmd_all(rest)
    if cmd == "init":
        return cmd_init(rest)
    if cmd == "commit":
        return cmd_commit(rest)
    if cmd == "check":
        return cmd_check(rest)
    if cmd == "status":
        return cmd_status(rest)
    if cmd == "claim":
        return cmd_claim(rest)
    if cmd == "predict":
        return cmd_predict(rest)
    if cmd == "components":
        return cmd_components(rest)
    if cmd == "migrate":
        return cmd_migrate(rest)
    if cmd == "source":
        return cmd_source(rest)
    if cmd == "compare":
        return cmd_compare(rest)
    if cmd == "next":
        return cmd_next(rest)
    if cmd == "verdict":
        return cmd_verdict(rest)
    if cmd == "conclude":
        return cmd_conclude(rest)
    if cmd == "migrate-layout":
        return cmd_migrate_layout(rest)
    if cmd == "close":
        return cmd_close(rest)
    if cmd == "seal":
        return cmd_seal(rest)
    if cmd == "import":
        return cmd_import(rest)
    campaign = {"idea": cmd_idea, "stage": cmd_stage, "match": cmd_match,
                "board": cmd_board, "dedup": cmd_dedup, "yield": cmd_yield}
    if cmd in campaign:
        return campaign[cmd](rest)
    # rules 8's capture and evidence commands, imported only when asked for so a
    # missing optional module never breaks another command. Each handler takes
    # (repo, args), prints its own output and returns its exit code; `release-check`
    # and `calibration` need no line and run from any directory.
    import importlib
    for name in ("tezgah_research_capture", "tezgah_research_evidence"):
        try:
            commands = importlib.import_module(name).COMMANDS
        except (ImportError, AttributeError):
            continue
        if cmd in commands:
            return commands[cmd](repo_root(os.getcwd()), rest)
    return misuse("unknown command %r (init, commit, check, status, --all, claim, predict, "
                  "components, migrate, source, compare, verdict, conclude, migrate-layout, "
                  "close, seal, import, next, idea, stage, match, board, dedup, yield, cite, "
                  "fetch, search, instrument, gold, label, switch, release-check, "
                  "calibration)" % cmd)


if __name__ == "__main__":
    sys.exit(main(sys.argv))
