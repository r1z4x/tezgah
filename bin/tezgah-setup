OK, NO = "  ok  ", " MISS "


def mkdirp(p):
    os.makedirs(p, exist_ok=True)


def expand(p):
    return os.path.expanduser(str(p))


# The one version reader for this install: the status line's `tezgah vX.Y.Z`
# prefix prints the same value, from `version_segment()` in the core
# (`hooks/tezgah_context.py`), so this is the call into that reader and not a
# second reading of the same rule. Two readers are two answers to "which
# version is this", and they drift the moment a release moves one of them - the
# shape the lessons ledger records for a write path and its checker. The reader
# takes the local plugin manifest first (the maintainer's file, untracked, so a
# clone has none) and the newest release heading in CHANGELOG.md second, and it
# answers None when it finds neither.
def plugin_version():
    """The version `--version` prints: the shared reader, else `unknown`.

    The degradation is this CLI's own and deliberately different from the status
    line's: a line with no readable version falls back to the bare name, because
    a placeholder there would read as a version, while this CLI's whole output
    is that value, so it keeps answering the word it has always answered rather
    than printing an empty string that would read as a broken flag."""
    return tezgah_context.version() or "unknown"
# The code-graph MCP server: one argv, one environment, both written into every
# host row from here. `CODEGRAPH_MCP_TOOLS` is what makes the tools the agent
# briefs name really exist - codegraph exposes `codegraph_explore` alone without
# it - and `CODEGRAPH_TELEMETRY=0` keeps a local-first toolchain from reporting
# usage; codegraph is opt-out, so the value has to be said out loud.
GRAPH_ARGS = ["serve", "--mcp"]
GRAPH_ENV = {
    "CODEGRAPH_MCP_TOOLS": "explore,node,search,callers,callees,impact,files,status",
    "CODEGRAPH_TELEMETRY": "0",
}


def static_core():
    """The always-on core as a static rules file carries it: `always_on_core()`
    minus the paragraph of every rule an armed global kill switch removes.

    A static file is read by every session, so it honours a switch only by being
    re-rendered without the paragraph; otherwise CLAUDE.md, AGENTS.md, RULES.md
    and opencode's contract kept promising a rule the user had switched off
    (audit L-1, INT-04). The key -> switch mapping is the hooks' own
    `switches()`, asked about the filesystem root: no configured root holds it,
    so no per-repo mark (.no-ponytail and kin) applies - a global file must not
    take one repo's opt-out for every repo."""
    drop, _disabled = tezgah_context.switches(os.sep)
    labels = tuple(label for key, label in tezgah_context.CORE_RULES
                   if key in drop)
    return "\n\n".join(p for p in tezgah_context.always_on_core().split("\n\n")
                       if not p.startswith(labels))


def _sha(text):
    return hashlib.sha256(text.encode("utf-8")).hexdigest()


def recorded_shas():
    """{artifact path: sha256 of the text tezgah last rendered into it}.

    One sha per artifact, in sha256sum's own `<sha>  <path>` line shape. The
    single shared hash this replaced was rewritten by opencode's per-session
    refresh, so a policy edit left CLAUDE.md, AGENTS.md and RULES.md stale while
    `--report` went green (audit M-5, INT-02)."""
    return ta.recorded_shas(CONTRACT_SHA)


def record_contract(path, text):
    """Record the sha of the text just rendered into one artifact."""
    record_shas({path: text})


def record_shas(texts, drop=()):
    """Record the sha of each {key: text} in the install record, after removing
    every key that starts with one of `drop`.

    opencode spawns `--refresh` once per session, so two sessions starting
    together run this at once. A bare read-then-rewrite let the slower writer
    drop the other's line, and a reader could see the file half-truncated
    (review of audit M-5). The update is a merge done under an exclusive lock
    on a side file - the record is re-read inside the lock, so only these
    lines change - and lands through a temp file and `os.replace`, so a reader
    never sees a partial file. Without fcntl (Windows) the lock is skipped and
    the replace alone still keeps every read whole."""
    mkdirp(tp.CONFIG_DIR)
    with open(CONTRACT_SHA + ".lock", "a", encoding="utf-8") as lock:
        if fcntl is not None:
            fcntl.flock(lock, fcntl.LOCK_EX)
        shas = {k: v for k, v in recorded_shas().items()
                if not k.startswith(tuple(drop))} if drop else recorded_shas()
        shas.update((k, _sha(t)) for k, t in texts.items())
        # A fixed name, safe because the lock is held: a crash between write
        # and replace leaves one known file that the next write overwrites and
        # a full uninstall removes (GENERATED_STATE), not one stray per pid.
        tmp = CONTRACT_SHA + ".tmp"
        with open(tmp, "w", encoding="utf-8") as fh:
            fh.writelines("%s  %s\n" % (shas[p], p) for p in sorted(shas))
        os.replace(tmp, CONTRACT_SHA)


def stale_artifacts(hosts):
    """The artifacts of these hosts whose recorded sha is not the sha of a fresh
    render: a policy edit, a renderer edit or a kill switch flipped since the
    last write all land here, whichever host's refresh ran last."""
    shas = recorded_shas()
    return sorted(path for path, (text, _write) in contract_artifacts(hosts).items()
                  if shas.get(path) != _sha(text))


def record_hooks(hosts):
    """Record the tezgah-owned hook entries each host carries now, under
    `hook:<host>:<entry>` keys in the same record the contract artifacts use:
    each session start compares against these (`hooks/tezgah_attest.py::drift`).
    A host's earlier keys go first, so an entry a release dropped is not
    remembered as wanted."""
    texts = {}
    for h in hosts:
        texts.update(ta.record_texts(h, HERE))
    record_shas(texts, drop=[ta.KEY % (h, "") for h in hosts])


def hook_entries(hosts):
    """{host: {entry: text}} - the hook entries THIS tree arms, as
    `hooks/tezgah_attest.py::registration` reads them back once written.
    `tezgah update` asks the new tree for this (`--hook-entries`) and prints
    what re-arming would change."""
    out = {}
    for h in hosts:
        if h in ("codex", "cursor"):
            groups = codex_hook_groups() if h == "codex" else cursor_hook_entries()
            out[h] = ta.own_groups({"hooks": {ev: [g] for ev, g in groups.items()}})
        elif h == "opencode":
            src = os.path.join(HERE, "hosts", "opencode", "plugins", "tezgah.js")
            out[h] = {d: src for d in ta.OPENCODE_DIRS}
        elif h == "omp":
            out[h] = {"bridge": omp_bridge()}
        else:
            out[h] = ta.registration(h, HERE)[0] or {}
    return out


def link(src, dst):
    """Idempotent symlink - or, where this platform refuses one, an entry
    materialised in place. A real file in the way is kept as
    `<backup_base(dst)>.tezgah-bak` and replaced, so an old shim
    (codex/bin/consult) does not block the build."""
    if is_tezgah_copy(dst):
        # tezgah's own materialised entry from an earlier symlink-less run: it
        # is replaced, not reported as a user's file and not left pointing at a
        # tree an upgrade has already moved away from
        remove_materialised(dst)
    elif os.path.isdir(dst) and not os.path.islink(dst):
        return "%s %s is a directory - move it aside first" % (NO, dst)
    elif os.path.islink(dst):
        if os.path.realpath(dst) == os.path.realpath(src):
            return "%s %s" % (OK, dst)
        os.unlink(dst)
    elif os.path.exists(dst):
        try:
            bak = backup_base(dst) + ".tezgah-bak"
            mkdirp(os.path.dirname(bak))
            shutil.move(dst, bak)
        except (OSError, shutil.Error) as exc:
            return "%s %s (%s)" % (NO, dst, exc)
    try:
        mkdirp(os.path.dirname(dst))
    except OSError as exc:
        return "%s %s (%s)" % (NO, dst, exc)
    if not symlinks_refused():
        try:
            os.symlink(src, dst)
            return "%s %s -> %s" % (OK, dst, src)
        except (OSError, NotImplementedError):
            pass  # an account or filesystem that has no symlink to give
    try:
        return _materialise(src, dst)
    except (OSError, shutil.Error) as exc:
        return "%s %s (%s)" % (NO, dst, exc)


def symlinks_refused():
    """True when this machine cannot make a symlink for tezgah's entries.

    A locked-down Windows account has no SeCreateSymbolicLinkPrivilege and a
    FAT/exFAT volume has no symlinks at all; TEZGAH_NO_SYMLINK=1 asks for the
    same layout on a machine that can, which is how a user picks it on purpose
    (and how the suite exercises it without a Windows host)."""
    return (os.environ.get("TEZGAH_NO_SYMLINK", "").strip() not in ("", "0")
            or not hasattr(os, "symlink"))


def materialised_paths():
    """The paths `link()` materialised (copy or relay) instead of symlinking.

    Recorded rather than guessed: with no symlink there is nothing in the entry
    itself that says tezgah wrote it, so "not a tezgah link" needs an answer
    that does not need a link - uninstall removes these, and a same-named file
    tezgah never wrote stays the user's."""
    try:
        with open(MATERIALISED, encoding="utf-8") as fh:
            return set(line.strip() for line in fh if line.strip())
    except OSError:
        return set()


def record_materialised(path, add=True):
    keys = materialised_paths()
    if add:
        keys.add(path)
    else:
        keys.discard(path)
    try:
        mkdirp(tp.CONFIG_DIR)
        with open(MATERIALISED, "w", encoding="utf-8") as fh:
            fh.write("".join(k + "\n" for k in sorted(keys)))
    except OSError:
        pass


def is_tezgah_copy(path):
    """True when `path` is a real entry this installer materialised where a
    symlink was refused. A same-named file tezgah never wrote is the user's."""
    return not os.path.islink(path) and path in materialised_paths()


def drop_entry(path):
    """Remove a file, link or directory `link()` is replacing."""
    if os.path.islink(path) or os.path.isfile(path):
        os.unlink(path)
    elif os.path.isdir(path):
        shutil.rmtree(path)


def remove_materialised(path):
    """Drop an entry `link()` materialised, and its record with it."""
    drop_entry(path)
    record_materialised(path, add=False)


def _python_shebang():
    """The relay's own shebang: a resolved interpreter is named directly, so a
    shell can start the entry on a machine whose python3 is not on PATH; a bare
    name goes through env, which is the same lookup the shell already does."""
    python = tp.python_cmd()
    if os.path.isabs(python) and " " not in python:
        return "#!" + python
    return "#!/usr/bin/env " + python


def _write_relay(src, dst, shebang):
    """A symlink-less entry for a script: a one-line launcher for `src`."""
    interpreter = (shebang[2:].strip().split() or [""])[0]
    if "sh" in os.path.basename(interpreter) and "python" not in shebang:
        # a shell script relays to the shell that would have run it
        # (bin/tezgah-dsh); Windows never reaches this branch - the dsh entry
        # there is the .cmd install_dsh_launcher copies, because a relay is a
        # file cmd.exe cannot start, and dsh_launcher_row() names the launcher
        # the row judged
        text = '#!/bin/sh\nexec "%s" "$@"\n' % src
    else:
        text = ("%s\n# tezgah: symlink-less entry, relays to %s\n"
                % (_python_shebang(), src)) + RELAY % (src, src)
    with open(dst, "w", encoding="utf-8") as fh:
        fh.write(text)
    os.chmod(dst, 0o755)


def _materialise(src, dst):
    """Put tezgah's entry at `dst` without a symlink, and record it.

    A plain copy of a tree script cannot work: every script here locates hooks/,
    skills/ and the plugin root by walking up from its own __file__, so a copy
    under ~/.config/tezgah/bin imports a hooks/ that is not there (measured: a
    copied farm entry dies with ModuleNotFoundError). A script is therefore
    written as a relay that runs the real file with the interpreter this tree
    resolved - runpy sets __file__ to it, so everything inside it resolves its
    own tree again - while a module a host imports by path (opencode's plugin,
    the Claude workflows, the TUI plugin) is copied verbatim, because a relay
    would hand the host the wrong body. A directory (a skill) is copied: a host
    reads SKILL.md and the scripts in it by path, and nothing in a skill walks
    up to the tree root."""
    if os.path.isdir(src):
        shutil.copytree(src, dst)
    else:
        with open(src, "rb") as fh:
            head = fh.readline(200)
        if head.startswith(b"#!"):
            _write_relay(src, dst, head.decode("utf-8", "replace").strip())
        else:
            shutil.copy2(src, dst)
    record_materialised(dst)
    return "%s %s (symlink refused here; written in place)" % (OK, dst)


def read_json(path, default):
    """The parsed file, or `default` when it is absent, unreadable, or of
    another top-level type than `default` (a report's `.get` on a list)."""
    try:
        with open(path, encoding="utf-8") as fh:
            data = json.load(fh)
    except Exception:
        return default
    if default is not None and not isinstance(data, type(default)):
        return default
    return data


# Every host config read_config refused this run; a non-empty list fails it.
REFUSED = []


def read_config(path, empty):
    """A host config tezgah is about to rewrite: `empty` when the file is absent,
    its object when it parses as one, None otherwise - named, recorded in
    REFUSED, and never written, because a write would replace the user's file
    with tezgah's default (a trailing comma once cost a whole opencode.json)."""
    try:
        with open(path, encoding="utf-8") as fh:
            data = json.load(fh)
    except FileNotFoundError:
        return empty
    except (OSError, ValueError) as exc:
        why = "not valid JSON: %s" % exc
    else:
        if isinstance(data, dict):
            return data
        why = "not a JSON object: the top level is %s" % type(data).__name__
    print("%s %s (%s; left untouched - fix it, then re-run --install)"
          % (NO, path, why))
    REFUSED.append(path)
    return None


def write_json(path, data):
    """Write JSON, skipping the write when the bytes are already there.

    An unchanged write is not free: it moves a host file's mtime and lays down a
    `.tezgah-bak`, so a command whose whole point is idempotence (a repeated
    --disable) would report a change it never made. Returns True when it wrote."""
    text = json.dumps(data, indent=2) + "\n"
    try:
        with open(path, encoding="utf-8") as fh:
            if fh.read() == text:
                return False
    except OSError:
        pass
    mkdirp(os.path.dirname(path))
    backup(path)
    tmp = path + ".tmp"
    with open(tmp, "w", encoding="utf-8") as fh:
        fh.write(text)
    os.replace(tmp, path)
    return True


# Timestamped backups kept per file: the oldest and the newest BACKUP_CAP - 1.
# The oldest is the file as it stood before tezgah's first timestamped write -
# the user's content, or tezgah's own for a file tezgah created; a bare
# `<file>.tezgah-bak` an older release left is not counted or pruned.
# ponytail: a fixed cap, no setting.
BACKUP_CAP = 5
BACKUP_RE = re.compile(r"(.+)\.\d{8}T\d{12}(?:-\d+)?\.tezgah-bak")
# Where a host file's backups live. A host enumerates its own config dirs - omp
# 18.6's hooks capability lists every non-dot file in hooks/pre, so a
# `tezgah-hook.ts.<stamp>.tezgah-bak` beside the bridge was one more hook entry -
# so a copy laid beside a host file is one more thing that host discovers.
# tezgah's own state dir is scanned by no host and keeps its copies beside the
# file, where the uninstall that owns them finds them.
BACKUP_DIR = os.path.join(tp.CONFIG_DIR, "backups")


def backup_base(path):
    """The path a backup of `path` is named after: `path` itself inside
    tezgah's config dir, otherwise its mirror under BACKUP_DIR (relative to
    HOME).

    ponytail: a file outside HOME keeps its backup beside it - every host dir
    lives under HOME on a real machine, and a mirror of an arbitrary absolute
    path would let an in-process caller write into the real home."""
    real = os.path.abspath(path)
    if real.startswith(tp.CONFIG_DIR + os.sep) or not real.startswith(tp.HOME + os.sep):
        return real
    return os.path.join(BACKUP_DIR, os.path.relpath(real, tp.HOME))


def backup(path):
    """Copy `path` to `<backup_base>.<timestamp>.tezgah-bak` before a write
    changes it.

    The suffix stays `.tezgah-bak`, so managed() and the uninstall cleanup still
    know it; past BACKUP_CAP the middle copies go, never the oldest."""
    if not os.path.exists(path):
        return
    base = backup_base(path)
    stamp = datetime.datetime.now().strftime("%Y%m%dT%H%M%S%f")
    dst = "%s.%s.tezgah-bak" % (base, stamp)
    n = 0
    while os.path.exists(dst):
        n += 1
        dst = "%s.%s-%d.tezgah-bak" % (base, stamp, n)
    try:
        mkdirp(os.path.dirname(dst))
        shutil.copy2(path, dst)
        d, name = os.path.split(base)
        old = sorted(entry for entry in os.listdir(d or ".")
                     if (m := BACKUP_RE.fullmatch(entry)) and m.group(1) == name)
        for entry in old[1:max(1, len(old) - BACKUP_CAP + 1)]:
            os.remove(os.path.join(d, entry))
    except OSError:
        pass


# Dirs a backup sweep never enters: a host's transcripts, caches and plugin
# marketplaces hold no file tezgah ever backed up, and they are where the bytes are.
SWEEP_SKIP = frozenset((
    ".git", ".tmp", "blobs", "browser-profiles", "cache", "file-history",
    "history", "log", "logs", "marketplaces", "memories", "node_modules", "packages",
    "projects", "sessions", "shell-snapshots", "shell_snapshots", "tmp",
    "vendor", "vendor_imports"))
SWEEP_DEPTH = 3


def sweep_backups():
    """Move every `.tezgah-bak` an older release laid beside a host file under
    BACKUP_DIR. Returns the moved destinations. A destination that already
    exists is left alone rather than overwritten: it may be the only copy of the
    user's original."""
    roots = set(tp.HOST_DIRS.values()) | {os.path.join(tp.HOME, ".codex")}
    moved = []
    for root in sorted(roots):
        depth0 = root.rstrip(os.sep).count(os.sep)
        for dirpath, dirnames, filenames in os.walk(root):
            deep = dirpath.count(os.sep) - depth0 >= SWEEP_DEPTH
            dirnames[:] = [] if deep else sorted(d for d in dirnames if d not in SWEEP_SKIP)
            for name in filenames:
                if not name.endswith(".tezgah-bak"):
                    continue
                src = os.path.join(dirpath, name)
                dst = backup_base(src)
                if dst == os.path.abspath(src) or os.path.lexists(dst):
                    continue
                try:
                    mkdirp(os.path.dirname(dst))
                    shutil.move(src, dst)
                    moved.append(dst)
                except (OSError, shutil.Error):
                    pass
    return moved


def set_managed_block(path, block, start="# tezgah:start", end="# tezgah:end"):
    """Replace the tezgah block in a text file, or append it. A YAML file that
    is an empty sequence (`[]`, the dsh patch-layer default) loses that token
    first, because a sequence cannot follow it."""
    try:
        with open(path, encoding="utf-8") as fh:
            lines = fh.read().splitlines()
    except OSError:
        lines = []
    out, skip = [], False
    for ln in lines:
        if ln.strip().startswith(start):
            skip = True
            continue
        if ln.strip().startswith(end):
            skip = False
            continue
        if not skip and ln.strip() != "[]":
            out.append(ln)
    while out and not out[-1].strip():
        out.pop()
    if not out:
        out = ["# dsh home patch layer - tezgah-setup manages the marked block below"]
    mkdirp(os.path.dirname(path))
    text = "\n".join(out) + "\n" + start + " (managed by tezgah-setup; do not edit)\n" \
        + block.strip() + "\n" + end + "\n"
    try:
        with open(path, encoding="utf-8") as fh:
            if fh.read() == text:
                return False  # nothing to back up or rewrite
    except OSError:
        pass
    backup(path)
    with open(path, "w", encoding="utf-8") as fh:
        fh.write(text)
    return True


def codegraph_command():
    """The codegraph executable every host row is written from.

    Three channels in the resolver's order (hooks/tezgah_paths.codegraph_bin):
    the TEZGAH_CODEGRAPH_BIN pin, the config an install writes, then PATH. The
    config value is read a second time here because a pin that is not yet on
    PATH still answers None from the resolver, and a row pinned to a path the
    user chose is what they meant."""
    return tp.codegraph_bin() or tp.config().get("codegraph_bin") or tp.CODEGRAPH


def graph_command():
    """The graph server's whole argv: the executable plus its serve flags.

    omp and dsh take `command` + `args` separately, and the two hosts whose
    schema takes one string (codex's toml, opencode's list) build it from this,
    so the argv is written once and cannot drift between the six rows."""
    return [codegraph_command()] + GRAPH_ARGS


# tezgah's own MCP surface, registered beside the graph server. The name is the
# prefix every tool is drawn under (`tezgah_status`, `tezgah_gate_check`, ...),
# and the report names it by this same constant.
TEZGAH_MCP_NAME = "tezgah"


def tezgah_mcp_command(root=HERE):
    """tezgah's MCP server's whole argv: the interpreter plus `bin/tezgah-mcp`.

    One builder for every host row, exactly as `graph_command()` is for the
    graph. `root` is the tree the row will be READ by: the five hosts that read
    this checkout's configs want this checkout, while Claude reads the plugin
    COPY, whose own `bin/tezgah-mcp` is the one that exists there - a row
    pointing at a checkout the user never had would start nothing."""
    return [tp.python_cmd(), os.path.join(root, "bin", "tezgah-mcp")]


def tezgah_mcp_server(root=HERE):
    """The tezgah row in the registry's shape (name/command/env), so each writer
    can treat it exactly like the app servers it already writes instead of
    growing a second rule."""
    return {"name": TEZGAH_MCP_NAME, "command": tezgah_mcp_command(root), "env": {}}


def selection():
    """The feature ids behind this run's wiring.

    A run-level override (--enable/--disable/--devtools/wizard) wins; otherwise
    `config.json["features"]` answers; otherwise None, which means "the declared
    default per feature" and is the backwards-compatible path - a config written
    before the key existed wires exactly what it used to."""
    if FEATURES is not None:
        return list(FEATURES)
    raw = tp.config().get("features")
    return [i for i in raw if isinstance(i, str)] if isinstance(raw, list) else None


def save_features(ids):
    """Persist `ids` as config.json["features"] - this key's only writer.

    An unchanged value writes nothing at all: a repeated --disable must not move
    a mtime or leave a second backup, because "wrote nothing" is what makes the
    command idempotent rather than merely convergent. Returns True when the file
    changed."""
    cfg = read_config(tp.CONFIG, {})
    if cfg is None or list(cfg.get("features") or []) == list(ids):
        return False
    cfg["features"] = list(ids)
    write_json(tp.CONFIG, cfg)
    return True


def app_servers(selected=None):
    """The app-analysis MCP servers to wire this run (shared spec)."""
    return tezgah_apps.servers(selection() if selected is None else selected)


def app_server_names(selected=None):
    """The names those servers are written under."""
    return [s["name"] for s in app_servers(selected)]


def app_mcp_names():
    """Every app server name tezgah may have written, for cleanup and checks.

    Not the selection: uninstall has to clear a row an older release left even
    when the feature is off today, and a disable is never an uninstall."""
    return tezgah_apps.names(tezgah_apps.MCP_IDS)


def reconcile_json_servers(holder, superseded=()):
    """Converge a JSON host's MCP holder on the selection, in both directions.

    Every writer used to be add-or-refresh only, so a server the user turns off
    stayed in the host file as a ghost. A name tezgah may have written but does
    not wire this run is dropped; a name tezgah never owned (`codegraph`, or a
    server of the user's own) is not in that list and stays. A name in
    `superseded` is one the host drops by itself (OMP_SUPERSEDED_MCP), so it is
    swept like a deselected one. Returns the names dropped, so the caller can
    say the file changed."""
    wanted = [n for n in app_server_names() if n not in superseded]
    dropped = [n for n in app_mcp_names() if n not in wanted and n in holder]
    for name in dropped:
        holder.pop(name)
    return dropped


def restart_hint(host, path):
    """What a run that changed a host's config must say.

    A host reads its MCP config at boot, and tezgah cannot reach into a running
    process, so the honest end of a write is naming the host to restart.
    Printed only when something was written."""
    print("%s %s: restart %s so it re-reads %s (read at boot)"
          % (OK, host, host, path))


def dsh_cli_args():
    """How to invoke the dsh CLI, or None when it cannot be found.

    dsh has no single install layout: a profile-local node entry appears only
    after a real `dsh web` boot, while an npx bootstrap leaves the CLI in the npm
    cache. So try, in order, an explicit override, the profile-local entry,
    tezgah's own launcher (which itself falls back to npx) and finally npx."""
    override = os.environ.get("TEZGAH_DSH_BIN")
    if override:
        return [override]
    local = os.path.join(DSH, "profiles", "node_modules", "@deepseek-ai",
                         "dsh", "lib", "bin.js")
    node = shutil.which("node")
    if node and os.path.isfile(local):
        return [node, local]
    launcher = os.path.join(HERE, "bin", "tezgah-dsh")
    if os.path.isfile(launcher):
        return [launcher]
    found = shutil.which("dsh")
    if found:
        return [found]
    if shutil.which("npx"):
        return ["npx", "-y", "@deepseek-ai/dsh"]
    return None


def dsh_run(args):
    """Run the dsh CLI with args. False when it cannot run, so a host without dsh
    never fails the install."""
    base = dsh_cli_args()
    if not base:
        return False
    try:
        return subprocess.run(base + args, capture_output=True,
                              text=True).returncode == 0
    except OSError:
        return False


# Provider key files tezgah already uses for consult/codegen, so the dsh route
# check and the rest of tezgah agree on what "a key is available" means.
DSH_KEY_FILES = {"OPENROUTER_API_KEY": os.path.join(HOME, ".config", "openrouter", "key"),
                 "DEEPSEEK_API_KEY": os.path.join(HOME, ".config", "deepseek", "key"),
                 "INCEPTION_API_KEY": os.path.join(HOME, ".config", "inception", "key")}


def dsh_key_resolvable(name):
    """True when the launch env, a tezgah provider key file, or the harness
    credential store can resolve the route key. Values are never read, only the
    reference name, so no secret enters tezgah's own config."""
    if os.environ.get(name) or os.path.exists(DSH_KEY_FILES.get(name, "")):
        return True
    try:
        with open(os.path.join(DSH, ".credentials.yaml"), encoding="utf-8") as fh:
            text = fh.read()
    except OSError:
        return False
    return re.search(r"(?m)^\s+%s\s*:" % re.escape(name), text) is not None


def opencode_key_resolvable(provider, env):
    """True when opencode can resolve a provider's key: the launch env (its
    registry declares one env var per provider), or its own auth store, which
    `opencode auth login` writes. Values are never read, only the record's
    presence, so no secret enters tezgah's own config or report."""
    if os.environ.get(env):
        return True
    store = read_json(os.path.join(OPENCODE_DATA, "auth.json"), {})
    return bool((store or {}).get(provider))


def detected():
    """Which hosts exist here, from the one place that decides that."""
    return {h: tp.host_installed(h) for h in ALL_HOSTS}


# ---------------------------------------------------------------- install ----

def install_common(new_roots, hosts):
    # tezgah's own config is refused like a host's: tp.config() reads a malformed
    # file as {}, and writing that back would drop the user's roots and settings
    cfg = read_config(tp.CONFIG, {})
    own = cfg is not None
    cfg = cfg if own else {}
    cfg["roots"] = [expand(r) for r in new_roots] if new_roots else \
        (tp.roots() or [tp.DEFAULT_ROOT])
    if tp.codegraph_bin():
        cfg["codegraph_bin"] = tp.codegraph_bin()
    cfg["hosts"] = hosts
    # The resolved selection, written beside roots/hosts: the next run reads one
    # persisted answer instead of the flags some earlier run happened to carry,
    # which is what lets --disable mean anything. A key absent here (and in the
    # file) normalises to the registry's declared default, so an install made
    # before this key existed keeps wiring exactly what it used to.
    cfg["features"] = list(tezgah_apps.selected_ids(selection()))
    # The prefix this install was made into, recorded beside roots and hosts: a
    # later `--upgrade` has no flag of its own to repeat and may run from
    # anywhere, so it moves the tree the install actually used instead of the
    # XDG default. An explicit --prefix or TEZGAH_PREFIX still wins over it.
    cfg["prefix"] = INSTALL_PREFIX
    if REPLY_LANG:
        cfg["reply_lang"] = REPLY_LANG
    if own:
        write_json(tp.CONFIG, cfg)
        print("%s %s  roots=%s" % (OK, tp.CONFIG, cfg["roots"]))
    for name, src in [
            ("consult", os.path.join(HERE, "bin", "consult")),
            ("codegen", os.path.join(HERE, "bin", "codegen")),
            ("tezgah-status", os.path.join(HERE, "bin", "tezgah-status")),
            ("tezgah-pony", os.path.join(HERE, "bin", "tezgah-pony")),
            ("tezgah-adhd", os.path.join(HERE, "bin", "tezgah-adhd")),
            ("tezgah-docs", os.path.join(HERE, "bin", "tezgah-docs")),
            ("tezgah-index", os.path.join(HERE, "bin", "tezgah-index")),
            ("tezgah-rollback", os.path.join(HERE, "bin", "tezgah-rollback")),
            ("tezgah-agents", os.path.join(HERE, "bin", "tezgah-agents")),
            ("tezgah-context", os.path.join(HERE, "bin", "tezgah-context")),
            ("tezgah-capture", os.path.join(HERE, "bin", "tezgah-capture")),
            ("tezgah-doctor", os.path.join(HERE, "bin", "tezgah-doctor")),
            ("tezgah-setup", os.path.join(HERE, "bin", "tezgah-setup")),
            ("tezgah-research", os.path.join(HERE, "bin", "tezgah-research")),
            ("tezgah-task", os.path.join(HERE, "bin", "tezgah-task")),
            ("tezgah-gate", os.path.join(HERE, "bin", "tezgah-gate")),
            ("tezgah-render-table", os.path.join(HERE, "skills", "plan-add", "render_table.py")),
            ("tezgah-codex-hook", os.path.join(HERE, "hosts", "codex", "hook.py")),
            ("tezgah-cursor-hook", os.path.join(HERE, "hosts", "cursor", "hook.py")),
            ("tezgah-statusline", os.path.join(HERE, "statusline.py")),
            ("tezgah-triage", os.path.join(HERE, "bin", "tezgah-triage")),
            ("tezgah-migrate", os.path.join(HERE, "bin", "tezgah-migrate")),
            ("tezgah-mcp", os.path.join(HERE, "bin", "tezgah-mcp")),
            ("tezgah-design", os.path.join(HERE, "bin", "tezgah-design")),
            ("tezgah-decisions", os.path.join(HERE, "bin", "tezgah-decisions")),
            ("tezgah-route", os.path.join(HERE, "bin", "tezgah-route")),
            ("tezgah-lessons", os.path.join(HERE, "bin", "tezgah-lessons")),
            # `tezgah` is this installer under the name `tezgah update` is typed
            # with (npm ships the same name). Not here on purpose: tezgah-dsh
            # (wired as ~/.local/bin/dsh, see dsh_launcher) and
            # tezgah-import-ai-research (dev-time only, its docstring).
            ("tezgah", os.path.join(HERE, "bin", "tezgah-setup"))]:
        print(link(src, os.path.join(tp.BIN_DIR, name)))
    mkdirp(tezgah_apps.ARTIFACTS)
    print("%s app artifacts -> %s" % (OK, tezgah_apps.ARTIFACTS))
    tighten_cache()


def tighten_cache():
    """Owner-only modes on the evidence cache: dirs 0700, regular files 0600.

    Audit SEC-05 / L-6: ledgers and snapshots are created owner-only since
    round 2, and this tightens the ones an earlier version left at the umask
    default (0644/0755). Here rather than in the writer, which would pay an
    fchmod per append. Symlinks are skipped, never followed, and a failing entry
    is left as it is."""
    root = tp.cache_dir()
    # os.walk lists through a symlinked top even with followlinks=False, so a
    # root that is itself a link - e.g. a /tmp/tezgah fallback another user
    # planted - would have every file behind it chmodded. Refused, not followed.
    if os.path.islink(root):
        print("%s cache modes left alone: %s is a symlink" % (NO, root))
        return
    if not os.path.isdir(root):
        return
    for dirpath, dirnames, filenames in os.walk(root):
        for path, mode in ([(dirpath, 0o700)]
                           + [(os.path.join(dirpath, n), 0o600) for n in filenames]):
            try:
                st = os.lstat(path)
                if stat.S_ISLNK(st.st_mode):
                    continue
                if (stat.S_ISDIR(st.st_mode) or stat.S_ISREG(st.st_mode)) \
                        and stat.S_IMODE(st.st_mode) != mode:
                    os.chmod(path, mode)
            except OSError:
                continue


def statusline_wired():
    sl = read_json(os.path.join(CLAUDE, "settings.json"), {}).get("statusLine") or {}
    return "statusline.py" in json.dumps(sl)


def sweep_claude_workflows():
    """Remove tezgah's `~/.claude/workflows` links, and dangling `cbm-*.js` ones.

    The plugin's own `workflows/` directory serves the graph workflows, so a
    link here loaded each of them twice. A predecessor harness left `cbm-*.js`
    links whose targets are gone; adopt()'s cbm sweep covers hook scripts only.
    A live `cbm-*.js` link or any other file is the user's and stays."""
    d = os.path.join(CLAUDE, "workflows")
    for w in WORKFLOW_FILES:
        unlink_tezgah(os.path.join(d, w))
    for name in (os.listdir(d) if os.path.isdir(d) else []):
        path = os.path.join(d, name)
        if (name.startswith("cbm-") and name.endswith(".js")
                and os.path.islink(path) and not os.path.exists(path)):
            os.unlink(path)
            print("%s removed dangling %s" % (OK, path))


def install_claude():
    print("\nclaude:")
    print(link(os.path.join(HERE, "statusline.py"), os.path.join(CLAUDE, "statusline.py")))
    sweep_claude_workflows()
    for b in ("consult", "codegen", "tezgah-render-table"):
        src = (os.path.join(HERE, "bin", b) if b != "tezgah-render-table"
               else os.path.join(HERE, "skills", "plan-add", "render_table.py"))
        print(link(src, os.path.join(CLAUDE, "bin", b)))
    wire_claude_statusline()
    wire_claude_attribution()
    # The always-on core as a managed block in Claude's own global memory file.
    # The plugin's SessionStart hook delivers it into one message, where this file
    # is the instructions Claude keeps for the whole session - and Claude reads
    # the user-level file into every session, so the core arrives there whatever
    # the hook does. Global, like codex's and omp's: a per-project file would be a
    # tracked project file. Claude's hook drops the core when the block is there
    # (`TEZGAH_CORE_IN_FILE`, hooks/projects-auto-init.py), so a session pays for
    # the contract once.
    print("%s %s (always-on contract)" % (OK, write_rules("claude")))
    register_claude_plugin()


# The marketplace a manifest rendered by this installer carries, so Claude
# installs the plugin as `tezgah@tezgah-local`. A manifest the tree already has
# under another name (the maintainer's) is kept, name included.
CLAUDE_MARKETPLACE = "tezgah-local"
CLAUDE_CLI_TIMEOUT = 120


def render_claude_manifest():
    """Write `.claude-plugin/{plugin,marketplace}.json` into this tree from the
    release version (ADR 013). Untracked (.gitignore), so a clone or a release
    tree has none until this runs. A pair this installer rendered follows the
    version on every run, because a checkout's CHANGELOG moves under it; a pair
    under another marketplace name is the maintainer's and is never rewritten.
    False, with a MISS row, when the tree is not writable (a root-owned
    `sudo npm -g` install): the install goes on to its report."""
    d = os.path.join(HERE, ".claude-plugin")
    market = os.path.join(d, "marketplace.json")
    name = read_json(market, {}).get("name")
    if name and name != CLAUDE_MARKETPLACE:
        return True
    url = "https://github.com/r1z4x/tezgah"
    plugin = {"name": "tezgah", "displayName": "Tezgah",
              "description": "One working contract for every AI coding assistant "
                             "inside the configured roots.",
              "version": tezgah_context.version(manifest=False) or "0.0.0",
              "author": {"name": "r1z4x"}, "license": "MIT",
              "repository": url, "homepage": url}
    pair = {"plugin.json": plugin,
            "marketplace.json": {"name": CLAUDE_MARKETPLACE,
                                 "owner": {"name": "r1z4x"},
                                 "plugins": [dict(plugin, source="./")],
                                 "version": plugin["version"]}}
    try:
        mkdirp(d)
        for fname, data in pair.items():
            # tezgah's own generated file: no backup, unlike a host config
            path, text = os.path.join(d, fname), json.dumps(data, indent=2) + "\n"
            if read_json(path, None) != data:
                with open(path, "w", encoding="utf-8") as fh:
                    fh.write(text)
    except OSError as exc:
        print("%s cannot write %s (%s): Claude's plugin manifest is not rendered"
              % (NO, d, exc.strerror or exc))
        return False
    return True


def claude_marketplace_source():
    """The directory the marketplace row names: a path that survives an upgrade.

    A release prefix flips `<prefix>/current` and deletes old version dirs, and
    Homebrew installs a new keg beside the old one behind `opt/tezgah`, so a row
    naming this versioned tree would point at nothing after `tezgah update`. npm
    replaces its tree in place and a git checkout is its own stable path, so
    both register this tree. The uninstall's `_is_tezgah_marketplace_row`
    resolves the link, so it still recognises the row."""
    prefix = running_prefix()
    if prefix:
        return os.path.join(prefix, "current")
    import tezgah_update
    if tezgah_update.channel(HERE) == "brew":
        return os.path.dirname(os.path.dirname(tezgah_update.launcher("brew", HERE)))
    return HERE


def register_claude_plugin():
    """Register the plugin with Claude through its own CLI (ADR 013).

    Claude's gate, Stop and ledger hooks ship inside the plugin, and Claude
    loads a plugin only from its registry, so an install that wrote no row left
    Claude unarmed on every machine but the maintainer's. The marketplace is a
    directory source pinned to `claude_marketplace_source()`, never an
    auto-updating remote. Any `tezgah@*` row already there is left alone: a
    second one fires every hook twice. The report's plugin row is the verdict."""
    # A release tree is new after every upgrade, and the stable link the row
    # names now resolves to it: the pair must be there for Claude to read, even
    # when the row exists and nothing is registered. A checkout keeps none
    # unless it registers, so the suite's own tree gets no untracked pair.
    rows = read_json(INSTALLED_PLUGINS, {}).get("plugins") or {}
    had = sorted(k for k in rows if k.split("@", 1)[0] == "tezgah")
    if had and not os.path.isdir(os.path.join(HERE, ".git")):
        render_claude_manifest()
    if had:
        print("%s Claude plugin registered (%s)" % (OK, ", ".join(had)))
        return
    cli = tp.claude_bin()
    if not cli:
        print("%s no `claude` CLI on PATH: Claude's gate, Stop and ledger hooks "
              "stay unarmed - install Claude Code, then re-run --install" % NO)
        return
    if not render_claude_manifest():
        return
    name = (read_json(os.path.join(HERE, ".claude-plugin", "marketplace.json"), {})
            .get("name") or CLAUDE_MARKETPLACE)
    steps = [["plugin", "install", "tezgah@%s" % name]]
    if not isinstance(read_json(KNOWN_MARKETPLACES, {}).get(name), dict):
        steps.insert(0, ["plugin", "marketplace", "add", claude_marketplace_source()])
    for step in steps:
        try:
            proc = subprocess.run([cli] + step, capture_output=True, text=True,
                                  stdin=subprocess.DEVNULL, timeout=CLAUDE_CLI_TIMEOUT)
        except (OSError, subprocess.SubprocessError) as exc:
            print("%s claude %s (%s)" % (NO, " ".join(step), exc))
            return
        if proc.returncode != 0:
            err = (proc.stderr or proc.stdout or "").strip().splitlines()
            print("%s claude %s exited %d%s" % (NO, " ".join(step), proc.returncode,
                                                ": " + err[-1][:200] if err else ""))
            return
        print("%s claude %s" % (OK, " ".join(step)))


def wire_claude_attribution():
    """Mechanically disable Claude Code's commit/PR attribution.

    `attribution` is a documented settings key (docs.claude.com settings
    reference): {"commit": "", "pr": "", "sessionUrl": false} hides all of it.
    The hooks also enforce this, but the setting removes the default at source.
    Backed up; skipped when already correct."""
    sp = os.path.join(CLAUDE, "settings.json")
    settings = read_json(sp, None)
    if settings is None:
        print("%s %s (will not create it - set attribution by hand)" % (NO, sp))
        return
    wanted = {"commit": "", "pr": "", "sessionUrl": False}
    if settings.get("attribution") == wanted:
        print("%s attribution disabled in Claude settings" % OK)
        return
    settings["attribution"] = wanted
    write_json(sp, settings)
    print("%s attribution -> none (previous kept as %s.<timestamp>.tezgah-bak)" % (OK, sp))


def wire_claude_statusline():
    """Point Claude's statusLine at tezgah's wrapper (it forwards to Orca, then
    appends the tezgah segment). Backed up; skipped when already correct."""
    sp = os.path.join(CLAUDE, "settings.json")
    settings = read_json(sp, None)
    if settings is None:
        print("%s %s (will not create it - add the statusLine line by hand)" % (NO, sp))
        return
    cmd = tp.hook_command(os.path.join(CLAUDE, "statusline.py"))
    if (settings.get("statusLine") or {}).get("command") == cmd:
        print("%s statusLine -> tezgah" % OK)
        return
    settings["statusLine"] = {"type": "command", "command": cmd}
    write_json(sp, settings)
    print("%s statusLine -> tezgah (previous kept as %s.<timestamp>.tezgah-bak)" % (OK, sp))


def codex_hook_groups():
    """{event: the group install_codex writes}; `hook_entries` plans from it."""
    cmd = tp.hook_command(os.path.join(tp.BIN_DIR, "tezgah-codex-hook"))
    out = {}
    for ev, matcher in CODEX_HOOK_EVENTS:
        # PreToolUse carries a matcher on the group object, mirroring
        # hosts/codex/hooks.json, and is what makes the policy gate blocking.
        group = {"matcher": matcher} if matcher else {}
        group["hooks"] = [{"type": "command", "command": cmd, "timeout": 10}]
        out[ev] = group
    return out


def install_codex():
    print("\ncodex:")
    path = os.path.join(CODEX, "hooks.json")
    data = read_config(path, {"hooks": {}})
    if data is not None:
        hooks = data.setdefault("hooks", {})
        for ev, group in codex_hook_groups().items():
            arr = hooks.setdefault(ev, [])
            arr[:] = [e for e in arr if "tezgah" not in json.dumps(e)]
            arr.append(group)
        write_json(path, data)
        print("%s %s" % (OK, path))
        # the group is written, not trusted: codex runs only trusted groups, and
        # a machine that never approves it has no gate at all (audit H-1)
        print("%s codex runs a hook group only once it is trusted: approve tezgah's "
              "group in codex's first interactive run (or start codex with "
              "--dangerously-bypass-hook-trust). `tezgah-setup --report` reads "
              "`[hooks.state]` in %s and says untrusted until then."
              % ("  --  ", os.path.join(CODEX, "config.toml")))
    for s in SKILLS:
        print(link(os.path.join(HERE, "skills", s), os.path.join(CODEX, "skills", s)))
    mcp = os.path.join(CODEX, "bin", "consult")
    print(link(os.path.join(tp.BIN_DIR, "consult"), mcp))
    ensure_toml_mcp(os.path.join(CODEX, "config.toml"))
    # The always-on core as a managed block in Codex's global instructions: the
    # SessionStart hook's context is one message, where this file is the
    # instructions Codex keeps for the whole session. Global, like omp's
    # RULES.md, because a per-project file would be a tracked project file.
    print("%s %s (always-on contract)" % (OK, write_rules("codex")))


def _toml_str(value):
    return '"%s"' % value.replace("\\", "\\\\").replace('"', '\\"')


def ensure_toml_mcp(path):
    try:
        with open(path, encoding="utf-8") as fh:
            text = fh.read()
    except OSError:
        if not os.path.isdir(os.path.dirname(path)):
            return
        text = ""  # codex is installed but has no config.toml yet
    # Reconcile before adding: a table an older release wrote for a feature that
    # is off today is the same ghost a JSON host would keep, and the removal
    # helper already takes out exactly one table and leaves the user's keys.
    stale = [n for n in app_mcp_names() if n not in app_server_names()]
    if strip_toml_mcp(path, stale):
        restart_hint("codex", path)
        with open(path, encoding="utf-8") as fh:
            text = fh.read()
    blocks = []
    if "mcp_servers.codegraph" not in text:
        argv = graph_command()
        blocks.append("\n".join(
            ["[mcp_servers.codegraph]",
             "command = %s" % _toml_str(argv[0]),
             "args = [%s]" % ", ".join(_toml_str(a) for a in argv[1:]),
             "env = { %s }" % ", ".join(
                 "%s = %s" % (k, _toml_str(v)) for k, v in GRAPH_ENV.items())]))
    # tezgah's own surface is written exactly like the app servers: the row is
    # registry-shaped (name/command/env), so this loop stays the only rule.
    servers = list(app_servers()) + [tezgah_mcp_server()]
    for srv in servers:
        marker = "[mcp_servers.%s]" % srv["name"]
        if marker in text:
            continue
        cmd = srv["command"]
        lines = [marker, "command = %s" % _toml_str(cmd[0]),
                 "args = [%s]" % ", ".join(_toml_str(a) for a in cmd[1:])]
        if srv["env"]:
            lines.append("env = { %s }" % ", ".join(
                "%s = %s" % (k, _toml_str(v)) for k, v in srv["env"].items()))
        blocks.append("\n".join(lines))
    if not blocks and not refresh_toml_mcp(path, servers):
        print("%s MCP servers already in %s" % (OK, path))
        return
    if not blocks:
        print("%s updated app MCP argv in %s" % (OK, path))
        restart_hint("codex", path)
        return
    backup(path)
    with open(path, "a", encoding="utf-8") as fh:
        fh.write(("\n" if text and not text.endswith("\n") else "")
                 + "\n".join(blocks) + "\n")
    # The append above only fires for a missing table; an existing one is
    # refreshed in place so a new pin or a new `--caps` reaches an install that
    # already had the server.
    refresh_toml_mcp(path, servers)
    print("%s added MCP server(s) to %s" % (OK, path))
    restart_hint("codex", path)


def refresh_toml_mcp(path, servers):
    """Update tezgah's own keys inside an existing [mcp_servers.*] table.

    An append-only writer means a table written by an older tezgah keeps its old
    argv forever, so a changed pin or a new `--caps` silently never reaches an
    existing install - which is how `--caps=testing,storage,network` landed on
    one host and none of the others. Only `command`, `args` and `env` are
    touched, because those are tezgah's; every other key in the table (a timeout,
    a comment) stays the user's.

    ponytail: an `env` line that does not exist yet is not inserted here - the
    append path writes it with the table, and a changed env value is rare enough
    to be worth a re-add. Returns True when it changed the file.
    """
    try:
        with open(path, encoding="utf-8") as fh:
            lines = fh.read().splitlines()
    except OSError:
        return False
    want = {s["name"]: s for s in servers}
    out, current, changed = [], None, False
    for line in lines:
        marker = re.match(r"\s*\[mcp_servers\.([^\]]+)\]\s*$", line)
        if marker:
            current = want.get(marker.group(1))
        elif current is not None and not line.lstrip().startswith("["):
            key = line.split("=", 1)[0].strip() if "=" in line else ""
            cmd = current["command"]
            new = None
            if key == "command":
                new = "command = %s" % _toml_str(cmd[0])
            elif key == "args":
                new = "args = [%s]" % ", ".join(_toml_str(a) for a in cmd[1:])
            elif key == "env" and current["env"]:
                new = "env = { %s }" % ", ".join(
                    "%s = %s" % (k, _toml_str(v))
                    for k, v in current["env"].items())
            if new is not None:
                changed = changed or line != new
                line = new
        out.append(line)
    if not changed:
        return False
    backup(path)
    with open(path, "w", encoding="utf-8") as fh:
        fh.write("\n".join(out) + "\n")
    return True


def strip_toml_mcp(path, names):
    """Remove only the named [mcp_servers.*] tables, keeping everything else.
    Returns True when it changed the file."""
    try:
        with open(path, encoding="utf-8") as fh:
            lines = fh.read().splitlines()
    except OSError:
        return False
    out, skip, changed = [], False, False
    for line in lines:
        m = re.match(r"\[mcp_servers\.([^\]]+)\]", line.strip())
        if m:
            skip = m.group(1) in names
            changed = changed or skip
        if not skip:
            out.append(line)
    if not changed:
        return False
    backup(path)
    with open(path, "w", encoding="utf-8") as fh:
        fh.write("\n".join(out).rstrip("\n") + "\n")
    print("%s removed tezgah app MCP server(s) from %s" % (OK, path))
    return True


OPENCODE_CONTRACT = os.path.join(tp.CONFIG_DIR, "opencode-contract.md")


def opencode_contract_text():
    """The standing contract for opencode, rendered from the shared policy.

    When the policy exposes a consolidated CORE block it is the contract;
    otherwise the individual blocks are concatenated as before."""
    root = (tp.roots() or [tp.DEFAULT_ROOT])[0]
    # Always-on = the invariants plus one-line pointers; the conditional rules
    # (spec/consult/research/graph) are armed per prompt by the hook hosts and
    # stay in the on-demand skill here.
    core = (static_core()
            if hasattr(tezgah_context, "always_on_core")
            else getattr(policy, "CORE", None))
    if core:
        blocks = [core]
    else:
        # the two `%` slots of CODEGRAPH_RULE, filled from the policy file that
        # owns them: this render lands in a file written before a repo is known,
        # so it can only state where codegraph keeps the index and how it is
        # built, never a path or a slug of its own
        blocks = [CODEGRAPH_RULE % CODEGRAPH_STATIC,
                  WORKFLOWS, ORCHESTRATE, PONYTAIL, ADHD, EXEC,
                  CONSULT if tp.consult_options() else NO_CONSULT]
    # opencode has no session-start inject hook, so the always-on file must
    # carry the same pointer every hook host appends: without it the two-tier
    # codegen routing and the consult detail are never in front of the session.
    blocks.append(
        "**Full contract on demand.** The router (frontier model) decides and "
        "verifies; bounded, well-specified edits go to `{CODEGEN_BIN}` on a "
        "cheap model, which returns a diff to a scratch dir and never writes "
        "the repo (exit 2 = write it yourself with the main model). Consult "
        "rules and the exact kill switches live in the `tezgah-contract` "
        "skill - read its `SKILL.md` from the skill router on the first "
        "non-trivial task (opencode disables the native `skill` tool).")
    text = tezgah_context.render("\n\n".join(b.strip() for b in blocks), root)
    return ("<!-- generated by tezgah-setup from hooks/tezgah_policy.py; edit "
            "the source, re-run --install -->\n\n" + text + "\n")


def write_artifact(path, text, write):
    """Write one contract artifact with its own writer and record its sha.

    The writers are idempotent (write_if_changed, set_managed_md): a re-render
    that produces the same bytes moves no mtime and lays no backup. Returns True
    when the file changed."""
    changed = write(path, text)
    if recorded_shas().get(path) != _sha(text):
        record_contract(path, text)
    return changed


def opencode_contract():
    """Write opencode's contract file; returns its path."""
    write_artifact(OPENCODE_CONTRACT, opencode_contract_text(), write_if_changed)
    return OPENCODE_CONTRACT


def contract_artifacts(hosts):
    """{path: (fresh render, writer)} for every always-on contract artifact
    these hosts read: the managed block of each static rules file (Claude,
    Codex, omp) and opencode's contract and skill routers."""
    out = {}
    for h in hosts:
        if h in STATIC_RULES:
            out[STATIC_RULES[h]()] = (rules_block(h), set_managed_md)
    if "opencode" in hosts:
        out[OPENCODE_CONTRACT] = (opencode_contract_text(), write_if_changed)
        always, full = skill_router_texts()
        out[SKILL_ROUTER] = (always, write_if_changed)
        out[SKILL_ROUTER_FULL] = (full, write_if_changed)
    return out


def refresh_contract():
    """Re-render every always-on contract artifact of the armed hosts.

    opencode has no session-start hook that can run the Python contract, so it
    calls this once per session; `--refresh` is also the documented step after a
    policy edit or a kill switch. It used to re-render opencode's files alone and
    then reset the one shared hash, which left CLAUDE.md, AGENTS.md and RULES.md
    stale while `--report` went green (audit M-5, INT-02), and a kill switch never
    reached a static file at all (L-1). Every artifact is now re-rendered from
    `static_core()` with its own writer. No-op before the first install (no sha
    record). Returns the paths whose bytes changed."""
    if not os.path.isfile(CONTRACT_SHA):
        return []
    hosts = tp.config().get("hosts") or []
    return [path for path, (text, write) in contract_artifacts(hosts).items()
            if write_artifact(path, text, write)]


def skill_description(path):
    """One compact trigger line from a SKILL.md frontmatter `description`.

    Best effort: a missing, unreadable or undescribed skill yields "" rather
    than an error, because the router must never fail an install. The sentence
    carrying the `Use when ...` trigger wins over the opening one: a description
    whose first sentence is a preface ("The full tezgah working contract.")
    otherwise reaches the router stripped of every word a session matches on."""
    try:
        with open(path, encoding="utf-8", errors="replace") as fh:
            text = fh.read(6000)
    except OSError:
        return ""
    block = re.search(r"^---\s*\n(.*?)\n---", text, re.S)
    if not block:
        return ""
    folded = re.search(r"description:\s*[>|]-?\s*\n((?:\s+.*\n?)+)", block.group(1))
    if folded:
        desc = " ".join(line.strip() for line in folded.group(1).splitlines())
    else:
        inline = re.search(r"description:\s*(.+)", block.group(1))
        desc = inline.group(1).strip().strip("\"'") if inline else ""
    desc = re.sub(r"\s+", " ", desc).strip()
    sentences = re.split(r"(?<=[.!?])\s+", desc)
    line = next((s for s in sentences if re.match(r"(?:Also )?[Uu]se\b", s)),
                sentences[0] if sentences else "")
    return line[:137].rstrip() + "..." if len(line) > 140 else line


def skill_category(name, path=""):
    if name in RESEARCH_SKILLS:
        return "research & papers"
    if name in SKILLS:
        return "tezgah core"
    if name.startswith("deepscientist-") or name == "orx" or name.startswith("orx-"):
        return "research & papers"
    if name in TOOLING_SKILLS:
        return "code & host tooling"
    real = os.path.realpath(path) if path else ""
    if any(src in real for src in AI_RESEARCH_SKILL_SOURCES):
        return "AI research & engineering"
    return "marketing & growth"


ROUTER_ORDER = ["tezgah core", "code & host tooling", "research & papers",
                "AI research & engineering", "marketing & growth"]
# The buckets a coding session actually reaches for; the rest are collapsed.
ROUTER_ALWAYS = ("tezgah core", "code & host tooling")


def skill_groups():
    """{bucket: [(name, path)]} over the installed skill dirs.

    Generated from the actual dirs so it tracks what is installed. The first dir
    to define a name wins, matching opencode's precedence."""
    dirs = [os.path.join(HERE, "skills"), os.path.join(OPENCODE, "skills"),
            os.path.join(CLAUDE, "skills"), os.path.join(HOME, ".agents", "skills")]
    found = {}
    for d in dirs:
        try:
            names = sorted(os.listdir(d))
        except OSError:
            continue
        for name in names:
            path = os.path.join(d, name, "SKILL.md")
            if name not in found and os.path.isfile(path):
                found[name] = path
    groups = {c: [] for c in ROUTER_ORDER}
    for name, path in sorted(found.items()):
        groups[skill_category(name, path)].append((name, path))
    return groups


def _router_head():
    return [
        "<!-- generated by tezgah-setup from the installed skill dirs;"
        " re-run --install after adding or removing a skill -->",
        "",
        "# Skill router",
        "",
        "opencode's native skill list and `skill` tool are disabled here"
        " (`permission.skill = deny`), so this router replaces them. When a task"
        " matches a skill below, read its `SKILL.md` with the read tool and follow"
        " it - do not call the `skill` tool, it will be denied.",
        "",
    ]


def _router_section(cat, items):
    out = ["## %s" % cat, ""]
    for name, path in items:
        trigger = skill_description(path)
        line = "- `%s` - %s" % (name, path)
        if trigger:
            line = "- `%s` - %s - %s" % (name, trigger, path)
        out.append(line)
    out.append("")
    return out


# Words every description carries, so a shared one settles nothing: the collision
# rule reads the distinguishing terms of a router line, not its grammar.
COLLISION_STOP = frozenset("""
a an the and or of for to in on with that this it its is are be as at by from not
no do does when where which who whom what whose then than so if but into over
under out up down off again more most other some such only own same too very can
will just don should now read reads reading use used uses using also one two
three every each any all both new old
""".split())
# Two skills a session could pick either way from: their router lines share this
# many subject words, so the description alone cannot settle the choice. Three is
# where the shipped set stops pairing near-neighbours - `plan-add` / `plan-status`
# / `plan-sync` share four terms and `product-analysis` / `feature-audit` three,
# while at two `harness` / `no-ai-slop` pair over "asks, user" and the section
# reads as noise.
COLLISION_SHARED = 3


def _collision_words(line):
    """One router line's subject words: lowercased, four letters or more, with
    the words every description carries dropped."""
    return frozenset(w for w in re.findall(r"[a-z]+", line.lower())
                     if len(w) >= 4 and w not in COLLISION_STOP)


def skill_collisions(groups):
    """[(a, b, [shared words])] over tezgah's own skills, sorted.

    The author's collision table is a judgement at 100+ skills; at this size the
    mechanical part of it still names the pairs, and naming them in the on-demand
    router is what a session picks from when the descriptions tie. It reads the
    shipped names only: a vendored library's internal collisions are its own
    index's business, and a pair tezgah cannot rename is not a tezgah decision."""
    lines = {name: skill_description(path)
             for cat in ROUTER_ORDER for name, path in groups[cat]
             if name in SKILLS}
    names = sorted(lines)
    pairs = []
    for i, a in enumerate(names):
        for b in names[i + 1:]:
            shared = sorted(_collision_words(lines[a]) & _collision_words(lines[b]))
            if len(shared) >= COLLISION_SHARED:
                pairs.append((a, b, shared))
    return pairs


def _collision_section(pairs):
    """The on-demand router's collision table, or [] when nothing collides."""
    if not pairs:
        return []
    out = [
        "## Collisions",
        "",
        "Pairs a description alone cannot settle: both router lines carry the"
        " words below, so a session could pick either way from them. Read both"
        " entries before choosing.",
        "",
    ]
    out += ["- `%s` / `%s` - %s" % (a, b, ", ".join(shared))
            for a, b, shared in pairs]
    out.append("")
    return out


def skill_router_texts():
    """(always-on router, full router).

    opencode's own skill list is denied at install, and the plugin's prompt-time
    injection carries the builder's per-turn text - the conditional rules
    included - rather than a roster, so the always-on file carries the skills a
    coding session needs and collapses the research/marketing buckets to a
    pointer at the full file, read only when that task class comes up. Same shape
    as the contract: the common case always-on, the rest on demand. tezgah's own
    on-demand skills are the exception: they are named always-on, because a
    library the session is never told about is one it answers from memory
    instead - measured with a live opencode turn that read nothing and answered
    anyway."""
    groups = skill_groups()
    always = _router_head()
    for cat in ROUTER_ORDER:
        if cat in ROUTER_ALWAYS and groups[cat]:
            always += _router_section(cat, groups[cat])
    own = {name for cat in ROUTER_ORDER if cat not in ROUTER_ALWAYS
           for name, _path in groups[cat] if name in RESEARCH_SKILLS}
    if own:
        always += _router_section("research (tezgah's own)",
                                  [row for cat in ROUTER_ORDER
                                   for row in groups[cat] if row[0] in own])
    collapsed = [(c, len([r for r in groups[c] if r[0] not in own]))
                 for c in ROUTER_ORDER if c not in ROUTER_ALWAYS and groups[c]]
    collapsed = [(c, n) for c, n in collapsed if n]
    if collapsed:
        always += [
            "## Other skill buckets (on demand)",
            "",
            "Not listed here, to keep every session cheap. Before picking a skill"
            " for one of these task classes, read the full list at `%s`."
            % SKILL_ROUTER_FULL,
            "",
        ]
        always += ["- %s: %d skill%s" % (cat, n, "" if n == 1 else "s")
                   for cat, n in collapsed]
        always.append("")
    full = _router_head()
    for cat in ROUTER_ORDER:
        if groups[cat]:
            full += _router_section(cat, groups[cat])
    # The collision table rides the on-demand file: it is read when a session is
    # about to choose, which is not every turn, and it costs always-on bytes.
    full += _collision_section(skill_collisions(groups))
    return ("\n".join(always).rstrip() + "\n",
            "\n".join(full).rstrip() + "\n")


def install_opencode():
    print("\nopencode:")
    src = os.path.join(HERE, "hosts", "opencode", "plugins", "tezgah.js")
    for d in ("plugins", "plugin"):  # opencode version drift; the plugin self-guards
        print(link(src, os.path.join(OPENCODE, d, "tezgah.js")))
    for s in SKILLS:
        print(link(os.path.join(HERE, "skills", s), os.path.join(OPENCODE, "skills", s)))
    contract = opencode_contract()
    mkdirp(tp.CONFIG_DIR)
    always, full = skill_router_texts()
    # write_if_changed: the router text depends on the skills tree, not on the
    # feature selection, so a repeated --disable renders the same bytes and must
    # leave both files (and their mtimes) alone.
    write_artifact(SKILL_ROUTER, always, write_if_changed)
    write_artifact(SKILL_ROUTER_FULL, full, write_if_changed)
    print("%s %s (always-on, %d chars)" % (OK, SKILL_ROUTER, len(always)))
    print("%s %s (on demand, %d chars)" % (OK, SKILL_ROUTER_FULL, len(full)))
    # TUI status line: opencode has no command statusLine, only a TUI plugin
    # declared in tui.json. Local path spec resolves relative to tui.json.
    print(link(os.path.join(HERE, "hosts", "opencode", "tui", "tezgah-tui.tsx"),
               os.path.join(OPENCODE, "tui-plugins", "tezgah-tui.tsx")))
    tpath = os.path.join(OPENCODE, "tui.json")
    tui = read_config(tpath, {"$schema": "https://opencode.ai/tui.json"})
    if tui is not None:
        plugins = tui.get("plugin") or []
        spec = "./tui-plugins/tezgah-tui.tsx"
        if spec not in [p if isinstance(p, str) else p[0] for p in plugins]:
            plugins.append(spec)
        tui["plugin"] = plugins
        write_json(tpath, tui)
        print("%s tui.json (status line plugin)" % OK)
    cfg = read_config(os.path.join(OPENCODE, "opencode.json"),
                      {"$schema": "https://opencode.ai/config.json"})
    if cfg is None:
        return
    instr = cfg.get("instructions") or []
    for extra in (contract, SKILL_ROUTER):
        if extra not in instr:
            instr.append(extra)
    cfg["instructions"] = instr
    mcp = cfg.setdefault("mcp", {})
    mcp.setdefault("codegraph", {"enabled": True, "type": "local",
                                 "command": graph_command(),
                                 "environment": dict(GRAPH_ENV)})
    for srv in list(app_servers()) + [tezgah_mcp_server()]:
        entry = mcp.get(srv["name"])
        if not isinstance(entry, dict):
            entry = mcp[srv["name"]] = {}
        # tezgah owns type/command/environment; `enabled` and any other key the
        # user added stay theirs. Refreshing in place is the point: setdefault
        # left an entry an older tezgah wrote with its old argv forever.
        entry.setdefault("enabled", True)
        entry["type"] = "local"
        entry["command"] = list(srv["command"])
        if srv["env"]:
            entry.setdefault("environment", {}).update(srv["env"])
    dropped = reconcile_json_servers(mcp)
    if dropped:
        print("%s removed %s from %s (not selected)"
              % (OK, ", ".join(dropped), os.path.join(OPENCODE, "opencode.json")))
    # Deny every skill so opencode stops injecting ~80 name+description blocks
    # into the system prompt; the generated router replaces them.
    cfg.setdefault("permission", {})["skill"] = "deny"
    # A skill body and tezgah's own CLIs live OUTSIDE the session's project (the
    # checkout is at a fixed path, the project is wherever the user works), and
    # opencode asks before reading or running anything out there. In a
    # non-interactive run there is nobody to answer that prompt, so the call is
    # auto-rejected and the session answers from memory instead - measured: a live
    # `opencode run` tried to open `skills/ai-research/` and was denied. Grant the
    # two directories tezgah installs for exactly this. A user who set the
    # shorthand action (`"external_directory": "ask"`) keeps it: an explicit
    # global choice is not ours to overwrite.
    grants = [os.path.join(HERE, "skills", "**"), os.path.join(tp.CONFIG_DIR, "bin", "**")]
    external = cfg["permission"].get("external_directory")
    if isinstance(external, dict):
        for grant in grants:
            external.setdefault(grant, "allow")
    elif external is None:
        cfg["permission"]["external_directory"] = {g: "allow" for g in grants}
    # Context hygiene: prune replaces old tool results in the prompt with
    # "[Old tool result content cleared]" so a long session stops re-sending
    # every output on every step. setdefault keeps a user's explicit choice.
    cfg.setdefault("compaction", {}).setdefault("prune", True)
    wat = cfg.setdefault("watcher", {})
    ign = wat.setdefault("ignore", [])
    for pat in OPENCODE_IGNORE:
        if pat not in ign:
            ign.append(pat)
    changed = write_json(os.path.join(OPENCODE, "opencode.json"), cfg)
    print("%s opencode.json (instructions + skill router + mcp + skill deny)" % OK)
    print("%s opencode.json (compaction.prune + watcher.ignore)" % OK)
    if changed or dropped:
        restart_hint("opencode", os.path.join(OPENCODE, "opencode.json"))


def cursor_hook_entries():
    """{event: the entry install_cursor writes}; `hook_entries` plans from it."""
    cmd = tp.hook_command(os.path.join(tp.BIN_DIR, "tezgah-cursor-hook"))
    return {ev: dict({"command": cmd}, **extra)
            for ev, extra in CURSOR_HOOK_EVENTS.items()}


# Cursor also reads ~/.codex/skills, ~/.claude/skills and ~/.agents/skills
# (cursor.com/docs/context/skills) and documents no winner for a name found in
# two of them. A tezgah skill Codex's install already linked into
# ~/.codex/skills therefore reached Cursor twice once ~/.cursor/skills linked it
# too: ~/.cursor/skills holds only the names no other dir Cursor reads resolves
# to this tree. Cursor installs last (install_all), so it sees Codex's links.
CURSOR_SHARED_SKILLS = tuple(os.path.join(HOME, d, "skills")
                             for d in (".codex", ".claude", ".agents"))


def cursor_shared_copy(s):
    """The other dir Cursor reads that already links skill `s` to this tree."""
    want = os.path.realpath(os.path.join(HERE, "skills", s))
    return next((d for d in CURSOR_SHARED_SKILLS
                 if os.path.realpath(os.path.join(d, s)) == want), None)


def link_cursor_skills():
    shared = []
    for s in SKILLS:
        dst = os.path.join(CURSOR, "skills", s)
        if cursor_shared_copy(s):
            unlink_tezgah(dst)
            shared.append(s)
        else:
            print(link(os.path.join(HERE, "skills", s), dst))
    if shared:
        print("%s %d skills reach Cursor through %s, not linked twice"
              % (OK, len(shared), ", ".join(sorted({cursor_shared_copy(s) for s in shared}))))


def install_cursor():
    print("\ncursor:")
    path = os.path.join(CURSOR, "hooks.json")
    data = read_config(path, {"version": 1, "hooks": {}})
    if data is not None:
        data.setdefault("version", 1)
        hooks = data.setdefault("hooks", {})
        # Mirrors hosts/cursor/hooks.json. Existing (Orca) entries are merged,
        # never overwritten: only tezgah entries are replaced.
        for ev, entry in cursor_hook_entries().items():
            arr = hooks.setdefault(ev, [])
            arr[:] = [e for e in arr if "tezgah" not in json.dumps(e)]
            arr.append(entry)
        write_json(path, data)
        print("%s %s" % (OK, path))
    link_cursor_skills()
    cc = os.path.join(CURSOR, "cli-config.json")
    cfg = read_config(cc, {})
    if cfg is not None:
        cfg.setdefault("version", 1)
        cfg["statusLine"] = {
            "type": "command",
            "command": tp.hook_command(
                os.path.join(tp.BIN_DIR, "tezgah-statusline")) + " --cursor",
        }
        write_json(cc, cfg)
        print("%s %s (statusLine -> tezgah)" % (OK, cc))
    mpath = os.path.join(CURSOR, "mcp.json")
    mcfg = read_config(mpath, {"mcpServers": {}})
    if mcfg is None:
        return
    servers = mcfg.setdefault("mcpServers", {})
    argv = graph_command()
    servers.setdefault("codegraph", {"command": argv[0], "args": argv[1:],
                                     "env": dict(GRAPH_ENV)})
    for srv in list(app_servers()) + [tezgah_mcp_server()]:
        entry = servers.get(srv["name"])
        if not isinstance(entry, dict):
            entry = servers[srv["name"]] = {}
        # tezgah owns command/args/env; other keys are the user's. setdefault
        # would leave an older entry's argv in place forever.
        entry["command"] = srv["command"][0]
        entry["args"] = list(srv["command"][1:])
        if srv["env"]:
            entry.setdefault("env", {}).update(srv["env"])
    dropped = reconcile_json_servers(servers)
    changed = write_json(mpath, mcfg)
    print("%s %s" % (OK, mpath))
    if dropped:
        print("%s removed %s from %s (not selected)" % (OK, ", ".join(dropped), mpath))
    if changed or dropped:
        restart_hint("cursor", mpath)


def dsh_app_mcp_rows():
    """One dsh-mcp-client row per MCP server tezgah writes into the block.

    `@deepseek-ai/dsh-mcp-client` takes `command` + `args` + `env` for a stdio
    server (confirmed against its published config schema), so the same argv
    tezgah writes for the other hosts works here - the app servers and tezgah's
    own surface, which is registry-shaped and joins this loop unchanged. A
    server that fails to start is inert by default (`failOnStartupError: false`),
    so a machine without the graph or a simulator never blocks a dsh boot."""
    rows = []
    for srv in list(app_servers()) + [tezgah_mcp_server()]:
        rows.append(
            "    - id: tezgah-mcp-%s\n"
            "      name: '@deepseek-ai/dsh-mcp-client'\n"
            "      config:\n"
            "        serverName: %s\n"
            "        transport: stdio\n"
            "        command: %s\n"
            "        args: [%s]\n" % (
                srv["name"], srv["name"], srv["command"][0],
                ", ".join("'%s'" % a for a in srv["command"][1:])))
        if srv["env"]:
            rows.append("        env:\n")
            for key, value in srv["env"].items():
                rows.append("          %s: '%s'\n" % (key, value))
    return "".join(rows)


def dsh_graph_mcp_row():
    """The dsh-mcp-client row for the code graph, in the shared patch block.

    codegraph's own `install --target` knows Claude Code, Cursor, Codex, opencode
    and others, but not dsh, so tezgah writes this row itself - from the same
    argv and environment every other host row gets, so dsh cannot end up on a
    different surface than the four hosts codegraph can install into."""
    argv = graph_command()
    rows = ["        serverName: codegraph\n",
            "        transport: stdio\n",
            "        command: %s\n" % argv[0],
            "        args: [%s]\n" % ", ".join("'%s'" % a for a in argv[1:])]
    rows.append("        env:\n")
    for key, value in GRAPH_ENV.items():
        rows.append("          %s: '%s'\n" % (key, value))
    return "".join(rows)


def dsh_patch_block():
    """dsh home-patch rows: run tezgah's existing Claude hooks in dsh through its
    claude-code bridge (same contract, same grep/Explore gate, same attribution
    gate), register the code graph and the app-analysis servers as MCP servers,
    and declare the three OpenAI-compatible LLM routes (OpenRouter, DeepSeek
    direct and Inception Labs) on the pi-ai adapter the base composition
    already mounts. The routes read their keys from the launch env or the
    harness credential store; the
    native deepseek-official route stays the default model provider. The bridge
    knows only SessionStart/UserPromptSubmit/PreToolUse/PostToolUse/SubagentStart/
    SubagentStop/Stop and silently drops any other event, so `configPath` names
    hosts/dsh/hooks.json rather than the Claude manifest - the file declares five
    of those seven: no SubagentStop (its record-only verdict waits for outcomes too) and no
    Stop (the bridge drops every outcome, so no check there can show a pass)."""
    return (
        "- insert:\n"
        "    - id: tezgah-hooks\n"
        "      name: '@deepseek-ai/dsh-hooks-claude-code'\n"
        "      config:\n"
        "        configPath: %s\n"
        "        pluginRoot: %s\n"
        "        projectDir: .\n"
        "    - id: tezgah-mcp\n"
        "      name: '@deepseek-ai/dsh-mcp-client'\n"
        "      config:\n"
        "%s"
        "%s"
        "- id: llm-pi-ai\n"
        "  config:\n"
        "    providers:\n"
        "      openrouter:\n"
        "        apiKeyEnv: OPENROUTER_API_KEY\n"
        "      deepseek:\n"
        "        apiKeyEnv: DEEPSEEK_API_KEY\n"
        "      inception:\n"
        "        apiKeyEnv: INCEPTION_API_KEY\n"
        # pi-ai's installed catalog ships openrouter and deepseek only, so a
        # route the catalog does not carry has to declare its own protocol,
        # endpoint and models - a route that names none of them resolves to
        # catalogError and no model can be selected on it.
        "        api: openai-completions\n"
        "        baseURL: https://api.inceptionlabs.ai/v1\n"
        "        compat:\n"
        "          maxTokensField: max_completion_tokens\n"
        "        models:\n"
        "          - id: mercury-2.5\n"
        "            name: Mercury 2.5\n"
        "            contextWindow: 260000\n"
        "            maxTokens: 65536\n"
        "          - id: mercury-2\n"
        "            name: Mercury 2\n"
        "            contextWindow: 128000\n"
        "            maxTokens: 50000\n"
        % (os.path.join(HERE, "hosts", "dsh", "hooks.json"), HERE,
           dsh_graph_mcp_row(), dsh_app_mcp_rows()))


def dsh_status_block():
    """Web-profile patch row for the tezgah status line.

    The row lives in the web profile, not the shared home patch, because the
    plugin's host half injects the web-only `connection` service: inserting it
    into a headless tree would leave a permanently pending row."""
    return (
        "- insert:\n"
        "    - id: tezgah-statusline\n"
        "      name: '%s'\n" % DSH_STATUSLINE)


def install_dsh_statusline():
    """Link the status-line plugin into the web profile and enable its row.

    The plugin is a plain dependency, not a bundle: pnpm links the repo package
    under the profile's node_modules and the patch row inserts it into the
    composed tree. A profile that has never booted `web` has no package.json, so
    this is a no-op with a hint instead of a half-written profile."""
    if not os.path.isfile(os.path.join(DSH_WEB, "package.json")):
        print("%s dsh web profile not initialized; run `dsh web` once, then "
              "re-run --install" % NO)
        return
    pkg = os.path.join(HERE, "hosts", "dsh", "statusline")
    if not dsh_run(["plugin", "--profile", "web", "add", "link:" + pkg]):
        if dsh_cli_args() is None:
            print("%s dsh CLI not found (need node + npx or a local dsh)" % NO)
        else:
            print("%s could not link the dsh status line (is pnpm on PATH?)" % NO)
        return
    print("%s status line linked into the web profile" % OK)
    set_managed_block(DSH_WEB_PATCH, dsh_status_block())
    print("%s %s" % (OK, DSH_WEB_PATCH))


def dsh_launcher(platform=None):
    """(launcher source, its entry) for the platform this install runs on.

    Chosen by the installer, not asked of the user: a `sh` script has no
    interpreter on Windows, and cmd.exe resolves a command through PATHEXT, so
    the platform decides both the file and the name of the entry that starts it.
    Called with `platform` by the tests that ask for the other answer; here it is
    os.name, which is also what the Windows dependency report branches on."""
    nt = (platform or os.name) == "nt"
    return (os.path.join(HERE, "bin", "tezgah-dsh.cmd" if nt else "tezgah-dsh"),
            os.path.join(LOCAL_BIN, "dsh.cmd" if nt else "dsh"))


def install_dsh_launcher(platform=None):
    """Wire the `dsh` entry onto the launcher this platform can start.

    Windows gets a copy rather than `link()`: where a symlink is refused, link()
    materialises a `#!` file as a relay, and the relay `_write_relay` writes for
    a shell script is a `/bin/sh` one-liner - a file cmd.exe cannot start. The
    copy has nothing to relay: it resolves the CLI, the index farm and its own
    interpreter by absolute path, so it works from ~/.local/bin. Recorded as
    materialised, which is how uninstall tells it from a same-named file the
    user wrote."""
    src, dst = dsh_launcher(platform)
    if not os.path.isfile(src):
        print("%s %s missing from this tree" % (NO, src))
        return
    if not src.endswith(".cmd"):
        print(link(src, dst))
        return
    if os.path.islink(dst):
        os.unlink(dst)  # an entry an earlier install wrote, not the user's file
    elif os.path.exists(dst) and not is_tezgah_copy(dst):
        backup(dst)     # a same-named file of the user's keeps link()'s backup
    try:
        mkdirp(os.path.dirname(dst))
        shutil.copy2(src, dst)
    except OSError as exc:
        print("%s %s (%s)" % (NO, dst, exc))
        return
    record_materialised(dst)
    print("%s %s (written in place; a .cmd has nothing to relay)" % (OK, dst))


def dsh_launcher_row(platform=None):
    """The report row for the dsh launcher, naming the launcher it judged.

    The entry is held against the launcher this platform chose, not against
    "tezgah wrote something here": a `sh` entry on Windows - or the `/bin/sh`
    relay a symlink-less install leaves - reads as a launcher while being a file
    that machine cannot start, so without the name in the row and this check the
    row would report a host that is armed and unrunnable."""
    src, dst = dsh_launcher(platform)
    good = is_tezgah_entry(dst)
    if good:
        try:
            if os.path.islink(dst):
                good = os.path.realpath(dst) == os.path.realpath(src)
            else:
                # a materialised entry: a copy of the launcher, or - where the
                # platform can run it - the relay link() writes pointing at it.
                # A `sh` relay where the launcher is the .cmd is exactly what
                # this row exists to catch, so a .cmd has to match byte for byte
                with open(dst, encoding="utf-8", errors="replace") as fh:
                    body = fh.read()
                with open(src, encoding="utf-8", errors="replace") as fh:
                    launcher = fh.read()
                good = body == launcher or (not src.endswith(".cmd")
                                            and src in body)
        except OSError:
            good = False
    return ("dsh launcher on PATH (~/.local/bin/%s -> %s)"
            % (os.path.basename(dst), os.path.basename(src)), good)


def install_dsh():
    print("\ndsh:")
    for s in SKILLS:
        print(link(os.path.join(HERE, "skills", s), os.path.join(DSH, "skills", s)))
    if set_managed_block(DSH_PATCH, dsh_patch_block()):
        restart_hint("dsh", DSH_PATCH)
    print("%s %s" % (OK, DSH_PATCH))
    install_dsh_statusline()
    install_dsh_launcher()



def write_if_changed(path, text):
    """Write text only when it differs. Returns True when it was written."""
    mkdirp(os.path.dirname(path))
    try:
        with open(path, encoding="utf-8") as fh:
            if fh.read() == text:
                return False
    except OSError:
        pass
    backup(path)
    with open(path, "w", encoding="utf-8") as fh:
        fh.write(text)
    return True


def set_managed_md(path, block, start="<!-- tezgah:start -->",
                   end="<!-- tezgah:end -->"):
    """Replace the marked block in a markdown file, or append it, keeping any
    user text around it. Markdown gets HTML-comment markers, not `#`."""
    try:
        with open(path, encoding="utf-8") as fh:
            lines = fh.read().splitlines()
    except OSError:
        lines = []
    out, skip = [], False
    for ln in lines:
        if ln.strip().startswith(start):
            skip = True
            continue
        if ln.strip().startswith(end):
            skip = False
            continue
        if not skip:
            out.append(ln)
    while out and not out[-1].strip():
        out.pop()
    text = "\n".join(out + [start + " (managed by tezgah-setup; do not edit)",
                            block.strip(), end]) + "\n"
    # write_if_changed, not a bare write: a run that renders the same bytes must
    # not move the file's mtime or lay a .tezgah-bak, which is what makes a
    # repeated --disable idempotent rather than merely convergent.
    return write_if_changed(path, text)


# The hook as an explicit `extensions:` entry in omp's own config. omp documents
# `<agentDir>/hooks/pre/` as a discovery root, but on a live omp 18.2.11 install
# nothing placed there loaded: the same file handed over with `--hook`, or named
# in `extensions:`, drew the status line on the first frame, and without either
# the footer stayed empty (tests/e2e_omp_statusline.py). A configured path is the
# documented route that does not ride the discovery glob, and omp dedupes a path
# that is both discovered and configured by its absolute path, so a build whose
# discovery works still loads the bridge once. The key is written through `omp
# config`, the owner's own writer: config.yml is YAML the user edits, and tezgah
# has no parser for it that would keep the rest of the file intact.
OMP_EXTENSIONS = "extensions"


def omp_config(*args):
    """Run `omp config <args>` against the agent dir tezgah writes into, or None.

    PI_CODING_AGENT_DIR pins the CLI to OMP_AGENT, so the registration lands
    beside the hook it names whatever profile the shell picked, and cwd is HOME so a project `extensions:` array is never copied machine-wide."""
    omp = tp.omp_bin()
    if not omp:
        return None
    env = dict(os.environ, PI_CODING_AGENT_DIR=OMP_AGENT)
    try:
        proc = subprocess.run([omp, "config", *args], capture_output=True,
                              text=True, timeout=30, env=env, cwd=tp.HOME)
    except (OSError, subprocess.SubprocessError):
        return None
    return proc if proc.returncode == 0 else None


def omp_extensions():
    """The `extensions` list omp reads (an unset key reads as []), or None when
    the CLI is missing or its answer cannot be parsed."""
    proc = omp_config("get", OMP_EXTENSIONS, "--json")
    if proc is None:
        return None
    try:
        value = json.loads(proc.stdout).get("value")
    except (ValueError, AttributeError):
        return None
    return [str(v) for v in value] if isinstance(value, list) else None


def register_omp_hook(hook_dst):
    """Name the bridge in omp's `extensions`, keeping every entry the user has."""
    current = omp_extensions()
    if current is None:
        print("%s omp CLI not answering `omp config`: %s is left to directory "
              "discovery, which omp 18.2.11 did not load" % (NO, hook_dst))
        return
    if hook_dst in current:
        print("%s %s registered in omp extensions" % (OK, hook_dst))
        return
    if omp_config("set", OMP_EXTENSIONS, json.dumps(current + [hook_dst])) is None:
        print("%s could not add %s to omp extensions" % (NO, hook_dst))
        return
    print("%s %s registered in omp extensions" % (OK, hook_dst))
    restart_hint("omp", os.path.join(OMP_AGENT, "config.yml"))


def unregister_omp_hook(hook_dst):
    """Drop the bridge from omp's `extensions`; the user's entries stay."""
    current = omp_extensions()
    if not current or hook_dst not in current:
        return
    rest = [p for p in current if p != hook_dst]
    done = (omp_config("set", OMP_EXTENSIONS, json.dumps(rest)) if rest
            else omp_config("reset", OMP_EXTENSIONS))
    print("%s %s %s omp extensions" % (OK if done else NO, hook_dst,
                                       "dropped from" if done else "still in"))
def strip_managed_md(path):
    """Remove set_managed_md's block, keeping the user's lines; a file left
    holding nothing else is removed."""
    try:
        with open(path, encoding="utf-8") as fh:
            text = fh.read()
    except OSError:
        return
    kept = re.sub(r"<!-- tezgah:start -->.*?<!-- tezgah:end -->\n?",
                  "", text, flags=re.S).strip()
    if kept == text.strip():
        return
    if kept:
        with open(path, "w", encoding="utf-8") as fh:
            fh.write(kept + "\n")
        print("%s stripped the tezgah block from %s" % (OK, path))
    else:
        os.remove(path)
        print("%s removed %s" % (OK, path))


# Codex's global instruction files in precedence order: it reads the override
# instead of AGENTS.md when the override exists.
CODEX_RULES = ("AGENTS.override.md", "AGENTS.md")


def codex_rules():
    """The global instructions file Codex loads (CODEX_RULES' first that
    exists, else AGENTS.md)."""
    for name in CODEX_RULES:
        if os.path.exists(os.path.join(CODEX, name)):
            return os.path.join(CODEX, name)
    return os.path.join(CODEX, CODEX_RULES[-1])


# Claude's global memory file: the user-level instructions file Claude Code reads
# into every session, whichever project it starts in. One path, not a precedence
# list like Codex's - Claude has no override spelling - and install_claude writes
# the always-on block there the way install_omp writes omp's RULES.md.
CLAUDE_RULES = os.path.join(CLAUDE, "CLAUDE.md")

# The hosts whose always-on contract is a managed block in a static rules file,
# and where that file is. A lambda per row, because codex_rules() answers from
# the disk (AGENTS.override.md wins when it exists).
STATIC_RULES = {"claude": lambda: CLAUDE_RULES, "codex": codex_rules,
                "omp": lambda: os.path.join(OMP_AGENT, "RULES.md")}


def rules_block(host):
    """The managed block one static-file host carries, rendered fresh."""
    text = static_core() + ("\n\n" + OMP_LESSONS if host == "omp" else "")
    return tezgah_context.render(text, (tp.roots() or [tp.DEFAULT_ROOT])[0])


def write_rules(host):
    """Render the host's block into its rules file and record its sha."""
    path = STATIC_RULES[host]()
    write_artifact(path, rules_block(host), set_managed_md)
    return path


def rules_current(host):
    """True when the managed block in the host's rules file is, byte for byte,
    a fresh render. A marker test alone stayed green over a block rendered from
    an older policy, or one still carrying a rule a kill switch has since
    removed (audit M-5). Only the block is compared: the user's own lines around
    it are theirs."""
    try:
        with open(STATIC_RULES[host](), encoding="utf-8") as fh:
            lines = fh.read().splitlines()
    except OSError:
        return False
    starts = [i for i, ln in enumerate(lines)
              if ln.strip().startswith("<!-- tezgah:start -->")]
    ends = [i for i, ln in enumerate(lines)
            if ln.strip().startswith("<!-- tezgah:end -->")]
    return (len(starts) == 1 and len(ends) == 1 and starts[0] < ends[0]
            and "\n".join(lines[starts[0] + 1:ends[0]]) == rules_block(host).strip())


def omp_bridge():
    """The omp extension as an install writes it: the template with this tree's
    hook path, or "" when the template is unreadable. The install, the report
    row, the live probe and the session-start attestation all call this one
    renderer (`hooks/tezgah_attest.py::omp_bridge`)."""
    return ta.omp_bridge(HERE)


def install_omp():
    print("\nomp:")
    mkdirp(OMP_AGENT)
    print("%s %s (always-on contract)" % (OK, write_rules("omp")))
    for s in SKILLS:
        print(link(os.path.join(HERE, "skills", s),
                   os.path.join(OMP_AGENT, "skills", s)))
    wanted = tezgah_agents.omp_user_agents()
    agents_dir = os.path.join(OMP_AGENT, "agents")
    for name, text in wanted.items():
        path = os.path.join(agents_dir, name)
        if write_if_changed(path, text):
            print("%s %s" % (OK, path))
    # omp's files carry no MARKER (render_md_omp), so ownership is the name: a
    # role tezgah ever generated (OWNED_NAMES) that is no longer wanted - retired,
    # capability gone, or `agents-off` - stops being loaded. A user's own
    # `tezgah-*.md` is not on that list and stays.
    owned = {n + ".md" for n in tezgah_agents.OWNED_NAMES}
    for name in (os.listdir(agents_dir) if os.path.isdir(agents_dir) else []):
        if name in owned and name not in wanted:
            try:
                os.remove(os.path.join(agents_dir, name))
                print("%s removed %s" % (OK, os.path.join(agents_dir, name)))
            except OSError:
                pass
    hook = omp_bridge()
    if hook:
        hook_dst = os.path.join(OMP_AGENT, "hooks", "pre", "tezgah-hook.ts")
        if write_if_changed(hook_dst, hook):
            print("%s %s (contract + gate + status line)" % (OK, hook_dst))
        register_omp(hook_dst)
    mcp_path = os.path.join(OMP_AGENT, "mcp.json")
    cfg = read_config(mcp_path, {})
    if cfg is None:
        return
    cfg["$schema"] = OMP_MCP_SCHEMA
    servers = cfg.setdefault("mcpServers", {})
    argv = graph_command()
    servers.setdefault("codegraph", {"type": "stdio", "command": argv[0],
                                     "args": argv[1:],
                                     "env": dict(GRAPH_ENV)})
    for srv in [s for s in app_servers() if s["name"] not in OMP_SUPERSEDED_MCP] + [
            tezgah_mcp_server()]:
        # omp spawns `command` as ONE executable and takes the rest in `args`
        # (its mcp-schema.json); the whole argv in `command` is spawned as the
        # comma-joined string and fails with ENOENT.
        entry = servers.get(srv["name"])
        if not isinstance(entry, dict):
            entry = servers[srv["name"]] = {}
        # tezgah owns the argv shape; every other key is the user's. The refresh
        # also heals an entry an earlier release wrote with the whole argv in
        # `command`, which omp spawns comma-joined and fails with ENOENT.
        entry["type"] = "stdio"
        entry["command"] = srv["command"][0]
        entry["args"] = list(srv["command"][1:])
        if srv["env"]:
            entry.setdefault("env", {}).update(srv["env"])
    dropped = reconcile_json_servers(servers, OMP_SUPERSEDED_MCP)
    changed = write_json(mcp_path, cfg)
    print("%s %s (mcpServers)" % (OK, mcp_path))
    if dropped:
        for name in dropped:
            print("%s removed %s from %s (%s)" % (
                OK, name, mcp_path,
                "omp's native browser supersedes it" if name in OMP_SUPERSEDED_MCP
                else "not selected"))
    if changed or dropped:
        restart_hint("omp", mcp_path)


INSTALLERS = {"claude": install_claude, "codex": install_codex,
              "opencode": install_opencode, "cursor": install_cursor,
              "dsh": install_dsh, "omp": install_omp}


def install_openresearch(hosts):
    """Trigger orx's own installer so the research routing rule has a manual to
    load.

    The shim files (a real `skills/orx/SKILL.md`, not a tezgah symlink) are owned
    by orx, so tezgah only runs its installer and never lists them for uninstall.
    dsh has no orx harness; the rule there falls back to `orx skill` on the
    shell. omp shares codex's target (see ORX_AGENTS), so each orx agent runs
    once however many hosts map onto it."""
    print("\nopenresearch (orx):")
    orx = tp.orx_bin()
    if not orx:
        print("%s orx not on PATH - skipped; run `tezgah-setup --deps` to install "
              "it, or see https://github.com/alphaXiv/OpenResearch" % NO)
        return
    ran = {}
    for h in hosts:
        agent = ORX_AGENTS.get(h)
        if not agent:
            print("%s %s: orx has no harness for this host" % (NO, h))
            continue
        if agent not in ran:
            proc = subprocess.run([orx, "install-skills", "--agent", agent],
                                  capture_output=True, text=True)
            last = (proc.stdout or proc.stderr).strip().splitlines()
            ran[agent] = (proc.returncode == 0,
                          last[-1] if last else "exit %d" % proc.returncode)
        ok, line = ran[agent]
        if h == "omp":
            line = "%s (shim at %s, omp's native agents root)" % (line, ORX_AGENTS_SKILL)
        print("%s %s: %s" % (OK if ok else NO, h, line))


# ------------------------------------------------------------ dependencies ----
# Tools an OPTIONAL FEATURE owns are not written here: `feature_deps()` reads
# them from the registry row, so `--features` (which answers for the same key)
# and this installer cannot disagree about what installing a feature means. Only
# the tools no feature owns stay private. `--install` installs the feature tools
# that are missing by default (`--no-deps` skips); each command is the vendor's
# own documented installer and none needs sudo. The private rows are third-party
# HOST CLIs (`"host": True`): they install only under `--host-deps`, because the
# README one-liner installed cursor-agent through `curl | bash` on machines that
# never asked for the cursor host, and uninstall left it behind (audit M-9,
# ENV-02). Without the flag the exact command is printed instead. dsh has no
# single installer, so the documented first step - initializing its home profile
# through npx - stands in; the first `dsh web` boot completes it.
PRIVATE_DEPS = (
    {"name": "cursor-agent", "host": True,
     "probe": lambda: shutil.which("cursor-agent") or shutil.which("cursor"),
     "needs": ("curl", "bash"),
     "cmd": ["bash", "-c", "curl https://cursor.com/install -fsS | bash"],
     "why": "the cursor host"},
    # Before dsh: its profile plugins are managed with pnpm, so `dsh plugin`
    # cannot initialize a profile without it.
    {"name": "pnpm", "host": True, "probe": lambda: bool(shutil.which("pnpm")),
     "needs": ("npm",), "cmd": ["npm", "install", "-g", "pnpm"],
     "why": "the dsh host and its web status line"},
    {"name": "dsh", "host": True, "probe": lambda: os.path.isdir(DSH),
     "needs": ("npx",),
     "cmd": ["npx", "-y", "@deepseek-ai/dsh", "plugin", "--profile", "web",
             "--version"],
     "why": "the dsh host; the first `dsh web` boot finishes it"},
)
# Set from `--host-deps` in main(): the one switch that lets install_deps run a
# host CLI's installer, read there so the wizard path needs no extra argument.
HOST_DEPS = False
# Bounds on one installer. Without them a stalled network hung `--install` with
# no end (killed at 240 s in the audit, GAP-06). The whole installer gets
# DEP_TIMEOUT; each curl in a `sh -c` pipeline gets --max-time, so a stall inside
# the pipe ends on its own instead of being orphaned by the kill.
DEP_TIMEOUT = 600
CURL_MAX_TIME = 300


def feature_deps(only=None):
    """Dependency rows the registry declares, in the two sets that need them.

    With no argument this is the INSTALL-TIME set: a feature that carries a
    server is left out, because its runtime is heavy - the browser build
    Playwright launches on its first tool call, the platform tools a simulator
    needs - and a plain `--install` must not download a browser nobody asked for.
    An opt-in feature (`default` False: the embedding models) is left out for the
    same reason. `only` is how `--enable <id>` asks for exactly the named
    features' rows instead, heavy ones included. Rows are de-duplicated on the
    install command, so three features sharing one interpreter ask for one
    installer."""
    rows, seen = [], set()
    for row in tezgah_apps.REGISTRY:
        if only is not None:
            if row["id"] not in only:
                continue
        elif row.get("command") or not row["default"]:
            continue
        dep = row.get("dep") or {}
        cmd = dep.get("cmd")
        if not cmd or tuple(cmd) in seen:
            continue
        seen.add(tuple(cmd))
        rows.append({"name": row["id"], "probe": dep["probe"],
                     "needs": tuple(dep.get("needs") or ()),
                     "cmd": list(cmd), "why": dep.get("why") or row["why"]})
    return tuple(rows)


DEPS = feature_deps() + PRIVATE_DEPS


def dep_rows(only=None):
    """The rows one dependency run considers.

    The install-time table, plus the named features' own rows: an --enable sits
    on top of an install, so it considers the same base set and not a different
    one. De-duplicated by name, because orx is a feature id and an install-time
    row at once. DEPS is read first and as a whole, so a caller that swaps the
    table (the Windows report test) still decides that set."""
    rows = list(DEPS)
    names = {d["name"] for d in rows}
    for dep in feature_deps(only=only):
        if dep["name"] not in names:
            rows.append(dep)
            names.add(dep["name"])
    return rows


def _dep_pretty(dep):
    cmd = dep["cmd"]
    return " ".join(cmd[2:]) if cmd[0] in ("sh", "bash") else " ".join(cmd)


def _dep_argv(dep):
    """The argv one installer runs with: a `sh -c`/`bash -c` pipeline runs
    under `pipefail` and with a `--max-time` on each curl. Without pipefail a
    refused `curl | sh` exits 0 (the empty `sh` succeeds) and the failure read
    as a PATH problem (audit M-9, GAP-06). Debian's dash has no pipefail, so
    the pipeline runs under bash whenever bash exists; a bare `sh` tries the
    option and goes on without it."""
    cmd = list(dep["cmd"])
    if len(cmd) == 3 and cmd[0] in ("sh", "bash") and cmd[1] == "-c":
        script = re.sub(r"\bcurl ", "curl --max-time %d " % CURL_MAX_TIME, cmd[2])
        if shutil.which("bash"):
            return ["bash", "-o", "pipefail", "-c", script]
        return [cmd[0], "-c",
                "(set -o pipefail) 2>/dev/null && set -o pipefail; " + script]
    return cmd


# The id `--devtools` is sugar for. It is a feature id, not a server name: one
# key per feature answers wire/install/report, and a flag that named the server
# instead would be a second way to say the same thing.
DEVTOOLS_FEATURE = "mcp-chrome-devtools"


def dep_state(dep):
    """A feature's dependency state as one line, and whether it is met.

    Shared by `--features` and by the enable step, so the two cannot describe the
    same probe differently, and the command is in the line because knowing the
    probe fails is useless without knowing what would fix it."""
    if not dep:
        return "no dependency", True
    if dep["probe"]():
        return "dep met", True
    text = "dep unmet (%s)" % (dep.get("why") or "its installer is not recorded")
    if dep.get("cmd"):
        text += "; would run: %s" % _dep_pretty(dep)
    return text, False


def features_report():
    """Every feature id with its default, its selection and its dependency.

    One table answers all three questions a feature asks: is it wired unless the
    user says otherwise, is it wired on this machine, and can it run at all -
    which is why the dependency state is printed here and not only inside an
    enable."""
    selected = set(tezgah_apps.selected_ids(selection()))
    stored = tp.config().get("features")
    print("features (%s; %s):"
          % (tp.CONFIG, "features=" + ",".join(stored) if isinstance(stored, list)
             else "no features key = the declared defaults"))
    for row in tezgah_apps.REGISTRY:
        state, met = dep_state(row.get("dep"))
        print("  %s %-20s default %-3s  selected %-3s  %s"
              % (OK if met else NO, row["id"],
                 "on" if row["default"] else "off",
                 "on" if row["id"] in selected else "off", state))


def parse_feature_ids(raw):
    """Ids from a comma/space list; None when one of them is unknown.

    The contract `parse_hosts` already has: an unknown token refuses the whole
    request rather than persisting half of it."""
    picked = []
    for tok in re.split(r"[,\s]+", (raw or "").strip()):
        if not tok:
            continue
        if tok not in tezgah_apps.IDS:
            return None
        if tok not in picked:
            picked.append(tok)
    return picked or None


def select_features(enabled, disabled, hosts, dry_run, deps_off=False):
    """Persist an --enable/--disable and bring the recorded hosts with it.

    `hosts` is what config.json records - the install's own answer - so a
    selection change reaches every armed host without re-asking which those are.
    Only MCP rows move: each writer converges on the selection and leaves every
    other key alone. An enable satisfies its feature's dependency in the same
    run; a disable runs no dependency command at all, because uninstalling a tool
    the user may still want is not what turning a server off means - only a file
    tezgah itself made for the row (`remove`, an embedding model) goes with it.
    Returns the exit code."""
    base = tezgah_apps.selected_ids(selection())
    keep = set(base) | set(enabled or ())
    keep -= set(disabled or ())
    global FEATURES
    FEATURES = list(tezgah_apps.selected_ids(keep))
    print("features: %s" % (", ".join(FEATURES) or "none"))
    still = []
    if enabled and not deps_off:
        # The dependency half of the enable side only. `only` keeps this to the
        # enabled ids: enabling one feature must not install every missing tool
        # on the machine.
        still = install_deps(dry_run=dry_run, only=set(enabled))
    elif enabled:
        # --no-deps (and TEZGAH_NO_DEPS) covers this step too, or the escape
        # hatch would not reach the one path that installs on demand. The state
        # is still printed, so a skipped check is never a silent one.
        for row in tezgah_apps.REGISTRY:
            if row["id"] in enabled:
                print("  --  %s: %s (deps skipped)"
                      % (row["id"], dep_state(row.get("dep"))[0]))
    if dry_run:
        # Nothing is written under --dry-run, the selection included: a preview
        # that persisted the choice would be the one step the flag did not cover.
        print("  --  --dry-run: %s and the host files were not written" % tp.CONFIG)
    else:
        print("%s %s" % (OK if save_features(FEATURES) else "  --  ", tp.CONFIG))
        for h in hosts:
            INSTALLERS[h]()
        # A row that owns a file tezgah made (an embedding model) takes it with
        # it; a row whose dependency is a tool the user installed keeps it.
        for row in tezgah_apps.REGISTRY:
            if row["id"] in (disabled or ()) and row.get("remove") and row["remove"]():
                print("%s %s: removed its file" % (OK, row["id"]))
    features_report()
    return 1 if still or REFUSED else 0


# How each optional tool is installed on Windows, by channel: the package
# manager that carries it and the command to run, or None with the reason no
# channel exists. A locked-down Windows account has no `sh` and no `curl | sh`
# pipeline, so the two tools whose only vendor installer is one are named as
# having no channel there instead of being passed over in silence.
WINDOWS_DEPS = {
    "orx": (None, "its installer is a POSIX `curl | sh` script"),
    "cursor-agent": (None, "the cursor-agent installer is Linux and macOS only"),
    "pnpm": ("npm", "npm install -g pnpm"),
    "dsh": ("npm", "npx -y @deepseek-ai/dsh plugin --profile web --version"),
}


def _install_deps_windows(only=None):
    """Report, per missing tool, the channel that would install it on Windows.

    The POSIX path runs the vendor's own installer; Windows has none of those
    pipelines to run, so this names the channel - npm, or the reason there is
    none - for every tool that is missing. It returns the names that have a
    channel here (the POSIX contract: what is still missing fails the run); a
    tool with no installer on this platform is reported with its manual step
    and does not fail the run, or every Windows install would exit 1."""
    still = []
    rows = dep_rows(only)
    for dep in rows:
        if dep["probe"]():
            continue
        # A feature-owned row has no entry here until one is recorded; naming the
        # channel as absent is the honest answer, and a KeyError would take the
        # whole install down instead.
        channel, how = WINDOWS_DEPS.get(
            dep["name"], (None, "no Windows channel is recorded for this tool"))
        if channel:
            print("%s %s missing (%s); install with %s: %s"
                  % (NO, dep["name"], dep["why"], channel, how))
        else:
            print("%s %s unavailable on Windows (%s); no Windows channel: %s - "
                  "install it by hand if you need it"
                  % ("  --  ", dep["name"], dep["why"], how))
        # Counted (non-zero exit) only with a channel on this platform, and a
        # host CLI only when asked for (`--host-deps`, opt-in everywhere).
        if channel and (HOST_DEPS or not dep.get("host")):
            still.append(dep["name"])
    return still


def _augment_path():
    """Let a just-installed tool be found without a new shell."""
    for d in (LOCAL_BIN, os.path.join(HOME, ".cargo", "bin")):
        parts = os.environ.get("PATH", "").split(os.pathsep)
        if os.path.isdir(d) and d not in parts:
            os.environ["PATH"] = d + os.pathsep + os.environ.get("PATH", "")


def _dep_log(name, cmd):
    try:
        os.makedirs(tp.CONFIG_DIR, exist_ok=True)
        with open(os.path.join(tp.CONFIG_DIR, "install.log"), "a", encoding="utf-8") as fh:
            fh.write("%s %s: %s\n"
                     % (datetime.datetime.now().isoformat(timespec="seconds"), name, cmd))
    except OSError:
        pass


def install_deps(dry_run=False, only=None):
    """Install the missing optional tools with their own installers.

    Auto (no prompt), no sudo, idempotent, each installer bounded by
    DEP_TIMEOUT. `only` names features whose own rows are added to the
    install-time table, which is how `--enable <id>` satisfies that feature's
    runtime without pulling the runtime of every feature nobody enabled. A host
    CLI row runs only under `--host-deps`; otherwise its command is printed and
    it is not counted. Returns the names still missing, which the callers turn
    into a non-zero exit."""
    print("\ndependencies:")
    if os.name == "nt":
        return _install_deps_windows(only)
    _augment_path()
    missing = [d for d in dep_rows(only) if not d["probe"]()]
    if not missing:
        print("%s all optional tools present" % OK)
        return []
    still = []
    for dep in missing:
        name, pretty = dep["name"], _dep_pretty(dep)
        if dep.get("host") and not HOST_DEPS:
            print("%s %s missing (%s); a third-party host CLI is installed only "
                  "with --host-deps - or run it yourself: %s"
                  % ("  --  ", name, dep["why"], pretty))
            continue
        helper = next((h for h in dep["needs"] if not shutil.which(h)), None)
        if helper:
            print("%s %s missing (%s) but `%s` is not on PATH - install that first"
                  % (NO, name, dep["why"], helper))
            still.append(name)
            continue
        if dry_run:
            print("%s %s missing (%s); would run: %s" % ("  --  ", name, dep["why"], pretty))
            continue
        print("%s %s missing (%s); running: %s" % ("  --  ", name, dep["why"], pretty))
        _dep_log(name, pretty)
        try:
            code = _run_bounded(_dep_argv(dep), DEP_TIMEOUT)
        except subprocess.TimeoutExpired:
            print("%s %s: installer still running after %d s (a stalled network?) "
                  "- stopped; re-run when the network answers"
                  % (NO, name, DEP_TIMEOUT))
            still.append(name)
            continue
        except OSError as exc:
            print("%s %s: %s" % (NO, name, exc))
            still.append(name)
            continue
        _augment_path()
        if dep["probe"]():
            print("%s %s installed" % (OK, name))
        elif code:
            print("%s %s: installer failed with exit %d; its own error is printed "
                  "above (a new shell will not fix it)"
                  % (NO, name, code))
            still.append(name)
        else:
            print("%s %s: installer exited 0 but `%s` is still not found; open a "
                  "new shell (PATH) and re-run" % (NO, name, name))
            still.append(name)
    return still


def _run_bounded(argv, timeout):
    """Run one installer and return its exit code; TimeoutExpired past
    `timeout`.

    `subprocess.run(timeout=)` kills only the direct child: in `curl | bash` that
    is the outer bash, and the piped installer kept running with nobody waiting
    for it (review of audit M-9). The installer starts in a session of its own,
    so its whole process group - every pipe member and what they spawned - is
    killed together. Only the POSIX path calls this (Windows reports channels).

    Any exit from the wait - the timeout, or a Ctrl-C (KeyboardInterrupt) - kills
    the group first: the new session puts the installer outside the terminal's
    process group, so the interrupt no longer reaches it and it would be left
    running as an orphan."""
    proc = subprocess.Popen(argv, start_new_session=True)
    try:
        return proc.wait(timeout=timeout)
    except BaseException:
        try:
            os.killpg(proc.pid, signal.SIGKILL)
        except OSError:
            pass
        proc.wait()
        raise



# ---------------------------------------------------------------- uninstall ----

def is_tezgah_link(path):
    """A symlink is tezgah-managed when it resolves inside this checkout,
    inside the install prefix, or into the farm.

    Both install roots count: an install unpacked from a release tarball links
    into <prefix>/<version>/, a checkout install links into the checkout.
    The farm counts because some entries hop through it - `~/.codex/bin/consult`
    resolves to `~/.config/tezgah/bin/consult`, which itself resolves here - and
    uninstall sweeps the farm first, so by the time a host uninstaller judges
    the hop the middle link is gone and a checkout-only answer reads the hop as
    a dangling stranger. Recognising only the checkout orphaned every link at a
    version flip - uninstall kept them, and the report called tezgah's own
    wiring the user's."""
    if not os.path.islink(path):
        return False
    target = os.path.realpath(path)
    return any(target == root or target.startswith(root + os.sep)
               for root in (os.path.realpath(HERE), INSTALL_PREFIX, tp.BIN_DIR))


def is_tezgah_entry(path):
    """True when `path` is tezgah's own wiring: a link into this tree or the
    install prefix, or an entry `link()` materialised where a symlink was
    refused. One predicate, because every check that asks "is this ours" would
    otherwise answer differently on a Windows account."""
    return is_tezgah_link(path) or is_tezgah_copy(path)


def unlink_tezgah(path):
    """Remove tezgah's own wiring - a link, or an entry this installer
    materialised - and leave anything else untouched."""
    if os.path.islink(path):
        if not is_tezgah_link(path):
            print("%s kept %s (not a tezgah link)" % (NO, path))
            return False
        os.unlink(path)
    elif is_tezgah_copy(path):
        remove_materialised(path)
    else:
        return False
    print("%s removed %s" % (OK, path))
    return True


def unlink_dir(d):
    """Remove every tezgah symlink directly inside d (non-recursive)."""
    try:
        names = sorted(os.listdir(d))
    except OSError:
        return
    for name in names:
        unlink_tezgah(os.path.join(d, name))


def drop_managed_hook_entries(path):
    """Remove only tezgah's own entries from a host hooks.json."""
    data = read_json(path, None)
    if not data:
        print("%s no %s" % (OK, path))
        return
    changed = False
    kept_events = {}
    for ev, arr in (data.get("hooks") or {}).items():
        kept = [e for e in arr if "tezgah" not in json.dumps(e)]
        changed = changed or len(kept) != len(arr)
        if kept:
            kept_events[ev] = kept
    if not changed:
        print("%s no tezgah hook entries in %s" % (OK, path))
        return
    if kept_events:
        data["hooks"] = kept_events
    else:
        data.pop("hooks", None)
    write_json(path, data)
    print("%s removed tezgah hook entries from %s" % (OK, path))


def remove_managed_block(path, start="# tezgah:start", end="# tezgah:end"):
    """Drop the tezgah-delimited block, leaving every other line intact."""
    try:
        with open(path, encoding="utf-8") as fh:
            lines = fh.read().splitlines()
    except OSError:
        print("%s no %s" % (OK, path))
        return
    out, skip, changed = [], False, False
    for ln in lines:
        stripped = ln.strip()
        if stripped.startswith(start):
            skip, changed = True, True
            continue
        if stripped.startswith(end):
            skip = False
            continue
        # the header line set_managed_block writes for a dsh patch layer is
        # tezgah's own: an uninstall that kept it left a file whose only
        # content named a tool that is no longer there
        if not skip and not stripped.startswith(
                "# dsh home patch layer - tezgah-setup manages"):
            out.append(ln)
        elif stripped.startswith("# dsh home patch layer"):
            changed = True
    if not changed:
        print("%s no tezgah block in %s" % (OK, path))
        return
    while out and not out[-1].strip():
        out.pop()
    # A dsh patch layer must stay a top-level YAML array; a file left holding
    # only comments parses to null and the next dsh boot fails on it.
    if not any(ln.strip() and not ln.strip().startswith("#") for ln in out):
        out.append("[]")
    with open(path, "w", encoding="utf-8") as fh:
        fh.write("\n".join(out) + "\n")
    print("%s removed tezgah block from %s" % (OK, path))


def uninstall_common():
    print("\ncommon:")
    unlink_dir(tp.BIN_DIR)
    removed = tezgah_agents.cleanup()
    if removed:
        print("%s removed %d generated repo agent file(s)" % (OK, removed))


def _is_tezgah_marketplace_row(row):
    """True when a known_marketplaces.json entry points into a tezgah tree.

    A marketplace whose source is the checkout or the install prefix exists to
    serve the tezgah plugin; removing its registry row never removes the tree it
    names."""
    if not isinstance(row, dict):
        return False
    src = (row.get("source") or {}).get("path") or ""
    loc = row.get("installLocation") or ""
    for value in (src, loc):
        if not value:
            continue
        real = os.path.realpath(expand(value))
        for root in (os.path.realpath(HERE), INSTALL_PREFIX):
            if real == root or real.startswith(root + os.sep):
                return True
    return False


def remove_plugin_copies():
    """Remove the Claude plugin copy and its registry rows: the wiring that
    outlived every other removal.

    Claude runs the plugin from the COPY under ~/.claude/plugins/cache and reads
    installed_plugins.json to keep loading it, so an uninstall that stopped at
    the symlinks left Claude applying tezgah's rules with nothing left in any
    report. The copy is wholly tezgah-generated - `sync()` empties and rewrites
    it on every run - so removing it takes nothing the user authored; the
    checkout itself is never a target."""
    data = read_json(INSTALLED_PLUGINS, None)
    dropped = []
    if isinstance(data, dict) and isinstance(data.get("plugins"), dict):
        dropped = [k for k in list(data["plugins"])
                   if k.split("@", 1)[0] == TEZGAH_MCP_NAME]
        for key in dropped:
            del data["plugins"][key]
        if dropped:
            write_json(INSTALLED_PLUGINS, data)
            print("%s removed %s from %s"
                  % (OK, ", ".join(dropped), INSTALLED_PLUGINS))
        # A marketplace stays only while something still installs from it: the
        # rows just dropped named theirs, and one whose source is a tezgah tree
        # has nothing left to serve.
        refs = {k.split("@", 1)[1] for k in data["plugins"] if "@" in k}
        markets = {k.split("@", 1)[1] for k in dropped if "@" in k}
        known = read_json(KNOWN_MARKETPLACES, None)
        if isinstance(known, dict):
            stale = [name for name in markets
                     if name not in refs and _is_tezgah_marketplace_row(known.get(name))]
            for name in stale:
                del known[name]
            if stale:
                write_json(KNOWN_MARKETPLACES, known)
                print("%s removed marketplace row(s) %s from %s"
                      % (OK, ", ".join(stale), KNOWN_MARKETPLACES))
    for target in plugin_copies():
        real, here = os.path.realpath(target), os.path.realpath(HERE)
        if real == here or here.startswith(real + os.sep):
            print("%s kept %s (it holds this checkout)" % (NO, target))
            continue
        try:
            shutil.rmtree(target)
        except OSError as exc:
            print("%s %s (%s)" % (NO, target, exc))
            continue
        print("%s removed plugin copy %s" % (OK, target))
    # the manifest pair this installer rendered into the tree (never the
    # maintainer's own, which carries another marketplace name)
    rendered = os.path.join(HERE, ".claude-plugin")
    if read_json(os.path.join(rendered, "marketplace.json"), {}).get("name") \
            == CLAUDE_MARKETPLACE:
        shutil.rmtree(rendered, ignore_errors=True)
        print("%s removed %s" % (OK, rendered))


def sweep_legacy_switches():
    """Remove the kill switches the pre-multi-host setup wrote to ~/.claude.

    OFF_DIRS still reads that directory, so a switch left behind keeps its rule
    silent after a reinstall, with no file in the canonical place saying why."""
    legacy = os.path.join(HOME, ".claude")
    for name in OFF_SWITCH_NAMES:
        path = os.path.join(legacy, name)
        if os.path.isfile(path):
            try:
                os.remove(path)
            except OSError as exc:
                print("%s %s (%s)" % (NO, path, exc))
                continue
            print("%s removed legacy switch %s" % (OK, path))


def _drop_state_entry(path):
    try:
        shutil.rmtree(path) if os.path.isdir(path) and not os.path.islink(path) \
            else os.remove(path)
    except OSError as exc:
        print("%s %s (%s)" % (NO, path, exc))
        return
    print("%s removed %s" % (OK, path))


def remove_generated_state(full):
    """Take tezgah's state back: the cache dirs always, the config dir's
    generated contents when the uninstall is full.

    `full` means the run covers every host config.json records - the armed set.
    A partial uninstall keeps the config: the hosts still armed read their roots
    and feature selection from it at runtime, and deleting it would degrade
    wiring this run did not touch. `adopted/` and any entry that is not one of
    tezgah's generated names survive in both cases."""
    for d in (tp.CACHE, tp.fallback_cache()):
        if os.path.isdir(d):
            shutil.rmtree(d, ignore_errors=True)
            print("%s removed %s" % (OK, d))
    if not full:
        return
    try:
        names = sorted(os.listdir(tp.CONFIG_DIR))
    except OSError as exc:
        print("%s %s (%s)" % (NO, tp.CONFIG_DIR, exc))
        return
    kept = []
    for name in names:
        path = os.path.join(tp.CONFIG_DIR, name)
        if name in ("adopted", "backups"):
            kept.append((path, "predecessor originals --adopt moved here"
                         if name == "adopted" else "host-file backups, for a manual restore"))
            continue
        if name in GENERATED_STATE or name.endswith((".off", "-off")) \
                or (name.endswith(".tezgah-bak")
                    and name[:-len(".tezgah-bak")] in GENERATED_STATE) \
                or ((m := BACKUP_RE.fullmatch(name)) and m.group(1) in GENERATED_STATE):
            if name == "bin":
                unlink_dir(path)  # a user's own file in the farm is not tezgah's
                if os.path.isdir(path) and os.listdir(path):
                    kept.append((path, "holds files tezgah did not write"))
                    continue
            _drop_state_entry(path)
        else:
            kept.append((path, "not a tezgah-generated name"))
    for path, why in kept:
        print("%s kept %s (%s)" % (NO, path, why))
    if os.path.isdir(tp.CONFIG_DIR) and not os.listdir(tp.CONFIG_DIR):
        os.rmdir(tp.CONFIG_DIR)
        print("%s removed %s" % (OK, tp.CONFIG_DIR))


def remove_install_tree():
    """Remove the versioned install tree: every version and the `current` flip.

    The tree is tezgah's own product, unpacked by packaging/upgrade.sh and
    serving nothing once the wiring is gone - leaving it behind left a full
    `bin/tezgah-setup` on disk that a stray PATH hit could re-arm. Only a
    recognizable layout goes: version dirs that carry `bin/tezgah-setup` plus
    the `current` link into them. When this process runs from inside the tree,
    its own version dir goes last, with a warning - on POSIX the running script
    survives the removal of its file."""
    if not os.path.isdir(INSTALL_PREFIX):
        return
    running = running_prefix()
    self_removal = bool(running) and os.path.realpath(running) == \
        os.path.realpath(INSTALL_PREFIX)
    if self_removal:
        print("%s this installer runs from %s; its tree goes last" % (NO, HERE))
    try:
        entries = os.listdir(INSTALL_PREFIX)
    except OSError as exc:
        print("%s %s (%s)" % (NO, INSTALL_PREFIX, exc))
        return
    versions = [name for name in sorted(entries)
                if os.path.isfile(os.path.join(INSTALL_PREFIX, name, "bin",
                                               "tezgah-setup"))
                and not is_link(os.path.join(INSTALL_PREFIX, name))]
    if not versions:
        print("%s kept %s (no tezgah version tree recognised)" % (NO, INSTALL_PREFIX))
        return
    current = os.path.join(INSTALL_PREFIX, "current")
    if is_link(current):
        try:
            os.unlink(current)
            print("%s removed %s" % (OK, current))
        except OSError as exc:
            print("%s %s (%s)" % (NO, current, exc))
    for name in versions:
        _drop_state_entry(os.path.join(INSTALL_PREFIX, name))
    try:
        rest = os.listdir(INSTALL_PREFIX)
    except OSError as exc:
        print("%s %s (%s)" % (NO, INSTALL_PREFIX, exc))
        return
    if not rest:
        try:
            os.rmdir(INSTALL_PREFIX)
        except OSError as exc:
            print("%s %s (%s)" % (NO, INSTALL_PREFIX, exc))
            return
        print("%s removed %s" % (OK, INSTALL_PREFIX))
    else:
        print("%s kept %s (holds %s)" % (NO, INSTALL_PREFIX, ", ".join(sorted(rest))))


def _text_clean(path, needle="tezgah"):
    """(True, "") when `path` is gone or carries no `needle`; else the leftover."""
    try:
        with open(path, encoding="utf-8", errors="replace") as fh:
            body = fh.read()
    except OSError:
        return True, ""
    return needle not in body, path


def verify_uninstall(hosts, full):
    """Re-derive the removal from the filesystem alone and print the result.

    This is the proof the run did what it printed: every path the uninstallers
    own is checked for absence (or for the exact residue that is by design), and
    the summary line counts what is left. Returns the number of claims that did
    not hold - 0 is a complete removal."""
    rows = []

    def claim(label, paths):
        left = [p for p in paths if os.path.lexists(p)]
        rows.append((label, left))
        if left:
            print("%s still present: %s" % (NO, ", ".join(left)))
        else:
            print("%s %s" % (OK, label))

    def clean(label, paths, needle="tezgah"):
        left = []
        for p in paths:
            ok, leftover = _text_clean(p, needle)
            if not ok:
                left.append(leftover)
        rows.append((label, left))
        if left:
            print("%s still wired: %s" % (NO, ", ".join(left)))
        else:
            print("%s %s" % (OK, label))

    # common state
    farm = [os.path.join(tp.BIN_DIR, n)
            for n in (os.listdir(tp.BIN_DIR) if os.path.isdir(tp.BIN_DIR) else [])]
    claim("config/bin farm holds no tezgah entry",
          [p for p in farm if is_tezgah_entry(p)])
    claim("materialised ledger gone", [MATERIALISED] if full else [])
    claim("state caches gone", [tp.CACHE, tp.fallback_cache()])
    if full:
        try:
            has_tree = os.path.isdir(INSTALL_PREFIX) and any(
                os.path.isfile(os.path.join(INSTALL_PREFIX, n, "bin", "tezgah-setup"))
                for n in os.listdir(INSTALL_PREFIX))
        except OSError:
            has_tree = False
        claim("install tree gone", [INSTALL_PREFIX] if has_tree else [])
    if "claude" in hosts:
        claim("claude plugin copy gone", plugin_copies())
        registry = read_json(INSTALLED_PLUGINS, {}) or {}
        claim("claude plugin registry has no tezgah row",
              [INSTALLED_PLUGINS] if any(k.split("@", 1)[0] == TEZGAH_MCP_NAME
                                         for k in (registry.get("plugins") or {}))
              else [])
        # the user's own CLAUDE.md may name tezgah; only the block is ours
        clean("claude global CLAUDE.md block gone", [CLAUDE_RULES],
              needle="<!-- tezgah:start")
    if "codex" in hosts:
        clean("codex hooks.json unwired", [os.path.join(CODEX, "hooks.json")])
        claim("codex skills unlinked",
              [os.path.join(CODEX, "skills", s) for s in SKILLS
               if os.path.lexists(os.path.join(CODEX, "skills", s))])
        clean("codex config.toml unwired", [os.path.join(CODEX, "config.toml")])
        claim("codex consult link gone", [os.path.join(CODEX, "bin", "consult")])
        # the user's own AGENTS.md may name tezgah; only the block is ours
        clean("codex global AGENTS.md block gone",
              [os.path.join(CODEX, n) for n in CODEX_RULES],
              needle="<!-- tezgah:start")
    if "opencode" in hosts:
        claim("opencode plugin unlinked",
              [os.path.join(OPENCODE, d, "tezgah.js") for d in ("plugins", "plugin")]
              + [os.path.join(OPENCODE, "tui-plugins", "tezgah-tui.tsx")])
        clean("opencode opencode.json unwired",
              [os.path.join(OPENCODE, "opencode.json")])
        claim("opencode generated routers gone", [SKILL_ROUTER, SKILL_ROUTER_FULL])
    if "cursor" in hosts:
        clean("cursor hooks.json unwired", [os.path.join(CURSOR, "hooks.json")])
        clean("cursor mcp.json unwired", [os.path.join(CURSOR, "mcp.json")])
        clean("cursor cli-config.json unwired",
              [os.path.join(CURSOR, "cli-config.json")])
    if "dsh" in hosts:
        clean("dsh patch layers unwired", [DSH_PATCH, DSH_WEB_PATCH])
        claim("dsh launcher gone", [dsh_launcher()[1]])
    if "omp" in hosts:
        clean("omp RULES.md unwired", [os.path.join(OMP_AGENT, "RULES.md")])
        claim("omp hook script gone",
              [os.path.join(OMP_AGENT, "hooks", "pre", "tezgah-hook.ts")])
        agents = os.path.join(OMP_AGENT, "agents")
        claim("omp subagents gone",
              [os.path.join(agents, n) for n in
               (os.listdir(agents) if os.path.isdir(agents) else [])
               if n[:-len(".md")] in tezgah_agents.OWNED_NAMES and n.endswith(".md")])
        clean("omp mcp.json unwired", [os.path.join(OMP_AGENT, "mcp.json")])
        claim("omp skills unlinked",
              [os.path.join(OMP_AGENT, "skills", s) for s in SKILLS
               if os.path.lexists(os.path.join(OMP_AGENT, "skills", s))])
    if "claude" in hosts:
        clean("claude settings.json unwired",
              [os.path.join(CLAUDE, "settings.json")])
    claim("legacy kill switches gone",
          [os.path.join(HOME, ".claude", n) for n in OFF_SWITCH_NAMES
           if os.path.exists(os.path.join(HOME, ".claude", n))])
    remaining = sum(len(left) for _label, left in rows)
    if remaining:
        print("%s uninstall incomplete: %d tezgah path(s) remain" % (NO, remaining))
    else:
        print("%s uninstall complete: %d checks, nothing tezgah wrote is left"
              % (OK, len(rows)))
    return remaining


def unwire_claude_settings():
    """Remove tezgah's statusLine, attribution and enabledPlugins keys, leaving
    everything else."""
    sp = os.path.join(CLAUDE, "settings.json")
    s = read_json(sp, None)
    if not s:
        return
    changed = False
    if "statusline.py" in json.dumps(s.get("statusLine") or {}):
        s.pop("statusLine", None)
        changed = True
    if s.get("attribution") == {"commit": "", "pr": "", "sessionUrl": False}:
        s.pop("attribution", None)
        changed = True
    enabled = s.get("enabledPlugins")
    for key in [k for k in enabled if k.split("@", 1)[0] == "tezgah"] \
            if isinstance(enabled, dict) else []:
        del enabled[key]
        changed = True
    if changed:
        write_json(sp, s)
        print("%s removed tezgah statusLine/attribution/enabledPlugins from %s (restore from its .tezgah-bak copies under %s if wanted)" % (OK, sp, BACKUP_DIR))


def unwire_opencode_config():
    """Drop tezgah's contract/router paths, skill deny, and TUI plugin spec."""
    p = os.path.join(OPENCODE, "opencode.json")
    c = read_json(p, None)
    if c:
        changed = False
        if c.get("instructions"):
            kept = [i for i in c["instructions"] if "tezgah" not in i]
            if kept != c["instructions"]:
                if kept:
                    c["instructions"] = kept
                else:
                    c.pop("instructions", None)
                changed = True
        perm = c.get("permission")
        if isinstance(perm, dict) and perm.get("skill") == "deny":
            perm.pop("skill")
            if not perm:
                c.pop("permission", None)
            changed = True
        perm = c.get("permission")
        external = perm.get("external_directory") if isinstance(perm, dict) else None
        if isinstance(external, dict):
            kept = {k: v for k, v in external.items()
                    if k not in (os.path.join(HERE, "skills", "**"),
                                 os.path.join(tp.CONFIG_DIR, "bin", "**"))}
            if kept != external:
                if kept:
                    perm["external_directory"] = kept
                else:
                    perm.pop("external_directory")
                    if not perm:
                        c.pop("permission", None)
                changed = True
        comp = c.get("compaction")
        if isinstance(comp, dict) and comp.get("prune") is True:
            c.pop("compaction", None)
            changed = True
        wat = c.get("watcher")
        if isinstance(wat, dict) and isinstance(wat.get("ignore"), list):
            kept = [p for p in wat["ignore"] if p not in OPENCODE_IGNORE]
            if kept != wat["ignore"]:
                if kept:
                    wat["ignore"] = kept
                else:
                    wat.pop("ignore")
                if not wat:
                    c.pop("watcher", None)
                changed = True
        mcp = c.get("mcp")
        if isinstance(mcp, dict):
            for name in app_mcp_names() + [TEZGAH_MCP_NAME]:
                if name in mcp:
                    mcp.pop(name)
                    changed = True
            if not mcp:
                c.pop("mcp", None)
        if changed:
            write_json(p, c)
            print("%s removed tezgah instructions/skill-deny from %s" % (OK, p))
    t = os.path.join(OPENCODE, "tui.json")
    tj = read_json(t, None)
    if tj and tj.get("plugin"):
        kept = [x for x in tj["plugin"]
                if "tezgah-tui" not in (x if isinstance(x, str) else x[0])]
        if kept != tj["plugin"]:
            if kept:
                tj["plugin"] = kept
            else:
                tj.pop("plugin", None)
            write_json(t, tj)
            print("%s removed tezgah TUI plugin from %s" % (OK, t))


def uninstall_claude():
    print("\nclaude:")
    unlink_tezgah(os.path.join(CLAUDE, "statusline.py"))
    sweep_claude_workflows()
    for b in ("consult", "codegen", "tezgah-render-table"):
        unlink_tezgah(os.path.join(CLAUDE, "bin", b))
    unwire_claude_settings()
    drop_claude_mcp_row()
    strip_managed_md(CLAUDE_RULES)


def drop_claude_mcp_row():
    """Remove tezgah's own MCP row from every installed plugin copy.

    Claude's MCP channel is the copy's `.mcp.json`, which `sync()` renders - so
    this is the one host whose row is not removed from a config under
    ~/.claude, and the one host an uninstall would otherwise leave wired. Only
    tezgah's own name is dropped: the graph row and the app servers are written
    by the same file, and the other five hosts keep codegraph through an
    uninstall too (`test_setup` pins that), so removing it here would make
    Claude the one host an uninstall changed the meaning of."""
    for target in plugin_copies():
        path = os.path.join(target, MCP_JSON)
        cfg = read_json(path, None)
        servers = (cfg or {}).get("mcpServers")
        if not isinstance(servers, dict) or TEZGAH_MCP_NAME not in servers:
            continue
        servers.pop(TEZGAH_MCP_NAME)
        write_json(path, cfg)
        print("%s removed the tezgah MCP server from %s" % (OK, path))


def uninstall_codex():
    print("\ncodex:")
    for s in SKILLS:
        unlink_tezgah(os.path.join(CODEX, "skills", s))
    drop_managed_hook_entries(os.path.join(CODEX, "hooks.json"))
    strip_toml_mcp(os.path.join(CODEX, "config.toml"),
                   app_mcp_names() + [TEZGAH_MCP_NAME])
    unlink_tezgah(os.path.join(CODEX, "bin", "consult"))
    # both names: the override may have appeared, or gone, since the install
    for name in CODEX_RULES:
        strip_managed_md(os.path.join(CODEX, name))


def uninstall_opencode():
    print("\nopencode:")
    for s in SKILLS:
        unlink_tezgah(os.path.join(OPENCODE, "skills", s))
    for d in ("plugins", "plugin"):
        unlink_tezgah(os.path.join(OPENCODE, d, "tezgah.js"))
    unlink_tezgah(os.path.join(OPENCODE, "tui-plugins", "tezgah-tui.tsx"))
    unwire_opencode_config()
    for path in (SKILL_ROUTER, SKILL_ROUTER_FULL):
        try:
            os.remove(path)
            print("%s removed %s" % (OK, path))
        except OSError:
            print("%s no %s" % (OK, path))


def uninstall_cursor():
    print("\ncursor:")
    for s in SKILLS:
        unlink_tezgah(os.path.join(CURSOR, "skills", s))
    drop_managed_hook_entries(os.path.join(CURSOR, "hooks.json"))
    mpath = os.path.join(CURSOR, "mcp.json")
    mcfg = read_json(mpath, None)
    if mcfg and isinstance(mcfg.get("mcpServers"), dict):
        removed = [n for n in app_mcp_names() + [TEZGAH_MCP_NAME]
                   if n in mcfg["mcpServers"]]
        for n in removed:
            mcfg["mcpServers"].pop(n)
        if removed:
            write_json(mpath, mcfg)
            print("%s removed app MCP server(s) from %s" % (OK, mpath))
    cc = os.path.join(CURSOR, "cli-config.json")
    cfg = read_json(cc, None)
    if isinstance(cfg, dict) and "tezgah-statusline" in json.dumps(
            cfg.get("statusLine") or {}):
        cfg.pop("statusLine", None)
        write_json(cc, cfg)
        print("%s removed tezgah statusLine from %s" % (OK, cc))


def uninstall_dsh():
    print("\ndsh:")
    for s in SKILLS:
        unlink_tezgah(os.path.join(DSH, "skills", s))
    remove_managed_block(DSH_PATCH)
    if os.path.isfile(os.path.join(DSH_WEB, "package.json")):
        remove_managed_block(DSH_WEB_PATCH)
        dsh_run(["plugin", "--profile", "web", "remove", DSH_STATUSLINE])
    unlink_tezgah(dsh_launcher()[1])


def uninstall_omp():
    print("\nomp:")
    for s in SKILLS:
        unlink_tezgah(os.path.join(OMP_AGENT, "skills", s))
    agents_dir = os.path.join(OMP_AGENT, "agents")
    if os.path.isdir(agents_dir):
        for name in os.listdir(agents_dir):
            if name.endswith(".md") and name[:-len(".md")] in tezgah_agents.OWNED_NAMES:
                os.remove(os.path.join(agents_dir, name))
                print("%s removed %s" % (OK, os.path.join(agents_dir, name)))
    hook = os.path.join(OMP_AGENT, "hooks", "pre", "tezgah-hook.ts")
    if os.path.exists(hook) and not os.path.islink(hook):
        os.remove(hook)
        print("%s removed %s" % (OK, hook))
    else:
        unlink_tezgah(hook)
    unregister_omp(hook)
    mcp_path = os.path.join(OMP_AGENT, "mcp.json")
    cfg = read_json(mcp_path, None)
    if isinstance(cfg, dict):
        servers = cfg.get("mcpServers")
        if isinstance(servers, dict):
            for name in ["codegraph", TEZGAH_MCP_NAME] + app_mcp_names():
                servers.pop(name, None)
            if not servers:
                cfg.pop("mcpServers", None)
        # $schema was written by install_omp and nothing else: a file left
        # holding only it would read as a wired-but-empty registration.
        if cfg.get("$schema") == OMP_MCP_SCHEMA:
            cfg.pop("$schema", None)
        if cfg:
            write_json(mcp_path, cfg)
            print("%s dropped tezgah servers from %s" % (OK, mcp_path))
        else:
            os.remove(mcp_path)
            print("%s removed %s (nothing left but tezgah's keys)" % (OK, mcp_path))
    strip_managed_md(os.path.join(OMP_AGENT, "RULES.md"))


UNINSTALLERS = {"claude": uninstall_claude, "codex": uninstall_codex,
                "opencode": uninstall_opencode, "cursor": uninstall_cursor,
                "dsh": uninstall_dsh, "omp": uninstall_omp}


def uninstall(hosts, dry_run=False):
    """Remove everything tezgah installed, then prove the removal.

    The first thing a FULL run does is stand the tool gate down
    (`pretooluse-off`): an uninstall is itself a stream of destructive
    commands, and a gate left armed over them would turn the user's own
    teardown into a series of refusals. A partial run leaves the switch alone,
    because the gate still guards the hosts that stay armed. A FULL run - one
    covering every host config.json records as armed - then takes the state with
    it: the generated config files and kill switches, both cache dirs, the Claude
    plugin copy with its registry rows, and the versioned install tree. Nothing
    tezgah wrote outlives the command, and the verify pass at the end re-derives
    that from the disk.

    What never goes, in any run: the user's own files, the host-file backups
    under `BACKUP_DIR`, the `adopted/` predecessor snapshots, and every
    repository's `.tezgah/` research state. A partial run (some armed hosts
    stay) also keeps config.json and the install tree, because the hosts still
    armed read both at runtime."""
    armed = tp.config().get("hosts") or []
    full = not armed or set(hosts) >= set(armed)
    if dry_run:
        print("uninstall preview (nothing written): hosts=%s (%s run)"
              % (", ".join(hosts) or "none detected",
                 "full" if full else "partial"))
        print("  the removal itself runs without --dry-run: hooks, skills, MCP")
        print("  rows, status line, launchers, the Claude plugin copy and its")
        print("  registry rows%s - and the gate stands down first"
              % (", the config state, the caches and the install tree"
                 if full else ""))
        return 0
    mkdirp(tp.CONFIG_DIR)
    stand_down = os.path.join(tp.CONFIG_DIR, "pretooluse-off")
    # H-2 (audit 2026-10-02): `pretooluse-off` is a global switch, so a partial
    # run that wrote it disarmed the gate for every host that stays armed. Only a
    # full run stands the gate down; a partial run never touches the file, which
    # also keeps a switch the user set themselves (the f38423b version wrote the
    # file and then deleted it, taking the user's own switch with it).
    # The text is the switch latch's carve-out (tezgah_paths.STAND_DOWN): a
    # session that began before this run ignores a switch made mid-session, and
    # this one is made mid-session on purpose.
    if full:
        with open(stand_down, "w", encoding="utf-8") as fh:
            fh.write(tp.STAND_DOWN)
        print("%s gate stood down (%s); this session will not be asked again"
              % (OK, stand_down))
    else:
        print("%s gate stays armed for the hosts this run does not touch" % OK)
    print("uninstalling for: %s (%s run)\n"
          % (", ".join(hosts) or "none detected", "full" if full else "partial"))
    uninstall_common()
    for h in hosts:
        UNINSTALLERS[h]()
    if "codex" in hosts and "cursor" in (armed or []) and "cursor" not in hosts:
        print("\ncursor (its skills came through ~/.codex/skills):")
        link_cursor_skills()
    if "claude" in hosts:
        print("\nclaude plugin copy:")
        remove_plugin_copies()
    remove_generated_state(full)
    sweep_legacy_switches()
    if full:
        remove_install_tree()
    elif armed:
        rest = sorted(set(armed) - set(hosts))
        print("\n%s still armed: %s keeps its config and the install tree"
              % (NO, ", ".join(rest)))
    remaining = verify_uninstall(hosts, full)
    print("\nrestart each host so in-memory wiring unloads.")
    pred = predecessors()
    if pred:
        for p in pred:
            print("?    %s" % p)
        print("predecessor wiring is still present; `tezgah-setup --adopt` "
              "retires it.")
    # Only a git checkout has a dev config to explain: an npm or release tree
    # that happens to carry the file is not the source tree, and the note told
    # an npm user about a checkout they do not have (audit L-12, ENV-10).
    dev_mcp = os.path.join(HERE, MCP_JSON)
    if os.path.exists(os.path.join(HERE, ".git")) and TEZGAH_MCP_NAME in json.dumps(
            read_json(dev_mcp, {}).get("mcpServers", {})):
        print("note: this checkout's own %s registers the tezgah MCP server for "
              "sessions run inside the checkout - it is the source tree's dev "
              "config, not an install artifact." % MCP_JSON)
    return 0 if remaining == 0 else 1


# ------------------------------------------------------------------ adopt ----

def _move(path, dest_dir):
    if not os.path.exists(path):
        return False
    mkdirp(dest_dir)
    shutil.move(path, os.path.join(dest_dir, os.path.basename(path)))
    return True


def adopt():
    """Retire the pre-tezgah wiring: the Codex projects-harness, the ~/.claude
    cbm-* hook files an older harness wrote, their settings.json entries, and
    the projects-harness marker block in a root's AGENTS.md. Nothing is deleted
    - it is moved under ~/.config/tezgah/adopted/<timestamp>/."""
    stamp = datetime.datetime.now().strftime("%Y%m%d-%H%M%S")
    dest = os.path.join(tp.CONFIG_DIR, "adopted", stamp)
    print("adopt: moving predecessor wiring to %s\n" % dest)

    # Codex: projects-harness dir + its hooks.json entries
    print("%s projects-harness" % (OK if _move(os.path.join(CODEX, "projects-harness"),
                                               dest) else NO))
    path = os.path.join(CODEX, "hooks.json")
    data = read_json(path, None)
    if data:
        for ev, arr in list((data.get("hooks") or {}).items()):
            arr[:] = [e for e in arr
                      if "projects-harness" not in json.dumps(e)
                      and "Code discovery: prefer" not in json.dumps(e)]
        data["hooks"] = {ev: arr for ev, arr in (data.get("hooks") or {}).items() if arr}
        if not data["hooks"]:
            data.pop("hooks", None)
        write_json(path, data)
        print("%s cleaned %s" % (OK, path))

    # Claude: the predecessor harness's cbm-* hook scripts and the settings.json
    # entries that call them. Those filenames are the files on disk, not this
    # engine's name, so they are moved aside under their own spelling.
    for name in ("cbm-code-discovery-gate", "cbm-session-reminder", "cbm-subagent-reminder"):
        print("%s ~/.claude/hooks/%s" % (OK if _move(os.path.join(CLAUDE, "hooks", name),
                                                     dest) else NO, name))
    # Codex: the old bin shims that exec'd projects-harness
    for name in ("codex-harness-status", "consult"):
        f = os.path.join(CODEX, "bin", name)
        if os.path.isfile(f) and not os.path.islink(f):
            try:
                # another tool's bytes: this only probes for a marker, so a
                # non-UTF-8 byte reads as absent instead of aborting the run
                stale = "projects-harness" in open(f, encoding="utf-8", errors="replace").read()
            except OSError:
                stale = False
            if stale:
                print("%s ~/.codex/bin/%s" % (OK if _move(f, dest) else NO, name))
    sp = os.path.join(CLAUDE, "settings.json")
    settings = read_json(sp, None)
    if settings:
        changed = False
        for ev, arr in (settings.get("hooks") or {}).items():
            kept = []
            for entry in arr:
                hs = entry.get("hooks")
                if isinstance(hs, list):
                    before = len(hs)
                    hs[:] = [h for h in hs if "cbm-" not in h.get("command", "")]
                    changed = changed or len(hs) != before
                    if not hs:
                        continue
                kept.append(entry)
            arr[:] = kept
        if changed:
            settings["hooks"] = {ev: arr for ev, arr in (settings.get("hooks") or {}).items() if arr}
            if not settings["hooks"]:
                settings.pop("hooks", None)
            write_json(sp, settings)
            print("%s cleaned cbm hook entries from %s" % (OK, sp))
        else:
            print("%s no cbm hook entries in %s" % (OK, sp))
    # Roots: the predecessor's AGENTS.md marker points every session at a
    # POLICY.md inside ~/.codex/projects-harness, so once the harness moves the
    # block is a standing dead pointer. Adopt moves, never deletes: the original
    # file goes to the snapshot first, then the cleaned text is written back.
    for agents in _marker_agents_files():
        try:
            with open(agents, encoding="utf-8") as fh:
                body = fh.read()
        except OSError:
            continue
        if not _move(agents, dest):
            continue
        kept = HARNESS_MARKER_RE.sub("", body).strip()
        if kept:
            with open(agents, "w", encoding="utf-8") as fh:
                fh.write(kept + "\n")
            print("%s stripped the projects-harness marker from %s "
                  "(original moved aside)" % (OK, agents))
        else:
            print("%s removed %s (it held nothing but the marker; original "
                  "moved aside)" % (OK, agents))
    print("\nrestart each host for the hooks to reload.")


# ----------------------------------------------------------------- report ----

def _marker_agents_files():
    """AGENTS.md files under the roots carrying the predecessor's marker block.

    The block points every session at a POLICY.md inside ~/.codex/projects-harness,
    so once the harness itself is gone the marker is a standing dead pointer -
    report it and let --adopt retire it with the rest."""
    out = []
    for root in (tp.roots() or [tp.DEFAULT_ROOT]):
        path = os.path.join(root, "AGENTS.md")
        try:
            with open(path, encoding="utf-8") as fh:
                body = fh.read()
        except OSError:
            continue
        if HARNESS_MARKER_START in body:
            out.append(path)
    return out


def predecessors():
    """Pre-tezgah wiring still present; --adopt retires it.

    The `cbm-*` names below are literal files an older, unrelated harness left
    on a user's disk - not this repo's engine, which is codegraph now. They stay
    spelled as the files are spelled: --adopt moves those files aside, and a
    probe renamed to match the new engine would leave the stale hooks
    undetected."""
    out = []
    if os.path.isdir(os.path.join(CODEX, "projects-harness")):
        out.append("~/.codex/projects-harness present")
    if _hooks_has(os.path.join(CODEX, "hooks.json"), "projects-harness"):
        out.append("projects-harness entries in ~/.codex/hooks.json")
    if any(os.path.exists(os.path.join(CLAUDE, "hooks", n)) for n in
           ("cbm-code-discovery-gate", "cbm-session-reminder", "cbm-subagent-reminder")):
        out.append("~/.claude/hooks/cbm-* present")
    if "cbm-" in json.dumps(read_json(os.path.join(CLAUDE, "settings.json"), {})):
        out.append("cbm hook entries in ~/.claude/settings.json")
    for path in _marker_agents_files():
        out.append("projects-harness marker in %s" % path)
    return out


def _frontmatter_description(path):
    """Return the joined `description:` block from a SKILL.md frontmatter."""
    try:
        with open(path, encoding="utf-8") as fh:
            text = fh.read()
    except OSError:
        return ""
    if not text.startswith("---"):
        return ""
    body = text.split("---", 2)[1]
    out, collecting = [], False
    for line in body.splitlines():
        if re.match(r"^description:\s*", line):
            collecting = True
            out.append(re.sub(r"^description:\s*[>|]?\s*", "", line))
            continue
        if collecting:
            if re.match(r"^\S", line):
                break
            out.append(line.strip())
    return " ".join(part for part in out if part).strip()


def context_budget():
    """Always-on context tezgah injects, as (label, chars) rows + on-demand size.

    Approximate and host-side only: it counts the rendered contract, the
    per-turn reminder and the skill/subagent metadata. MCP tool schemas are the
    host's to measure and are deliberately not counted here. The on-demand size
    is the shipped `tezgah-contract` skill itself - the text a session reads -
    not a join of the policy blocks, which drifted from it.
    """
    core = tezgah_context.render(tezgah_context.always_on_core())
    conditional = sum(
        len(p) for p in policy.CORE.split("\n\n")
        if next((k for k, label in tezgah_context.CORE_RULES
                 if p.startswith(label)), None) in policy.CONDITIONAL_KEYS)
    reminder = tezgah_context.render(policy.PROMPT_REMINDER)
    skills = sum(len(name) + len(_frontmatter_description(
        os.path.join(HERE, "skills", name, "SKILL.md"))) + 8 for name in SKILLS)
    agents = sum(len(name) + len(desc) for name, desc, *_ in tezgah_agents.ROLES)
    agents += len("tezgah-orchestrator") + len(tezgah_agents.ORCH_DESC)
    rows = [
        ("core contract (always-on, per session)", len(core)),
        ("per-turn reminder", len(reminder)),
        ("skill metadata (%d)" % len(SKILLS), skills),
        ("subagent metadata (%d)" % (len(tezgah_agents.ROLES) + 1), agents),
        ("conditional rules (armed by task class)", conditional),
    ]
    with open(os.path.join(HERE, "skills", "tezgah-contract", "SKILL.md"),
              encoding="utf-8") as fh:
        on_demand = len(fh.read())
    return rows, on_demand


def mcp_tool_schemas(command, timeout=30, env=None):
    """(tool count, schema bytes) an MCP server declares, or (0, None).

    The one band the budget report cannot count: the schemas are the host's,
    and the only honest way to size them is to ask the server. This performs
    the initialize + tools/list handshake over stdio and measures the JSON.
    `env` is the environment the host will spawn the server with, because the
    surface itself can depend on it: codegraph exposes one tool without its
    CODEGRAPH_MCP_TOOLS and eight with it."""
    import json as _json
    import subprocess as _subprocess
    requests = [
        {"jsonrpc": "2.0", "id": 1, "method": "initialize",
         "params": {"protocolVersion": "2024-11-05", "capabilities": {},
                    "clientInfo": {"name": "tezgah-setup", "version": "1"}}},
        {"jsonrpc": "2.0", "method": "notifications/initialized"},
        {"jsonrpc": "2.0", "id": 2, "method": "tools/list", "params": {}},
    ]
    payload = "".join(_json.dumps(r) + "\n" for r in requests)
    try:
        proc = _subprocess.run(command, input=payload, capture_output=True,
                               text=True, timeout=timeout, env=env)
    except (OSError, _subprocess.SubprocessError):
        return 0, None
    for line in proc.stdout.splitlines():
        try:
            msg = _json.loads(line)
        except ValueError:
            continue
        if msg.get("id") == 2 and isinstance(msg.get("result"), dict):
            tools = msg["result"].get("tools") or []
            if tools:
                return len(tools), len(_json.dumps(tools))
    return 0, None


def mcp_schema_report():
    """Print the measured schema band for every MCP server tezgah registers.

    The app-analysis servers run through `npx`, so measuring them needs node and
    a (one-time) registry fetch; a server that cannot start is reported as not
    measured rather than silently left out of the band."""
    servers = []
    if tp.codegraph_bin():
        servers.append(("codegraph", graph_command(),
                        dict(os.environ, **GRAPH_ENV)))
    # tezgah's own surface is registered in all six hosts, so it rides the band
    # like any other server: a tool set that grew past the recorded ceiling has
    # to show up in the measurement that ceiling is written against.
    servers.append((TEZGAH_MCP_NAME, tezgah_mcp_command(), None))
    for srv in app_servers():
        servers.append((srv["name"], list(srv["command"]), None))
    print("\nMCP tool-schema band (measured by an initialize + tools/list handshake):")
    total_tools = total_bytes = 0
    for name, command, env in servers:
        tools, size = mcp_tool_schemas(command, env=env)
        if size is None:
            print("     %-24s not measured (the server did not answer tools/list)"
                  % name)
            continue
        total_tools += tools
        total_bytes += size
        print("     %-24s %3d tools  %7d bytes  ~%4.1fk tok"
              % (name, tools, size, size / 4 / 1000.0))
    if not servers:
        print("     no MCP server binary found on this machine")
    else:
        print("     %-24s %3d tools  %7d bytes  ~%4.1fk tok"
              % ("total", total_tools, total_bytes, total_bytes / 4 / 1000.0))
    print("     These bytes ride every request unless the host fetches schemas "
          "on demand.")


def context_budget_report():
    rows, on_demand = context_budget()
    print("\ncontext budget (always-on text; ~tokens = chars/4):")
    for label, chars in rows:
        print("     %-34s ~%4.1fk tok  %6d chars"
              % (label, (chars + 3) // 4 / 1000.0, chars))
    print("     %-34s ~%4.1fk tok  (only when the skill is read)"
          % ("full contract (on demand)", (on_demand + 3) // 4 / 1000.0))
    print("     %-34s run --mcp-schemas to measure" % "MCP tool schemas")


# ------------------------------------------------------------------ live ----
# `--report` reads what was WRITTEN; `--live` proves the hooks EXECUTE (audit
# Phase 1.2: Codex's hooks were wired, untrusted and silently skipped while the
# report said ok, H-1). Per host, two synthetic events go through the wiring the
# host itself reads - the command in its hooks.json, the plugin file it imports,
# the extension it loads - never through tezgah's own constants: a harmless
# PostToolUse for `true`, which must write a ledger row, and a PreToolUse for
# LIVE_DENY_COMMAND, which the gate must refuse in the host's own deny envelope
# and record as a deny row. Both run against a throwaway root (TEZGAH_ROOTS), so
# no repository is touched, and every cache file named for the session is
# removed after.

LIVE_TIMEOUT = 20
LIVE_DENY_COMMAND = "git commit --no-verify -m x"
# The JS half: loads the omp extension (`--experimental-strip-types`, the .ts as
# omp's bun would) or the opencode plugin (an ES module, as opencode imports
# it), registers its handlers against inert host objects and fires one handler:
# the tool-result one, or with a command the tool-call one, printing what it
# answered (omp) or what it threw (opencode) as JSON. argv: host, module path,
# root, session id, command ("" for the tool result).
LIVE_DRIVER = r"""
const [host, mod, root, sid, cmd] = process.argv.slice(1);
const noop = new Proxy(function () {}, { get: () => noop, apply: () => noop });
(async () => {
  const m = await import(require("node:url").pathToFileURL(mod).href);
  if (host === "omp") {
    const handlers = {};
    m.default(new Proxy({ on: (n, fn) => { handlers[n] = fn; } },
                        { get: (t, k) => (k in t ? t[k] : noop) }));
    const want = cmd ? "tool_call" : "tool_result";
    if (!handlers[want]) throw new Error("the extension registered no " + want + " handler");
    const ctx = new Proxy({ cwd: root, sessionManager: { getSessionId: () => sid } },
                          { get: (t, k) => (k in t ? t[k] : noop) });
    if (cmd) {
      const res = await handlers.tool_call({ toolName: "bash", input: { command: cmd } }, ctx);
      process.stdout.write(JSON.stringify(res || {}));
      return;
    }
    await handlers.tool_result({ toolName: "bash", input: { command: "true" },
                                 isError: false, content: "ok" }, ctx);
  } else {
    const hooks = await (m.Tezgah || m.default)({ directory: root, worktree: root,
                                                  client: noop, $: noop });
    const want = cmd ? "tool.execute.before" : "tool.execute.after";
    if (!hooks || !hooks[want]) throw new Error("the plugin registered no " + want + " hook");
    if (cmd) {
      try {
        await hooks[want]({ tool: "bash", sessionID: sid, callID: "live" },
                          { args: { command: cmd } });
        process.stdout.write("{}");
      } catch (e) {
        process.stdout.write(JSON.stringify({ threw: String((e && e.message) || e) }));
      }
      return;
    }
    await hooks[want]({ tool: "bash", sessionID: sid, callID: "live", args: { command: "true" } },
                      { title: "", output: "ok", metadata: { exit: 0 }, args: { command: "true" } });
  }
})().catch((e) => { process.stderr.write(String((e && e.message) || e) + "\n"); process.exit(1); });
"""


def _hook_command(groups, want="Bash", own=False):
    """The first tezgah command among a host's hook groups that fires for
    `want`: a group's `matcher` (Claude's shape) or a bare entry (Cursor's).
    In a shared file (codex, cursor) only an entry naming tezgah counts; tezgah's
    own manifest (`own`, the plugin's and dsh's hooks.json) names its scripts
    through ${CLAUDE_PLUGIN_ROOT}, so every entry there is tezgah's."""
    for group in groups if isinstance(groups, list) else []:
        if not isinstance(group, dict) or not (own or "tezgah" in json.dumps(group)):
            continue
        matcher = group.get("matcher")
        if matcher and not re.fullmatch(matcher, want):
            continue
        for entry in group.get("hooks") or [group]:
            if isinstance(entry, dict) and entry.get("command") and (
                    own or "tezgah" in str(entry["command"])):
                return entry["command"]
    return None


def _claude_plugin_root():
    """The plugin copy Claude loads: the tezgah row of installed_plugins.json,
    when settings.json enables it. (None, cause) otherwise."""
    rows = read_json(INSTALLED_PLUGINS, {}).get("plugins") or {}
    key = next((k for k in rows if k.split("@")[0] == "tezgah"), None)
    if not key or not rows[key]:
        return None, "no tezgah row in %s" % INSTALLED_PLUGINS
    enabled = read_json(os.path.join(CLAUDE, "settings.json"), {}).get("enabledPlugins") or {}
    if not enabled.get(key):
        return None, "plugin %s is not enabled in settings.json" % key
    return rows[key][-1].get("installPath"), None


def _dsh_bridge():
    """configPath and pluginRoot from tezgah's row in dsh's patch file."""
    try:
        with open(DSH_PATCH, encoding="utf-8") as fh:
            text = fh.read()
    except OSError:
        return None, None
    conf = re.search(r"configPath:\s*(\S+)", text)
    root = re.search(r"pluginRoot:\s*(\S+)", text)
    return (conf.group(1) if conf else None), (root.group(1) if root else None)


def _node_for_ts():
    """node able to strip TypeScript types (22.6+), or None."""
    node = shutil.which("node")
    if not node:
        return None
    try:
        out = subprocess.run([node, "--version"], capture_output=True, text=True,
                             timeout=10).stdout.strip().lstrip("v").split(".")
        return node if (int(out[0]), int(out[1])) >= (22, 6) else None
    except (OSError, ValueError, IndexError, subprocess.SubprocessError):
        return None


def live_plan(host, deny=False):
    """How one host's real wiring is driven: ("shell", command, payload, env),
    ("node", argv-head, module path), or ("unverified"|"miss", cause). `deny`
    drives the PreToolUse wiring with LIVE_DENY_COMMAND instead of the
    PostToolUse wiring with `true`."""
    event = "PreToolUse" if deny else "PostToolUse"
    claude_payload = ({"hook_event_name": event, "tool_name": "Bash",
                       "tool_input": {"command": LIVE_DENY_COMMAND}} if deny else
                      {"hook_event_name": event, "tool_name": "Bash",
                       "tool_input": {"command": "true"},
                       "tool_response": {"exit_code": 0}})
    if host == "codex":
        groups = (read_json(os.path.join(CODEX, "hooks.json"), {}).get("hooks")
                  or {}).get(event)
        cmd = _hook_command(groups)
        if not cmd:
            return ("miss", "no tezgah %s command in %s"
                    % (event, os.path.join(CODEX, "hooks.json")))
        return ("shell", cmd, claude_payload, {})
    if host == "claude":
        root, cause = _claude_plugin_root()
        if not root:
            return ("miss", cause)
        groups = (read_json(os.path.join(root, "hooks", "hooks.json"), {})
                  .get("hooks") or {}).get(event)
        cmd = _hook_command(groups, own=True)
        if not cmd:
            return ("miss", "no %s command for Bash in %s/hooks/hooks.json" % (event, root))
        return ("shell", cmd, claude_payload, {"CLAUDE_PLUGIN_ROOT": root})
    if host == "dsh":
        conf, root = _dsh_bridge()
        if not conf or not root:
            return ("miss", "no tezgah hook bridge row in %s" % DSH_PATCH)
        cmd = _hook_command((read_json(conf, {}).get("hooks") or {}).get(event),
                            own=True)
        if not cmd:
            return ("miss", "no %s command for Bash in %s" % (event, conf))
        return ("shell", cmd, claude_payload, {"CLAUDE_PLUGIN_ROOT": root})
    if host == "cursor":
        name = "preToolUse" if deny else "postToolUse"
        cmd = _hook_command((read_json(os.path.join(CURSOR, "hooks.json"), {})
                             .get("hooks") or {}).get(name), "Shell")
        if not cmd:
            return ("miss", "no tezgah %s command in %s"
                    % (name, os.path.join(CURSOR, "hooks.json")))
        payload = {"hook_event_name": name, "tool_name": "Shell",
                   "tool_input": {"command": LIVE_DENY_COMMAND if deny else "true"}}
        if not deny:
            payload["tool_output"] = json.dumps({"exitCode": 0})
        return ("shell", cmd, payload, {})
    if host == "opencode":
        plugin = next((p for p in (os.path.join(OPENCODE, d, "tezgah.js")
                                   for d in ("plugins", "plugin")) if os.path.exists(p)), None)
        if not plugin:
            return ("miss", "no tezgah.js under %s/plugins" % OPENCODE)
        node = shutil.which("node")
        if not node:
            return ("unverified", "node is not on PATH to import %s" % plugin)
        return ("node", [node, "--no-warnings"], plugin)
    if host == "omp":
        ext = os.path.join(OMP_AGENT, "hooks", "pre", "tezgah-hook.ts")
        try:
            with open(ext, encoding="utf-8") as fh:
                bridge = fh.read()
        except OSError:
            return ("miss", "no extension at %s" % ext)
        # the same renderer the install writes with: a bridge edited by hand, or
        # left by an older tree, is not the wiring this tree arms
        if bridge != omp_bridge():
            return ("miss", "%s differs from a fresh render of this tree's bridge "
                    "- re-run `tezgah-setup --install --hosts omp`" % ext)
        registered = omp_extensions()
        if registered is not None and ext not in registered:
            return ("miss", "%s is not in omp's `extensions` list, so omp never "
                    "loads it" % ext)
        node = _node_for_ts()
        if not node:
            return ("unverified", "no node 22.6+ to load %s (omp's own loader "
                    "needs a session)" % ext)
        plan = ("node", [node, "--experimental-strip-types", "--no-warnings"], ext)
        if registered is None:
            return plan + ("registration unread: the omp CLI did not answer",)
        return plan
    return ("unverified", "no live probe for this host")


def _denied(host, stdout):
    """True when a PreToolUse answer is the host's own deny envelope."""
    try:
        got = json.loads((stdout or "").strip() or "null")
    except ValueError:
        return False
    if not isinstance(got, dict):
        return False
    if host == "cursor":
        return got.get("permission") == "deny"
    if host == "omp":
        return got.get("block") is True
    if host == "opencode":
        return bool(got.get("threw"))
    return (got.get("hookSpecificOutput") or {}).get("permissionDecision") == "deny"


def _live_cleanup(slug):
    """Remove every cache file the synthetic session left (named by its slug)."""
    for dirpath, _dirs, files in os.walk(tp.cache_dir()):
        for name in files:
            if slug in name:
                try:
                    os.remove(os.path.join(dirpath, name))
                except OSError:
                    pass


def live_probe(host, deny=False):
    """(state, line) for one host: ok, miss or unverified. `deny` sends the
    PreToolUse probe: the host's deny envelope and a deny row must both appear;
    its line reads `live <host> deny:`."""
    who = host + " deny" if deny else host
    if deny:
        # the two switches that stand the probe's refusal down: the whole gate,
        # or the integrity rule whose shortcut denial `--no-verify` is
        switch = next((s for s in ("pretooluse-off", "verify-off") if tp.off(s)), None)
        if switch:
            return "unverified", ("live %s: %s is set, so the gate does not refuse "
                                  "`%s` - nothing to prove" % (who, switch,
                                                               LIVE_DENY_COMMAND))
    event = "PreToolUse" if deny else "PostToolUse"
    plan = live_plan(host, deny)
    if plan[0] == "miss":
        return "miss", "live %s: %s" % (who, plan[1])
    if plan[0] == "unverified":
        return "unverified", "live %s: %s" % (who, plan[1])
    sid = "tezgah-live-%d-%d" % (os.getpid(), int(time.time() * 1000))
    slug = tezgah_integrity._slug(sid)
    ledger = os.path.join(tp.cache_dir(), "evidence", slug + ".jsonl")
    root = tempfile.mkdtemp(prefix="tezgah-live-")
    env = dict(os.environ, TEZGAH_ROOTS=root)
    started = time.monotonic()
    try:
        if plan[0] == "shell":
            _kind, cmd, payload, extra = plan
            env.update(extra)
            payload = dict(payload, session_id=sid, conversation_id=sid, cwd=root)
            proc = subprocess.run(cmd, shell=True, input=json.dumps(payload),
                                  capture_output=True, text=True, env=env,
                                  cwd=root, timeout=LIVE_TIMEOUT)
        else:
            proc = subprocess.run(plan[1] + ["-e", LIVE_DRIVER, host, plan[2], root,
                                             sid, LIVE_DENY_COMMAND if deny else ""],
                                  capture_output=True, text=True, env=env,
                                  cwd=root, timeout=LIVE_TIMEOUT)
        ms = int((time.monotonic() - started) * 1000)
        try:
            with open(ledger, encoding="utf-8") as fh:
                kinds = [json.loads(ln).get("kind") for ln in fh if ln.strip()]
        except (OSError, ValueError):
            kinds = []
    except (OSError, subprocess.SubprocessError) as exc:
        return "miss", "live %s: the hook did not run (%s)" % (who, exc)
    finally:
        _live_cleanup(slug)
        shutil.rmtree(root, ignore_errors=True)
    err = (proc.stderr or "").strip().splitlines()
    tail = " (exit %d%s)" % (proc.returncode, ": " + err[-1][:160] if err else "")
    if deny and not _denied(host, proc.stdout):
        return "miss", ("live %s: PreToolUse returned no deny envelope for `%s`%s"
                        % (who, LIVE_DENY_COMMAND, tail))
    if deny and "deny" not in kinds:
        return "miss", ("live %s: PreToolUse denied `%s` but wrote no deny row%s"
                        % (who, LIVE_DENY_COMMAND, tail))
    if not kinds:
        return "miss", "live %s: %s wrote no ledger row%s" % (who, event, tail)
    line = ("live %s: PreToolUse denied `%s` and wrote a deny row in %d ms"
            % (who, LIVE_DENY_COMMAND, ms) if deny else
            "live %s: PostToolUse wrote a ledger row in %d ms" % (who, ms))
    if host == "codex":
        hooks = os.path.join(CODEX, "hooks.json")
        try:
            with open(os.path.join(CODEX, "config.toml"), encoding="utf-8") as fh:
                toml = fh.read()
        except OSError:
            toml = ""
        if not _codex_hooks_trusted(hooks, toml):
            return "miss", ("live %s: the hook runs, but codex does not trust "
                            "tezgah's group in %s [hooks.state], so codex skips it "
                            "- approve it in one interactive codex run"
                            % (who, os.path.join(CODEX, "config.toml")))
    if len(plan) > 3 and plan[0] == "node":
        return "unverified", line + "; " + plan[3]
    return "ok", line


def live_report(hosts):
    """Print two live rows per host (the PostToolUse ledger row, the PreToolUse
    deny); 1 when any is MISS. UNVERIFIED (no way to drive the loader here, or a
    switch that stands the refusal down) is reported, never as ok, and never
    fails."""
    print("\nlive (per host, through its own wiring: one synthetic PostToolUse, "
          "one PreToolUse the gate must deny):")
    failed = False
    for h in hosts:
        for deny in (False, True):
            state, line = live_probe(h, deny)
            mark = {"ok": OK, "miss": NO}.get(state, " UNVERIFIED ")
            print("  %s %s" % (mark, line))
            failed = failed or state == "miss"
    return 1 if failed else 0


# The report rows whose MISS means the host is not armed: its hooks wired and
# its contract current. Rows a correct fresh install leaves MISS stay out:
# Codex "hooks trusted" (the user approves it in Codex) and the provider keys.
ARMING_ROWS = ("hooks.json wired", "plugin wired (link or copy)",
               "carries the contract", "contract in instructions",
               "claude-code hooks bridge in cordis.patch.yml",
               "session, prompt, tool and stop hooks wired",
               "hook registered in omp extensions", "plugin copy current")


def arming_miss(label, good):
    """True for a MISS row in ARMING_ROWS. A row the host's own CLI arms counts
    only where that CLI exists: the omp extension row (`omp config`) and
    Claude's plugin row (`claude plugin`)."""
    if good or not any(row in label for row in ARMING_ROWS):
        return False
    if "omp extensions" in label:
        return bool(tp.omp_bin())
    if "plugin copy current" in label:
        return bool(tp.claude_bin())
    return True


def report(hosts):
    print("tezgah checkout: %s\n" % HERE)
    print("roots (%s):" % ("TEZGAH_ROOTS" if os.environ.get("TEZGAH_ROOTS")
                           else "config" if os.path.exists(tp.CONFIG) else "default"))
    for r in tp.roots():
        print("  %s %s" % (OK if os.path.isdir(r) else NO, r))
    print("\ncommon:")
    rows = [
        ("config %s" % tp.CONFIG, os.path.exists(tp.CONFIG)),
        ("%s on PATH" % tp.CODEGRAPH, bool(tp.codegraph_bin())),
        ("consult option (agent CLI or provider key): %s"
         % (", ".join(tp.consult_options()) or "none"),
         bool(tp.consult_options())),
        ("codegen provider key (OpenRouter, DeepSeek or Inception)",
         tp.have_provider_key()),
        ("orx on PATH (OpenResearch research routing)", bool(tp.orx_bin())),
        ("npx on PATH (app-analysis MCP servers)", bool(shutil.which("npx"))),
        ("app artifacts dir %s" % tezgah_apps.ARTIFACTS,
         os.path.isdir(tezgah_apps.ARTIFACTS)),
        ("git", bool(shutil.which("git"))), hosts_row(),
        ("local plugin manifest consistent when present (untracked)",
         versions_agree()),
    ]
    for label, good in rows:
        print("  %s %s" % (OK if good else NO, label))
    # One row per artifact whose recorded sha is not a fresh render's: the shared
    # hash this replaced was reset by opencode's own refresh, so a stale CLAUDE.md,
    # AGENTS.md or RULES.md never showed here (audit M-5).
    for path in stale_artifacts(tp.config().get("hosts") or []):
        print("  %s always-on contract stale: %s - run `tezgah-setup --refresh`"
              % (NO, path))
    pred = predecessors()
    if pred:
        print("\npredecessor wiring still present (retire with --adopt):")
        for p in pred:
            print("  ?    %s" % p)
    missed = []
    for h in hosts:
        print("\n%s:" % h)
        for label, good in HOST_CHECKS[h]():
            print("  %s %s" % (OK if good else NO, label))
            if arming_miss(label, good):
                missed.append("%s (%s)" % (h, label))
        attestation_rows(h)
    context_budget_report()
    return missed


def attestation_rows(host):
    """The session-start attestation, asked here by hand: the same comparison
    every session start writes its `attest` row from (`hooks/tezgah_attest.py::
    drift`), against the tree the host really runs - Claude's plugin copy when
    one is registered. Not an arming row: a drifted entry is reported, and the
    install's exit code is left to the rows that say whether a host is armed."""
    root = (_claude_plugin_root()[0] if host == "claude" else None) or HERE
    found, unknown = ta.drift(host, root)
    print("  %s hook entries match the install record (attestation)"
          % (NO if found else OK if not unknown else " UNVERIFIED "))
    for item in found:
        print("         drift: %s" % item)
    for item in unknown:
        print("         unverified: %s" % item)


def mcp_rows(wired, where, superseded=()):
    """One report row per known server: `wired == selected` is what green means.

    A per-host `all(...)` over the always-on pair could not see either failure
    in the other direction - a server the user turned off that is still wired
    (the ghost an older release left) or one that is selected and missing - and
    chrome-devtools was reported by no row at all."""
    selected = set(app_server_names())
    rows = []
    for name in app_mcp_names():
        want, got = name in selected, name in wired
        if want and name in superseded:
            # the host drops it itself (OMP_SUPERSEDED_MCP): green means absent
            rows.append(("app MCP %s (selected, superseded by the host's native "
                         "browser)" % name, not got))
            continue
        if want and got:
            rows.append(("app MCP %s (selected, wired)" % name, True))
        elif not want and not got:
            rows.append(("app MCP %s (deselected, absent)" % name, True))
        elif want:
            rows.append(("app MCP %s (selected, not wired in %s)" % (name, where),
                         False))
        else:
            rows.append(("app MCP %s (deselected, ghost in %s)"
                         % (name, where), False))
    return rows


def toml_servers(path):
    """The [mcp_servers.*] tables a toml file carries."""
    try:
        with open(path, encoding="utf-8") as fh:
            text = fh.read()
    except OSError:
        return set()
    return set(re.findall(r"(?m)^\s*\[mcp_servers\.([^\]]+)\]", text))


def dsh_servers(path):
    """The serverName values the dsh patch file declares."""
    try:
        with open(path, encoding="utf-8") as fh:
            text = fh.read()
    except OSError:
        return set()
    return set(re.findall(r"(?m)^\s*serverName:\s*(\S+)", text))


def host_checks_claude():
    copies = live_plugin_copies()
    return [
        ("statusline wired (link or copy)",
         is_tezgah_entry(os.path.join(CLAUDE, "statusline.py"))),
        ("statusLine in settings.json", statusline_wired()),
        ("workflows served by the plugin (no link in ~/.claude/workflows)",
         not any(is_tezgah_entry(os.path.join(CLAUDE, "workflows", w))
                 for w in WORKFLOW_FILES)),
        ("bin on ~/.claude/bin",
         all(is_tezgah_entry(os.path.join(CLAUDE, "bin", b))
             for b in ("consult", "codegen", "tezgah-render-table"))),
        # Claude runs the plugin COPY, not this checkout, so a copy that lags it
        # is the one gap the other four rows cannot see. An absent copy is not
        # current either: all([]) is True, and a row that stays green on a
        # machine with no tezgah plugin at all is not a check.
        ("plugin copy current (every copied file matches)",
         bool(copies) and all(plugin_copy_current(t) for t in copies)),
        ("CLAUDE.md carries the contract (matches a fresh render)",
         rules_current("claude")),
    ] + claude_mcp_rows(copies)


def mcp_entry_argv(entry):
    """(command, args) an MCP entry declares, whichever shape its host uses.

    opencode keeps the whole argv in `command`; codex's toml, Claude, Cursor and
    omp split it into `command` + `args`. One reader, so a row that checks the
    argv cannot answer differently per host."""
    if not isinstance(entry, dict):
        return None, []
    command = entry.get("command")
    if isinstance(command, list):
        return (command[0] if command and isinstance(command[0], str) else None), \
            [a for a in command[1:] if isinstance(a, str)]
    if isinstance(command, str):
        args = entry.get("args")
        return command, ([a for a in args if isinstance(a, str)]
                         if isinstance(args, list) else [])
    return None, []


def mcp_row(name, entry, where, argv):
    """The report row for one named server: it is wired with exactly `argv`.

    Presence alone is not the check. A row written by an older tezgah pins the
    interpreter of another machine or a tree that has moved, and `name in
    servers` reads green while the process it names cannot start. Keys the host
    adds (omp's `type`, opencode's `enabled`) are not ours and do not fail it.
    The written value may carry the `${HOME}` template the render puts in for a
    tracked file; the host resolves that template at read time, so the check
    compares the path the host resolves - `_host_value` is that read half."""
    command, args = mcp_entry_argv(entry)
    command, args = _host_value(command), [_host_value(a) for a in args]
    return ("MCP %s server wired with this tree's argv in %s" % (name, where),
            command == argv[0] and args == list(argv[1:]))


def _toml_unquote(value):
    """The value `_toml_str` wrote, read back."""
    return value.replace('\\"', '"').replace("\\\\", "\\")


def toml_mcp_entry(path, name):
    """The `command` and `args` a `[mcp_servers.<name>]` table declares, or None.

    A reader for the check side only: the writer appends a table, and a report
    that only asked whether the name is in the text could not see a table
    pointing at another machine's interpreter."""
    try:
        with open(path, encoding="utf-8") as fh:
            text = fh.read()
    except OSError:
        return None
    block = re.search(r"(?ms)^[ \t]*\[mcp_servers\.%s\][ \t]*$(.*?)(?=^[ \t]*\[|\Z)"
                      % re.escape(name), text)
    if not block:
        return None
    command = re.search(r'(?m)^\s*command\s*=\s*"((?:[^"\\]|\\.)*)"', block.group(1))
    if not command:
        return None
    args = re.search(r"(?m)^\s*args\s*=\s*\[(.*?)\]", block.group(1))
    return {"command": _toml_unquote(command.group(1)),
            "args": [_toml_unquote(a) for a in
                     re.findall(r'"((?:[^"\\]|\\.)*)"',
                                args.group(1) if args else "")]}


def dsh_mcp_entry(text, name):
    """The argv one `serverName: <name>` row of the dsh patch block declares.

    Same reason as `toml_mcp_entry`: the block is generated text, and a row that
    asked only whether the name appears would pass on a block still pointing at
    a moved tree."""
    block = re.search(r"(?ms)^\s*serverName:\s*%s\s*$(.*?)(?=^\s*serverName:|\Z)"
                      % re.escape(name), text)
    if not block:
        return None
    command = re.search(r"(?m)^\s*command:\s*(\S+)\s*$", block.group(1))
    if not command:
        return None
    args = re.search(r"(?m)^\s*args:\s*\[(.*?)\]\s*$", block.group(1))
    return {"command": command.group(1),
            "args": re.findall(r"'([^']*)'", args.group(1) if args else "")}


def claude_mcp_rows(copies):
    """The MCP row Claude never had: the copy it loads, its server set, and
    whether that set equals the selection.

    Claude reads `.mcp.json` from the plugin COPY (nothing else writes the file
    for it), so the row names the copy by path and prints both sets - a copy
    holding a server the user turned off is the one shape that looks wired while
    the selection says otherwise. The set is the graph row, tezgah's own MCP
    surface and the selected app servers, because this file is Claude's only MCP
    channel: a name missing here is a name Claude never gets at all, while the
    graph row lives in the other five hosts from their own writers."""
    selected = sorted(set(["codegraph", TEZGAH_MCP_NAME] + app_server_names()))
    rows = []
    for t in copies:
        servers = (read_json(os.path.join(t, MCP_JSON), {}) or {}).get("mcpServers")
        wired = sorted(servers) if isinstance(servers, dict) else []
        rows.append(("MCP server set in %s (%s) equals the selection (%s)"
                     % (t, ", ".join(wired) or "none", ", ".join(selected) or "none"),
                     wired == selected))
        rows.append(mcp_row(TEZGAH_MCP_NAME, (servers or {}).get(TEZGAH_MCP_NAME),
                            t, tezgah_mcp_command(t)))
    if not copies:
        rows.append(("MCP server set in an installed plugin copy "
                     "(no tezgah plugin copy found)", False))
    return rows


def _hooks_has(path, marker, events=None):
    """True when `marker` is wired under every event in `events`, or under any
    event when `events` is None.

    A row that one event can satisfy answers the wrong question: a manifest
    carrying tezgah's command under SessionStart and not under Stop reads as
    wired, and Stop is the integrity refusal."""
    hooks = (read_json(path, {}) or {}).get("hooks") or {}
    if events is None:
        return any(marker in json.dumps(e) for arr in hooks.values() for e in arr)
    return all(any(marker in json.dumps(e) for e in (hooks.get(ev) or []))
               for ev in events)


def _codex_hooks_trusted(hooks_path, toml):
    """True when Codex's own trust table covers tezgah's hook group.

    Codex records one `[hooks.state."<hooks.json path>:<event>:<group>:<hook>"]`
    table per trusted hook command, the event in snake case (`pre_tool_use`),
    as read from a live ~/.codex/config.toml. tezgah cannot compute the hash
    Codex stores, but it can read which group indices its own `hooks.json` holds
    and check that a state key exists for each of them: a wired-but-untrusted
    group is the silent disarm this row exists to surface. The key carries the
    file path, so a trusted group 1 in another project's hooks.json cannot pass
    for this one. Anything unreadable, and a file with no tezgah group at all,
    reads as untrusted, never as ok."""
    try:
        with open(hooks_path, encoding="utf-8") as fh:
            data = json.load(fh)
    except (OSError, ValueError):
        return False
    events = data.get("hooks") if isinstance(data, dict) else None
    if not isinstance(events, dict):
        return False
    paths = {os.path.abspath(hooks_path), os.path.realpath(hooks_path)}
    found = False
    for event, groups in events.items():
        if not isinstance(groups, list):
            continue
        snake = re.sub(r"(?<!^)(?=[A-Z])", "_", event).lower()
        for index, group in enumerate(groups):
            if "tezgah" not in json.dumps(group):
                continue
            found = True
            if not any('"%s:%s:%d:0"' % (p, snake, index) in toml for p in paths):
                return False
    return found


def host_checks_codex():
    cmd = "tezgah-codex-hook"
    # a relocated home is named, so a report can never show ~/.codex while these
    # rows read the tree codex actually loads
    where = (" in %s" % CODEX
             if CODEX != os.path.join(tp.HOME, ".codex") else "")
    toml_path = os.path.join(CODEX, "config.toml")
    try:
        with open(toml_path, encoding="utf-8") as fh:
            toml = fh.read()
    except OSError:
        toml = ""
    return [
        ("hooks.json wired%s" % where,
         _hooks_has(os.path.join(CODEX, "hooks.json"), cmd,
                    [ev for ev, _matcher in CODEX_HOOK_EVENTS])),
        # H-1 (audit 2026-10-02): codex runs only hook groups its own
        # `[hooks.state]` table trusts, so "wired" without a trust entry is a
        # gate that never runs - the report said ok while nothing executed
        ("hooks trusted%s" % where,
         _codex_hooks_trusted(os.path.join(CODEX, "hooks.json"), toml)),
        ("skills linked%s" % where,
         skills_linked(os.path.join(CODEX, "skills"))),
        ("MCP in config.toml", "mcp_servers.codegraph" in toml),
        ("%s carries the contract (matches a fresh render)"
         % os.path.basename(codex_rules()), rules_current("codex")),
    ] + mcp_rows(toml_servers(toml_path), "config.toml") + [
        mcp_row(TEZGAH_MCP_NAME, toml_mcp_entry(toml_path, TEZGAH_MCP_NAME),
                "config.toml", tezgah_mcp_command()),
    ]


def host_checks_opencode():
    cfg = read_json(os.path.join(OPENCODE, "opencode.json"), {})
    tui = read_json(os.path.join(OPENCODE, "tui.json"), {})
    instr = cfg.get("instructions") or []
    specs = [p if isinstance(p, str) else p[0] for p in (tui.get("plugin") or [])]
    return [
        ("plugin wired (link or copy)",
         any(is_tezgah_entry(os.path.join(OPENCODE, d, "tezgah.js"))
             for d in ("plugins", "plugin"))),
        ("skills linked", skills_linked(os.path.join(OPENCODE, "skills"))),
        ("contract in instructions", any("tezgah" in i for i in instr)),
        ("skill router in instructions + written",
         SKILL_ROUTER in instr and os.path.isfile(SKILL_ROUTER)),
        ("full skill router written (on demand)",
         os.path.isfile(SKILL_ROUTER_FULL)),
        ("permission.skill denied", (cfg.get("permission") or {}).get("skill") == "deny"),
        ("MCP in opencode.json", "codegraph" in (cfg.get("mcp") or {})),
    ] + mcp_rows(set(cfg.get("mcp") or {}), "opencode.json") + [
        mcp_row(TEZGAH_MCP_NAME, (cfg.get("mcp") or {}).get(TEZGAH_MCP_NAME),
                "opencode.json", tezgah_mcp_command()),
        ("context pruning armed (compaction.prune)",
         (cfg.get("compaction") or {}).get("prune") is True),
        ("watcher ignores noisy trees",
         bool(set(OPENCODE_IGNORE)
              & set(((cfg.get("watcher") or {}).get("ignore") or [])))),
        ("status line plugin in tui.json + linked",
         any("tezgah-tui" in s for s in specs)
         and os.path.exists(os.path.join(OPENCODE, "tui-plugins", "tezgah-tui.tsx"))),
        # opencode's own registry declares INCEPTION_API_KEY for the inception
        # provider, so nothing needs adding to opencode.json - but the route is
        # only usable once a key resolves, and that is what this reports.
        ("Inception provider key resolvable (env or auth store)",
         opencode_key_resolvable("inception", "INCEPTION_API_KEY")),
    ]


def host_checks_cursor():
