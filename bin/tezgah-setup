# The relay `_materialise` writes where a symlink is refused: it runs the real
# script with __file__ and sys.argv[0] pointing at it, so a script that finds
# its own tree by walking up from __file__ still finds the install tree.
RELAY = ('import runpy\nimport sys\n\n'
         'sys.argv[0] = %r\n'
         'runpy.run_path(%r, run_name="__main__")\n')
