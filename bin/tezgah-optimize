#!/usr/bin/env python3
"""tezgah-optimize - one decision over what verification a change costs.

  tezgah-optimize next [--files PATH ...] [--cmd COMMAND ...] [--sha SHA] [--json]
  tezgah-optimize record <COMMAND> --seconds N --exit N [--sha SHA]
  tezgah-optimize push [--sha SHA]

`next` answers, per candidate command, exactly one of three things. `already
green` when a recorded row for this repository, this sha and this command exited
0 - the analogue of a remote build cache, keyed by the change rather than by a
file. `defer` when the command's recorded median wall time is at or above
`TURN_SECONDS`, so it belongs to the merge step. Else `run now`. The candidates
are the commands the active plan's Acceptance items name in backticks, plus every
`--cmd`; the plan already carries the commands that prove its work, so the
planner reads them instead of asking for a list a session would re-derive.

The tier map is measured, not declared: with no row for a command the answer is
`run now`, and the median of its rows moves it. A project that never adopted this
repository's `AGENTS.md` therefore still gets a batch (plan 109, decision d1v1).

`record` appends the row `next` reads, and `push` prints the one push the session
should make for this change - or refuses while the last recorded push of the same
sha is inside `PUSH_WINDOW`, because a second push pays the same CI minutes
again. The rows live in the repository's own store
(`<repo>/.tezgah/taste/taste.db`, tables `checks` and `pushes`), so a second
session in the same checkout reads the first one's measurements.

The orchestrating session calls these. A user does not, and no hook does.

Exit codes: 0 ok, 1 a refusal or a problem, 2 misuse.
"""
import json
import os
import re
import subprocess
import sys
import time

HERE = os.path.dirname(os.path.dirname(os.path.realpath(__file__)))
sys.path.insert(0, os.path.join(HERE, "hooks"))
import tezgah_store as store  # noqa: E402
import tezgah_task as tt  # noqa: E402
from tezgah_paths import project_top  # noqa: E402

# A command whose recorded median is at or above this belongs to the merge step.
# The repository's own measured tiers (AGENTS.md) put the impacted set in a turn
# at about 10-95 s and the whole suite, about 105 s, at the merge step, so the bar
# is the line between them. One number, not a table: the plan's decision rejected
# a declared per-repository map (d1v2) because a second project would have to
# write one before the planner helped it at all.
TURN_SECONDS = 105.0
# One push per sha inside this window. A second push of the same change pays the
# same CI minutes again, which is the cost this command coalesces; the window is
# long enough for a session's next edit to join the first push.
PUSH_WINDOW = 300.0
BACKTICK = re.compile(r"`([^`]+)`")


def repo_root(path):
    """The repository this run is about: git's own answer, else the directory it
    was called in."""
    try:
        out = subprocess.run(["git", "-C", path, "rev-parse", "--show-toplevel"],
                             capture_output=True, text=True)
        if out.returncode == 0 and out.stdout.strip():
            return project_top(out.stdout.strip())
    except OSError:
        pass
    return os.path.realpath(path)


def misuse(message):
    print("tezgah-optimize: %s" % message, file=sys.stderr)
    return 2


def problems(items):
    for problem in items:
        print("FAIL %s" % problem)
    return 1


def now():
    return time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())


def git_out(root, *args):
    """One git command's stdout, or None when git cannot answer - a checkout git
    cannot describe never refuses anything here."""
    try:
        out = subprocess.run(["git", "-C", root] + list(args),
                             capture_output=True, text=True)
    except OSError:
        return None
    return out.stdout.strip() if out.returncode == 0 else None


def parse(args, repeats=(), valued=(), flags=()):
    """(({repeat: [...]}, {plain: value}), positionals, problem). A repeatable
    option collects every occurrence, a valued one keeps the last, a flag is
    True, and any other `--x` is a problem."""
    collected = {name: [] for name in repeats}
    plain, pos, i = {}, [], 0
    while i < len(args):
        arg = args[i]
        if arg in repeats or arg in valued:
            if i + 1 >= len(args):
                return None, None, "%s needs a value" % arg
            if arg in repeats:
                collected[arg].append(args[i + 1])
            else:
                plain[arg] = args[i + 1]
            i += 2
        elif arg in flags:
            plain[arg] = True
            i += 1
        elif arg.startswith("--"):
            return None, None, "unknown option %r" % arg
        else:
            pos.append(arg)
            i += 1
    return (collected, plain), pos, None


def store_dir(root):
    return os.path.join(root, ".tezgah", "taste")


def recorded(root, table, where="", args=()):
    """One table's rows in append order; [] when the store is not there yet, so a
    first run answers from nothing instead of failing."""
    try:
        with store.taste(store_dir(root), create=False) as db:
            return store.rows(db, table, where, args) if db else []
    except store.ERRORS:
        return []


def median(values):
    ordered = sorted(values)
    if not ordered:
        return None
    mid = len(ordered) // 2
    return ordered[mid] if len(ordered) % 2 else (ordered[mid - 1] + ordered[mid]) / 2.0


PROGRAM = re.compile(
    r"^(?:python3?|pytest|ruff|mypy|bash|sh|zsh|make|npm|npx|yarn|pnpm|cargo|go|gradle|"
    r"\./gradlew|mvn|dotnet|swift|xcodebuild|git|gh|docker|bundle|rake|nox|tox|"
    r"\./bin/[a-z][a-z-]*|bin/[a-z][a-z-]*)$")


def plan_commands(root):
    """The commands the active plan's Acceptance items name in backticks, in
    order, deduplicated. The plan format asks each item for the command that
    proves it, so this is the list the session would otherwise retype.

    A backticked token counts when its first word is a program - `python3`, `ruff
    check .`, `pytest`, `package.json`'s `npm test`, or a script under `bin/` - and
    it carries no placeholder. An item's prose is backticked too (`stale`, a file
    path such as `hooks/tezgah_store.py`), and a planner that took every token, or
    every token with a slash in it, would hand the session a path as a check and
    drop `ruff check .` (review of plan 109, F3). A command the rule cannot see is
    what `--cmd` is for."""
    task = tt.active(root, root, held=True)
    if not task:
        return []
    try:
        with open(task["path"], encoding="utf-8") as fh:
            text = fh.read()
    except OSError:
        return []
    out = []
    for item in tt.acceptance_items(text):
        for found in BACKTICK.findall(item["text"]):
            command = " ".join(found.split())
            words = command.split()
            if "<" in command or ">" in command or command in out or not words:
                continue
            if not PROGRAM.match(words[0]):
                continue
            out.append(command)
    return out


def same_commit(one, other):
    """True when two sha spellings name the same commit. Git prints a short sha
    that grows as the repository does, so a row recorded with the full one would
    never match the short one `next` reads (review of plan 109)."""
    one, other = str(one or ""), str(other or "")
    return bool(one) and bool(other) and (one.startswith(other) or other.startswith(one))


def decide(root, command, sha):
    """(verdict, why) for one command: the three answers `next` gives.

    A green row for this change outranks the tier, because running it again would
    add nothing - but only while the working tree is clean. Inside a turn the
    edits are usually uncommitted, so HEAD does not move, and a row for that sha
    can describe a tree this session has already changed: on a dirty tree the
    answer is `run now` whatever the rows say (review of plan 109, F2)."""
    history = [row for row in recorded(root, "checks")
               if row.get("command") == command]
    dirty = bool(git_out(root, "status", "--porcelain")) if sha else False
    green = [row for row in history
             if same_commit(row.get("sha"), sha) and not int(row.get("exit") or 0)
             and row.get("tree") == "clean"]
    if green and not dirty:
        return "already green", "recorded exit 0 for %s at %s" % (
            sha, green[-1].get("ts") or "?")
    seconds = [float(row["seconds"]) for row in history
               if isinstance(row.get("seconds"), (int, float))]
    middle = median(seconds)
    if green:
        return "run now", ("a green row exists for %s, but the working tree holds "
                           "uncommitted edits, so that pass is not this change" % sha)
    if middle is None:
        return "run now", "nothing measured for it yet"
    if middle >= TURN_SECONDS:
        return "defer", "its measured median is %.1fs, at or above the %.0fs in-turn bar" % (
            middle, TURN_SECONDS)
    return "run now", "its measured median is %.1fs" % middle


def cmd_next(args):
    parsed, pos, bad = parse(args, repeats=("--files", "--cmd"), valued=("--sha",),
                             flags=("--json",))
    if bad or pos:
        return misuse(bad or "next takes options only (%r)" % pos[0])
    collected, plain = parsed
    root = repo_root(os.getcwd())
    sha = plain.get("--sha") or git_out(root, "rev-parse", "--short", "HEAD") or ""
    commands = []
    for command in list(collected["--cmd"]) + plan_commands(root):
        if command not in commands:
            commands.append(command)
    rows = [{"command": command, "verdict": decide(root, command, sha)[0],
             "why": decide(root, command, sha)[1]} for command in commands]
    payload = {"repo": root, "sha": sha, "files": collected["--files"],
               "commands": rows, "turn_seconds": TURN_SECONDS}
    if plain.get("--json"):
        print(json.dumps(payload, indent=2, sort_keys=True))
        return 0
    print("repo %s at %s" % (root, sha or "(no commit yet)"))
    if collected["--files"]:
        print("  changed: %s" % ", ".join(collected["--files"]))
    for row in rows:
        print("  %-13s %s (%s)" % (row["verdict"], row["command"], row["why"]))
    if not rows:
        print("no candidate command: name one with --cmd, or give the active plan "
              "an Acceptance item whose proof names one in backticks")
    return 0


def cmd_record(args):
    parsed, pos, bad = parse(args, valued=("--seconds", "--exit", "--sha"))
    if bad or len(pos) != 1:
        return misuse(bad or "record takes one COMMAND")
    _collected, plain = parsed
    command = " ".join(pos[0].split())
    if not command:
        return misuse("record takes the command it measured")
    for name in ("--seconds", "--exit"):
        if name not in plain:
            return misuse("record needs %s" % name)
    try:
        seconds, code = float(plain["--seconds"]), int(plain["--exit"])
    except ValueError:
        return misuse("--seconds takes a wall time and --exit an exit code")
    if seconds < 0:
        return misuse("--seconds takes a wall time, not a negative one")
    root = repo_root(os.getcwd())
    sha = plain.get("--sha") or git_out(root, "rev-parse", "--short", "HEAD") or ""
    row = {"repo": root, "sha": sha, "command": command, "seconds": seconds,
           "exit": code, "ts": now(),
           # the tree the run describes: a green row recorded over uncommitted
           # edits describes a tree nobody else has, and `decide` will not spend
           # it as a pass (review of plan 109, F2)
           "tree": "clean" if not git_out(root, "status", "--porcelain") else "dirty"}
    try:
        with store.taste(store_dir(root)) as db:
            store.append(db, "checks", row)
    except store.ERRORS as exc:
        return problems(["cannot record in %s: %s" % (store_dir(root), exc)])
    print("recorded: %s %s %.1fs exit %d" % (sha or "(no commit)", command,
                                             seconds, code))
    return 0


def cmd_push(args):
    parsed, pos, bad = parse(args, valued=("--sha",))
    if bad or pos:
        return misuse(bad or "push takes [--sha SHA]")
    _collected, plain = parsed
    root = repo_root(os.getcwd())
    sha = plain.get("--sha") or git_out(root, "rev-parse", "--short", "HEAD") or ""
    if not sha:
        return problems(["%s has no commit to push" % root])
    name = git_out(root, "symbolic-ref", "-q", "--short", "HEAD")
    if not name:
        return problems(["%s is on a detached HEAD: name the branch to push (check "
                         "it out, or push an explicit ref)" % root])
    at = time.time()
    for row in reversed(recorded(root, "pushes")):
        if row.get("sha") != sha or not isinstance(row.get("at"), (int, float)):
            continue
        waited = at - float(row["at"])
        if waited < PUSH_WINDOW:
            return problems([
                "%s is already pushed and CI is paying for it: one push per change "
                "is the point. Add the next edit to this one, or push again in %d s "
                "(`tezgah-optimize push`)" % (sha, int(PUSH_WINDOW - waited))])
    try:
        with store.taste(store_dir(root)) as db:
            store.append(db, "pushes", {"repo": root, "sha": sha, "branch": name,
                                        "at": at})
    except store.ERRORS as exc:
        return problems(["cannot record the push in %s: %s" % (store_dir(root), exc)])
    print("push: git push -u origin %s - one push for %s" % (name, sha))
    return 0


def main(argv):
    if len(argv) < 2:
        print(__doc__, file=sys.stderr)
        return 2
    cmd, rest = argv[1], argv[2:]
    if cmd == "next":
        return cmd_next(rest)
    if cmd == "record":
        return cmd_record(rest)
    if cmd == "push":
        return cmd_push(rest)
    return misuse("unknown command %r (next, record, push)" % cmd)


if __name__ == "__main__":
    sys.exit(main(sys.argv))
