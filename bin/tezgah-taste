#!/usr/bin/env python3
"""tezgah-taste - mine, measure, learn and apply the coding-taste signals.

  tezgah-taste mine [--host omp|claude|all] [--root DIR] [--stats] [--out FILE]
  tezgah-taste measure --samples FILE --labels FILE [--model M] [--json]
  tezgah-taste rate --in MINED [--limit N] [--json]
  tezgah-taste learn [--repo DIR] [--from-transcripts] [--host omp|claude|all]
                     [--limit N] [--json]
  tezgah-taste list [--repo DIR] [--all] [--json]
  tezgah-taste show|accept|reject ID [--repo DIR]
  tezgah-taste edit ID --text TEXT [--repo DIR]
  tezgah-taste export [--repo DIR]
  tezgah-taste label [ID LABEL] [--n N] [--repo DIR]
  tezgah-taste calibrate|gate [--repo DIR] [--json]

`mine` reads the session transcripts on this machine - omp's top-level session
files under `~/.omp/agent/sessions/*/` (a nested file is a subagent session) and
Claude's top-level transcripts under `~/.claude/projects/*/` - whose cwd is under
`--root` (default `~/Projects`, a `.runs` directory excluded). A writing turn is
one in which the agent wrote a file without an error (omp `edit`/`write`, Claude
`Edit`/`Write`/`MultiEdit`/`NotebookEdit`); the prompt the user sent directly
after one, unless it is a harness injection, is a row. The definitions are the
ones the coding-taste-learning line froze, so `--stats` prints the same session,
write and prompt counts that line's `measure.py` prints for omp. Each row is
`{host, session, cwd, repo, prompt, writes_in_turn}`, the prompt redacted and cut
to 2000 characters, because the rows are what `rate` sends to the judge.

`measure` classifies hand-labelled samples (`{set, n, text}` joined with
`{set, n, label}`) with the judge seam and prints the confusion against the
labels, per-class precision and recall, and what the calls cost. `rate`
classifies mined rows the same way and prints preference corrections per
writing-turn prompt, per repo and overall. Both send the sample text to the
judge's provider (`hooks/tezgah_judge.py` names it); with no credential or
`judge-off` set they send nothing and exit 2.

`learn` is taste-1's pipeline on tezgah (research line taste-architecture,
design T1P). Each prompt after a writing turn - from the capture rows in
`<repo>/.tezgah/taste/signals.jsonl`, or with `--from-transcripts` from this
repository's omp and Claude transcripts - becomes one structured signal built by
code: the prompt, the files written, the agent's edits and the user's own edit
between two agent writes. One typed decision per signal, required from TypeSafe
(`only=("typesafe",)`): preference, defect or none; the category; the scope; and
how it relates to each learning held. A decision any other provider gave is
recorded `unverified` and never applied. A defect goes to `defects.jsonl`, never
into the ledger. The ledger itself is `hooks/tezgah_taste_ledger.py`. A
learning that becomes active gets one readable line from a generative provider
(a `text` question; the user's own words when none answers).

`list`, `show`, `accept`, `reject` and `edit` are the user's control; `export`
writes the accepted learnings into AGENTS.md. `label` draws an independent
random sample of decided signals for the user to label, `calibrate` prints the
Clopper-Pearson bound a rule needs, and `gate` runs the pooled before/after test
that stops injection when the corrections do not fall.

Exit codes: 0 done, 2 misuse or no judge.
"""
import argparse
import datetime
import difflib
import glob
import hashlib
import json
import os
import random
import subprocess
import sys

HERE = os.path.dirname(os.path.dirname(os.path.realpath(__file__)))
sys.path.insert(0, os.path.join(HERE, "hooks"))
import tezgah_integrity as ti  # noqa: E402
import tezgah_judge  # noqa: E402
import tezgah_models  # noqa: E402
import tezgah_taste_ledger as tl  # noqa: E402

WRITE_TOOLS = {"omp": {"edit", "write"},
               "claude": {"Edit", "Write", "MultiEdit", "NotebookEdit"}}
HARNESS = ("<system-", "<harness-", "This turn did work", "The reply states")
CUT = 2000
BATCH = 20
CLASSES = ("preference", "defect", "none")
RULE = """Each sample is a user prompt that followed a turn in which the agent wrote files. Label it with exactly one class.
- preference: the user asks to change how something the agent already produced looks, is named, is structured or worded, or which language, library, pattern or approach it uses, or states a standing "do it this way" about code or written output - where the complaint is about form or choice, not that it is broken.
- defect: the user says something the agent produced is wrong, broken, missing, not done, still failing, or still visible when it should not be.
- none: everything else, including a new task or feature request that corrects nothing in the previous turn; a workflow directive about how to run the work (use subagents, run in parallel, push, release, commit, ask or do not ask, which tool or model to consult); a question, approval, continuation or status request.
If a prompt carries both a defect and a preference, label it preference. If unsure between preference and none, label none."""
CRITERIA = {"preference": "a correction of form or choice in what the agent produced",
            "defect": "what the agent produced is wrong, broken, missing or not done",
            "none": "anything else"}
# Jev's price as `bin/tezgah-triage` quotes it: $0.042 per 1M input, output free.
JEV_PRICE = (0.042, 0.0)


def misuse(message):
    print("tezgah-taste: %s" % message, file=sys.stderr)
    return 2


# ------------------------------------------------------------------- mine ----

def text_of(content):
    if isinstance(content, str):
        return content
    return "\n".join(part.get("text") or "" for part in content or []
                     if isinstance(part, dict) and part.get("type") == "text")


def harness_prompt(text):
    stripped = text.lstrip()
    return not stripped or stripped.startswith(HARNESS)


def rows_of(path):
    with open(path, encoding="utf-8", errors="replace") as fh:
        for line in fh:
            try:
                row = json.loads(line)
            except ValueError:
                continue
            if isinstance(row, dict):
                yield row


def omp_cwd(path):
    """The cwd the session header names; it sits in the first four lines."""
    with open(path, encoding="utf-8", errors="replace") as fh:
        for i, line in enumerate(fh):
            if i > 3:
                break
            if '"type":"session"' in line:
                try:
                    return json.loads(line).get("cwd") or ""
                except ValueError:
                    pass
    return ""


def claude_cwd(path):
    for row in rows_of(path):
        if isinstance(row.get("cwd"), str):
            return row["cwd"]
    return ""


def omp_args(args):
    """A tool call's arguments as the gate saw them: omp adds an intent key `i`
    to every call the hook payload does not carry, so it is dropped before the
    arguments are hashed into a `call_id`."""
    return {k: v for k, v in (args or {}).items() if k != "i"} \
        if isinstance(args, dict) else {}


def stamp(row):
    """A transcript row's ISO timestamp as epoch seconds, or None."""
    when = row.get("timestamp")
    if not isinstance(when, str):
        return None
    try:
        return datetime.datetime.fromisoformat(when.replace("Z", "+00:00")).timestamp()
    except ValueError:
        return None


def walk_omp(path, calls=False):
    """('user', text) and ('write',) in transcript order. With `calls`, also
    ('call', name, args, ts) per tool call (omp's `i` key dropped) and
    ('reply', text, ts) per assistant message that carries text."""
    for row in rows_of(path):
        m = row.get("message")
        if not isinstance(m, dict):
            continue
        if m.get("role") == "user":
            yield ("user", text_of(m.get("content")))
        elif (m.get("role") == "toolResult" and m.get("toolName") in WRITE_TOOLS["omp"]
              and not m.get("isError")):
            yield ("write",)
        elif calls and m.get("role") == "assistant" and isinstance(m.get("content"), list):
            ts = stamp(row)
            for part in m["content"]:
                if isinstance(part, dict) and part.get("type") == "toolCall":
                    yield ("call", part.get("name"), omp_args(part.get("arguments")), ts)
            text = text_of(m["content"])
            if text.strip():
                yield ("reply", text, ts)


def walk_claude(path, calls=False):
    """walk_omp's events for a Claude transcript; `calls` adds ('call', name,
    input, ts) per tool_use and ('reply', text, ts) per assistant text."""
    pending = {}
    for row in rows_of(path):
        m = row.get("message")
        if not isinstance(m, dict):
            continue
        content = m.get("content")
        if row.get("type") == "assistant" and isinstance(content, list):
            ts = stamp(row)
            for part in content:
                if isinstance(part, dict) and part.get("type") == "tool_use":
                    pending[part.get("id")] = part.get("name")
                    if calls:
                        inp = part.get("input")
                        yield ("call", part.get("name"), inp if isinstance(inp, dict) else {}, ts)
            if calls and text_of(content).strip():
                yield ("reply", text_of(content), ts)
        elif row.get("type") == "user":
            results = [p for p in content if isinstance(p, dict)
                       and p.get("type") == "tool_result"] if isinstance(content, list) else []
            if results:
                for part in results:
                    if (pending.get(part.get("tool_use_id")) in WRITE_TOOLS["claude"]
                            and not part.get("is_error")):
                        yield ("write",)
                continue
            text = text_of(content)
            if "[Request interrupted by user" not in text:
                yield ("user", text)


HOSTS = {
    "omp": (lambda: os.path.join(os.path.expanduser("~"), ".omp", "agent", "sessions"),
            omp_cwd, walk_omp),
    "claude": (lambda: os.path.join(os.path.expanduser("~"), ".claude", "projects"),
               claude_cwd, walk_claude),
}


def sessions(host, root, nested=False):
    """(path, cwd) of each session file whose cwd is under `root`. Top-level
    files only - the frozen `mine` definition - unless `nested`, which adds the
    subagent files below them (omp `<session>/<agent>.jsonl` at any depth,
    Claude `<session>/subagents/*.jsonl`)."""
    base, cwd_of, _walk = HOSTS[host]
    pattern = ("**", "*.jsonl") if nested else ("*", "*.jsonl")
    for path in sorted(glob.glob(os.path.join(base(), *pattern), recursive=nested)):
        cwd = cwd_of(path)
        if cwd.startswith(root + os.sep) and ".runs" not in cwd.split(os.sep):
            yield path, cwd


def session_id(host, path):
    """The session id the host hands its hooks - the id the ledger file is
    named after (`tezgah_integrity._slug`) - and, for omp, the parent session
    file a subagent names. Claude subagent files carry the parent's id."""
    for i, row in enumerate(rows_of(path)):
        if host == "omp" and row.get("type") == "session":
            return row.get("id"), row.get("parentSession")
        if host == "claude" and isinstance(row.get("sessionId"), str):
            return row["sessionId"], None
        if host == "omp" and i > 3:
            break
    return None, None


def repo_of(cwd, root):
    """The nearest directory holding `.git` below the root, else the first path
    component under it - without git, since a session's cwd may be gone."""
    here = cwd
    while here.startswith(root + os.sep):
        if os.path.exists(os.path.join(here, ".git")):
            return here
        here = os.path.dirname(here)
    return os.path.join(root, os.path.relpath(cwd, root).split(os.sep)[0])


def mine_session(events):
    """(writes, [(prompt, writes_in_turn)]) under the frozen definitions."""
    writes, turn, prompts = 0, 0, []
    for event in events:
        if event[0] == "write":
            writes += 1
            turn += 1
            continue
        if turn and not harness_prompt(event[1]):
            prompts.append((event[1], turn))
        turn = 0
    return writes, prompts


def cmd_mine(args):
    root = os.path.abspath(os.path.expanduser(args.root or "~/Projects"))
    out = open(args.out, "w", encoding="utf-8") if args.out and not args.stats else sys.stdout
    try:
        for host in (("omp", "claude") if args.host == "all" else (args.host,)):
            count = writes = prompts = 0
            for path, cwd in sessions(host, root):
                count += 1
                wrote, rows = mine_session(HOSTS[host][2](path))
                writes += wrote
                prompts += len(rows)
                if args.stats:
                    continue
                for text, turn in rows:
                    out.write(json.dumps({
                        "host": host,
                        "session": os.path.splitext(os.path.basename(path))[0],
                        "cwd": cwd, "repo": repo_of(cwd, root),
                        "prompt": ti.redact(text)[:CUT], "writes_in_turn": turn},
                        ensure_ascii=False) + "\n")
            if args.stats:
                print("%s: sessions=%d writes=%d prompts_after_write=%d"
                      % (host, count, writes, prompts))
    finally:
        if out is not sys.stdout:
            out.close()
    return 0


# ------------------------------------------------------- judge, measure ----

def read_jsonl(path):
    try:
        return list(rows_of(path))
    except OSError as exc:
        raise SystemExit(misuse("cannot read %s: %s" % (path, exc)))


def classify(texts, model, only=None):
    """One label per text (None when the judge gave none) and the usage.

    The rule rides the state, so each request pays for it once and the
    questions carry only their own prompt."""
    labels, tokens_in, tokens_out, used = [], 0, 0, model
    for start in range(0, len(texts), BATCH):
        chunk = texts[start:start + BATCH]
        questions = {"p%d" % i: {"type": "choice", "criteria": CRITERIA,
                                 "instructions": "Label this prompt under the rule "
                                                 "in the state:\n" + ti.redact(text)}
                     for i, text in enumerate(chunk)}
        result = tezgah_judge.ask(RULE, questions, model=model, timeout=120, only=only)
        if result is not None:
            tokens_in += result["usage"]["input_tokens"]
            tokens_out += result["usage"]["output_tokens"]
            used = result.get("model", used)
        for i in range(len(chunk)):
            label = tezgah_judge.choice(result, "p%d" % i)
            labels.append(label if label in CLASSES else None)
    return labels, {"model": used, "input_tokens": tokens_in,
                    "output_tokens": tokens_out, "cost_usd": cost(used, tokens_in,
                                                                  tokens_out)}


def cost(model, tokens_in, tokens_out):
    """Dollars at the model's listed price per 1M tokens, None when unlisted."""
    price = JEV_PRICE if model == tezgah_judge.MODEL else (
        tezgah_models.overlay().get("prices", {}).get(model)
        or tezgah_models.SNAPSHOT.get(model))
    if not (isinstance(price, (list, tuple)) and len(price) == 2):
        return None
    return round((tokens_in * price[0] + tokens_out * price[1]) / 1e6, 6)


def usage_line(usage):
    money = ("$%.6f" % usage["cost_usd"] if usage["cost_usd"] is not None
             else "cost unknown (no listed price)")
    return "judge: %s, %d input tokens, %d output; %s" % (
        usage["model"], usage["input_tokens"], usage["output_tokens"], money)


def ratio(a, b):
    return round(a / b, 4) if b else None


def cmd_measure(args):
    labels = {(r.get("set"), r.get("n")): r.get("label") for r in read_jsonl(args.labels)}
    pairs = [(r.get("text") or "", labels[(r.get("set"), r.get("n"))])
             for r in read_jsonl(args.samples) if (r.get("set"), r.get("n")) in labels]
    if not pairs:
        return misuse("no sample joins a label on (set, n)")
    if not tezgah_judge.available():
        return misuse("no judge: no credential resolves or judge-off is set; nothing sent")
    got, usage = classify([text for text, _gold in pairs], args.model,
                          only=("typesafe",) if args.typed else None)
    confusion = {g: {p: 0 for p in CLASSES} for g in CLASSES}
    unjudged = 0
    for (_text, gold), pred in zip(pairs, got):
        if pred is None or gold not in CLASSES:
            unjudged += 1
            continue
        confusion[gold][pred] += 1
    per_class = {c: {"precision": ratio(confusion[c][c], sum(confusion[g][c] for g in CLASSES)),
                     "recall": ratio(confusion[c][c], sum(confusion[c].values()))}
                 for c in CLASSES}
    report = {"n": len(pairs) - unjudged, "unjudged": unjudged, "confusion": confusion,
              "per_class": per_class, "usage": usage}
    if args.json:
        print(json.dumps(report, indent=2))
        return 0
    print("n=%d unjudged=%d (rows: label, columns: judge)" % (report["n"], unjudged))
    print("%-11s %s" % ("", " ".join("%10s" % p for p in CLASSES)))
    for g in CLASSES:
        print("%-11s %s" % (g, " ".join("%10d" % confusion[g][p] for p in CLASSES)))
    for c in CLASSES:
        print("%s: precision %s, recall %s" % (c, per_class[c]["precision"],
                                                per_class[c]["recall"]))
    print(usage_line(usage))
    return 0


def cmd_rate(args):
    rows = read_jsonl(args.inp)
    if args.limit is not None:
        rows = rows[:args.limit]
    if not rows:
        return misuse("no mined rows in %s" % args.inp)
    if not tezgah_judge.available():
        return misuse("no judge: no credential resolves or judge-off is set; nothing sent")
    got, usage = classify([(r.get("prompt") or "")[:CUT] for r in rows], tezgah_judge.MODEL)
    repos = {}
    for row, label in zip(rows, got):
        if label is None:
            continue
        tally = repos.setdefault(row.get("repo") or "", [0, 0])
        tally[0] += 1
        tally[1] += label == "preference"
    n = sum(t[0] for t in repos.values())
    pref = sum(t[1] for t in repos.values())
    report = {"n": n, "unjudged": len(rows) - n, "preference": pref,
              "rate": ratio(pref, n),
              "repos": {repo: {"n": t[0], "preference": t[1], "rate": ratio(t[1], t[0])}
                        for repo, t in sorted(repos.items())},
              "usage": usage}
    if args.json:
        print(json.dumps(report, indent=2))
        return 0
    for repo, row in report["repos"].items():
        print("%s: %d/%d preference (%s)" % (repo, row["preference"], row["n"], row["rate"]))
    print("overall: %d/%d preference (%s), unjudged %d"
          % (pref, n, report["rate"], report["unjudged"]))
    print(usage_line(usage))
    return 0

# ------------------------------------------------------------ learn, apply ----

SCOPE_CRITERIA = {
    "path": "only files under the directory the agent wrote",
    "language": "files of the language or extension the agent wrote",
    "repository": "everything in this repository",
    "user": "every repository this user works in"}
RELATION_CRITERIA = {
    "supports": "the prompt asks for the same preference as this learning",
    "contradicts": "the prompt asks for the opposite of this learning",
    "narrows": "the prompt keeps this learning but makes an exception for a narrower place",
    "unrelated": "the prompt is about something else"}
CATEGORY_CRITERIA = {c: c.replace("-", " ") for c in tl.CATEGORIES}
HELD_MAX = 30
DIFF_MAX = 1500


def repo_root(path):
    out = subprocess.run(["git", "-C", path, "rev-parse", "--show-toplevel"],
                         capture_output=True, text=True)
    return out.stdout.strip() if out.returncode == 0 and out.stdout.strip() else None


def sig_id(*parts):
    return hashlib.sha1("\0".join(str(p) for p in parts).encode()).hexdigest()[:12]


def iso_day(ts):
    """A capture row's ISO timestamp as days since the epoch, or None."""
    try:
        return datetime.datetime.fromisoformat(str(ts).replace("Z", "+00:00")) \
            .timestamp() / 86400.0
    except ValueError:
        return None


def _snapshots():
    """{absolute path: [(ts, id, after)]} over the snapshot store, oldest first."""
    import tezgah_snapshot as ts
    out = {}
    for d in ts._dirs():
        try:
            with open(os.path.join(d, "meta.json"), encoding="utf-8") as fh:
                meta = json.load(fh)
        except (OSError, ValueError):
            continue
        if isinstance(meta, dict) and meta.get("path"):
            out.setdefault(meta["path"], []).append(
                (int(meta.get("ts") or 0), os.path.basename(d), bool(meta.get("after"))))
    for rows in out.values():
        rows.sort()
    return out


def _read_blob(sid):
    import tezgah_snapshot as ts
    try:
        with open(ts._blob(sid), "rb") as fh:
            return fh.read().decode("utf-8", "replace")
    except OSError:
        return None


def user_diff(repo, rel, after_sid, snaps):
    """The user's own change to `rel` after the agent's write: the after-blob
    against the pre-write bytes of the next agent write to it, or against the
    file on disk when none came. "" when nothing changed in between."""
    after = _read_blob(after_sid)
    if after is None:
        return ""
    apath = os.path.realpath(os.path.join(repo, rel))
    rows = snaps.get(apath) or []
    mine = next((t for t, sid, _a in rows if sid == after_sid), None)
    later = next((sid for t, sid, a in rows if mine is not None and t >= mine
                  and not a and sid != after_sid), None)
    if later:
        now = _read_blob(later)
    else:
        try:
            with open(apath, encoding="utf-8", errors="replace") as fh:
                now = fh.read()
        except OSError:
            return ""
    if now is None or now == after:
        return ""
    diff = "".join(difflib.unified_diff(after.splitlines(True), now.splitlines(True),
                                        "agent/" + rel, "user/" + rel, n=1))
    return ti.redact(diff)[:DIFF_MAX]


def capture_signals(repo):
    """One signal per prompt that followed a writing turn, from the capture rows."""
    snaps, turns, out = None, {}, []
    for row in tl.rows(os.path.join(tl.store_dir(repo), "signals.jsonl")):
        session = row.get("session") or ""
        turn = turns.setdefault(session, {"edits": [], "after": []})
        if row.get("kind") == "edit":
            turn["edits"].append(row)
        elif row.get("kind") == "after":
            turn["after"].append(row)
        elif row.get("kind") == "prompt":
            if turn["edits"]:
                if snaps is None:
                    snaps = _snapshots()
                diffs = [d for d in (user_diff(repo, a.get("path"), a.get("snapshot"), snaps)
                                     for a in turn["after"] if a.get("path")) if d]
                out.append({
                    "id": sig_id(session, row.get("ts"), row.get("text")),
                    "at": iso_day(row.get("ts")),
                    "session": session, "text": row.get("text") or "",
                    "paths": sorted({e.get("path") for e in turn["edits"] if e.get("path")}),
                    "edits": [(e.get("path"), (e.get("old") or "")[:300],
                               (e.get("new") or "")[:300]) for e in turn["edits"][-4:]],
                    "diffs": diffs})
            turns[session] = {"edits": [], "after": []}
    return out


def _call_path(args):
    for key in ("path", "file_path", "notebook_path"):
        if isinstance(args.get(key), str):
            return args[key]
    return None


def transcript_signals(repo, host):
    """The same signals from this repository's top-level host transcripts: the
    prompt and the files written; no edit text or user diff (the history
    bootstrap, Command Code's `/learn-taste`)."""
    out = []
    for name in (("omp", "claude") if host == "all" else (host,)):
        for path, cwd in sessions(name, os.path.dirname(repo)):
            if cwd != repo and not cwd.startswith(repo + os.sep):
                continue
            session = session_id(name, path)[0] or os.path.basename(path)
            written, n, k, at = [], 0, 0, None
            for event in HOSTS[name][2](path, calls=True):
                if event[0] in ("call", "reply") and isinstance(event[-1], (int, float)):
                    at = event[-1] / 86400.0
                if event[0] == "call" and event[1] in WRITE_TOOLS[name]:
                    target = _call_path(event[2])
                    if target:
                        rel = os.path.relpath(os.path.join(cwd, target), repo)
                        if not rel.startswith(".."):
                            written.append(rel)
                elif event[0] == "write":
                    n += 1
                elif event[0] == "user":
                    if n and not harness_prompt(event[1]):
                        text = ti.redact(event[1])[:CUT]
                        # keyed inside its own session, so another session's
                        # new turns never shift this id and re-decide it
                        k += 1
                        out.append({"id": sig_id(name, session, k, text), "at": at,
                                    "session": session, "text": text,
                                    "paths": sorted(set(written)), "edits": [], "diffs": []})
                    written, n = [], 0
    return out


def held(ledgers):
    """The learnings a new signal is compared against: every one not retired,
    the most supported first, capped so one call stays one call."""
    alive = [v for v in tl.every(ledgers).values() if v["state"] != "retired"]
    alive.sort(key=lambda v: -v.get("r", 0.0))
    return alive[:HELD_MAX]


def decision_request(sig, learnings):
    state = ["A user prompt that followed a turn in which a coding agent wrote files.",
             "Prompt: " + ti.redact(sig["text"])[:CUT]]
    if sig["paths"]:
        state.append("Files the agent wrote: " + ", ".join(sig["paths"][:12]))
    for path, old, new in sig.get("edits") or ():
        state.append("Agent edit to %s:\n- %s\n+ %s" % (path, ti.redact(old), ti.redact(new)))
    for diff in sig.get("diffs") or ():
        state.append("The user's own edit after the agent's write:\n" + diff)
    questions = {
        "kind": {"type": "choice", "instructions": RULE, "criteria": CRITERIA},
        "category": {"type": "choice", "criteria": CATEGORY_CRITERIA,
                     "instructions": "If the prompt states a coding preference, which "
                                     "category does it belong to?"},
        "scope": {"type": "choice", "criteria": SCOPE_CRITERIA,
                  "instructions": "Where should this preference apply, judging only from "
                                  "what the prompt says?"}}
    for learning in learnings:
        questions["rel_" + learning["id"]] = {
            "type": "choice", "criteria": RELATION_CRITERIA,
            "instructions": "How does the prompt relate to this learning (%s, %s): %s"
                            % (learning["category"], learning["scope"],
                               " ".join(learning["text"].split())[:300])}
    return "\n\n".join(state), questions


def picked(result, qid, default):
    choice = tezgah_judge.choice(result, qid)
    if choice is None:
        return default, 0.0
    p = tezgah_judge.noul(result, qid, choice)
    return choice, (p if p is not None else 0.5)


def decide(sig, learnings, fallback=True):
    """(decision, result): the typed decision, TypeSafe required; when it cannot
    answer, the seam's own providers, recorded unverified - only on a signal's
    first try, since an unverified answer is never applied and a rerun would pay
    for it again."""
    state, questions = decision_request(sig, learnings)
    result = tezgah_judge.ask(state, questions, only=("typesafe",), timeout=60)
    if result is None and fallback:
        result = tezgah_judge.ask(state, questions, timeout=120)
    if result is None:
        return None, None
    dec = {"kind": picked(result, "kind", "none"),
           "category": picked(result, "category", ""),
           "scope": picked(result, "scope", "repository"),
           "relations": {lr["id"]: picked(result, "rel_" + lr["id"], "unrelated")
                         for lr in learnings},
           "verified": result.get("provider") == "typesafe"}
    return dec, result


def write_line(learning):
    """One readable line for a learning that became active, from a generative
    provider; None when none answers (the user's own words stay)."""
    evidence = " ".join(learning["text"].split())[:600]
    result = tezgah_judge.ask(
        "A user corrected a coding agent with: " + evidence,
        {"line": {"type": "text", "instructions":
                  "Write the coding preference this correction states as one imperative "
                  "line for a coding agent, under 20 words. Use only what the correction "
                  "says; add no preference it does not state."}},
        timeout=120)
    return tezgah_judge.text(result, "line")


def store_or_exit(args):
    repo = repo_root(os.path.abspath(args.repo or os.getcwd()))
    if not repo:
        raise SystemExit(misuse("not inside a git repository"))
    return repo


def learn_refusal(repo):
    """Why `learn` sends and writes nothing here, or None - read before the
    store lock, so a refused run leaves no lock file behind."""
    if tezgah_judge.tp.off("judge-off") or not (
            tezgah_judge.available() or tezgah_judge.named(("typesafe",))):
        return "no judge: no credential resolves or judge-off is set; nothing sent"
    import tezgah_context
    if ".no-taste" in tezgah_context.repo_marks(repo)[1]:
        return ".no-taste marks this repository; nothing learned"
    return None


def cmd_learn(args):
    repo = store_or_exit(args)
    signals = (transcript_signals(repo, args.host) if args.from_transcripts
               else capture_signals(repo))
    decided = {}
    for r in tl.rows(os.path.join(tl.store_dir(repo), "decisions.jsonl")):
        decided[r.get("id")] = decided.get(r.get("id")) or r.get("provider") == "typesafe"
    # a typed decision is final; an unverified one is retried, TypeSafe only
    todo = [s for s in signals if not decided.get(s["id"])]
    if args.limit is not None:
        todo = todo[:args.limit]
    ledgers = tl.load(repo)
    before = {k for k, v in tl.every(ledgers).items() if v["state"] == "active"}
    counts = {"signals": len(todo), "typesafe": 0, "unverified": 0, "unanswered": 0,
              "preference": 0, "defect": 0, "none": 0}
    tokens = [0, 0]
    for sig in todo:
        dec, result = decide(sig, held(ledgers), fallback=sig["id"] not in decided)
        if dec is None:
            counts["unanswered"] += 1
            continue
        tokens[0] += result["usage"]["input_tokens"]
        tokens[1] += result["usage"]["output_tokens"]
        day = tl.now_day()
        tl.append(os.path.join(tl.store_dir(repo), "decisions.jsonl"), {
            "id": sig["id"], "day": day, "at": sig.get("at"), "session": sig["session"],
            "provider": result.get("provider"), "model": result.get("model"),
            "verified": dec["verified"], "kind": dec["kind"][0], "p": dec["kind"][1],
            "category": dec["category"][0], "scope": dec["scope"][0],
            "relations": {k: v[0] for k, v in dec["relations"].items() if v[0] != "unrelated"},
            "text": ti.redact(sig["text"])[:300], "paths": sig["paths"][:8]}, strict=True)
        if not dec["verified"]:
            counts["unverified"] += 1
            continue
        counts["typesafe"] += 1
        counts[dec["kind"][0] if dec["kind"][0] in CLASSES else "none"] += 1
        if dec["kind"][0] == "defect":
            tl.append(os.path.join(tl.store_dir(repo), "defects.jsonl"),
                      {"id": sig["id"], "day": day, "session": sig["session"],
                       "text": ti.redact(sig["text"])[:600], "paths": sig["paths"][:8]},
                      strict=True)
        tl.apply(ledgers, sig, dec, day, applied=tl.injected(repo, sig["session"]))
    for lid, learning in tl.every(ledgers).items():
        if learning["state"] == "active" and lid not in before \
                and not learning.get("written") and not learning.get("edited"):
            line = write_line(learning)
            if line:
                learning.update(text=" ".join(line.split())[:400], written=True)
    tl.save(repo, ledgers)
    tl.markdown(repo)
    states = {}
    for learning in tl.every(ledgers).values():
        states[learning["state"]] = states.get(learning["state"], 0) + 1
    report = dict(counts, states=states, input_tokens=tokens[0], output_tokens=tokens[1],
                  cost_usd=cost(tezgah_judge.MODEL, tokens[0], tokens[1]))
    if args.json:
        print(json.dumps(report, indent=2))
        return 0
    print("signals %d: typesafe %d, unverified %d, unanswered %d" % (
        counts["signals"], counts["typesafe"], counts["unverified"], counts["unanswered"]))
    print("decided: preference %d, defect %d, none %d" % (
        counts["preference"], counts["defect"], counts["none"]))
    print("ledger: " + (", ".join("%s %d" % kv for kv in sorted(states.items())) or "empty"))
    print("typed decisions: %d input tokens, $%s" % (tokens[0], report["cost_usd"]))
    return 0


def cmd_list(args):
    repo = store_or_exit(args)
    ledgers = tl.load(repo)
    modes = {m[1]["id"]: m[0] for m in tl.usable(repo)}
    rows = [v for v in tl.every(ledgers).values() if args.all or v["state"] != "retired"]
    rows.sort(key=lambda v: (v["state"] != "active", -tl.confidence(v)))
    if args.json:
        print(json.dumps([dict(v, confidence=round(tl.confidence(v), 4),
                               mode=modes.get(v["id"])) for v in rows], indent=2))
        return 0
    if not rows:
        print("no learnings")
        return 0
    for v in rows:
        print("%-6s %-11s %-4s %.2f %-10s %-17s %s" % (
            v["id"], v["state"], modes.get(v["id"], "-"), tl.confidence(v),
            v["scope"] + ("" if v["scope"] in ("repository", "user") else ":" + v["where"]),
            v["category"], " ".join(v["text"].split())[:80]))
    return 0


def cmd_one(args):
    repo = store_or_exit(args)
    ledgers = tl.load(repo)
    if args.cmd == "show":
        learning = tl.every(ledgers).get(args.id)
        if learning is None:
            return misuse("no learning %s" % args.id)
        print(json.dumps(dict(learning, confidence=round(tl.confidence(learning), 4)),
                         indent=2, ensure_ascii=False))
        return 0
    if not tl.decide_user(ledgers, args.id, args.cmd, tl.now_day(),
                          text=getattr(args, "text", None)):
        return misuse("no learning %s" % args.id)
    tl.save(repo, ledgers)
    tl.markdown(repo)
    print("%s %s" % (args.id, {"accept": "accepted", "reject": "rejected",
                               "edit": "edited"}[args.cmd]))
    return 0


def cmd_export(args):
    repo = store_or_exit(args)
    print("AGENTS.md: %d accepted learning(s)" % tl.export_agents(repo))
    return 0


def cmd_label(args):
    """With ID and LABEL, record the user's label; without, print a random
    sample of unlabelled typed decisions - drawn without regard to what was
    injected, so the calibration bound rests on an unselected sample."""
    repo = store_or_exit(args)
    store = tl.store_dir(repo)
    decided = {r["id"]: r for r in tl.rows(os.path.join(store, "decisions.jsonl"))
               if r.get("provider") == "typesafe" and r.get("id")}
    labelled = {r.get("id") for r in tl.rows(os.path.join(store, "labels.jsonl"))}
    if args.id:
        if args.label not in CLASSES:
            return misuse("label is one of %s" % ", ".join(CLASSES))
        row = decided.get(args.id)
        if row is None:
            return misuse("no typed decision %s" % args.id)
        tl.append(os.path.join(store, "labels.jsonl"),
                  {"id": args.id, "label": args.label, "decided": row.get("kind"),
                   "provider": row.get("provider"), "day": tl.now_day()}, strict=True)
        print("%s labelled %s (decided %s)" % (args.id, args.label, row.get("kind")))
        return 0
    pool = sorted(i for i in decided if i not in labelled)
    for i in random.Random().sample(pool, min(args.n, len(pool))):
        print("%s  %s" % (i, " ".join(decided[i].get("text", "").split())[:200]))
    print("label each: tezgah-taste label <id> preference|defect|none")
    return 0


def cmd_calibrate(args):
    repo = store_or_exit(args)
    x, n, bound = tl.calibration(repo)
    report = {"agree": x, "labelled_preference_decisions": n, "bound": round(bound, 4),
              "rules_allowed": bound >= tl.BOUND_AT}
    if args.json:
        print(json.dumps(report, indent=2))
    else:
        print("preference precision %d/%d, Clopper-Pearson 95%% lower bound %.4f: %s" % (
            x, n, bound, "rules allowed" if report["rules_allowed"]
            else "hints only (a rule needs >= %.1f)" % tl.BOUND_AT))
    return 0


def cmd_gate(args):
    repo = store_or_exit(args)
    report = tl.gate(repo)
    if args.json:
        print(json.dumps(report, indent=2))
        return 0
    b, a = report["before"], report["after"]
    print("before: %d/%d preference per writing turn; after: %d/%d; one-sided p %s; "
          "need %d per arm; injection %s" % (
              b["preference"], b["turns"], a["preference"], a["turns"], report["p"],
              report["need"], "STOPPED" if report["stopped"] else "on"))
    return 0



def main(argv):
    parser = argparse.ArgumentParser(prog="tezgah-taste", description=__doc__,
                                     formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = parser.add_subparsers(dest="cmd", required=True)
    mine = sub.add_parser("mine")
    mine.add_argument("--host", choices=("omp", "claude", "all"), default="all")
    mine.add_argument("--root")
    mine.add_argument("--stats", action="store_true")
    mine.add_argument("--out")
    measure = sub.add_parser("measure")
    measure.add_argument("--samples", required=True)
    measure.add_argument("--labels", required=True)
    measure.add_argument("--model", default=tezgah_judge.MODEL)
    measure.add_argument("--json", action="store_true")
    measure.add_argument("--typed", action="store_true",
                         help="require TypeSafe (the decision T1P's ledger trusts)")
    rate = sub.add_parser("rate")
    rate.add_argument("--in", dest="inp", required=True)
    rate.add_argument("--limit", type=int)
    rate.add_argument("--json", action="store_true")
    learn = sub.add_parser("learn")
    learn.add_argument("--from-transcripts", action="store_true")
    learn.add_argument("--host", choices=("omp", "claude", "all"), default="all")
    learn.add_argument("--limit", type=int)
    listing = sub.add_parser("list")
    listing.add_argument("--all", action="store_true")
    for name in ("show", "accept", "reject", "edit"):
        one = sub.add_parser(name)
        one.add_argument("id")
        if name == "edit":
            one.add_argument("--text", required=True)
    sub.add_parser("export")
    label = sub.add_parser("label")
    label.add_argument("id", nargs="?")
    label.add_argument("label", nargs="?")
    label.add_argument("--n", type=int, default=10)
    sub.add_parser("calibrate")
    sub.add_parser("gate")
    for name, p in sub.choices.items():
        if name not in ("mine", "measure", "rate"):
            p.add_argument("--repo")
            if name in ("learn", "list", "calibrate", "gate"):
                p.add_argument("--json", action="store_true")
    args = parser.parse_args(argv[1:])
    handler = {"mine": cmd_mine, "measure": cmd_measure, "rate": cmd_rate,
               "learn": cmd_learn, "list": cmd_list, "show": cmd_one, "accept": cmd_one,
               "reject": cmd_one, "edit": cmd_one, "export": cmd_export,
               "label": cmd_label, "calibrate": cmd_calibrate,
               "gate": cmd_gate}[args.cmd]
    if args.cmd not in ("learn", "accept", "reject", "edit"):
        return handler(args)
    # the commands that rewrite ledger.json: one at a time, or the last one
    # to finish would silently drop what the other wrote
    try:
        repo = store_or_exit(args)
        refused = learn_refusal(repo) if args.cmd == "learn" else None
        if refused:
            return misuse(refused)
        with tl.locked():
            return handler(args)
    except tl.Busy as busy:
        return misuse("the taste ledger is in use (%s); run this again when it ends" % busy)


if __name__ == "__main__":
    sys.exit(main(sys.argv))
