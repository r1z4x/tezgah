def host_checks_dsh():
    try:
        with open(DSH_PATCH, encoding="utf-8") as fh:
            patched = fh.read()
    except OSError:
        patched = ""
    try:
        with open(DSH_WEB_PATCH, encoding="utf-8") as fh:
            web_patch = fh.read()
    except OSError:
        web_patch = ""
    linked = os.path.join(DSH_WEB, "node_modules", DSH_STATUSLINE)
    return [
        ("claude-code hooks bridge in cordis.patch.yml", "dsh-hooks-claude-code" in patched),
        ("MCP bridge in cordis.patch.yml", "dsh-mcp-client" in patched),
        # codegraph's own installer does not know dsh, so this row is written by
        # hand here and nothing else would report it missing
        ("code graph row in cordis.patch.yml", "serverName: codegraph" in patched),
    ] + mcp_rows(dsh_servers(DSH_PATCH), "cordis.patch.yml") + [
        mcp_row(TEZGAH_MCP_NAME, dsh_mcp_entry(patched, TEZGAH_MCP_NAME),
                "cordis.patch.yml", tezgah_mcp_command()),
        ("OpenRouter + DeepSeek + Inception routes in cordis.patch.yml",
         "openrouter" in patched and "DEEPSEEK_API_KEY" in patched
         and "INCEPTION_API_KEY" in patched),
        dsh_launcher_row(),
        ("skills linked", skills_linked(os.path.join(DSH, "skills"))),
        ("OpenRouter route key resolvable (env, ~/.config/openrouter/key or store)",
         dsh_key_resolvable("OPENROUTER_API_KEY")),
        ("DeepSeek route key resolvable (env, ~/.config/deepseek/key or store)",
         dsh_key_resolvable("DEEPSEEK_API_KEY")),
        ("Inception route key resolvable (env, ~/.config/inception/key or store)",
         dsh_key_resolvable("INCEPTION_API_KEY")),
        ("status-line plugin linked into the web profile",
         os.path.exists(linked)),
        ("status-line row in the web cordis.patch.yml", DSH_STATUSLINE in web_patch),
    ]



def omp_hook_answers():
    """Run the omp hook once: it must answer the status event with the marks.

    The installed extension is a bridge, so the only honest check is that the
    python half starts and answers; a hook that cannot start is the difference
    between a status line and an empty line.
    """
    path = os.path.join(HERE, "hosts", "omp", "hook.py")
    try:
        proc = subprocess.run([sys.executable, path],
                              input=json.dumps({"event": "status",
                                                "cwd": os.getcwd()}),
                              capture_output=True, text=True, timeout=20)
    except (OSError, subprocess.SubprocessError):
        return False
    try:
        return bool(json.loads(proc.stdout or "{}").get("status"))
    except ValueError:
        return False


def host_checks_omp():
    hook_path = os.path.join(OMP_AGENT, "hooks", "pre", "tezgah-hook.ts")
    try:
        with open(hook_path, encoding="utf-8") as fh:
            hook_text = fh.read()
    except OSError:
        hook_text = ""
    mcp = read_json(os.path.join(OMP_AGENT, "mcp.json"), {})
    servers = mcp.get("mcpServers") or {}
    agents_dir = os.path.join(OMP_AGENT, "agents")
    agents = ([n for n in os.listdir(agents_dir)
               if n.endswith(".md") and n[:-len(".md")] in tezgah_agents.OWNED_NAMES]
              if os.path.isdir(agents_dir) else [])
    rows = [
        # the byte comparison covers the two marker rows that stood here
        # ("Ponytail", "ADHD-friendly"): a kill switch now removes those
        # paragraphs on purpose, and a present-but-stale block passed them
        ("RULES.md carries the contract (matches a fresh render)",
         rules_current("omp")),
        ("skills linked", skills_linked(os.path.join(OMP_AGENT, "skills"))),
        ("subagents generated", len(agents) >= 4),
        ("MCP in mcp.json", "codegraph" in servers),
    ] + mcp_rows(set(servers), "mcp.json", OMP_SUPERSEDED_MCP) + [
        mcp_row(TEZGAH_MCP_NAME, servers.get(TEZGAH_MCP_NAME),
                "mcp.json", tezgah_mcp_command()),
        ("app MCP command is one executable",
         all(isinstance((servers.get(n) or {}).get("command"), str)
             for n in app_server_names() if n not in OMP_SUPERSEDED_MCP)),
        # byte for byte against a fresh render, as the RULES.md row above: a
        # keyword test passed a bridge an older tree or a hand edit left behind
        ("session, prompt, tool and stop hooks wired (bridge matches a fresh render)",
         bool(hook_text) and hook_text == omp_bridge()),
        # the bridge loads from `extensions:`, not from the directory it sits in
        # (see OMP_EXTENSIONS); a hook file that is not named there draws nothing
        ("hook registered in omp extensions (config.yml)",
         hook_path in (omp_extensions() or [])),
        # omp is the host that spends this key: judge(), auto thinking,
        # unexpected-stop and AI staging fall back to a chat model without it.
        # What resolves it is the env it reads or its own login store, not
        # tezgah's key-file convention, which omp never opens.
        ("TypeSafe (Jev) key resolvable (env or omp login store)",
         tp.have_typesafe_key()),
        # One row per channel: the two disagree in both directions - a key file
        # alone serves the seam, an omp login-store record alone serves omp.
        ("judgement seam key resolvable (env or key file)",
         tp.have_judge_key()),
        ("status line answers", omp_hook_answers()), ("tier models in task.agentModelOverrides and modelRoles.plan/slow", tier_models_current()),
    ]
    # omp reads orx's shim from its native `~/.agents/skills` root (ORX_AGENTS);
    # the row is asked only where orx is selected, as the install is
    if "orx" in tezgah_apps.selected_ids(selection()):
        rows.append(("orx skill in ~/.agents/skills (omp's native agents root)",
                     os.path.isfile(ORX_AGENTS_SKILL)))
    return rows


HOST_CHECKS = {"claude": host_checks_claude, "codex": host_checks_codex,
               "opencode": host_checks_opencode, "cursor": host_checks_cursor,
               "dsh": host_checks_dsh, "omp": host_checks_omp}


def versions_agree():
    """Do the local manifest's two files carry one version?

    Both are untracked (they are the maintainer's), so an absent pair is normal
    and only a present-but-disagreeing pair is a failure."""
    try:
        v = []
        for f in ("plugin.json", "marketplace.json"):
            with open(os.path.join(HERE, ".claude-plugin", f), encoding="utf-8") as fh:
                d = json.load(fh)
            v.append(d["plugins"][0]["version"] if f == "marketplace.json" else d["version"])
        return v[0] == v[1]
    except FileNotFoundError:
        return True
    except Exception:
        return False


# ------------------------------------------------------------------- sync ----

# One file any revision of the checkout carries, so a directory in the plugin
# cache is RECOGNISED as a tezgah copy; freshness is a separate question, asked
# over the whole tree by plugin_copy_current.
PLUGIN_FINGERPRINT = os.path.join("hooks", "tezgah_policy.py")

# The MCP config Claude Code reads, at the plugin root: written into the checkout
# by `--write-mcp-json` (a release step, from the declared default selection) and
# re-rendered into the plugin copy by `sync()`, because the copy is what Claude
# actually loads and a per-user selection cannot live in a committed file.
MCP_JSON = ".mcp.json"

# The files that live at the tree root, are not part of the managed listing, and
# are therefore compared and carried specially by the plugin copy. Three kinds:
# the maintainer's local manifests (the version signal this check exists to
# replace, so a copy without one is still a copy), the generated `VERSION` a
# release artifact carries at its root (a release tree answers `--version` from
# it, a checkout has none), and the generated `.mcp.json` Claude reads from the
# copy - `sync()` re-renders that one from the selection rather than copying the
# checkout's, because the checkout's answers a release-time default. One
# constant, so `plugin_copy_current` and `sync` cannot drift apart on which files
# they treat specially.
PLUGIN_ROOT_FILES = (".claude-plugin/plugin.json", ".claude-plugin/marketplace.json",
                     "VERSION", MCP_JSON)

# The tracked listing of the tree, written by `--write-manifest` at release time.
# A checkout lists itself through git, which cannot go stale; an unpacked release
# tarball has no `.git` and reads this instead, so `plugin_files()` answers in
# both shapes. It is not a file a copy carries, so `managed()` excludes it and
# the listing therefore never lists itself.
MANIFEST = "MANIFEST"
# The paired-outcome lab (plan 062): a maintainer instrument tracked so a
# measurement can be re-run from the repository, never a copy member - its 49
# task trees and arm HOMEs have no business in a host plugin tree or a release.
# `benchmarks/codegraph-bench/` stays: bin/tezgah-doctor loads its probe.
ARM_BENCH = "benchmarks/arm-bench"
# Its test module imports the lab, so it ships only where the lab does.
ARM_BENCH_TEST = "tests/test_arm_bench.py"


def managed(rel):
    """True for a relpath a copy is expected to hold: the tracked tree minus the
    maintainer's `.tezgah/` (the private workspace, never shipped - a plan, a
    research line, a lesson), any bytecode cache, the manifest itself, and a
    `.tezgah-bak` backup (bare or timestamped) - the installer keeps copies of
    a file it overwrote, and a backup is no more a copy member than it is product code.
    Shared by plugin_files() and the copy listing, so the two cannot drift.

    `.tezgah/` is the private workspace and is never a copy member. A checkout
    whose `.tezgah` is a symlink - the shape a tezgah worktree uses - is not
    matched by .gitignore's `/.tezgah/`, which only matches a directory: git
    lists the link as one entry, `tree_sha` cannot read it, and without this
    every copy reported stale. The directory case is excluded here too, so the
    rule does not depend on which shape the workspace has.

    The checkout's own `.mcp.json` is its dev config: its tezgah row names the
    maintainer's clone (`${HOME}/Projects/tezgah/bin/tezgah-mcp`), and a copy
    gets its own render from `sync()` anyway. Listed, it rode the MANIFEST into
    the release tarball and pointed an opened release tree at a path that is
    not there (audit L-12, SEC-12)."""
    return (bool(rel) and rel not in (".tezgah", ARM_BENCH, ARM_BENCH_TEST)
            and not rel.startswith((".tezgah/", ARM_BENCH + "/"))
            and rel != MANIFEST and rel != MCP_JSON
            and not rel.endswith(".tezgah-bak") and "__pycache__" not in rel)


def plugin_files():
    """The relpaths `sync` copies, sorted; None when the tree lists none.

    git is the listing that cannot go stale, so a checkout uses it and the
    `--write-manifest` output is regenerated from the same filter. An unpacked
    release has no `.git` and reads the tracked MANIFEST instead; a tree with
    neither (an unpacked copy from before the manifest existed) is None, which
    is what makes `sync` refuse rather than empty a copy it cannot refill."""
    tracked = subprocess.run(
        ["git", "-C", HERE, "ls-files", "--cached", "--others", "--exclude-standard"],
        capture_output=True, text=True)
    if tracked.returncode == 0:
        # --others includes a new source file that is not committed yet; a plain
        # `ls-files` would drop it from the copy (and delete it from the plugin cache)
        return sorted(f for f in tracked.stdout.splitlines() if managed(f))
    try:
        with open(os.path.join(HERE, MANIFEST), encoding="utf-8") as fh:
            listed = [line.strip() for line in fh]
    except OSError:
        return None
    # an empty or truncated manifest is not a listing: `sync()` deletes what the
    # copy holds and re-copies this, so an unreadable manifest must refuse, not
    # wipe. `tests/test_packaging.py` holds the file to the git listing.
    return sorted(f for f in listed if managed(f)) or None


def write_manifest():
    """Regenerate the tracked MANIFEST from git: the release step, its only writer.

    One filter for both sides - `managed()` - so the generated listing and the
    reader that trusts it cannot disagree about what a copy holds."""
    tracked = subprocess.run(
        ["git", "-C", HERE, "ls-files", "--cached", "--others", "--exclude-standard"],
        capture_output=True, text=True)
    if tracked.returncode != 0:
        print("%s %s needs a git checkout to regenerate" % (NO, MANIFEST))
        return 1
    files = sorted(f for f in tracked.stdout.splitlines() if managed(f))
    with open(os.path.join(HERE, MANIFEST), "w", encoding="utf-8") as fh:
        fh.write("".join(f + "\n" for f in files))
    print("%s %s (%d paths)" % (OK, MANIFEST, len(files)))
    return 0


def write_plugin_agents():
    """Re-render the plugin's tracked `agents/*.md` from tezgah_agents' role
    bodies, the source the per-repo agents are generated from. A plain write,
    not write_if_changed: a tracked file needs no `.tezgah-bak` beside it."""
    for name, text in tezgah_agents.plugin_agents().items():
        path = os.path.join(HERE, "agents", name)
        try:
            with open(path, encoding="utf-8") as fh:
                if fh.read() == text:
                    continue
        except OSError:
            pass
        with open(path, "w", encoding="utf-8") as fh:
            fh.write(text)
        print("%s %s" % (OK, path))
    return 0


def tree_sha(root, files):
    """sha256 over each relpath and its bytes, or None when one is unreadable."""
    h = hashlib.sha256()
    for rel in files:
        h.update(rel.encode() + b"\0")
        try:
            with open(os.path.join(root, rel), "rb") as fh:
                h.update(fh.read())
        except OSError:
            return None
        h.update(b"\0")
    return h.hexdigest()


def plugin_copies():
    """Every installed tezgah plugin copy under ~/.claude/plugins/cache.

    Claude Code runs the plugin from a COPY, never from this checkout, so this
    is the tree its hooks and skills actually come from. A copy is recognised by
    the hook file `sync` writes into it, not by the plugin manifest: the manifest
    is the maintainer's local, untracked file, so a fresh clone (and CI) has
    none and a copy made from it would go unrecognised."""
    cache = os.path.join(HOME, ".claude", "plugins", "cache")
    out = []
    for dirpath, dirnames, _files in os.walk(cache):
        dirnames.sort()
        if os.path.isfile(os.path.join(dirpath, PLUGIN_FINGERPRINT)):
            out.append(dirpath)
    return sorted(out)


def live_plugin_copies():
    """The plugin copies a refresh keeps current: the one installed_plugins.json
    names, or every copy when it names none. An older version dir is Claude's
    cache to collect; refreshing it rewrote a tree no session loads, and its
    staleness turned the report red for nothing."""
    copies = plugin_copies()
    rows = read_json(INSTALLED_PLUGINS, {}).get("plugins") or {}
    named = {os.path.realpath(r.get("installPath") or "")
             for k, v in rows.items() if k.split("@")[0] == "tezgah"
             for r in (v or [])[-1:] if isinstance(r, dict)}
    return [t for t in copies if os.path.realpath(t) in named] or copies


def copy_files(target):
    """Every managed relpath the copy holds.

    A hash over the relpaths the checkout still has cannot see a file the
    checkout STOPPED shipping: the ghost is absent from `files`, so it cannot
    move the hash, and Claude keeps being served a skill that no longer exists.
    Only a `.git` or a bytecode cache a copy accumulated is ignored."""
    out = set()
    for dirpath, dirnames, filenames in os.walk(target):
        dirnames[:] = [d for d in dirnames if d != ".git" and d != "__pycache__"]
        for name in filenames:
            rel = os.path.relpath(os.path.join(dirpath, name), target)
            if managed(rel):
                out.add(rel)
    return out


def _home_relative(value):
    """A string pointing under this machine's home dir, written as `${HOME}/...`.

    The rendered `.mcp.json` is TRACKED and read on another machine, so a value
    naming this machine's home is wrong there; Claude Code expands `${VAR}` in
    this file, which is also how the app servers' output dir is written."""
    return value.replace(HOME, "${HOME}") if value.startswith(HOME) else value


def _host_value(value):
    """`_home_relative` read back: the path the host resolves that string to.

    A check that compared the written string against the argv would report MISS
    on a correctly wired file, so every reader of a written value goes through
    this - it is the same `${HOME}` half of the pair. A None value (no entry to
    compare) passes through unchanged, so the caller reports MISS rather than
    crashing on a host that has no row."""
    if value is None:
        return None
    return value.replace("${HOME}", HOME)


def render_mcp_json(selected=None, root=HERE, templated=True):
    """`.mcp.json` for Claude, rendered from the registry and the selection.

    Hand-kept, this file was the one wiring nobody validated: nothing under bin/
    or hooks/ read or wrote it, so a changed pin reached five hosts and not the
    sixth. Environment values are written with `${HOME}` in place of this
    machine's home dir, because the rendered file is tracked and read on another
    machine (Claude Code expands `${VAR}` in this file).

    The graph row and tezgah's own MCP surface are part of the same render: this
    file is Claude's ONLY MCP channel (no `install_claude` writer exists), so a
    name left out here is a name Claude never gets while the other five hosts
    carry it. `root` is the tree the reader will have - `sync()` renders into the
    plugin copy, and tezgah's row there must name that copy's own
    `bin/tezgah-mcp` rather than a checkout the copy's machine may not have. A
    render into a copy passes `templated=False`: the copy is read on this very
    machine, so `${HOME}` would only stand between it and the file it names."""
    rows = [("codegraph", graph_command(), dict(GRAPH_ENV)),
            (TEZGAH_MCP_NAME, tezgah_mcp_command(root), {})]
    rows += [(srv["name"], list(srv["command"]), srv["env"])
             for srv in app_servers(selected)]
    servers = {}
    for name, argv, env in rows:
        # Every string this file carries goes through the one rule above: a value
        # pointing under this machine's home is written as `${HOME}/...`. The argv
        # is where that rule earns its keep - the graph binary, the interpreter
        # and the checkout are all absolute paths that mean nothing on the machine
        # that reads this tracked file.
        # The tracked template is machine-independent by contract: it names the
        # default `codegraph`, the portable `python3`, and the documented clone
        # location, so the render is byte-identical wherever it runs. A plugin
        # COPY is rendered with this same function but a different root, and it
        # must run on this machine - so every normalization below is scoped to
        # the checkout's own file, and a copy keeps the resolved absolute argv.
        tracked = templated and root == HERE
        if tracked and name == "codegraph":
            argv = [tp.CODEGRAPH] + list(argv[1:])
        if tracked and name == TEZGAH_MCP_NAME:
            argv = ["python3"] + [
                a.replace(root, os.path.join(HOME, "Projects", "tezgah"))
                for a in argv[1:]]
        if templated:
            argv = [_home_relative(a) for a in argv]
            env = {k: _home_relative(v) for k, v in env.items()}
        entry = {"command": argv[0], "args": list(argv[1:])}
        if env:
            entry["env"] = env
        servers[name] = entry
    return json.dumps({"mcpServers": servers}, indent=2) + "\n"


def write_mcp_json(path=None, selected=None, root=HERE, templated=True):
    """Write the rendered file. Returns 0, or 1 when the tree has no registry
    row to render (which would otherwise write an empty file over a good one).
    A render into a plugin copy passes `templated=False`: the copy is read on
    this machine, so `${HOME}` would only stand between it and the file it
    names."""
    if not app_server_names(selected):
        print("%s no MCP server is selected; %s left alone" % (NO, MCP_JSON))
        return 1
    path = path or os.path.join(HERE, MCP_JSON)
    mkdirp(os.path.dirname(path))
    if write_if_changed(path, render_mcp_json(selected, root, templated)):
        print("%s %s" % (OK, path))
    else:
        print("%s %s already current" % (OK, path))
    return 0


def plugin_copy_current(target):
    """True when the copy holds this checkout's whole tracked tree, byte for byte.

    The copy is what Claude runs, so a one-file hash cannot see a change to
    another hook: with hooks/tezgah_policy.py equal on both sides, --install
    reported `ok` while the copy still ran the previous hooks/tezgah_gate.py.
    Both directions are compared: a listed file missing from the copy is caught
    by the hash (`tree_sha` returns None for an unreadable source), and a file
    the copy holds and the checkout does not is caught by the listing, which is
    the direction a hash over existing relpaths can never see.

    The listing is cut to the files this tree really holds, the same files
    `sync()` copies: the MANIFEST names every tracked path, but the npm package
    ships a subset (no `bin/*.py` twin symlinks, no `.github/`, ~143 entries),
    so on an npm install `tree_sha(HERE)` was always None, the row could never
    pass and every `--install` re-copied the plugin (audit M-11b, QA-2)."""
    files = [f for f in plugin_files() or []
             if f not in PLUGIN_ROOT_FILES and os.path.isfile(os.path.join(HERE, f))]
    if not files:
        return False
    want = tree_sha(HERE, files)
    if want is None or want != tree_sha(target, files):
        return False
    return copy_files(target) - set(PLUGIN_ROOT_FILES) == set(files)


# Where `sync()` builds the next copy: beside the cache, not in it, so a staging
# tree a killed run leaves behind is never walked by `plugin_copies()` (it
# carries the fingerprint), and on the same filesystem, so the swap is a rename.
SYNC_STAGE_PREFIX = ".tezgah-sync-"


def _copy_normalised(src, dst):
    """Copy one file into a staged copy, owner-writable only: 0755 for a file
    the tree marks executable, 0644 otherwise, whatever mode the source has. A
    copy that inherited a world-writable checkout file (0666) carried that mode
    into the tree Claude runs."""
    os.makedirs(os.path.dirname(dst), exist_ok=True)
    shutil.copyfile(src, dst)
    os.chmod(dst, 0o755 if os.stat(src).st_mode & 0o100 else 0o644)


def _swap(stage, target):
    """Put the staged tree at `target`, carrying the target's `.git` over.

    ponytail: two renames (target aside, stage in), not one atomic exchange -
    renameat2(RENAME_EXCHANGE) is Linux-only and macOS's renamex_np is not in
    the stdlib - so between them the copy's path is absent for a moment. Each
    failure puts back what it moved; a kill in between is put back by the next
    sync (`_recover_sync`), from the target path written beside the stage."""
    git, staged_git, old = (os.path.join(target, ".git"),
                            os.path.join(stage, ".git"), stage + ".old")
    with open(stage + ".target", "w", encoding="utf-8") as fh:
        fh.write(target)
    moved = os.path.isdir(git)
    if moved:
        os.rename(git, staged_git)
    try:
        os.rename(target, old)
    except OSError:
        if moved:
            os.rename(staged_git, git)
        raise
    try:
        os.rename(stage, target)
    except OSError:
        os.rename(old, target)
        if moved:
            os.rename(staged_git, git)
        raise
    shutil.rmtree(old, ignore_errors=True)
    os.remove(stage + ".target")


def _recover_sync(plugins):
    """Undo what a sync killed mid-swap left beside the cache, then sweep it.

    `<stage>.target` names the copy a swap was replacing. A copy moved aside
    (`<stage>.old`) with nothing at its path is moved back; a `.git` the swap
    had already carried into the stage goes back to the copy that lacks one.
    Only then is the staging debris removed - a sweep before this deleted the
    only copy, `.git` included."""
    if not os.path.isdir(plugins):
        return
    names = sorted(os.listdir(plugins))
    for name in names:
        if not (name.startswith(SYNC_STAGE_PREFIX) and name.endswith(".target")):
            continue
        base = os.path.join(plugins, name[:-len(".target")])
        try:
            with open(base + ".target", encoding="utf-8") as fh:
                target = fh.read().strip()
            if target and not os.path.exists(target) and os.path.isdir(base + ".old"):
                os.rename(base + ".old", target)
                print("%s restored %s (a sync was stopped mid-swap)" % (OK, target))
            if target and os.path.isdir(os.path.join(base, ".git")) \
                    and os.path.isdir(target) \
                    and not os.path.exists(os.path.join(target, ".git")):
                os.rename(os.path.join(base, ".git"), os.path.join(target, ".git"))
        except OSError as exc:
            print("%s could not restore from %s (%s); left in place" % (NO, base, exc))
            continue
    for name in sorted(os.listdir(plugins)):
        # a staging tree a killed run left, once nothing in it is a copy's last
        # bytes: never a copy, never loaded
        if name.startswith(SYNC_STAGE_PREFIX):
            path = os.path.join(plugins, name)
            if os.path.isdir(path):
                shutil.rmtree(path, ignore_errors=True)
            else:
                os.remove(path)


def sync():
    """Copy this checkout over the installed Claude plugin, which is a COPY.

    Each copy is built in a staging tree first and swapped in (`_swap`): the
    old delete-then-copy left a half-empty tree Claude would load when the
    copy failed or the run was killed in between. 1 when any copy failed."""
    cache = os.path.join(HOME, ".claude", "plugins", "cache")
    plugins = os.path.dirname(cache)
    _recover_sync(plugins)
    targets = live_plugin_copies()
    if not targets:
        print("no installed tezgah found under %s (nothing to sync)" % cache)
        return 1
    files = plugin_files()
    if files is None:
        print("nothing to sync from: %s lists no files (no git checkout, no %s)"
              % (HERE, MANIFEST))
        return 1
    failed = False
    for t in targets:
        # A copy that contains this checkout IS this checkout, so replacing it
        # would delete the tree being copied from (someone running the copy's
        # own bin/tezgah-setup). The documented path never does; this says no.
        real, here = os.path.realpath(t), os.path.realpath(HERE)
        if real == here or here.startswith(real + os.sep):
            print("%s skip %s (it holds this checkout)" % (NO, t))
            continue
        stage = tempfile.mkdtemp(prefix=SYNC_STAGE_PREFIX, dir=plugins)
        try:
            # A copy's manifest stays when this tree has none to carry over:
            # without it the copy is not a plugin Claude can load.
            manifest = os.path.join(t, ".claude-plugin")
            if not os.path.isdir(os.path.join(HERE, ".claude-plugin")) \
                    and os.path.isdir(manifest):
                shutil.copytree(manifest, os.path.join(stage, ".claude-plugin"))
            for f in files:
                src = os.path.join(HERE, f)
                if not os.path.isfile(src):
                    # ls-files lists a path deleted in the working tree until
                    # the deletion is staged; copying it would crash the sync
                    # (measured when the README translations were reduced).
                    continue
                _copy_normalised(src, os.path.join(stage, f))
            # The files that live at the tree root rather than in the listing:
            # the plugin manifest is the maintainer's local, untracked file and
            # a copy without one is not a plugin Claude can load, and `VERSION`
            # is the release artifact's version file, which a copy made from one
            # has to answer `--version` with. Carry each over when this checkout
            # has it, and copy nothing when it does not (a checkout has no
            # VERSION).
            for rel in PLUGIN_ROOT_FILES:
                if rel == MCP_JSON:
                    continue  # rendered below, from the selection
                src = os.path.join(HERE, rel)
                if os.path.isfile(src):
                    _copy_normalised(src, os.path.join(stage, rel))
            # Claude reads the MCP config from THIS copy, so it is rendered from
            # the selection rather than carried from the checkout, whose file
            # answers the release-time default and would undo a disable. The
            # copy is also the tree that will read it, so tezgah's own row
            # names the copy's bin/tezgah-mcp - the one path that exists here.
            write_mcp_json(os.path.join(stage, MCP_JSON), root=t)
            _swap(stage, t)
        except (OSError, shutil.Error) as exc:
            shutil.rmtree(stage, ignore_errors=True)
            if os.path.exists(stage + ".target"):
                os.remove(stage + ".target")
            print("%s %s left as it was: the staged copy failed (%s)" % (NO, t, exc))
            failed = True
            continue
        print("%s synced %s (%d files)" % (OK, t, len(files)))
    record_hooks(["claude"])
    print("\nrestart Claude Code: hooks are read once per session.")
    return 1 if failed else 0


def refresh_plugin_copy(hosts):
    """A stale plugin copy is the one gap --install would otherwise leave behind,
    because Claude runs that copy and not this checkout: refresh it exactly as
    `--sync` does rather than duplicating the copy logic.

    The render after the refresh is the half that staleness check cannot see:
    `.mcp.json` is excluded from `plugin_copy_current` in both directions on
    purpose - rendering into the copy must not make a current copy read stale -
    which also means a copy carrying no tezgah row at all is still judged
    current. So a claude install always renders the file into every live copy
    (`live_plugin_copies`) with that copy as the root, the same half `sync()` performs."""
    if "claude" in hosts:
        for t in live_plugin_copies():
            write_mcp_json(path=os.path.join(t, MCP_JSON), selected=selection(), root=t)
        if any(not plugin_copy_current(t) for t in live_plugin_copies()):
            print()
            sync()


# ----------------------------------------------------------------- wizard ----

class WizardAbort(Exception):
    """No answer could be collected: EOF on stdin, or a non-answer repeated past
    WIZ_TRIES. The wizard writes nothing before its final yes, so an abort
    leaves the machine as it was."""


WIZ_TRIES = 5


def _ask(prompt, default, input_fn):
    """One line of input. Empty takes the default; an unusable stdin aborts
    instead of hanging or dumping a traceback, which is what makes a piped or
    already-closed stdin safe."""
    text = "%s [%s] " % (prompt, default) if default else "%s " % prompt
    try:
        raw = input_fn(text)
    except (EOFError, OSError, ValueError, RuntimeError) as exc:
        raise WizardAbort("stdin unusable (%s)" % (str(exc) or "closed"))
    return raw.strip() or default


def _ask_bool(prompt, default, input_fn):
    hint = "[Y/n]" if default else "[y/N]"
    for _ in range(WIZ_TRIES):
        raw = _ask("%s %s " % (prompt, hint), "", input_fn).lower()
        if not raw:
            return default
        if raw in ("y", "yes"):
            return True
        if raw in ("n", "no"):
            return False
        print("  answer y or n")
    raise WizardAbort("no yes/no answer for %r" % prompt)


def parse_hosts(raw):
    """Names, 1-based numbers, or `all` -> host list. None when anything is
    unknown, so the caller re-asks instead of arming half the selection."""
    if raw.strip().lower() == "all":
        return list(ALL_HOSTS)
    picked = []
    for tok in re.split(r"[,\s]+", raw.strip()):
        if not tok:
            continue
        if tok.isdigit() and 1 <= int(tok) <= len(ALL_HOSTS):
            tok = ALL_HOSTS[int(tok) - 1]
        if tok not in ALL_HOSTS:
            return None
        if tok not in picked:
            picked.append(tok)
    return picked or None


def _ask_hosts(default, input_fn):
    present = detected()
    print("\nhosts (%s detected here):" % (", ".join(
        h for h in ALL_HOSTS if present[h]) or "none"))
    for i, h in enumerate(ALL_HOSTS, 1):
        print("  %d) %-9s %s" % (i, h, "detected" if present[h] else "not detected"))
    for _ in range(WIZ_TRIES):
        raw = _ask("arm which hosts?", ",".join(default), input_fn)
        picked = parse_hosts(raw)
        if picked:
            return picked
        if not default and not raw.strip():
            # nothing is detectable here: an empty answer means "arm none", the
            # end state a bare `--install` reaches, not a dead end
            return []
        print("  unknown host; choose from %s" % ", ".join(ALL_HOSTS))
    raise WizardAbort("no valid host selection")


def _ask_features(default, input_fn):
    """Which optional features to wire: one question listing every id's state.

    Replaces the single chrome-devtools yes/no, so a new optional feature joins
    the registry table and appears here instead of growing a sixth question."""
    print("\noptional features (each is wired only when it is selected):")
    for row in tezgah_apps.REGISTRY:
        print("  %-20s %s" % (row["id"],
                              "selected" if row["id"] in default else "not selected"))
    for _ in range(WIZ_TRIES):
        raw = _ask("features (`all`, `none`, or ids separated by commas)",
                   ",".join(default), input_fn)
        if not raw.strip():
            return list(default)
        if raw.strip().lower() == "all":
            return list(tezgah_apps.IDS)
        if raw.strip().lower() == "none":
            return []
        picked = parse_feature_ids(raw)
        if picked is not None:
            return picked
        print("  unknown feature; choose from %s" % ", ".join(tezgah_apps.IDS))
    raise WizardAbort("no valid feature selection")


def _ask_roots(default, input_fn):
    print("\nroots are the directories your repos live in; context and subagents "
          "are scoped to them")
    for _ in range(WIZ_TRIES):
        raw = _ask("roots (%s-separated)" % os.pathsep, os.pathsep.join(default), input_fn)
        picked = [expand(p) for p in raw.split(os.pathsep) if p.strip()]
        # a relative path would be resolved against whatever cwd a later session
        # happens to have, and a file can hold no repos, so both are re-asked
        if picked and all(os.path.isabs(p) and not os.path.isfile(p) for p in picked):
            for p in picked:
                # a root that does not exist yet is legitimate: the repos may not
                # be cloned yet. tezgah never creates it, so say so once.
                if not os.path.isdir(p):
                    print("  note: %s does not exist yet; tezgah will not create it, "
                          "and generates nothing under it until it does" % p)
            return picked
        print("  use absolute paths to directories, e.g. %s/work" % HOME)
    raise WizardAbort("no valid root directory")


def wizard_plan(hosts, roots, deps_off, features, adopt_now):
    """What the wizard is about to do, printed before it does any of it."""
    print("\nthe plan:")
    print("  %s arm: %s" % (OK, ", ".join(hosts) or "none detected"))
    for r in roots:
        print("  %s root %s" % (OK if os.path.isdir(r) else NO, r))
    print("  %s optional tools: %s" % (OK, "skip" if deps_off else
          "install the missing ones over the network (orx, cursor-agent, dsh, pnpm)"))
    # One line per feature id, beside the hosts and the roots: the plan has to
    # name what is about to be wired, and the choice is now a selection rather
    # than one boolean.
    for row in tezgah_apps.REGISTRY:
        print("  %s feature %-20s %s"
              % (OK, row["id"], "wire" if row["id"] in features else "skip"))
    if adopt_now:
        print("  %s retire the predecessor wiring (moved aside, not deleted)" % OK)
    print("  files tezgah rewrites are backed up as <file>.<timestamp>.tezgah-bak "
          "under %s (oldest and newest four kept); an unparseable host config "
          "is refused" % BACKUP_DIR)


def wizard(default_hosts, default_roots, deps_off_default, default_features,
           dry_run=False, input_fn=input):
    """Every question first, then the plan, then the shared apply path. The flags
    supply the defaults, so `--wizard --hosts omp` only asks the rest."""
    print("tezgah setup - press enter to take the value in brackets\n")
    hosts = _ask_hosts(default_hosts, input_fn)
    roots = _ask_roots(default_roots, input_fn)
    deps_off = not _ask_bool("install the missing optional tools (needs the network)?",
                             not deps_off_default, input_fn)
    features = _ask_features(default_features, input_fn)
    pred = predecessors()
    if pred:
        print("\npredecessor wiring still present:")
        for p in pred:
            print("  ?    %s" % p)
    adopt_now = _ask_bool("retire it (moved aside under ~/.config/tezgah/adopted/)?",
                          True, input_fn) if pred else False
    wizard_plan(hosts, roots, deps_off, features, adopt_now)
    if not _ask_bool("\nproceed?", True, input_fn):
        print("nothing was installed; `tezgah-setup --install` runs the same steps "
              "with no questions")
        return 0
    global FEATURES
    FEATURES = list(tezgah_apps.selected_ids(features))
    if adopt_now:
        adopt()
    return install_all(hosts, roots, deps_off, dry_run, redetect=False)


# ------------------------------------------------------------------- main ----

# packaging/upgrade.sh owns the whole version move: fetch, checksum, unpack,
# flip `current`. install.sh (a first install) and `tezgah-setup --upgrade` both
# call it rather than re-implementing it, so a version is unpacked in one place.
# Windows has no `bash` to run it, and packaging/install.ps1 does the same move
# there (`-NoInstall` leaves the re-arm to upgrade()).
UPGRADE = os.path.join(HERE, "packaging", "upgrade.sh")
UPGRADE_PS1 = os.path.join(HERE, "packaging", "install.ps1")


def upgrade(version, dry_run):
    """Move the install tree to `version` and re-arm the hosts that are armed.

    Two steps, and the second is why this is one command: `packaging/upgrade.sh`
    unpacks the release and flips `<prefix>/current`, and the NEW tree's
    installer then re-runs the wiring - this process started from the old tree,
    so its farm links would point back into it. The hosts and roots come from
    config.json, so an upgrade does not re-ask the install questions. Nothing
    else calls this: a flag never upgrades tezgah as a side effect of another
    (hooks/tezgah_policy.py:792). Prints every step before running it, and
    `--dry-run` stops after the printing."""
    cfg = tp.config()
    hosts = cfg.get("hosts") or detected_hosts()
    roots = cfg.get("roots") or []
    if os.name == "nt":
        script = UPGRADE_PS1
        cmd = ["powershell", "-NoProfile", "-ExecutionPolicy", "Bypass", "-File",
               script, "-Prefix", INSTALL_PREFIX, "-NoInstall"]
        if version:
            cmd += ["-Version", version]
    else:
        script = UPGRADE
        cmd = ["bash", script, "--prefix", INSTALL_PREFIX]
        if version:
            cmd += ["--version", version]
    print("upgrade: %s -> %s" % (version or "the newest release", INSTALL_PREFIX))
    print("  fetch/unpack: %s" % " ".join(cmd))
    print("  re-arm: %s (roots: %s)"
          % (", ".join(hosts) or "no host", ", ".join(roots) or "default"))
    if dry_run:
        print("  --dry-run: nothing fetched, nothing unpacked, nothing re-armed")
        return 0
    if not os.path.isfile(script):
        print("%s no %s - this tree carries no packaging/ layer, so it cannot "
              "upgrade itself" % (NO, script))
        return 1
    if not shutil.which(cmd[0]):
        print("%s no `%s` on PATH to run %s, so this install cannot upgrade "
              "itself" % (NO, cmd[0], script))
        return 127
    import tezgah_update
    old = tezgah_update.installed_entries(hosts)
    proc = subprocess.run(cmd)
    if proc.returncode != 0:
        print("%s %s exited %d; tezgah was not re-armed"
              % (NO, script, proc.returncode))
        return proc.returncode
    launcher = os.path.join(INSTALL_PREFIX, "current", "bin", "tezgah-setup")
    if not os.path.isfile(launcher):
        # a prefix with no `current` tree to run (a machine upgraded from a
        # checkout): re-arm from this tree rather than leave the hosts wired to
        # a tree the flip just moved away from
        print("%s %s is absent; re-arming from %s" % (NO, launcher, HERE))
        launcher = os.path.join(HERE, "bin", "tezgah-setup")
    argv = [sys.executable, launcher, "--install", "--no-deps",
            "--prefix", INSTALL_PREFIX]
    if hosts:
        argv += ["--hosts", ",".join(hosts)]
    if roots:
        argv += ["--roots", os.pathsep.join(roots)]
    print()
    if not tezgah_update.confirm_rearm(old, launcher):
        print("%s fetched, not re-armed: %s. Re-arm later with `%s`"
              % (NO, tezgah_update.NOT_REARMED["prefix"], " ".join(argv)))
        return 1
    return subprocess.run(argv).returncode


def detected_hosts():
    """The hosts present here, in ALL_HOSTS order."""
    return [h for h, present in detected().items() if present]


def unarmed_new_hosts(armed, before, after):
    """Hosts that only appeared while the tools were being installed and are not
    in `armed`. `before` keeps this to what the install itself made available,
    so the hosts the user deliberately left out are not reported back at them."""
    return [h for h in after if h not in before and h not in armed]


def install_all(hosts, new_roots, deps_off, dry_run, redetect):
    """The one install path, shared by `--install` and the wizard: the wizard
    decides the answers, never how they are applied."""
    late, still = [], []
    if not deps_off:
        before = detected_hosts()
        still = install_deps(dry_run=dry_run)
        if redetect:
            # a just-installed tool can enable a host we did not detect at start
            hosts = detected_hosts()
        else:
            late = unarmed_new_hosts(hosts, before, detected_hosts())
    print("installing for: %s\n" % (", ".join(hosts) or "none detected"))
    if late:
        print("%s %s appeared while the tools were being installed, but only the "
              "hosts in the plan were armed; add it with "
              "`tezgah-setup --install --hosts %s`" % (NO, ", ".join(late), ",".join(late)))
    install_common(new_roots, hosts)
    # before the host installers: opencode's generated skill router indexes
    # the orx skill dir, so the shim must exist when the router is written.
    # The registry is the one place orx is described, so its row is the switch:
    # a deselected orx runs no command, and the line says so rather than the
    # step being stepped over in silence.
    if "orx" in tezgah_apps.selected_ids(selection()):
        install_openresearch(hosts)
    else:
        print("\nopenresearch (orx):\n%s skipped: orx is not selected" % NO)
    # cursor last: link_cursor_skills reads the skill links the other hosts made
    for h in sorted(hosts, key=lambda h: h == "cursor"):
        INSTALLERS[h]()
    for dst in sweep_backups():
        print("%s moved a backup out of a host dir: %s" % (OK, dst))
    refresh_plugin_copy(hosts)
    record_hooks(hosts)
    print()
    if deps_off:
        print("(deps skipped; run `tezgah-setup --deps` to install orx, and "
              "`--deps --host-deps` for cursor-agent, pnpm and dsh)")
    missed = report(hosts)
    if missed:
        print("\n%s not armed: %s" % (NO, "; ".join(missed)))
    if REFUSED:
        print("\n%s refused to rewrite: %s" % (NO, ", ".join(REFUSED)))
    # A requested tool that is still missing is a failed step, not a footnote:
    # the run used to exit 0 after a refused download (audit M-9, GAP-06).
    if still:
        print("\n%s still missing: %s (see `dependencies:` above)"
              % (NO, ", ".join(still)))
        return 1
    # A planned host the run could not arm is a failed install too: the run
    # printed MISS under it and exited 0, so `curl | sh` reported success.
    return 1 if missed or REFUSED else 0


def main(argv):
    ap = argparse.ArgumentParser(description="arm tezgah in every installed host; "
                                 "`tezgah update [--dry-run]` moves this install "
                                 "to the newest release and re-arms it")
    ap.add_argument("--install", action="store_true")
    ap.add_argument("--wizard", action="store_true",
                    help="ask the install questions (a bare run on a terminal does this)")
    ap.add_argument("--report", action="store_true",
                    help="report what is armed, per host (a bare run on a pipe does this)")
    ap.add_argument("--live", action="store_true",
                    help="with the report: run one synthetic tool event through "
                         "each host's own hook wiring and require a ledger row")
    ap.add_argument("--refresh", action="store_true",
                    help="re-render every always-on contract file of the armed "
                         "hosts (after a policy edit or a kill switch)")
    ap.add_argument("--uninstall", action="store_true")
    ap.add_argument("--adopt", action="store_true")
    ap.add_argument("--sync", action="store_true")
    ap.add_argument("--hook-entries", action="store_true",
                    help="print the hook entries this tree arms, per armed host, "
                         "as JSON (`tezgah update` diffs them before re-arming)")
    ap.add_argument("--status", nargs="?", const=os.getcwd())
    ap.add_argument("--agents", nargs="?", const=os.getcwd(),
                    help="regenerate this repo's subagent set (default: cwd)")
    ap.add_argument("--write-manifest", action="store_true",
                    help="release: regenerate the tracked MANIFEST from git")
    ap.add_argument("--write-plugin-agents", action="store_true",
                    help="release: re-render the plugin's agents/ from the role source")
    ap.add_argument("--deps", action="store_true")
    ap.add_argument("--mcp-schemas", action="store_true",
                    help="measure the MCP tool-schema band by asking each server")
    ap.add_argument("--no-deps", action="store_true")
    ap.add_argument("--host-deps", action="store_true",
                    help="also install the missing third-party host CLIs "
                         "(cursor-agent, pnpm, dsh); without it their commands "
                         "are printed, not run")
    ap.add_argument("--devtools", action="store_true",
                    help="sugar for --enable %s" % DEVTOOLS_FEATURE)
    ap.add_argument("--features", action="store_true",
                    help="list every feature id with its default, its selection "
                         "and its dependency state")
    ap.add_argument("--enable", metavar="ID[,ID]",
                    help="select features and persist the choice (config.json)")
    ap.add_argument("--disable", metavar="ID[,ID]",
                    help="deselect features and persist the choice; unwires them, "
                         "uninstalls nothing")
    ap.add_argument("--write-mcp-json", action="store_true",
                    help="release: re-render the tracked .mcp.json from the "
                         "registry and the declared default selection")
    ap.add_argument("--dry-run", action="store_true",
                    help="preview: the optional-tool install runs nothing, and "
                         "--uninstall prints what it would remove")
    # the install prefix a released artifact unpacks into, and the root
    # `is_tezgah_link` judges a farm link against besides this checkout
    ap.add_argument("--prefix", metavar="DIR",
                    help="install prefix (default: TEZGAH_PREFIX, else what "
                         "this tree or an earlier install recorded, else "
                         "XDG_DATA_HOME/tezgah, else ~/.local/share/tezgah)")
    # bare `--upgrade` takes the newest release; the version is optional because
    # a team that pins one passes it and everyone else takes what is current
    ap.add_argument("--upgrade", nargs="?", const="", metavar="VERSION",
                    help="fetch and unpack a release (default: the newest) into "
                         "the prefix, flip `current`, re-arm the installed hosts")
    # the one version reader (hooks/tezgah_context.py): the status line's prefix
    # prints the same value, and `unknown` is what a checkout carrying neither
    # the local manifest nor a changelog answers
    ap.add_argument("--version", action="version",
                    version=tezgah_context.version() or "unknown")
    ap.add_argument("--roots")
    ap.add_argument("--hosts")
    ap.add_argument("--reply-lang", choices=tp.REPLY_LANGS,
                    help="with --install: the language replies are asked for and "
                         "the Stop rule checks (config.json `reply_lang`; `tr` "
                         "when unset, `any` checks none)")
    # `--version` is argparse's print-and-exit action, so `--upgrade --version V`
    # would print the current version, exit 0 and move nothing at all - the
    # "reads as done, did nothing" shape this repo hunts. Refused by name here,
    # before parse_args can swallow it: the version goes positionally.
    if "--version" in argv[1:] and any(a.startswith("--upgrade") for a in argv[1:]):
        sys.stderr.write(
            "tezgah-setup: --version prints the current version and stops, so it "
            "cannot name the version to upgrade to; write "
            "`tezgah-setup --upgrade VERSION`\n")
        return 2
    # `tezgah update` is the one subcommand: argparse has no positional for it,
    # so it is taken off before the flags are parsed (`--dry-run` still reads)
    command = argv[1:2] == ["update"]
    args = ap.parse_args(argv[2:] if command else argv[1:])
    global FEATURES, INSTALL_PREFIX, HOST_DEPS, REPLY_LANG
    HOST_DEPS = args.host_deps
    REPLY_LANG = args.reply_lang
    select_code = 0
    # --devtools is --enable <id> and nothing else: one code path, so the flag
    # cannot reach the selection in a way the explicit command does not.
    enable = args.enable or (DEVTOOLS_FEATURE if args.devtools else None)
    if args.prefix:
        # the flag wins over TEZGAH_PREFIX, which won over the rest at import:
        # an argument typed for this run is the most specific answer
        INSTALL_PREFIX = os.path.realpath(expand(args.prefix))
    elif not PREFIX_PINNED:
        # nothing explicit was given, so an install's own answer decides: the
        # tree this process runs from (a release tree says where it lives, and
        # `packaging/install.sh` starts the installer without a --prefix), then
        # the prefix a previous install recorded, then the XDG default
        INSTALL_PREFIX = (running_prefix()
                          or tp.config().get("prefix") or INSTALL_PREFIX)

    # before every other branch: an upgrade is asked for by name or not at all,
    # and --dry-run must reach it without fetching anything
    if args.upgrade is not None:
        return upgrade(args.upgrade, args.dry_run)
    if command:
        import tezgah_update
        return tezgah_update.update(HERE, running_prefix(), upgrade, args.dry_run)

    if args.sync:
        return sync()
    if args.hook_entries:
        hosts = tp.config().get("hosts") or ALL_HOSTS
        print(json.dumps(hook_entries(hosts), indent=1, sort_keys=True))
        return 0
    if args.write_mcp_json:
        return write_mcp_json()
    if args.features:
        features_report()
        return 0
    if args.refresh:
        paths = refresh_contract()
        for path in paths:
            print("%s refreshed %s" % (OK, path))
        if not paths:
            print("contract is current")
        return 0
    if args.write_manifest:
        return write_manifest()
    if args.write_plugin_agents:
        return write_plugin_agents()
    if args.status:
        print(tezgah_context.health_lines(os.path.realpath(expand(args.status))))
        # The install-health half of this report, from the same function the
        # `--report` row uses (hosts_row), printed here because a session checks
        # its own health with --status rather than with a full report. Only when
        # it fails: the marks above are this branch's answer, and a row that can
        # only say `ok` is a line every run pays for and nobody reads.
        label, ok = hosts_row()
        if not ok:
            print("%s%s" % (NO, label))
        # Orca's presence, and whose codex home CODEX_HOME names: printed only
        # where Orca is installed or this shell runs inside it.
        orca = tezgah_orca.summary(CODEX)
        if orca:
            print(orca)
        return 0
    if args.deps and not args.install:
        return 1 if install_deps(dry_run=args.dry_run) else 0
    if args.mcp_schemas:
        mcp_schema_report()
        return 0

    if args.agents:
        repo = tezgah_context.repo_root(os.path.realpath(expand(args.agents)))
        note = tezgah_agents.sync_root(repo, report_steady=True)
        print(note or "no agents generated (outside a root, or no capability)")
        return 0

    hosts = [h.strip() for h in args.hosts.split(",")] if args.hosts else detected_hosts()
    bad = [h for h in hosts if h not in ALL_HOSTS]
    if bad:
        sys.exit("unknown host(s): %s (choose from %s)" % (", ".join(bad), ", ".join(ALL_HOSTS)))

    # A bare run in a terminal is a person, so it gets the wizard; a piped,
    # agent or CI run keeps the non-interactive report.
    bare_tty = not argv[1:] and sys.stdin.isatty() and sys.stdout.isatty()
    wizard_mode = (args.wizard or bare_tty) and not args.report

    if args.uninstall:
        uninstall(hosts, dry_run=args.dry_run)
        return 0

    # A selection change is its own command: it persists the choice and brings
    # every host the install recorded along, so `--enable`/`--disable` reach the
    # writers without re-deciding which hosts are armed. `--install` given beside
    # it continues into the install path with the new selection in force.
    if (enable or args.disable) and not wizard_mode:
        picked = parse_feature_ids(enable)
        dropped = parse_feature_ids(args.disable)
        if (enable and picked is None) or (args.disable and dropped is None):
            bad = enable if (enable and picked is None) else args.disable
            sys.stderr.write("unknown feature id in %r; choose from %s\n"
                             % (bad, ", ".join(tezgah_apps.IDS)))
            return 1
        recorded = tp.config().get("hosts") or []
        # TEZGAH_NO_DEPS is the CI/test escape hatch, mirroring --no-deps; it has
        # to cover this path too, since this is the one that installs on demand
        deps_off = args.no_deps or os.environ.get("TEZGAH_NO_DEPS",
                                                  "").strip() not in ("", "0")
        select_code = select_features(picked, dropped,
                                      hosts if args.hosts else (recorded or hosts),
                                      args.dry_run, deps_off)
        # a missing dependency of an enabled feature fails the run, but an
        # `--install` beside it still arms the hosts first
        if not (args.install or args.report):
            return select_code

    # --adopt retires the predecessor wiring before an install, but under the
    # wizard it waits: the wizard asks about it and adopts only after the yes, so
    # nothing is written before the plan is confirmed.
    if args.adopt and not wizard_mode:
        adopt()
        if not args.install:
            return 0

    new_roots = [r for r in args.roots.split(os.pathsep) if r.strip()] if args.roots else []
    # TEZGAH_NO_DEPS is the CI/test escape hatch, mirroring --no-deps
    deps_off = args.no_deps or os.environ.get("TEZGAH_NO_DEPS", "").strip() not in ("", "0")

    if wizard_mode:
        try:
            # The flags supply the defaults, so --devtools pre-answers the
            # feature question rather than being a second path through it.
            default_features = list(tezgah_apps.selected_ids(selection()))
            if args.devtools and DEVTOOLS_FEATURE not in default_features:
                default_features.append(DEVTOOLS_FEATURE)
            return wizard(hosts, new_roots or tp.roots() or [tp.DEFAULT_ROOT],
                          deps_off, default_features, args.dry_run)
        except WizardAbort as exc:
            print("wizard: %s" % exc)
            print("nothing was installed; `tezgah-setup --install` runs the same "
                  "steps with no questions")
            return 1

    if args.install:
        return (install_all(hosts, new_roots, deps_off, args.dry_run,
                            redetect=not args.hosts) or select_code)

    if args.roots:
        sys.exit("--roots only means something with --install")
    report(hosts)
    if args.live:
        return live_report(hosts) or select_code
    return select_code


def hosts_row():
    """config.json's `hosts` against the hosts whose wiring is on disk (each
    host's first HOST_CHECKS row), as one report row. Reported, never changed:
    `--upgrade`, `--enable`/`--disable` and a full uninstall act on the recorded
    list, so a host wired but not recorded is one they skip, and which list is
    right is the user's call (`--install --hosts ...` records it)."""
    recorded = sorted(tp.config().get("hosts") or [])
    wired = sorted(h for h in ALL_HOSTS if HOST_CHECKS[h]()[0][1])
    return ("config.json hosts (%s) match the hosts wired (%s)"
            % (", ".join(recorded) or "none", ", ".join(wired) or "none"),
            recorded == wired)


# --- tier models on omp ------------------------------------------------------

def register_omp(hook_dst):
    """The bridge in omp's `extensions`, then the tier workers' models in
    `task.agentModelOverrides` (hooks/tezgah_models.py), the user's entries kept."""
    register_omp_hook(hook_dst)
    status = tezgah_agents.tm.apply_omp()
    mark = OK if status and tezgah_agents.tm.FAIL_MARK not in status and \
        tezgah_agents.tm.SKIP_MARK not in status else (
            " skip " if status and tezgah_agents.tm.SKIP_MARK in status else NO)
    print("%s %s" % (mark, status or "omp not answering: tier model overrides not written"))


def unregister_omp(hook_dst):
    """Undo register_omp: the bridge and every tezgah-* model override."""
    unregister_omp_hook(hook_dst)
    status = tezgah_agents.tm.apply_omp(remove=True)
    if status:
        print("%s %s" % (OK if tezgah_agents.tm.FAIL_MARK not in status else NO, status))


def tier_models_current():
    """Every tezgah-* override omp should carry is there, with the table's model,
    and so is every role the table pins: `modelRoles.plan` and `.slow` hold the
    frontier row, so a wrong or missing plan role is a missing row rather than a
    pass."""
    tm = tezgah_agents.tm
    current = tm.omp_get("task.agentModelOverrides") or {}
    roles = tm.omp_get("modelRoles") or {}
    written = tm.overlay().get("omp_written") or {}
    mode = tm.omp_mode(roles.get("default"))

    def ours(key, cur, want):
        # the row asks whether OUR entries are there. A value the user set by hand
        # is not a missing row - nothing could repair it, and prompting for one
        # forever is the fault this row was already fixed for once; `written` is
        # the same ownership record `apply_omp` writes with.
        return cur == want or (cur is not None and written.get(key) != cur)

    want = tm.omp_overrides(mode)
    want_roles = tm.omp_role_overrides(mode)
    # `off`, and the credential-less `any`, want nothing: `all(())` is True
    return (all(ours(k, current.get(k), v) for k, v in want.items()) and
            all(ours(k, roles.get(k.split(".", 1)[-1]), v)
                for k, v in want_roles.items()))


if __name__ == "__main__":
    sys.exit(main(sys.argv))
