ORX_AGENTS = {"claude": "claude", "codex": "codex",
              "opencode": "opencode", "cursor": "cursor"}
CONTRACT_SHA = os.path.join(tp.CONFIG_DIR, "contract.sha256")
SKILL_ROUTER = os.path.join(tp.CONFIG_DIR, "opencode-skills.md")
