{
  "id": "t06-readonly-impact",
  "family": "read-only-impact",
  "prompt": "prompt.md",
  "allow": ["ANSWER.md"],
  "allow_note": "the answer is the only artefact; every source file is read-only",
  "checks": [
    {"name": "answer", "cmd": "python3 {hidden}/check_answer.py", "expect_exit": 0}
  ],
  "baseline_expect": "fail",
  "gold_expect": "pass"
}
