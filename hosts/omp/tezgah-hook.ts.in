import { execFileSync } from "node:child_process";

const PRETOOLUSE = "@PRETOOLUSE@";

function gate(tool: string, input: unknown, cwd: string): string | undefined {
  try {
    const out = execFileSync("python3", [PRETOOLUSE], {
      input: JSON.stringify({
        hook_event_name: "PreToolUse",
        cwd,
        tool_name: tool,
        tool_input: input ?? {},
      }),
      cwd,
      encoding: "utf8",
      timeout: 10000,
    });
    if (!out.trim()) return undefined;
    const data = JSON.parse(out);
    return data?.hookSpecificOutput?.permissionDecisionReason;
  } catch {
    return undefined;
  }
}

export default function tezgahOmp(pi: any): void {
  pi.on("tool_call", async (event: any) => {
    const tool = String(event?.toolName ?? event?.name ?? "");
    if (!["grep", "bash", "shell"].includes(tool)) return;
    const reason = gate(tool, event?.input ?? event?.args, process.cwd());
    if (reason) return { block: true, reason };
    return undefined;
  });
}
