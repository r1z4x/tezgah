#!/usr/bin/env python3
"""tezgah-setup - arm every host you have from this one checkout.

  tezgah-setup                         on a terminal: the install wizard
  tezgah-setup --report                report what is armed, per host
  tezgah-setup --wizard                the same wizard, forced (also on a pipe)
  tezgah-setup --install               wire every detected host
  tezgah-setup --install --hosts omp
  tezgah-setup --install --hosts claude,codex,cursor,opencode,dsh
  tezgah-setup --roots ~/work:~/oss --install
  tezgah-setup --uninstall             remove everything tezgah installed
  tezgah-setup --version               print the plugin version
  tezgah-setup --adopt                 move the predecessor wiring aside
  tezgah-setup --sync                  dev: copy this checkout over the Claude plugin copy
  tezgah-setup --write-manifest        release: regenerate the tracked MANIFEST from git
  tezgah-setup --write-plugin-agents   release: re-render the plugin's agents/ from the role source
  tezgah-setup --status [PATH]         print the armed/used checklist
  tezgah-setup --agents [PATH]         regenerate this repo's subagent set
  tezgah-setup --deps [--dry-run]      install missing optional tools only
  tezgah-setup --install --no-deps     arm hosts without installing tools
  tezgah-setup --install --host-deps   also install missing host CLIs (cursor-agent, pnpm, dsh)
  tezgah-setup --prefix DIR            install prefix (default ~/.local/share/tezgah)
  tezgah-setup --upgrade [VERSION]     fetch a release into the prefix, re-arm
  tezgah-setup --upgrade --dry-run     say what an upgrade would do, run nothing

Claude Code installs from a plugin; the other four do not have that channel,
so they are wired here: Codex hooks.json + skills, Cursor hooks.json + skills,
opencode plugins + instructions + skills, dsh's managed patch block, and the
shared MCP registration.
Re-running is idempotent; every write that changes a file first copies it to
<file>.<timestamp>.tezgah-bak (the oldest and the newest four are kept), and a
host config that does not parse as a JSON object is refused, never rewritten.
"""
