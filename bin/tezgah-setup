DSH = os.environ.get("DSH_HOME") or os.path.join(HOME, ".dsh")
DSH_PATCH = os.path.join(DSH, "cordis.patch.yml")
DSH_WEB = os.path.join(DSH, "profiles", "web")
DSH_WEB_PATCH = os.path.join(DSH_WEB, "cordis.patch.yml")
