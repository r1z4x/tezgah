def skills_linked(base):
    """True when every shipped skill resolves to a readable SKILL.md under
    `base`. `islink` alone called a dangling link installed: a name in SKILLS
    whose skill file was never written reported as linked on every host at once,
    while no host could read it."""
    return all(os.path.isfile(os.path.join(base, s, "SKILL.md"))
               for s in SKILLS)


