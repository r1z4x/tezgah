HOME = os.path.expanduser("~")
# Where a released artifact unpacks: <prefix>/<version> plus a `current` symlink
# to the active one. XDG_DATA_HOME is honoured and TEZGAH_PREFIX wins outright,
# and main() resolves the prefix a flag, that env var, the tree this process is
# running from, or the prefix an install recorded - in that order - because "is
# this link tezgah's?" has to accept an install tree exactly as it accepts this
# checkout: a version flip moves what `current` points at, and a link judged by
# the checkout alone is orphaned by every upgrade.
PREFIX_ENV = "TEZGAH_PREFIX"
INSTALL_PREFIX = os.path.realpath(
    os.environ.get(PREFIX_ENV)
    or os.path.join(os.environ.get("XDG_DATA_HOME")
                    or os.path.join(HOME, ".local", "share"), "tezgah"))
# True when the prefix came from the environment rather than from the computed
# default: an explicit answer outranks both fallbacks main() resolves (the tree
# that is running, and the prefix an install recorded).
PREFIX_PINNED = bool(os.environ.get(PREFIX_ENV))


def running_prefix():
    """The install prefix this tree is running from, or "" when it is a checkout.

    `<prefix>/<version>/bin/tezgah-setup` with `<prefix>/current` pointing back
    at it is exactly the released layout, and the running tree is the one piece
    of evidence that cannot be stale about where it lives. It is needed because
    `packaging/install.sh` runs this installer from the tree it just unpacked,
    without a --prefix to pass on: without this, a first `--upgrade` from an
    artifact would aim at ~/.local/share/tezgah wherever the user put the tree."""
    prefix = os.path.dirname(HERE)  # HERE is <prefix>/<version>, two levels above bin/
    current = os.path.join(prefix, "current")
    if os.path.isdir(prefix) and os.path.islink(current) \
            and os.path.realpath(current) == HERE:
        return prefix
    return ""
