__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
.DS_Store

# local research notes: kept out of the public repo, never published
/docs/research/

# tezgah: generated agents (managed; removed by tezgah-setup --uninstall)
/.claude/agents/
/.codex/agents/
/.opencode/agents/
# tezgah: end generated agents

# local state: the lessons ledger, the research lines, and the local plugin
# manifest are the maintainer's, not repository content. No trailing slash: a
# linked worktree shows `.tezgah` as a symlink to the main checkout's workspace,
# and `/.tezgah/` matches a directory only, so every worktree read as dirty and
# its implementation phase began with a `checkpoint: pending` that only a commit
# adding the link to the repository could clear (plan 108).
/.tezgah
/.claude-plugin/

# codegraph index (an internal spike; the directory carries its own .gitignore that
# un-ignores its marker file, so the directory itself stays visible without this)
/.codegraph/

# release build output: packaging/build.sh writes the tarball and its checksum
# here, and a rebuild is byte-identical, so the artifact is never repository
# content - the release upload is the channel that carries it
/dist/
