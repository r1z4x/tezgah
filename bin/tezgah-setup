                "opencode": uninstall_opencode, "cursor": uninstall_cursor,
                "dsh": uninstall_dsh, "omp": uninstall_omp}


def uninstall(hosts):
    print("uninstalling for: %s\n" % (", ".join(hosts) or "none detected"))
    uninstall_common()
    for h in hosts:
        UNINSTALLERS[h]()
    print("\nnon-tezgah files and .tezgah-bak backups were left untouched.")


# ------------------------------------------------------------------ adopt ----

def _move(path, dest_dir):
    if not os.path.exists(path):
        return False
    mkdirp(dest_dir)
    shutil.move(path, os.path.join(dest_dir, os.path.basename(path)))
    return True


def adopt():
    """Retire the pre-tezgah wiring: the Codex projects-harness, the ~/.claude
    cbm-* hook files and their settings.json entries. Nothing is deleted - it is
    moved under ~/.config/tezgah/adopted/<timestamp>/."""
    stamp = datetime.datetime.now().strftime("%Y%m%d-%H%M%S")
    dest = os.path.join(tp.CONFIG_DIR, "adopted", stamp)
    print("adopt: moving predecessor wiring to %s\n" % dest)

    # Codex: projects-harness dir + its hooks.json entries
    print("%s projects-harness" % (OK if _move(os.path.join(CODEX, "projects-harness"),
                                               dest) else NO))
    path = os.path.join(CODEX, "hooks.json")
    data = read_json(path, None)
    if data:
        for ev, arr in list((data.get("hooks") or {}).items()):
            arr[:] = [e for e in arr
                      if "projects-harness" not in json.dumps(e)
                      and "Code discovery: prefer" not in json.dumps(e)]
        data["hooks"] = {ev: arr for ev, arr in (data.get("hooks") or {}).items() if arr}
        if not data["hooks"]:
            data.pop("hooks", None)
        write_json(path, data)
        print("%s cleaned %s" % (OK, path))

    # Claude: the cbm-* hook scripts and the settings.json entries that call them
    for name in ("cbm-code-discovery-gate", "cbm-session-reminder", "cbm-subagent-reminder"):
        print("%s ~/.claude/hooks/%s" % (OK if _move(os.path.join(CLAUDE, "hooks", name),
                                                     dest) else NO, name))
    # Codex: the old bin shims that exec'd projects-harness
    for name in ("codex-harness-status", "consult"):
        f = os.path.join(CODEX, "bin", name)
        if os.path.isfile(f) and not os.path.islink(f):
            try:
                stale = "projects-harness" in open(f).read()
            except OSError:
                stale = False
            if stale:
                print("%s ~/.codex/bin/%s" % (OK if _move(f, dest) else NO, name))
    sp = os.path.join(CLAUDE, "settings.json")
    settings = read_json(sp, None)
    if settings:
        changed = False
        for ev, arr in (settings.get("hooks") or {}).items():
            kept = []
            for entry in arr:
                hs = entry.get("hooks")
                if isinstance(hs, list):
                    before = len(hs)
                    hs[:] = [h for h in hs if "cbm-" not in h.get("command", "")]
                    changed = changed or len(hs) != before
                    if not hs:
                        continue
                kept.append(entry)
            arr[:] = kept
        if changed:
            settings["hooks"] = {ev: arr for ev, arr in (settings.get("hooks") or {}).items() if arr}
            if not settings["hooks"]:
                settings.pop("hooks", None)
            write_json(sp, settings)
            print("%s cleaned cbm hook entries from %s" % (OK, sp))
        else:
            print("%s no cbm hook entries in %s" % (OK, sp))
    print("\nrestart each host for the hooks to reload.")


# ----------------------------------------------------------------- report ----

def predecessors():
    """Pre-tezgah wiring still present; --adopt retires it."""
    out = []
    if os.path.isdir(os.path.join(CODEX, "projects-harness")):
        out.append("~/.codex/projects-harness present")
    if _hooks_has(os.path.join(CODEX, "hooks.json"), "projects-harness"):
        out.append("projects-harness entries in ~/.codex/hooks.json")
    if any(os.path.exists(os.path.join(CLAUDE, "hooks", n)) for n in
           ("cbm-code-discovery-gate", "cbm-session-reminder", "cbm-subagent-reminder")):
        out.append("~/.claude/hooks/cbm-* present")
    if "cbm-" in json.dumps(read_json(os.path.join(CLAUDE, "settings.json"), {})):
        out.append("cbm hook entries in ~/.claude/settings.json")
    return out


def _frontmatter_description(path):
    """Return the joined `description:` block from a SKILL.md frontmatter."""
    try:
        with open(path) as fh:
            text = fh.read()
    except OSError:
        return ""
    if not text.startswith("---"):
        return ""
    body = text.split("---", 2)[1]
    out, collecting = [], False
    for line in body.splitlines():
        if re.match(r"^description:\s*", line):
            collecting = True
            out.append(re.sub(r"^description:\s*[>|]?\s*", "", line))
            continue
        if collecting:
            if re.match(r"^\S", line):
                break
            out.append(line.strip())
    return " ".join(part for part in out if part).strip()


def context_budget():
    """Always-on context tezgah injects, as (label, chars) rows + on-demand size.

    Approximate and host-side only: it counts the rendered contract, the
    per-turn reminder and the skill/subagent metadata. MCP tool schemas are the
    host's to measure and are deliberately not counted here.
    """
    core = tezgah_context.render(tezgah_context.always_on_core())
    conditional = sum(
        len(p) for p in policy.CORE.split("\n\n")
        if next((k for k, label in tezgah_context.CORE_RULES
                 if p.startswith(label)), None) in policy.CONDITIONAL_KEYS)
    reminder = tezgah_context.render(policy.PROMPT_REMINDER)
    skills = sum(len(name) + len(_frontmatter_description(
        os.path.join(HERE, "skills", name, "SKILL.md"))) + 8 for name in SKILLS)
    agents = sum(len(name) + len(desc) for name, desc, *_ in tezgah_agents.ROLES)
    agents += len("tezgah-orchestrator") + len(tezgah_agents.ORCH_DESC)
    rows = [
        ("core contract (always-on, per session)", len(core)),
        ("per-turn reminder", len(reminder)),
        ("skill metadata (%d)" % len(SKILLS), skills),
        ("subagent metadata (%d)" % (len(tezgah_agents.ROLES) + 1), agents),
        ("conditional rules (armed by task class)", conditional),
    ]
    return rows, len(tezgah_context.render(policy.CONTRACT))


def mcp_tool_schemas(command, timeout=30):
    """(tool count, schema bytes) an MCP server declares, or (0, None).

    The one band the budget report cannot count: the schemas are the host's,
    and the only honest way to size them is to ask the server. This performs
    the initialize + tools/list handshake over stdio and measures the JSON."""
    import json as _json
    import subprocess as _subprocess
    requests = [
        {"jsonrpc": "2.0", "id": 1, "method": "initialize",
         "params": {"protocolVersion": "2024-11-05", "capabilities": {},
                    "clientInfo": {"name": "tezgah-setup", "version": "1"}}},
        {"jsonrpc": "2.0", "method": "notifications/initialized"},
        {"jsonrpc": "2.0", "id": 2, "method": "tools/list", "params": {}},
    ]
    payload = "".join(_json.dumps(r) + "\n" for r in requests)
    try:
        proc = _subprocess.run(command, input=payload, capture_output=True,
                               text=True, timeout=timeout)
    except (OSError, _subprocess.SubprocessError):
        return 0, None
    for line in proc.stdout.splitlines():
        try:
            msg = _json.loads(line)
        except ValueError:
            continue
        if msg.get("id") == 2 and isinstance(msg.get("result"), dict):
            tools = msg["result"].get("tools") or []
            if tools:
                return len(tools), len(_json.dumps(tools))
    return 0, None


def mcp_schema_report():
    """Print the measured schema band for every MCP server tezgah registers."""
    servers = []
    cbm = tp.cbm_bin()
    if cbm:
        servers.append(("codebase-memory-mcp", [cbm]))
    print("\nMCP tool-schema band (measured by an initialize + tools/list handshake):")
    total_tools = total_bytes = 0
    for name, command in servers:
        tools, size = mcp_tool_schemas(command)
        if size is None:
            print("     %-24s not measured (the server did not answer tools/list)"
                  % name)
            continue
        total_tools += tools
        total_bytes += size
        print("     %-24s %3d tools  %7d bytes  ~%4.1fk tok"
              % (name, tools, size, size / 4 / 1000.0))
    if not servers:
        print("     no MCP server binary found on this machine")
    else:
        print("     %-24s %3d tools  %7d bytes  ~%4.1fk tok"
              % ("total", total_tools, total_bytes, total_bytes / 4 / 1000.0))
    print("     These bytes ride every request unless the host fetches schemas "
          "on demand.")


def context_budget_report():
    rows, on_demand = context_budget()
    print("\ncontext budget (always-on text; ~tokens = chars/4):")
    for label, chars in rows:
        print("     %-34s ~%4.1fk tok  %6d chars"
              % (label, (chars + 3) // 4 / 1000.0, chars))
    print("     %-34s ~%4.1fk tok  (only when the skill is read)"
          % ("full contract (on demand)", (on_demand + 3) // 4 / 1000.0))
    print("     %-34s run --mcp-schemas to measure" % "MCP tool schemas")


def report(hosts):
    print("tezgah checkout: %s\n" % HERE)
    print("roots (%s):" % ("TEZGAH_ROOTS" if os.environ.get("TEZGAH_ROOTS")
                           else "config" if os.path.exists(tp.CONFIG) else "default"))
    for r in tp.roots():
        print("  %s %s" % (OK if os.path.isdir(r) else NO, r))
    print("\ncommon:")
    rows = [
        ("config %s" % tp.CONFIG, os.path.exists(tp.CONFIG)),
        ("%s on PATH" % tp.CBM, bool(tp.cbm_bin())),
        ("consult/codegen provider key (OpenRouter or DeepSeek)", tp.have_consult_key()),
        ("orx on PATH (OpenResearch research routing)", bool(tp.orx_bin())),
        ("npx on PATH (app-analysis MCP servers)", bool(shutil.which("npx"))),
        ("app artifacts dir %s" % tezgah_apps.ARTIFACTS,
         os.path.isdir(tezgah_apps.ARTIFACTS)),
        ("git", bool(shutil.which("git"))),
        ("plugin.json and marketplace.json agree on the version", versions_agree()),
    ]
    for label, good in rows:
        print("  %s %s" % (OK if good else NO, label))
    if contract_stale():
        print("  %s %s" % (NO, "opencode contract stale - re-run --install"))
    pred = predecessors()
    if pred:
        print("\npredecessor wiring still present (retire with --adopt):")
        for p in pred:
            print("  ?    %s" % p)
    for h in hosts:
        print("\n%s:" % h)
        for label, good in HOST_CHECKS[h]():
            print("  %s %s" % (OK if good else NO, label))
    context_budget_report()


def host_checks_claude():
    copies = plugin_copies()
    return [
        ("statusline symlink", os.path.islink(os.path.join(CLAUDE, "statusline.py"))),
        ("statusLine in settings.json", statusline_wired()),
        ("workflows in ~/.claude/workflows",
         all(os.path.islink(os.path.join(CLAUDE, "workflows", w)) for w in WORKFLOW_FILES)),
        ("bin on ~/.claude/bin",
         all(os.path.islink(os.path.join(CLAUDE, "bin", b))
             for b in ("consult", "codegen", "tezgah-render-table"))),
        # Claude runs the plugin COPY, not this checkout, so a copy that lags it
        # is the one gap the other four rows cannot see. An absent copy is not
        # current either: all([]) is True, and a row that stays green on a
        # machine with no tezgah plugin at all is not a check.
        ("plugin copy current (hooks/tezgah_policy.py matches)",
         bool(copies) and all(plugin_copy_current(t) for t in copies)),
    ]


def _hooks_has(path, marker, events=None):
    data = read_json(path, {}) or {}
    for ev, arr in (data.get("hooks") or {}).items():
        if events and ev not in events:
            continue
        if any(marker in json.dumps(e) for e in arr):
            return True
    return False


def host_checks_codex():
    cmd = "tezgah-codex-hook"
    # a relocated home is named, so a report can never show ~/.codex while these
    # rows read the tree codex actually loads
    where = (" in %s" % CODEX
             if CODEX != os.path.join(tp.HOME, ".codex") else "")
    try:
        with open(os.path.join(CODEX, "config.toml")) as fh:
            toml = fh.read()
    except OSError:
        toml = ""
    return [
        ("hooks.json wired%s" % where,
         _hooks_has(os.path.join(CODEX, "hooks.json"), cmd)),
        ("skills linked%s" % where,
         all(os.path.islink(os.path.join(CODEX, "skills", s)) for s in SKILLS)),
        ("MCP in config.toml", "mcp_servers.codebase-memory-mcp" in toml),
        ("app MCP servers in config.toml",
         all("[mcp_servers.%s]" % n in toml for n in tezgah_apps.names(False))),
    ]


def host_checks_opencode():
    cfg = read_json(os.path.join(OPENCODE, "opencode.json"), {})
    tui = read_json(os.path.join(OPENCODE, "tui.json"), {})
    instr = cfg.get("instructions") or []
    specs = [p if isinstance(p, str) else p[0] for p in (tui.get("plugin") or [])]
    return [
        ("plugin linked", any(os.path.islink(os.path.join(OPENCODE, d, "tezgah.js"))
                              for d in ("plugins", "plugin"))),
        ("skills linked", all(os.path.islink(os.path.join(OPENCODE, "skills", s)) for s in SKILLS)),
        ("contract in instructions", any("tezgah" in i for i in instr)),
        ("skill router in instructions + written",
         SKILL_ROUTER in instr and os.path.isfile(SKILL_ROUTER)),
        ("full skill router written (on demand)",
         os.path.isfile(SKILL_ROUTER_FULL)),
        ("permission.skill denied", (cfg.get("permission") or {}).get("skill") == "deny"),
        ("MCP in opencode.json", "codebase-memory-mcp" in (cfg.get("mcp") or {})),
        ("app MCP servers in opencode.json",
         all(n in (cfg.get("mcp") or {}) for n in tezgah_apps.names(False))),
        ("context pruning armed (compaction.prune)",
         (cfg.get("compaction") or {}).get("prune") is True),
        ("watcher ignores noisy trees",
         bool(set(OPENCODE_IGNORE)
              & set(((cfg.get("watcher") or {}).get("ignore") or [])))),
        ("status line plugin in tui.json + linked",
         any("tezgah-tui" in s for s in specs)
         and os.path.exists(os.path.join(OPENCODE, "tui-plugins", "tezgah-tui.tsx"))),
    ]


def host_checks_cursor():
    mcp = read_json(os.path.join(CURSOR, "mcp.json"), {})
    cli = read_json(os.path.join(CURSOR, "cli-config.json"), {})
    return [
        ("hooks.json wired", _hooks_has(os.path.join(CURSOR, "hooks.json"), "tezgah-cursor-hook")),
        ("skills linked", all(os.path.islink(os.path.join(CURSOR, "skills", s)) for s in SKILLS)),
        ("MCP in mcp.json", "codebase-memory-mcp" in (mcp.get("mcpServers") or {})),
        ("app MCP servers in mcp.json",
         all(n in (mcp.get("mcpServers") or {}) for n in tezgah_apps.names(False))),
        ("statusLine in cli-config.json", "tezgah-statusline" in json.dumps(cli.get("statusLine") or {})),
        ("cursor-agent CLI on PATH",
         bool(tp.which_user("cursor-agent") or tp.which_user("cursor"))),
    ]


def host_checks_dsh():
    try:
        with open(DSH_PATCH) as fh:
            patched = fh.read()
    except OSError:
        patched = ""
    try:
        with open(DSH_WEB_PATCH) as fh:
            web_patch = fh.read()
    except OSError:
        web_patch = ""
    linked = os.path.join(DSH_WEB, "node_modules", DSH_STATUSLINE)
    return [
        ("claude-code hooks bridge in cordis.patch.yml", "dsh-hooks-claude-code" in patched),
        ("MCP bridge in cordis.patch.yml", "dsh-mcp-client" in patched),
        ("app MCP servers in cordis.patch.yml",
         all("serverName: %s" % n in patched for n in tezgah_apps.names(False))),
        ("OpenRouter + DeepSeek routes in cordis.patch.yml",
         "openrouter" in patched and "DEEPSEEK_API_KEY" in patched),
        ("dsh launcher on PATH (~/.local/bin/dsh)",
         is_tezgah_link(os.path.join(LOCAL_BIN, "dsh"))),
        ("skills linked", all(os.path.islink(os.path.join(DSH, "skills", s)) for s in SKILLS)),
        ("OpenRouter route key resolvable (env, ~/.config/openrouter/key or store)",
         dsh_key_resolvable("OPENROUTER_API_KEY")),
        ("DeepSeek route key resolvable (env, ~/.config/deepseek/key or store)",
         dsh_key_resolvable("DEEPSEEK_API_KEY")),
        ("status-line plugin linked into the web profile",
         os.path.exists(linked)),
        ("status-line row in the web cordis.patch.yml", DSH_STATUSLINE in web_patch),
    ]



def omp_hook_answers():
    """Run the omp hook once: it must answer the status event with the marks.

    The installed extension is a bridge, so the only honest check is that the
    python half starts and answers; a hook that cannot start is the difference
    between a status line and an empty line.
    """
    path = os.path.join(HERE, "hosts", "omp", "hook.py")
    try:
        proc = subprocess.run([sys.executable, path],
                              input=json.dumps({"event": "status",
                                                "cwd": os.getcwd()}),
                              capture_output=True, text=True, timeout=20)
    except (OSError, subprocess.SubprocessError):
        return False
    try:
        return bool(json.loads(proc.stdout or "{}").get("status"))
    except ValueError:
        return False


def host_checks_omp():
    rules = os.path.join(OMP_AGENT, "RULES.md")
    try:
        with open(rules) as fh:
            rules_text = fh.read()
    except OSError:
        rules_text = ""
    try:
        with open(os.path.join(OMP_AGENT, "hooks", "pre", "tezgah-hook.ts")) as fh:
            hook_text = fh.read()
    except OSError:
        hook_text = ""
    mcp = read_json(os.path.join(OMP_AGENT, "mcp.json"), {})
    servers = mcp.get("mcpServers") or {}
    agents_dir = os.path.join(OMP_AGENT, "agents")
    agents = ([n for n in os.listdir(agents_dir)
               if n.startswith("tezgah-") and n.endswith(".md")]
              if os.path.isdir(agents_dir) else [])
    return [
        ("RULES.md carries the contract",
         "tezgah:start" in rules_text and "Ponytail" in rules_text),
        ("skill metadata band present", "Ponytail" in rules_text),
        ("skills linked",
         all(os.path.islink(os.path.join(OMP_AGENT, "skills", s))
             for s in SKILLS)),
        ("subagents generated", len(agents) >= 4),
        ("MCP in mcp.json", "codebase-memory-mcp" in servers),
        ("app MCP servers in mcp.json",
         all(n in servers for n in tezgah_apps.names(False))),
        ("app MCP command is one executable",
         all(isinstance((servers.get(n) or {}).get("command"), str)
             for n in tezgah_apps.names(False))),
        ("session, prompt, tool and stop hooks wired",
         all(k in hook_text for k in ("session_start", "before_agent_start",
                                      "tool_call", "session_stop",
                                      "setWidget", "setStatus"))),
        ("status line answers", omp_hook_answers()),
    ]


HOST_CHECKS = {"claude": host_checks_claude, "codex": host_checks_codex,
               "opencode": host_checks_opencode, "cursor": host_checks_cursor,
               "dsh": host_checks_dsh, "omp": host_checks_omp}


def versions_agree():
    try:
        v = []
        for f in ("plugin.json", "marketplace.json"):
            with open(os.path.join(HERE, ".claude-plugin", f)) as fh:
                d = json.load(fh)
            v.append(d["plugins"][0]["version"] if f == "marketplace.json" else d["version"])
        return v[0] == v[1]
    except Exception:
        return False


# ------------------------------------------------------------------- sync ----

# One file any revision of the checkout carries and Claude's runtime loads, so a
# COPY that lags HEAD shows up as a hash mismatch instead of as the version
# number both trees happen to report.
PLUGIN_FINGERPRINT = os.path.join("hooks", "tezgah_policy.py")


def file_sha(path):
    try:
        with open(path, "rb") as fh:
            return hashlib.sha256(fh.read()).hexdigest()
    except OSError:
        return ""


def plugin_copies():
    """Every installed tezgah plugin copy under ~/.claude/plugins/cache.

    Claude Code runs the plugin from a COPY, never from this checkout, so this
    is the tree its hooks and skills actually come from."""
    cache = os.path.join(HOME, ".claude", "plugins", "cache")
    out = []
    for dirpath, _dirnames, _files in os.walk(cache):
        try:
            with open(os.path.join(dirpath, ".claude-plugin", "plugin.json")) as fh:
                if json.load(fh).get("name") == "tezgah":
                    out.append(dirpath)
        except Exception:
            continue
    return out


def plugin_copy_current(target):
    """True when the copy carries this checkout's PLUGIN_FINGERPRINT."""
    want = file_sha(os.path.join(HERE, PLUGIN_FINGERPRINT))
    return bool(want) and file_sha(os.path.join(target, PLUGIN_FINGERPRINT)) == want


def sync():
    """Copy this checkout over the installed Claude plugin, which is a COPY."""
    cache = os.path.join(HOME, ".claude", "plugins", "cache")
    targets = plugin_copies()
    if not targets:
        print("no installed tezgah found under %s (nothing to sync)" % cache)
        return 1
    tracked = subprocess.run(
        ["git", "-C", HERE, "ls-files", "--cached", "--others", "--exclude-standard"],
        capture_output=True, text=True)
    if tracked.returncode != 0:
        print("not a git checkout, nothing to sync from: %s" % HERE)
        return 1
    # --others includes a new source file that is not committed yet; a plain
    # `ls-files` would drop it from the copy (and delete it from the plugin cache)
    files = [f for f in tracked.stdout.splitlines()
             if f and not f.startswith("plans/") and "__pycache__" not in f]
    for t in targets:
        # A copy that contains this checkout IS this checkout, so emptying it
        # would delete the tree being copied from (someone running the copy's own
        # bin/tezgah-setup). The documented path never does; this says no.
        real = os.path.realpath(t)
        if real == HERE or HERE.startswith(real + os.sep):
            print("%s skip %s (it holds this checkout)" % (NO, t))
            continue
        for name in os.listdir(t):
            if name != ".git":
                path = os.path.join(t, name)
                shutil.rmtree(path, ignore_errors=True) if os.path.isdir(path) \
                    else os.remove(path)
        for f in files:
            src = os.path.join(HERE, f)
            if not os.path.isfile(src):
                # ls-files lists a path deleted in the working tree until the
                # deletion is staged; copying it would crash the sync (measured
                # when the README translations were reduced).
                continue
            dst = os.path.join(t, f)
            os.makedirs(os.path.dirname(dst), exist_ok=True)
            shutil.copy2(src, dst)
        print("%s synced %s (%d files)" % (OK, t, len(files)))
    print("\nrestart Claude Code: hooks are read once per session.")
    return 0


def refresh_plugin_copy(hosts):
    """A stale plugin copy is the one gap --install would otherwise leave behind,
    because Claude runs that copy and not this checkout: refresh it exactly as
    `--sync` does rather than duplicating the copy logic."""
    if "claude" in hosts and any(not plugin_copy_current(t) for t in plugin_copies()):
        print()
        sync()


# ----------------------------------------------------------------- wizard ----

class WizardAbort(Exception):
    """No answer could be collected: EOF on stdin, or a non-answer repeated past
    WIZ_TRIES. The wizard writes nothing before its final yes, so an abort
    leaves the machine as it was."""


WIZ_TRIES = 5


def _ask(prompt, default, input_fn):
    """One line of input. Empty takes the default; an unusable stdin aborts
    instead of hanging or dumping a traceback, which is what makes a piped or
    already-closed stdin safe."""
    text = "%s [%s] " % (prompt, default) if default else "%s " % prompt
    try:
        raw = input_fn(text)
    except (EOFError, OSError, ValueError, RuntimeError) as exc:
        raise WizardAbort("stdin unusable (%s)" % (str(exc) or "closed"))
    return raw.strip() or default


def _ask_bool(prompt, default, input_fn):
    hint = "[Y/n]" if default else "[y/N]"
    for _ in range(WIZ_TRIES):
        raw = _ask("%s %s " % (prompt, hint), "", input_fn).lower()
        if not raw:
            return default
        if raw in ("y", "yes"):
            return True
        if raw in ("n", "no"):
            return False
        print("  answer y or n")
    raise WizardAbort("no yes/no answer for %r" % prompt)


def parse_hosts(raw):
    """Names, 1-based numbers, or `all` -> host list. None when anything is
    unknown, so the caller re-asks instead of arming half the selection."""
    if raw.strip().lower() == "all":
        return list(ALL_HOSTS)
    picked = []
    for tok in re.split(r"[,\s]+", raw.strip()):
        if not tok:
            continue
        if tok.isdigit() and 1 <= int(tok) <= len(ALL_HOSTS):
            tok = ALL_HOSTS[int(tok) - 1]
        if tok not in ALL_HOSTS:
            return None
        if tok not in picked:
            picked.append(tok)
    return picked or None


def _ask_hosts(default, input_fn):
    present = detected()
    print("\nhosts (%s detected here):" % (", ".join(
        h for h in ALL_HOSTS if present[h]) or "none"))
    for i, h in enumerate(ALL_HOSTS, 1):
        print("  %d) %-9s %s" % (i, h, "detected" if present[h] else "not detected"))
    for _ in range(WIZ_TRIES):
        raw = _ask("arm which hosts?", ",".join(default), input_fn)
        picked = parse_hosts(raw)
        if picked:
            return picked
        if not default and not raw.strip():
            # nothing is detectable here: an empty answer means "arm none", the
            # end state a bare `--install` reaches, not a dead end
            return []
        print("  unknown host; choose from %s" % ", ".join(ALL_HOSTS))
    raise WizardAbort("no valid host selection")


def _ask_roots(default, input_fn):
    print("\nroots are the directories your repos live in; context and subagents "
          "are scoped to them")
    for _ in range(WIZ_TRIES):
        raw = _ask("roots (%s-separated)" % os.pathsep, os.pathsep.join(default), input_fn)
        picked = [expand(p) for p in raw.split(os.pathsep) if p.strip()]
        # a relative path would be resolved against whatever cwd a later session
        # happens to have, and a file can hold no repos, so both are re-asked
        if picked and all(os.path.isabs(p) and not os.path.isfile(p) for p in picked):
            for p in picked:
                # a root that does not exist yet is legitimate: the repos may not
                # be cloned yet. tezgah never creates it, so say so once.
                if not os.path.isdir(p):
                    print("  note: %s does not exist yet; tezgah will not create it, "
                          "and generates nothing under it until it does" % p)
            return picked
        print("  use absolute paths to directories, e.g. %s/work" % HOME)
    raise WizardAbort("no valid root directory")


def wizard_plan(hosts, roots, deps_off, devtools, adopt_now):
    """What the wizard is about to do, printed before it does any of it."""
    print("\nthe plan:")
    print("  %s arm: %s" % (OK, ", ".join(hosts) or "none detected"))
    for r in roots:
        print("  %s root %s" % (OK if os.path.isdir(r) else NO, r))
    print("  %s optional tools: %s" % (OK, "skip" if deps_off else
          "install the missing ones over the network (orx, cursor-agent, dsh, pnpm)"))
    print("  %s Chrome DevTools MCP: %s" % (OK, "wire" if devtools else "skip"))
    if adopt_now:
        print("  %s retire the predecessor wiring (moved aside, not deleted)" % OK)
    print("  files tezgah rewrites are backed up once as <file>.tezgah-bak")


def wizard(default_hosts, default_roots, deps_off_default, devtools_default,
           dry_run=False, input_fn=input):
    """Every question first, then the plan, then the shared apply path. The flags
    supply the defaults, so `--wizard --hosts omp` only asks the rest."""
    print("tezgah setup - press enter to take the value in brackets\n")
    hosts = _ask_hosts(default_hosts, input_fn)
    roots = _ask_roots(default_roots, input_fn)
    deps_off = not _ask_bool("install the missing optional tools (needs the network)?",
                             not deps_off_default, input_fn)
    devtools = _ask_bool("wire the optional Chrome DevTools MCP?", devtools_default, input_fn)
    pred = predecessors()
    if pred:
        print("\npredecessor wiring still present:")
        for p in pred:
            print("  ?    %s" % p)
    adopt_now = _ask_bool("retire it (moved aside under ~/.config/tezgah/adopted/)?",
                          True, input_fn) if pred else False
    wizard_plan(hosts, roots, deps_off, devtools, adopt_now)
    if not _ask_bool("\nproceed?", True, input_fn):
        print("nothing was installed; `tezgah-setup --install` runs the same steps "
              "with no questions")
        return 0
    global APPS_DEVTOOLS
    APPS_DEVTOOLS = devtools
    if adopt_now:
        adopt()
    return install_all(hosts, roots, deps_off, dry_run, redetect=False)


# ------------------------------------------------------------------- main ----

def detected_hosts():
    """The hosts present here, in ALL_HOSTS order."""
    return [h for h, present in detected().items() if present]


def unarmed_new_hosts(armed, before, after):
    """Hosts that only appeared while the tools were being installed and are not
    in `armed`. `before` keeps this to what the install itself made available,
    so the hosts the user deliberately left out are not reported back at them."""
    return [h for h in after if h not in before and h not in armed]


def install_all(hosts, new_roots, deps_off, dry_run, redetect):
    """The one install path, shared by `--install` and the wizard: the wizard
    decides the answers, never how they are applied."""
    late = []
    if not deps_off:
        before = detected_hosts()
        install_deps(dry_run=dry_run)
        if redetect:
            # a just-installed tool can enable a host we did not detect at start
            hosts = detected_hosts()
        else:
            late = unarmed_new_hosts(hosts, before, detected_hosts())
    print("installing for: %s\n" % (", ".join(hosts) or "none detected"))
    if late:
        print("%s %s appeared while the tools were being installed, but only the "
              "hosts in the plan were armed; add it with "
              "`tezgah-setup --install --hosts %s`" % (NO, ", ".join(late), ",".join(late)))
    install_common(new_roots, hosts)
    # before the host installers: opencode's generated skill router indexes
    # the orx skill dir, so the shim must exist when the router is written
    install_openresearch(hosts)
    for h in hosts:
        INSTALLERS[h]()
    refresh_plugin_copy(hosts)
    print()
    if deps_off:
        print("(deps skipped; run `tezgah-setup --deps` to install orx, "
              "cursor-agent and dsh)")
    return report(hosts)


def main(argv):
    ap = argparse.ArgumentParser(description="arm tezgah in every installed host")
    ap.add_argument("--install", action="store_true")
    ap.add_argument("--wizard", action="store_true",
                    help="ask the install questions (a bare run on a terminal does this)")
    ap.add_argument("--report", action="store_true",
                    help="report what is armed, per host (a bare run on a pipe does this)")
    ap.add_argument("--refresh", action="store_true",
                    help="re-render generated contract artifacts when the policy changed")
    ap.add_argument("--uninstall", action="store_true")
    ap.add_argument("--adopt", action="store_true")
    ap.add_argument("--sync", action="store_true")
    ap.add_argument("--status", nargs="?", const=os.getcwd())
    ap.add_argument("--agents", nargs="?", const=os.getcwd(),
                    help="regenerate this repo's subagent set (default: cwd)")
    ap.add_argument("--deps", action="store_true")
    ap.add_argument("--mcp-schemas", action="store_true",
                    help="measure the MCP tool-schema band by asking each server")
    ap.add_argument("--no-deps", action="store_true")
    ap.add_argument("--devtools", action="store_true",
                    help="also wire the optional Chrome DevTools MCP")
    ap.add_argument("--dry-run", action="store_true")
    ap.add_argument("--version", action="version", version=plugin_version())
    ap.add_argument("--roots")
    ap.add_argument("--hosts")
    args = ap.parse_args(argv[1:])
    global APPS_DEVTOOLS
    APPS_DEVTOOLS = args.devtools

    if args.sync:
        return sync()
    if args.refresh:
        path = refresh_contract()
        print("%s refreshed %s" % (OK, path) if path else "contract is current")
        return 0
    if args.status:
        print(tezgah_context.health_lines(os.path.realpath(expand(args.status))))
        return 0
    if args.deps and not args.install:
        install_deps(dry_run=args.dry_run)
        return 0
    if args.mcp_schemas:
        mcp_schema_report()
        return 0

    if args.agents:
        repo = tezgah_context.repo_root(os.path.realpath(expand(args.agents)))
        note = tezgah_agents.sync_root(repo, report_steady=True)
        print(note or "no agents generated (outside a root, or no capability)")
        return 0

    hosts = [h.strip() for h in args.hosts.split(",")] if args.hosts else detected_hosts()
    bad = [h for h in hosts if h not in ALL_HOSTS]
    if bad:
        sys.exit("unknown host(s): %s (choose from %s)" % (", ".join(bad), ", ".join(ALL_HOSTS)))

    # A bare run in a terminal is a person, so it gets the wizard; a piped,
    # agent or CI run keeps the non-interactive report.
    bare_tty = not argv[1:] and sys.stdin.isatty() and sys.stdout.isatty()
    wizard_mode = (args.wizard or bare_tty) and not args.report

    if args.uninstall:
        uninstall(hosts)
        return 0

    # --adopt retires the predecessor wiring before an install, but under the
    # wizard it waits: the wizard asks about it and adopts only after the yes, so
    # nothing is written before the plan is confirmed.
    if args.adopt and not wizard_mode:
        adopt()
        if not args.install:
            return 0

    new_roots = [r for r in args.roots.split(os.pathsep) if r.strip()] if args.roots else []
    # TEZGAH_NO_DEPS is the CI/test escape hatch, mirroring --no-deps
    deps_off = args.no_deps or os.environ.get("TEZGAH_NO_DEPS", "").strip() not in ("", "0")

    if wizard_mode:
        try:
            return wizard(hosts, new_roots or tp.roots() or [tp.DEFAULT_ROOT],
                          deps_off, args.devtools, args.dry_run)
        except WizardAbort as exc:
            print("wizard: %s" % exc)
            print("nothing was installed; `tezgah-setup --install` runs the same "
                  "steps with no questions")
            return 1

    if args.install:
        return install_all(hosts, new_roots, deps_off, args.dry_run, redetect=not args.hosts)

    if args.roots:
        sys.exit("--roots only means something with --install")
    return report(hosts)


if __name__ == "__main__":
    sys.exit(main(sys.argv))
